// lfsr_decoder.nanz — PRNG video frame decoder for ZX Spectrum
//
// LFSR seed → 96-byte buffer → XOR 8×8 blocks on screen
// Uses pointer deref (p^) for direct memory access — works on mzv AND mzx!
//
// HOW TO RUN:
//   mz fun/lfsr_decoder.nanz --asserts mir2            # asserts pass
//   mzv fun/lfsr_decoder.nanz                          # visual on MZV
//   mz fun/lfsr_decoder.nanz -o build/lfsr.a80         # Z80 asm
//   mza build/lfsr.a80 -o build/lfsr.bin               # binary for mzx

// ── LFSR-16: Galois, taps 16,14,13,11 ──────────────────────
// Period: 65535. Optimal Z80: SRL H; RR L; JR NC,+; XOR taps

fun lfsr_step(state: u16) -> u16 {
    // state / 2 = SRL+RR on Z80 (shift right, LSB→CY)
    // state % 2 = CY flag after shift
    let lsb: u8 = state % 2
    var next: u16 = state / 2
    if lsb == 1 { next = next xor 0xB400 }
    return next
}

// ── Buffer: 96 bytes at 0xE000 ──────────────────────────────
// Linear layout: byte[cy*4 + cx/8] bit(cx%8) = 32×24 grid

fun lfsr_fill_buffer(seed: u16) -> u16 {
    var state: u16 = seed
    let buf: ^u8 = 0xE000
    var i: u8 = 0
    while i < 96 {
        // Take low byte from LFSR state as buffer byte
        let p: ^u8 = 0xE000 + i
        p^ = state % 256
        // Advance LFSR 8 steps
        var j: u8 = 0
        while j < 8 {
            state = lfsr_step(state)
            j = j + 1
        }
        i = i + 1
    }
    return state
}

fun buf_bit_set(cx: u8, cy: u8) -> u8 {
    let byte_idx: u16 = cy * 4 + cx / 8
    let p: ^u8 = 0xE000 + byte_idx
    var val: u8 = p^
    let bit_idx: u8 = cx % 8
    var k: u8 = 0
    while k < bit_idx { val = val / 2  k = k + 1 }
    return val % 2
}

// ── ZX Spectrum screen ──────────────────────────────────────
// Cell (cx,cy) row r: 0x4000 + (cy/8)*2048 + r*256 + (cy%8)*32 + cx
// Next row in cell: +256 = INC H on Z80

fun cell_addr(cx: u8, cy: u8, row: u8) -> u16 {
    let third: u16 = cy / 8
    let char_row: u16 = cy % 8
    return 0x4000 + third * 2048 + row * 256 + char_row * 32 + cx
}

// XOR solid 8×8 block via pointer deref
// p^ = p^ xor 0xFF → LD A,(HL); XOR 0xFF; LD (HL),A on Z80
fun xor_block_8x8(cx: u8, cy: u8) -> void {
    var row: u8 = 0
    while row < 8 {
        let p: ^u8 = cell_addr(cx, cy, row)
        p^ = p^ xor 0xFF
        row = row + 1
    }
}

// ── Decode frame ────────────────────────────────────────────

fun decode_frame(seed: u16) -> u16 {
    let final_state: u16 = lfsr_fill_buffer(seed)
    var cy: u8 = 0
    while cy < 24 {
        var cx: u8 = 0
        while cx < 32 {
            if buf_bit_set(cx, cy) == 1 {
                xor_block_8x8(cx, cy)
            }
            cx = cx + 1
        }
        cy = cy + 1
    }
    return final_state
}

// ── Main ────────────────────────────────────────────────────

fun main() -> void {
    var seed: u16 = 0xACE1
    seed = decode_frame(seed)
    seed = decode_frame(seed)
    seed = decode_frame(seed)
}

// ── Tests ───────────────────────────────────────────────────

fun test_lfsr() -> u16 { return lfsr_step(1) }
fun test_no_zero() -> u8 {
    var s: u16 = 1
    var i: u8 = 0
    while i < 100 { s = lfsr_step(s)  if s == 0 { return 0 }  i = i + 1 }
    return 1
}
fun test_origin() -> u16 { return cell_addr(0, 0, 0) }
fun test_row1() -> u16 { return cell_addr(0, 0, 1) }
fun test_third2() -> u16 { return cell_addr(0, 16, 0) }

assert test_lfsr() == 46080 via mir2
assert test_no_zero() == 1 via mir2
assert test_origin() == 16384 via mir2
assert test_row1() == 16640 via mir2
assert test_third2() == 20480 via mir2
