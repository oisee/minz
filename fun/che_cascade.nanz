// che_cascade.nanz — Che Guevara cascade LFSR-16 renderer
//
// LFSR-16 (poly 0xB400) — single u16! Minimal register pressure.
// Split into tiny functions for PBQP (7 GPR = split wins over inline).
//
// HOW TO RUN:
//   mz fun/che_cascade.nanz -o build/che_cas.a80
//   mza build/che_cas.a80 -o build/che_cas.sna -t zxspectrum
//   mzx build/che_cas.sna

// ── LFSR-16 ─────────────────────────────────────────────────

fun lfsr16(state: u16) -> u16 {
    let bit: u8 = state % 2
    var next: u16 = state / 2
    if bit == 1 { next = next xor 0xB400 }
    if next == 0 { next = 1 }
    return next
}

// ── Make buffer: LFSR → 768 bytes at 0xC000 ─────────────────

global g_state: u16 = 0

fun warmup(n: u16) -> void {
    var i: u16 = 0
    while i < n { g_state = lfsr16(g_state)  i = i + 1 }
}

fun fill_buf(and_mask: u8) -> void {
    var idx: u16 = 0
    while idx < 768 {
        g_state = lfsr16(g_state)
        let p: ^u8 = 0xC000 + idx
        let lo: u8 = g_state % 256
        if (lo % (and_mask + 1)) == and_mask {
            p^ = 1
        } else {
            p^ = 0
        }
        idx = idx + 1
    }
}

// ── XOR single pixel on ZX screen ───────────────────────────

fun xor_pixel(px: u8, py: u8) -> void {
    if px >= 128 { return }
    if py >= 96 { return }
    let third: u16 = py / 64
    let prow: u16 = py % 8
    let crow: u16 = (py / 8) % 8
    let xbyte: u8 = px / 8
    let xbit: u8 = 7 - (px % 8)
    let addr: u16 = 0x4000 + third * 2048 + prow * 256 + crow * 32 + xbyte
    var bit_mask: u8 = 1
    var s: u8 = 0
    while s < xbit { bit_mask = bit_mask + bit_mask  s = s + 1 }
    let sp: ^u8 = addr
    sp^ = sp^ xor bit_mask
}

// ── XOR blk×blk block at (px, py) ──────────────────────────

fun xor_blk(px: u8, py: u8, blk: u8) -> void {
    var dy: u8 = 0
    while dy < blk {
        var dx: u8 = 0
        while dx < blk {
            xor_pixel(px + dx, py + dy)
            dx = dx + 1
        }
        dy = dy + 1
    }
}

// ── Apply buffer to screen ──────────────────────────────────

fun apply_buf(ox: u8, oy: u8, blk: u8) -> void {
    var by: u8 = 0
    while by < 24 {
        var bx: u8 = 0
        while bx < 32 {
            let p: ^u8 = 0xC000 + by * 32 + bx
            if p^ != 0 {
                xor_blk(ox + bx * blk, oy + by * blk, blk)
            }
            bx = bx + 1
        }
        by = by + 1
    }
}

// ── Process one seed ────────────────────────────────────────

fun process_seed(seed: u16, and_n: u8, wu: u16, ox: u8, oy: u8, blk: u8) -> void {
    g_state = seed
    warmup(wu)
    var mask: u8 = 1
    var m: u8 = 0
    while m < and_n { mask = mask + mask  m = m + 1 }
    mask = mask - 1
    fill_buf(mask)
    apply_buf(ox, oy, blk)
}

// ── Main: first 21 seeds (coarse layer) ─────────────────────

fun main() -> void {
    process_seed(450, 3, 0, 0, 0, 4)
    // More seeds: see cascade_seeds.json

    // Halt — freeze screen for screenshot
    asm {
        DI
        HALT
    }
}
