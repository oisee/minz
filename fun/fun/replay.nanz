// replay.nanz — LFSR-16 AND-cascade XOR renderer for ZX Spectrum
//
// Reads seeds from binary table at SEEDS_ADDR (generated by gen_seeds_bin.py).
// Renders onto ZX Spectrum screen (0x4000).
//
// Binary format at SEEDS_ADDR:
//   u16 LE: n_seeds
//   per entry × n_seeds (7 bytes each):
//     u16 LE: seed
//     u8: ox, oy, blk, and_n, warmup
//
// HOW TO BUILD:
//   python3 gen_seeds_bin.py ~/dev/z80-optimizer/data/foveal_cascade_seeds.json seeds_lfsr.bin
//   mz --vir replay.nanz -o build/replay.a80
//   # edit build/replay.a80: add SEEDS_ADDR data near the end (see gen_seeds_bin.py output)
//   mza build/replay.a80 -o build/replay.bin
//   mze --target spectrum build/replay.bin

// ── Memory layout ─────────────────────────────────────────────
// 0x4000..0x57FF  ZX Spectrum screen
// 0xC000..0xCBFF  buf[768] — block buffer (1 byte per block)
// 0xCC00..0xCFFF  seeds binary table (n_seeds u16 + entries)
// 0xD000..0xFF00  stack

global seeds_addr: u16 = 0xCC00    // seeds binary table
global buf_addr:   u16 = 0xC000    // 768-byte block buffer

// ── LFSR-16: next state ────────────────────────────────────────
// state = (state >> 1) ^ (0xB400 if state & 1 else 0)
fun lfsr16(state: u16) -> u16 {
    let lsb: u8 = state % 2        // LSB
    let next: u16 = state / 2      // state >> 1
    if lsb == 1 {
        return next xor 0xB400
    }
    return next
}

// ── makeBuf: fill 768-byte buffer at buf_addr ──────────────────
// Runs LFSR (warmup + 768*and_n) steps, fills buf[i] = AND of and_n bits.
fun make_buf(seed: u16, warmup: u8, and_n: u8) -> void {
    var s: u16 = seed
    if s == 0 { s = 1 }

    var w: u8 = 0
    while w < warmup { s = lfsr16(s)  w = w + 1 }

    var i: u8 = 0
    var j: u8 = 0
    while i < 3 {                   // 3 × 256 = 768 blocks
        while j < 255 {             // j = 0..254 in inner, last iter j=255 below
            var acc: u8 = 1
            var k: u8 = 0
            while k < and_n {
                s = lfsr16(s)
                acc = acc & (s % 2)
                k = k + 1
            }
            let p: ^u8 = buf_addr + i * 256 + j
            p^ = acc
            j = j + 1
        }
        // j == 255: last block of the 256
        var acc: u8 = 1
        var k: u8 = 0
        while k < and_n {
            s = lfsr16(s)
            acc = acc & (s % 2)
            k = k + 1
        }
        let p: ^u8 = buf_addr + i * 256 + 255
        p^ = acc
        i = i + 1
        j = 0
    }
}

// ── ZX Spectrum pixel address ──────────────────────────────────
fun pixel_addr(x: u8, y: u8) -> u16 {
    let y7:   u8 = y / 64
    let y2_0: u8 = y % 8
    let y5_3: u8 = (y / 8) % 8
    let xb:   u8 = x / 8
    return 0x4000 + y7 * 2048 + y2_0 * 256 + y5_3 * 32 + xb
}

// ── XOR one pixel ──────────────────────────────────────────────
fun xor_pixel(x: u8, y: u8) -> void {
    let bit_pos: u8 = 7 - (x % 8)
    var mask: u8 = 1
    var i: u8 = 0
    while i < bit_pos { mask = mask + mask  i = i + 1 }
    let addr: u16 = pixel_addr(x, y)
    let p: ^u8 = addr
    p^ = p^ xor mask
}

// ── applyBuf: XOR active blocks onto screen ───────────────────
fun apply_buf(ox: u8, oy: u8, blk: u8) -> void {
    var by: u8 = 0
    while by < 24 {
        var bx: u8 = 0
        while bx < 32 {
            let bidx: u16 = by * 32 + bx
            let bp: ^u8 = buf_addr + bidx
            if bp^ == 1 {
                var dy: u8 = 0
                while dy < blk {
                    var dx: u8 = 0
                    while dx < blk {
                        let px: u8 = ox + bx * blk + dx
                        let py: u8 = oy + by * blk + dy
                        if px < 128 {
                            if py < 96 {
                                xor_pixel(px, py)
                            }
                        }
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
            }
            bx = bx + 1
        }
        by = by + 1
    }
}

// ── Main: read seeds table, render all ────────────────────────
fun main() -> void {
    // Clear screen
    var i: u16 = 0
    while i < 0x17FF {
        let p: ^u8 = 0x4000 + i
        p^ = 0
        i = i + 1
    }

    // Read n_seeds from table header (u16 LE at seeds_addr)
    let p0: ^u8 = seeds_addr
    let p1: ^u8 = seeds_addr + 1
    let n_seeds: u16 = p0^ + p1^ * 256

    // Process each seed entry (7 bytes: u16 seed + 5 × u8)
    var idx: u16 = 0
    while idx < n_seeds {
        let base: u16 = seeds_addr + 2 + idx * 7
        let ps0: ^u8 = base
        let ps1: ^u8 = base + 1
        let seed: u16 = ps0^ + ps1^ * 256
        let ox_p:     ^u8 = base + 2
        let oy_p:     ^u8 = base + 3
        let blk_p:    ^u8 = base + 4
        let and_n_p:  ^u8 = base + 5
        let warmup_p: ^u8 = base + 6

        make_buf(seed, warmup_p^, and_n_p^)
        apply_buf(ox_p^, oy_p^, blk_p^)

        idx = idx + 1
    }
}
