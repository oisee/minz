// che_nanz.nanz — Che Guevara decoder, idiomatic Nanz
//
// for..in range → DJNZ, pointer deref → LD (HL), strength-reduced div/mod
//
// HOW TO RUN:
//   mz fun/che_nanz.nanz -o build/che_n.a80
//   mza build/che_n.a80 -o build/che_n.bin
//   mze build/che_n.bin

// ── LFSR state (globals → VIR accesses via LD (nn)) ─────────

global st_dh: u16 = 0
global st_el: u16 = 0

fun lfsr_step() -> void {
    let el: u16 = st_el
    let dh: u16 = st_dh
    let bit: u8 = el % 2
    st_el = el / 2
    if dh % 2 == 1 { st_el = st_el + 32768 }
    st_dh = dh / 2
    if bit == 1 {
        st_dh = st_dh xor 0xB4BC
        st_el = st_el xor 0xD35C
    }
}

fun lfsr_x(el: u16) -> u8 {
    let raw: u8 = el % 128
    return raw / 8
}

fun lfsr_y(dh: u16) -> u8 {
    // Full 16-bit mod 96, not just low byte!
    let y16: u16 = dh % 96
    let y: u8 = y16 % 256
    return y / 8
}

// ── Screen XOR block ────────────────────────────────────────

fun xor_block(cx: u8, cy: u8) -> void {
    let third: u16 = cy / 8
    let row: u16 = cy % 8
    var addr: u16 = 0x4000 + third * 2048 + row * 32 + cx
    for r in 0..8 {
        let p: ^u8 = addr
        p^ = p^ xor 0xFF
        addr = addr + 256
    }
}

// ── Main ────────────────────────────────────────────────────

fun main() -> void {
    st_dh = 0x8165
    st_el = 0xBEEF

    // Warmup
    for i in 0..8 { lfsr_step() }

    // Clear buffer
    for i in 0..192 {
        let p: ^u8 = 0xC000 + i
        p^ = 0
    }

    // 576 points → toggle buffer cells
    var pt: u16 = 0
    while pt < 576 {
        lfsr_step()
        let cx: u8 = lfsr_x(st_el)
        let cy: u8 = lfsr_y(st_dh)
        let bp: ^u8 = 0xC000 + cy * 16 + cx
        bp^ = bp^ xor 0xFF
        pt = pt + 1
    }

    // Blit buffer → screen
    for cy in 0..12 {
        for cx in 0..16 {
            let bp: ^u8 = 0xC000 + cy * 16 + cx
            if bp^ != 0 { xor_block(cx, cy) }
        }
    }
}
