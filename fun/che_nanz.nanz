// che_nanz.nanz — Che Guevara decoder, optimized for Z80 code size
//
// 32-bit Galois LFSR → XOR 8×8 blocks on ZX Spectrum screen
// seg0: seed=0x8165, init=0xBEEF, 576 points, 128×96 region
//
// HOW TO RUN:
//   mz fun/che_nanz.nanz -o build/che_n.a80
//   mza build/che_n.a80 -o build/che_n.bin       # ~400 bytes
//   mze build/che_n.bin                            # display Che!
//
// Gap: 3.3× vs optimal asm (121B). Remaining gap is structural:
//   globals in memory (not register-resident DEHL)
//   CALL overhead, while-mod96 loop, multiply-based screen addr

global st_dh: u16 = 0
global st_el: u16 = 0

fun lfsr_step() -> void {
    let el: u16 = st_el
    let dh: u16 = st_dh
    let bit: u8 = el % 2
    st_el = el / 2
    if dh % 2 == 1 { st_el = st_el + 32768 }
    st_dh = dh / 2
    if bit == 1 {
        st_dh = st_dh xor 0xB4BC
        st_el = st_el xor 0xD35C
    }
}

fun xor_block(cx: u8, cy: u8) -> void {
    let third: u16 = cy / 8
    let row: u16 = cy % 8
    var addr: u16 = 0x4000 + third * 2048 + row * 32 + cx
    var r: u8 = 0
    while r < 8 {
        let p: ^u8 = addr
        p^ = p^ xor 0xFF
        addr = addr + 256
        r = r + 1
    }
}

fun main() -> void {
    st_dh = 0x8165
    st_el = 0xBEEF

    var w: u8 = 0
    while w < 8 { lfsr_step()  w = w + 1 }

    var i: u8 = 0
    while i < 192 {
        let p: ^u8 = 0xC000 + i
        p^ = 0
        i = i + 1
    }

    var pt: u16 = 0
    while pt < 576 {
        lfsr_step()
        let cx: u8 = (st_el % 128) / 8
        let dh_lo: u8 = st_dh % 256
        var raw_y: u8 = dh_lo
        while raw_y >= 96 { raw_y = raw_y - 96 }
        let cy: u8 = raw_y / 8
        let bp: ^u8 = 0xC000 + cy * 16 + cx
        bp^ = bp^ xor 0xFF
        pt = pt + 1
    }

    var cy: u8 = 0
    while cy < 12 {
        var cx: u8 = 0
        while cx < 16 {
            let bp: ^u8 = 0xC000 + cy * 16 + cx
            if bp^ != 0 { xor_block(cx, cy) }
            cx = cx + 1
        }
        cy = cy + 1
    }
}
