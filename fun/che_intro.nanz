// che_intro.nanz — Che Guevara ZX Spectrum intro
//
// 64 LFSR layers XOR random pixels on 128×96 screen.
// GPU-found optimal seeds: 2968 total points → recognizable face.
// Rewritten in a more idiomatic Nanz style:
//   - static typed arrays for layer data
//   - LUT-based bit masks
//   - no runtime table construction
//
// HOW TO RUN (Nanz → Z80):
//   mz fun/che_intro.nanz -o build/che.a80
//   mza build/che.a80 -o build/che.bin
//   mze build/che.bin
//
// HOW TO RUN (asm version — hand-optimized):
//   mza fun/che_intro.asm -o build/che_asm.bin

// ── LFSR-16: same as z80-optimizer CUDA kernel ──────────────

fun lfsr_step(seed_h: u8, seed_l: u8, init_h: u8, init_l: u8) -> u16 {
    var sh: u8 = seed_h
    var sl: u8 = seed_l
    let feedback: u8 = sh / 128

    sh = (sh + sh) + (sl / 128)
    sl = sl + sl

    if feedback == 1 {
        sl = sl xor init_l
        sh = sh xor init_h
    }

    return sh * 256 + sl
}

// ── Static layer data ───────────────────────────────────────

global bit_masks: [u8; 8] = [128, 64, 32, 16, 8, 4, 2, 1]

global layer_seeds: [u16; 64] = [
    0xC6A1, 0xDE22, 0xA455, 0x6CCA, 0x6CCA, 0x6CCA, 0x6CCA, 0x6CCA,
    0x43AD, 0x2D28, 0x2D28, 0x2D28, 0xCE7A, 0x0C20, 0xF88E, 0x40B0,
    0x6370, 0x3498, 0x70C8, 0xE447, 0xD595, 0x1840, 0x1F56, 0x5E92,
    0x3449, 0x0BE0, 0x2968, 0x83C6, 0x894A, 0x5C3A, 0xB662, 0xD337,
    0x744F, 0x99F1, 0xC176, 0x060D, 0x56A7, 0x3E4D, 0x2FCD, 0x4AB5,
    0x9475, 0x3A0F, 0x5E9C, 0x2B1C, 0x6EF7, 0x0FD2, 0xAED2, 0x5EB5,
    0x7CE5, 0x4BE5, 0x0BEA, 0x33EC, 0x7D0D, 0x0613, 0x13F0, 0x96CE,
    0x4CCE, 0x091E, 0x2A8D, 0x5364, 0xB494, 0x15C5, 0x0176, 0x02EA
]

global layer_points: [u8; 64] = [
    128, 126, 124, 122, 120, 118, 116, 114,
    112, 110, 108, 106, 104, 102, 100, 98,
    48, 47, 46, 45, 44, 43, 42, 41,
    40, 39, 38, 37, 36, 35, 34, 33,
    24, 23, 23, 22, 22, 21, 21, 20,
    20, 19, 19, 18, 18, 17, 17, 16,
    16, 15, 15, 14, 14, 13, 13, 12,
    12, 11, 11, 10, 10, 9, 9, 8
]

// ── Pixel plot via pointer deref ────────────────────────────

fun xor_pixel(x: u8, y: u8) -> void {
    let y7: u8 = y / 64
    let y2_0: u8 = y % 8
    let y5_3: u8 = (y / 8) % 8
    let xbyte: u8 = x / 8

    let addr: u16 = 0x4000 + y7 * 2048 + y2_0 * 256 + y5_3 * 32 + xbyte
    let mask: u8 = bit_masks[x % 8]

    let p: ^u8 = addr
    p^ = p^ xor mask
}

// ── Render one layer ────────────────────────────────────────

fun render_layer(layer_idx: u8) -> void {
    let seed: u16 = layer_seeds[layer_idx]
    let points: u8 = layer_points[layer_idx]
    let init: u16 = 0x1337

    var sh: u8 = seed / 256
    var sl: u8 = seed % 256
    let ih: u8 = init / 256
    let il: u8 = init % 256

    var w: u8 = 0
    while w < 8 {
        let next: u16 = lfsr_step(sh, sl, ih, il)
        sh = next / 256
        sl = next % 256
        w = w + 1
    }

    var p: u8 = 0
    while p < points {
        let next: u16 = lfsr_step(sh, sl, ih, il)
        sh = next / 256
        sl = next % 256

        let x: u8 = sl % 128
        let y: u8 = sh % 96

        xor_pixel(x, y)
        p = p + 1
    }
}

// ── Main: render all 64 layers ──────────────────────────────

fun main() -> void {
    var layer: u8 = 0
    while layer < 64 {
        render_layer(layer)
        layer = layer + 1
    }
}

// Tests: run via mzv (MIR2 VM heap too small for 0x4000 screen address)
// mzv fun/che_intro.nanz
