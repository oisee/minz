// ADT Option pattern — safe nullable values on Z80
//
// enum with payload compiles to u16: tag in high byte, payload in low byte.
// None = 0x0000, Some(42) = 0x012A
// __tag() and __payload() auto-generated by the compiler.

enum Option { None, Some(u8) }

fun unwrap_or(opt: u16, def: u8) -> u8 {
    if (__tag(opt) == 1) {
        return __payload(opt)
    }
    return def
}

fun map_option(opt: u16, delta: u8) -> u16 {
    if (__tag(opt) == 0) {
        return None
    }
    return Some(__payload(opt) + delta)
}

// Find first non-zero element, return Some(value) or None
fun find_nonzero(buf: ^u8, idx: u8) -> u16 {
    if (buf[idx] != 0) {
        return Some(buf[idx])
    }
    return None
}

// Test wrappers for assert system (asserts only accept fn(literals) == literal)
fun test_unwrap_some() -> u8 {
    return unwrap_or(Some(42), 0)
}

fun test_unwrap_none() -> u8 {
    return unwrap_or(None, 77)
}

fun test_tag_some() -> u8 {
    return __tag(Some(99))
}

fun test_tag_none() -> u8 {
    return __tag(None)
}

fun test_payload() -> u8 {
    return __payload(Some(99))
}

fun test_map_some() -> u8 {
    return __payload(map_option(Some(10), 5))
}

fun test_map_none() -> u8 {
    return __tag(map_option(None, 5))
}

assert test_unwrap_some() == 42
assert test_unwrap_none() == 77
assert test_tag_some() == 1
assert test_tag_none() == 0
assert test_payload() == 99
assert test_map_some() == 15
assert test_map_none() == 0
