fun @MULBY3(%r1: u8 [acc]) -> u8 [acc]
  block @entry:
    %r2 = const 0 : u8 [general]
    %r3 = const 3 : u8 [general]
    %r4 = mul %r1, %r3 : u8 [general]
    ret %r4

