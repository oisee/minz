; MIR2 module: examples/nanz/hello_cpm_fib.nanz
fun @putch(%r1: u8 [acc])
  block @entry:
    asm "LD E, A\n        LD C, 2\n        CALL 0x0005"
    ret void

fun @print_digit(%r2: u8 [acc])
  block @entry:
    %r3 = const 48 : u8 [general]
    %r4 = add %r2, %r3 : u8 [acc]
    %r5 = move %r4 : u8 [acc]
    call @putch(%r5)
    ret void

fun @fib(%r6: u8 [acc]) -> u8 [acc]
  block @entry:
    %r7 = const 2 : u8 [general]
    %r8 = cmp.ult %r6, %r7 : bool [flag]
    br_if %r8, @if_then1(), @if_join2()
  block @if_then1:
    ret %r6
  block @if_join2:
    %r9 = const 1 : u8 [general]
    %r10 = sub %r6, %r9 : u8 [acc]
    %r11 = move %r10 : u8 [acc]
    %r12 = call @fib(%r11) : u8 [acc]
    %r13 = const 2 : u8 [general]
    %r14 = sub %r6, %r13 : u8 [acc]
    %r15 = move %r14 : u8 [acc]
    %r16 = call @fib(%r15) : u8 [acc]
    %r17 = add %r12, %r16 : u8 [acc]
    ret %r17

fun @gcd(%r18: u8 [general], %r19: u8 [general]) -> u8 [acc]
  block @entry:
    jmp @loop_head1(%r18, %r19)
  block @loop_head1(%r20: u8 [general], %r21: u8 [general]):
    %r22 = const 0 : u8 [general]
    %r23 = cmp.ne %r21, %r22 : bool [flag]
    cond_ret %r23, [%r20], @loop_body2()
  block @loop_body2:
    %r24 = mod %r20, %r21 : u8 [general]
    jmp @loop_head1(%r21, %r24)

