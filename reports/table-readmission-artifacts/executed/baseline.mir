; MIR2 module: grace_measure.nanz
global @calls : u8

fun @left_sum(%r1: ptr [pointer], %r2: u8 [general]) -> u8 [acc]
  block @entry:
    %r3 = const 0 : u8 [general]
    %r4 = const 0 : u8 [general]
    jmp @loop_head1(%r4, %r2, %r1, %r3)
  block @loop_head1(%r4: u8 [general], %r6: u8 [general], %r7: ptr [general], %r3: u8 [general]):
    %r9 = cmp.ult %r4, %r6 : bool [flag]
    cond_ret %r9, [%r3], @loop_body2()
  block @loop_body2:
    %r10 = ext %r4 : u8 -> u16 [index]
    %r11 = ptr_add %r7, %r10 : ptr [pointer]
    %r12 = load %r11 : u8 [general]
    %r13 = add %r3, %r12 : u8 [general]
    %r14 = const 1 : u8 [general]
    %r15 = add %r4, %r14 : u8 [general]
    jmp @loop_head1(%r15, %r6, %r7, %r13)

fun @right_sum(%r16: ptr [pointer], %r17: u8 [general]) -> u8 [acc]
  block @entry:
    %r18 = const 0 : u8 [general]
    %r19 = const 0 : u8 [general]
    jmp @loop_head1(%r19, %r17, %r16, %r18)
  block @loop_head1(%r19: u8 [general], %r21: u8 [general], %r22: ptr [general], %r18: u8 [general]):
    %r24 = cmp.ult %r19, %r21 : bool [flag]
    cond_ret %r24, [%r18], @loop_body2()
  block @loop_body2:
    %r25 = ext %r19 : u8 -> u16 [index]
    %r26 = ptr_add %r22, %r25 : ptr [pointer]
    %r27 = load %r26 : u8 [general]
    %r28 = add %r18, %r27 : u8 [general]
    %r29 = const 1 : u8 [general]
    %r30 = add %r19, %r29 : u8 [general]
    jmp @loop_head1(%r30, %r21, %r22, %r28)

fun @caller(%r31: ptr [pointer], %r32: u8 [general]) -> u8 [acc]
  block @entry:
    %r33 = move %r31 : ptr [pointer]
    %r34 = call @left_sum(%r33, %r32) : u8 [acc]
    %r35 = move %r31 : ptr [pointer]
    %r36 = call @right_sum(%r35, %r32) : u8 [acc]
    %r37 = addr_of @calls : ptr [pointer]
    %r38 = load %r37 : u8 [general]
    %r39 = const 1 : u8 [general]
    %r40 = add %r38, %r39 : u8 [acc]
    %r41 = addr_of @calls : ptr [pointer]
    store %r41, %r40 : u8
    %r42 = add %r34, %r36 : u8 [acc]
    ret %r42

fun @add5(%r43: u8 [acc]) -> u8 [acc]
  block @entry:
