    LD A, 7
    LD C, 4
    LD B, 1
    ; genCall: tui_color dst=0
    CALL tui_color
    LD HL, _buf_credit
    LD C, 6
    ; genCall: tui_read_line dst=420
    CALL tui_read_line
    ; genCall: tui_reset dst=0
    CALL tui_reset
    LD HL, _buf_credit
    ; genCall: _scr_atoi dst=423
    LD D, H
    LD E, L
    CALL _scr_atoi
    LD D, H
    LD E, L
    LD HL, _val_credit
    LD (HL), E     ; lo
