    ; genCall: tui_read_key dst=447
    CALL tui_read_key
    ; genCall: screen_handle_key dst=449
    CALL screen_handle_key
    JRS .screen_show_loop_head1
.screen_show_loop_exit3:
    ; genCall: tui_clear dst=0
    PUSH AF
    CALL tui_clear
    POP AF
    LD B, 0
    LD C, 0
    ; genCall: tui_goto dst=0
    PUSH AF
    LD A, B
    CALL tui_goto
    POP AF
    ; genCall: tui_reset dst=0
    PUSH AF
    CALL tui_reset
    POP AF
    RET
.screen_show_trmp0:
    JRS .screen_show_loop_exit3

