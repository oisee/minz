; MIR2 module: literal-width.nanz
global @witness : u8

fun @make(%r1: u8 [acc], %r2: ptr [pointer]) [struct-result0 param1 S:1B] -> S [pointer]
  block @entry:
    %r3 = alloca 1 : ptr
    store %r3, %r1 : u8
    %r4 = const 0 : u8 [general]
    %r5 = cmp.eq %r1, %r4 : bool [flag]
    br_if %r5, @if_then1(), @if_else3()
  block @if_then1:
    %r6 = const 0 : u8 [general]
    store %r3, %r6 : u8
    jmp @if_join2()
  block @if_join2:
    %r7 = load %r3 : u8 [general]
    store %r2, %r7 : u8
    ret %r2
  block @if_else3:
    store %r3, %r1 : u8
    jmp @if_join2()

fun @overwrite(%r8: u8 [acc]) -> u8 [acc]
  block @entry:
    %r9 = alloca 1 : ptr
    store %r9, %r8 : u8
    %r10 = load %r9 : u8 [general]
    %r11 = addr_of @witness : ptr [pointer]
    store %r11, %r10 : u8
    %r12 = load %r9 : u8 [acc]
    ret %r12

fun @delayed(%r13: u8 [acc], %r14: u8 [general]) -> u8 [acc]
  block @entry:
    %r15 = alloca 1 : ptr
    %r16 = move %r13 : u8 [acc]
    %r17 = call @make(%r16, %r15) : S [pointer] [struct-result0 param1 S:1B]
    %r18 = move %r14 : u8 [acc]
    %r19 = call @overwrite(%r18) : u8 [acc]
    %r20 = load %r17 : u8 [acc]
    ret %r20

fun @two_returns(%r21: u8 [acc], %r22: u8 [general]) -> u8 [acc]
  block @entry:
    %r23 = alloca 1 : ptr
    %r24 = alloca 1 : ptr
    %r25 = move %r21 : u8 [acc]
    %r26 = call @make(%r25, %r23) : S [pointer] [struct-result0 param1 S:1B]
    %r27 = move %r22 : u8 [acc]
    %r28 = call @make(%r27, %r24) : S [pointer] [struct-result0 param1 S:1B]
    %r29 = load %r26 : u8 [general]
    %r30 = load %r28 : u8 [general]
    %r31 = add %r29, %r30 : u8 [acc]
    ret %r31

