// probe.nanz — repro: the ZX Spectrum keyboard matrix reports the *unshifted*
// (uppercase) ASCII of a letter key, so a demo that compares zx_getkey() against
// a lowercase code never sees the key.
//
// Prints the code of the first key held, as three decimal digits.
import zx.text

global KEYTAB: [u8; 40] = [
    0, 90, 88, 67, 86,
    65, 83, 68, 70, 71,
    81, 87, 69, 82, 84,
    49, 50, 51, 52, 53,
    48, 57, 56, 55, 54,
    80, 79, 73, 85, 89,
    13, 76, 75, 74, 72,
    32, 0, 77, 78, 66,
]

fun zx_in_fe(@z80_a high: u8) -> u8 {
    asm z80 (in high) (ret A) (clob A, F) { IN A, (0xFE) }
}

fun zx_scan() -> u8 {
    var addr: u8 = 0xFE
    var idx: u8 = 0
    var row: u8 = 0
    while row < 8 {
        let bits: u8 = zx_in_fe(addr)
        var b: u8 = 0
        var mask: u8 = 1
        while b < 5 {
            if (bits & mask) == 0 {
                return KEYTAB[idx]
            }
            idx = idx + 1
            mask = mask << 1
            b = b + 1
        }
        addr = (addr << 1) | 1
        row = row + 1
    }
    return 0
}

fun main() -> void {
    text_set_width(8)
    win_open(0, 0, 0, 32, 1)
    win_select(0)
    var last: u8 = 255
    while 1 == 1 {
        let k: u8 = zx_scan()
        if k != last {
            last = k
            win_goto(0, 0)
            win_putch(48 + k / 100)
            win_putch(48 + (k / 10) - (k / 100) * 10)
            win_putch(48 + k - (k / 10) * 10)
        }
    }
}
