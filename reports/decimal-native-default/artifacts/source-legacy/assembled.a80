ORG 0x8000
start:
 LD SP, 0xf000
 CALL demo
 LD (answer), HL
done:
 DI
 HALT
answer: DW 0
; generated by MIR2 Z80 codegen

; fun demo() -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
demo:
    LD DE, (input)    ; u16 direct load, no scratch clobber
    INC DE
    ; genCall: @mir.io.print.u8 dst=0
    PUSH DE
    LD A, E
    LD C, A
    LD B, 0
.pdec_h0:
    LD A, C
    CP 100
    JR C, .pdec_ht0
    SUB 100
    LD C, A
    INC B
    JR .pdec_h0
.pdec_ht0:
    LD A, B
    OR A
    JR Z, .pdec_t0
    ADD A, 48
    OUT (0x23), A
.pdec_t0:
    LD D, 0
.pdec_tl0:
    LD A, C
    CP 10
    JR C, .pdec_tt0
    SUB 10
    LD C, A
    INC D
    JR .pdec_tl0
.pdec_tt0:
    LD A, B
    OR D
    JR Z, .pdec_u0
    LD A, D
    ADD A, 48
    OUT (0x23), A
.pdec_u0:
    LD A, C
    ADD A, 48
    OUT (0x23), A
    POP DE
    LD HL, 99
    ADD HL, DE
    ; genCall: @mir.io.print.dec dst=0
    PUSH DE
    LD A, L
    LD C, A
    LD B, 0
.pdec_h1:
    LD A, C
    CP 100
    JR C, .pdec_ht1
    SUB 100
    LD C, A
    INC B
    JR .pdec_h1
.pdec_ht1:
    LD A, B
    OR A
    JR Z, .pdec_t1
    ADD A, 48
    OUT (0x23), A
.pdec_t1:
    LD D, 0
.pdec_tl1:
    LD A, C
    CP 10
    JR C, .pdec_tt1
    SUB 10
    LD C, A
    INC D
    JR .pdec_tl1
.pdec_tt1:
    LD A, B
    OR D
    JR Z, .pdec_u1
    LD A, D
    ADD A, 48
    OUT (0x23), A
.pdec_u1:
    LD A, C
    ADD A, 48
    OUT (0x23), A
    POP DE
    LD HL, 17
    ADD HL, DE
    RET

; globals
input:
    DW 255
