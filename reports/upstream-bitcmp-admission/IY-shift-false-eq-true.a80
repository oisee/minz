ORG 0x8000
LD SP,0xFF00
LD IY,1
LD HL,1
LD A,1
CALL testbit
DI
stop:
HALT
; generated by MIR2 Z80 codegen

; fun testbit(x: u16 = IY) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
testbit:
    PUSH IY
    POP HL
    LD A, H
    AND 0
    LD H, A
    LD A, L
    AND 1
    LD L, A
    LD A, 0
    LD C, A
    LD B, 0
    OR A
    SBC HL, BC
    JRS NZ, .testbit_no
.testbit_yes:
    LD A, 1
    RET
.testbit_no:
    LD A, 0
    RET

