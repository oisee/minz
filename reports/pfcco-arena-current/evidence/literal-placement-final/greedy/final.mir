    %r8 = load %r6 : u16 [pointer]
    %r9 = add %r8, %r7 : u16 [pointer]
    %r10 = field %r6, +2 : ptr [pointer]
    %r11 = load %r10 : u16 [pointer]
    %r12 = cmp.ugt %r9, %r11 : bool [flag]
    br_if %r12, @if_then1(), @if_join2()
  block @if_then1:
    %r13 = const 0 : u16 [pointer]
    ret %r13
  block @if_join2:
    store %r6, %r9 : u16
    ret %r8

fun @Arena_reset(%r14: ptr [pointer], %r15: u16 [index])
  block @entry:
    store %r14, %r15 : u16
