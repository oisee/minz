_mir2_str_0:
    DB "CREATE TABLE mara (matnr TEXT, mtart TEXT, mbrsh TEXT, meins TEXT, brgew INTEGER, ntgew INTEGER)", 0
_mir2_str_1:
    DB "INSERT INTO mara VALUES ('100-100', 'FERT', 'M', 'ST', 250, 230)", 0
_mir2_str_2:
    DB "INSERT INTO mara VALUES ('100-110', 'FERT', 'M', 'ST', 180, 165)", 0
_mir2_str_3:
    DB "INSERT INTO mara VALUES ('100-200', 'HALB', 'M', 'KG', 50, 45)", 0
_mir2_str_4:
    DB "INSERT INTO mara VALUES ('100-300', 'ROH',  'M', 'KG', 10, 10)", 0
_mir2_str_5:
    DB "INSERT INTO mara VALUES ('200-100', 'FERT', 'E', 'ST', 500, 480)", 0
_mir2_str_6:
    DB "INSERT INTO mara VALUES ('200-200', 'HAWA', 'E', 'ST', 100, 95)", 0
_mir2_str_7:
    DB "INSERT INTO mara VALUES ('300-100', 'DIEN', 'D', 'AU', 0, 0)", 0
_mir2_str_8:
    DB "CREATE TABLE makt (matnr TEXT, spras TEXT, maktx TEXT)", 0
_mir2_str_9:
    DB "INSERT INTO makt VALUES ('100-100', 'E', 'Pump Assembly GRUNDFOS')", 0
_mir2_str_10:
    DB "INSERT INTO makt VALUES ('100-100', 'D', 'Pumpenaggregat GRUNDFOS')", 0
_mir2_str_11:
    DB "INSERT INTO makt VALUES ('100-110', 'E', 'Motor 3-Phase 5kW')", 0
_mir2_str_12:
    DB "INSERT INTO makt VALUES ('100-200', 'E', 'Shaft Steel DIN 1.4301')", 0
_mir2_str_13:
    DB "INSERT INTO makt VALUES ('100-300', 'E', 'Steel Rod Raw Material')", 0
_mir2_str_14:
    DB "INSERT INTO makt VALUES ('200-100', 'E', 'Desktop PC Standard')", 0
_mir2_str_15:
    DB "INSERT INTO makt VALUES ('200-200', 'E', 'Office Chair Ergonomic')", 0
_mir2_str_16:
    DB "INSERT INTO makt VALUES ('300-100', 'E', 'Consulting Service')", 0
_mir2_str_17:
    DB 30, "=== Material Master Report ==="
_mir2_str_18:
    DB 43, "Selection: MTART = FERT (Finished Products)"
_mir2_str_19:
    DB 43, "MATNR      MTART MEINS  BRGEW  NTGEW  MAKTX"
_mir2_str_20:
    DB 54, "------------------------------------------------------"
_mir2_str_21:
    DB "SELECT m.matnr, m.mtart, m.meins, m.brgew, m.ntgew, t.maktx FROM mara m LEFT JOIN makt t ON m.matnr = t.matnr AND t.spras = 'E' WHERE m.mtart = 'FERT' ORDER BY m.matnr", 0
_mir2_str_22:
    DB 2, "  "
_mir2_str_23:
    DB 17, " materials found."
_mir2_str_24:
    DB 39, "=== Weight Summary by Material Type ==="
_mir2_str_25:
    DB "SELECT mtart, COUNT(*), SUM(brgew) FROM mara GROUP BY mtart ORDER BY mtart", 0
_mir2_str_26:
    DB 2, ": "
_mir2_str_27:
    DB 19, " materials, weight="
_mir2_str_28:
    DB 16, "Report complete."
