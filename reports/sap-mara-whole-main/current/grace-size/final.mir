; MIR2 module: sap_mara_demo.nanz
string @mir2.str.0 = "CREATE TABLE mara (matnr TEXT, mtart TEXT, mbrsh TEXT, meins TEXT, brgew INTEGER, ntgew INTEGER)"
string @mir2.str.1 = "INSERT INTO mara VALUES ('100-100', 'FERT', 'M', 'ST', 250, 230)"
string @mir2.str.2 = "INSERT INTO mara VALUES ('100-110', 'FERT', 'M', 'ST', 180, 165)"
string @mir2.str.3 = "INSERT INTO mara VALUES ('100-200', 'HALB', 'M', 'KG', 50, 45)"
string @mir2.str.4 = "INSERT INTO mara VALUES ('100-300', 'ROH',  'M', 'KG', 10, 10)"
string @mir2.str.5 = "INSERT INTO mara VALUES ('200-100', 'FERT', 'E', 'ST', 500, 480)"
string @mir2.str.6 = "INSERT INTO mara VALUES ('200-200', 'HAWA', 'E', 'ST', 100, 95)"
string @mir2.str.7 = "INSERT INTO mara VALUES ('300-100', 'DIEN', 'D', 'AU', 0, 0)"
string @mir2.str.8 = "CREATE TABLE makt (matnr TEXT, spras TEXT, maktx TEXT)"
string @mir2.str.9 = "INSERT INTO makt VALUES ('100-100', 'E', 'Pump Assembly GRUNDFOS')"
string @mir2.str.10 = "INSERT INTO makt VALUES ('100-100', 'D', 'Pumpenaggregat GRUNDFOS')"
string @mir2.str.11 = "INSERT INTO makt VALUES ('100-110', 'E', 'Motor 3-Phase 5kW')"
string @mir2.str.12 = "INSERT INTO makt VALUES ('100-200', 'E', 'Shaft Steel DIN 1.4301')"
string @mir2.str.13 = "INSERT INTO makt VALUES ('100-300', 'E', 'Steel Rod Raw Material')"
string @mir2.str.14 = "INSERT INTO makt VALUES ('200-100', 'E', 'Desktop PC Standard')"
string @mir2.str.15 = "INSERT INTO makt VALUES ('200-200', 'E', 'Office Chair Ergonomic')"
string @mir2.str.16 = "INSERT INTO makt VALUES ('300-100', 'E', 'Consulting Service')"
string @mir2.str.17 = "=== Material Master Report ==="
string @mir2.str.18 = "Selection: MTART = FERT (Finished Products)"
string @mir2.str.19 = "MATNR      MTART MEINS  BRGEW  NTGEW  MAKTX"
string @mir2.str.20 = "------------------------------------------------------"
string @mir2.str.21 = "SELECT m.matnr, m.mtart, m.meins, m.brgew, m.ntgew, t.maktx FROM mara m LEFT JOIN makt t ON m.matnr = t.matnr AND t.spras = 'E' WHERE m.mtart = 'FERT' ORDER BY m.matnr"
string @mir2.str.22 = "  "
string @mir2.str.23 = " materials found."
string @mir2.str.24 = "=== Weight Summary by Material Type ==="
string @mir2.str.25 = "SELECT mtart, COUNT(*), SUM(brgew) FROM mara GROUP BY mtart ORDER BY mtart"
string @mir2.str.26 = ": "
string @mir2.str.27 = " materials, weight="
string @mir2.str.28 = "Report complete."

