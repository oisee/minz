; fun board_get(x: u8 = A, y: u8 = C) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1,dead-block-arg=1]
board_get:
    LD HL, board
    LD B, 0
.board_get_loop_head1:
    LD E, A    ; preserve live accumulator before CMP
    LD A, B
    CP C
    LD A, E
    ; restore live-out r211 from scratch
    JRS NC, .board_get_loop_exit3
.board_get_loop_body2:
    LD DE, 10
    ADD HL, DE
    LD D, 1
    LD E, A    ; preserve live r211 before ALU scratch
    LD A, B
    ADD A, 1
    LD D, A
    LD A, E
    ; restore live-out r211 from scratch
    LD B, D
    JRS .board_get_loop_head1
.board_get_loop_exit3:
