; fun spawn_piece() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
spawn_piece:
    LD HL, next_type
    LD C, (HL)
    LD A, C
    LD (cur_type), A
    ; genCall: random_piece dst=649
    CALL __cpm_stack_check
    CALL random_piece
    LD (next_type), A
    LD HL, cur_rot
    LD (HL), 0
    LD HL, cur_x
    LD (HL), 3
    LD HL, cur_y
    LD (HL), 0
    LD HL, hold_used
    LD (HL), 0
    LD HL, cur_type
    LD C, (HL)
    LD A, C
    LD HL, cur_rot
    LD C, (HL)
    LD HL, cur_x
    LD D, (HL)
    LD B, D
    LD HL, cur_y
    LD D, (HL)
    ; genCall: can_place dst=669
    LD IXH, C
    LD IXL, D
    CALL __cpm_stack_check
    CALL can_place
    AND A
    JRS NZ, .spawn_piece_if_join2
.spawn_piece_if_then1:
    LD HL, game_over
    LD (HL), 1
.spawn_piece_if_join2:
    RET

; fun hold_piece() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
hold_piece:
    LD HL, hold_used
    LD D, (HL)
    LD A, D
    CP 1
    JRS NZ, .hold_piece_if_join2
.hold_piece_if_then1:
    RET
.hold_piece_if_join2:
    LD HL, hold_used
    LD (HL), 1
    LD HL, hold_type
    LD D, (HL)
    LD A, D
    CP 255
    JRS NZ, .hold_piece_if_else5
.hold_piece_if_then3:
    LD HL, cur_type
    LD C, (HL)
    LD A, C
    LD (hold_type), A
    ; genCall: spawn_piece dst=0
    CALL __cpm_stack_check
    CALL spawn_piece
.hold_piece_if_join4:
    RET
.hold_piece_if_else5:
    LD HL, cur_type
    LD C, (HL)
    LD HL, hold_type
    LD D, (HL)
    LD A, D
    LD (cur_type), A
    LD A, C
    LD (hold_type), A
    LD HL, cur_rot
    LD (HL), 0
    LD HL, cur_x
    LD (HL), 3
    LD HL, cur_y
    LD (HL), 0
    JRS .hold_piece_if_join4

; fun score_lines(cl: u8 = A) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
score_lines:
    AND A
    JRS NZ, .score_lines_if_join2
.score_lines_if_then1:
    RET
.score_lines_if_join2:
    CP 1
    JRS NZ, .score_lines_if_join4
.score_lines_if_then3:
    LD HL, (score)    ; u16 direct load (20T, no A clobber)
    LD DE, 100
    ADD HL, DE
    LD DE, score
    LD (score), HL    ; u16 direct store (16T, no A clobber)
.score_lines_if_join4:
    CP 2
    JRS NZ, .score_lines_if_join6
.score_lines_if_then5:
    LD HL, (score)    ; u16 direct load (20T, no A clobber)
    LD DE, 300
    ADD HL, DE
    LD DE, score
    LD (score), HL    ; u16 direct store (16T, no A clobber)
.score_lines_if_join6:
    CP 3
    JRS NZ, .score_lines_if_join8
.score_lines_if_then7:
    LD HL, (score)    ; u16 direct load (20T, no A clobber)
    LD DE, 500
    ADD HL, DE
    LD DE, score
    LD (score), HL    ; u16 direct store (16T, no A clobber)
.score_lines_if_join8:
    CP 4
    JRS NZ, .score_lines_if_join10
.score_lines_if_then9:
    LD HL, (score)    ; u16 direct load (20T, no A clobber)
    LD DE, 800
    ADD HL, DE
    LD DE, score
    LD (score), HL    ; u16 direct store (16T, no A clobber)
.score_lines_if_join10:
    LD HL, (lines_cleared)    ; u16 direct load (20T, no A clobber)
    LD E, A
    LD D, 0
    ADD HL, DE
    LD D, H
    LD E, L
    LD HL, lines_cleared
    LD (HL), E     ; lo
    INC HL
    LD (HL), D     ; hi
    DEC HL
    LD HL, drop_speed
    LD D, (HL)
    LD A, 2
    CP D
    JRS NC, .score_lines_if_join12
.score_lines_if_then11:
    LD HL, (lines_cleared)    ; u16 direct load (20T, no A clobber)
    LD D, L
    LD A, D
    AND 7
    AND A
    JRS NZ, .score_lines_if_join14
.score_lines_if_then13:
    LD HL, drop_speed
    LD D, (HL)
    LD C, 1
    LD A, D
    SUB 1
    LD (drop_speed), A
.score_lines_if_join14:
.score_lines_if_join12:
    RET

