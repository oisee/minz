    .loop: LD A, (HL)
    OR A
    RET Z
    LD E, A
    CALL __cpm_stack_check
    PUSH HL
    LD C, 2
    CALL 5
    POP HL
    INC HL
    JR .loop
    RET

; fun tui__render__tui_read_key() -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
tui__render__tui_read_key:
    ; BDOS 1: blocking console input, char returned in A.
    LD C, 1
    CALL __cpm_stack_check
    CALL 5
    CP 27              ; ESC?
    RET NZ
    
    ; Try to decode VT100 escape sequence ESC [ X
    LD C, 1
    CALL __cpm_stack_check
    CALL 5
    CP 91              ; '['
    LD A, 27
    RET NZ
    
    LD C, 1
    CALL __cpm_stack_check
    CALL 5
    CP 65              ; 'A'
    JR Z, .up
    CP 66              ; 'B'
    JR Z, .down
    CP 67              ; 'C'
    JR Z, .right
    CP 68              ; 'D'
    JR Z, .left
    LD A, 27
    RET
    
    .up:
    LD A, 128
    RET
    .down:
    LD A, 129
    RET
    .left:
    LD A, 130
    RET
    .right:
    LD A, 131
    RET
    RET

; fun rng_next() -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[ident-simp=1,dse=1]
rng_next:
    LD DE, (rng_state)    ; u16 direct load, no scratch clobber
    CALL __cpm_stack_check
    PUSH DE
    POP BC
    LD A, B
    AND 0
    LD B, A
    LD A, C
    AND 1
    LD C, A
    LD HL, (rng_state)    ; u16 direct load (20T, no A clobber)
    SRL H
    RR  L
    LD DE, rng_state
    LD (rng_state), HL    ; u16 direct store (16T, no A clobber)
    LD D, 1
    LD H, B
    LD L, C
    LD E, D
    LD D, 0
    OR A
    SBC HL, DE
    JRS NZ, .rng_next_if_join2
.rng_next_if_then1:
    LD DE, (rng_state)    ; u16 direct load, no scratch clobber
    LD A, D
    XOR 180
    LD D, A
    LD A, E
    XOR 0
    LD E, A
    LD HL, rng_state
    LD (HL), E     ; lo
    INC HL
    LD (HL), D     ; hi
    DEC HL
.rng_next_if_join2:
    LD HL, (rng_state)    ; u16 direct load (20T, no A clobber)
    LD A, L
    RET

; fun random_piece() -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1,condret-sink=1,cond-rets=1]
random_piece:
    ; genCall: rng_next dst=135
    CALL __cpm_stack_check
    CALL rng_next
    AND 7
    LD E, A
    ; materialize r137 (pendingAcc)
    LD A, E
    CP 7
    LD A, E
    ; restore live-out r137 from scratch
    RET C
.random_piece_if_then1:
    LD A, 0
    RET

; fun piece_dx(t: u8 = A, r: u8 = C, c: u8 = B) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1,dead-block-arg=1]
piece_dx:
    LD HL, PIECE_DX
    LD IXH, 0
.piece_dx_loop_head1:
    CP IXH
    JRS Z, .piece_dx_loop_exit3
    JRS C, .piece_dx_loop_exit3
.piece_dx_loop_body2:
    LD DE, 16
    ADD HL, DE
    LD D, 1
    LD E, A    ; preserve live r148 before ALU scratch
    LD A, IXH
    ADD A, 1
    LD D, A
    LD A, E
    ; restore live-out r148 from scratch
    LD IXH, D
    JRS .piece_dx_loop_head1
.piece_dx_loop_exit3:
    LD A, 0
.piece_dx_loop_head4:
    CP C
    JRS NC, .piece_dx_loop_exit6
.piece_dx_loop_body5:
    LD DE, 4
    ADD HL, DE
    INC A
    JRS .piece_dx_loop_head4
.piece_dx_loop_exit6:
    LD C, 0
.piece_dx_loop_head7:
    LD A, C
    CP B
    JRS NC, .piece_dx_loop_exit9
.piece_dx_loop_body8:
    INC HL
    INC C
    JRS .piece_dx_loop_head7
.piece_dx_loop_exit9:
    LD A, (HL)
    RET

; fun piece_dy(t: u8 = A, r: u8 = C, c: u8 = B) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
