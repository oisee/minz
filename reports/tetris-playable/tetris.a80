; fun draw_cell(sx: u8 = A, sy: u8 = C, color_idx: u8 = B) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1]
draw_cell:
    ; genCall: tui__render__tui_goto dst=0
    CALL __cpm_stack_check
    PUSH BC
    CALL tui__render__tui_goto
    POP BC
    LD A, B
    AND A
    JRS NZ, .draw_cell_if_else3
.draw_cell_if_then1:
    LD HL, FG_BLACK
    LD C, (HL)
    LD A, C
    LD HL, BG_BLACK
    LD C, (HL)
    LD B, 0
    ; genCall: tui__render__tui_color dst=0
    CALL __cpm_stack_check
    CALL tui__render__tui_color
    LD A, 32
    ; genCall: tui__render__tui_putch dst=0
    CALL __cpm_stack_check
    CALL tui__render__tui_putch
    LD A, 32
    ; genCall: tui__render__tui_putch dst=0
    CALL __cpm_stack_check
    CALL tui__render__tui_putch
.draw_cell_if_join2:
    RET
.draw_cell_if_else3:
    LD HL, PIECE_FG
    LD C, 1
    LD A, B
    SUB 1
    LD E, A
    LD D, 0
    ADD HL, DE
    LD C, (HL)
    LD HL, PIECE_BR
    LD D, 1
    LD A, B
    SUB 1
    LD E, A
    LD D, 0
    ADD HL, DE
    LD D, (HL)
    LD HL, FG_BLACK
    LD E, (HL)
    ; genCall: tui__render__tui_color dst=0
    LD A, E
    LD B, D
    CALL __cpm_stack_check
