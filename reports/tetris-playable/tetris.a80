; strings
_mir2_str_0:
    DB "Score: ", 0
_mir2_str_1:
    DB "Lines: ", 0
_mir2_str_2:
    DB "Arrows:Move Z:Rot X:Drop C:Hold Q:Quit", 0
_mir2_str_3:
    DB "GAME OVER!", 0

; BDOS2 console: preserve primary registers and flags across the operating system.
__cpm_putchar:
    CALL __cpm_stack_check
    PUSH AF
    PUSH BC
    PUSH DE
    PUSH HL
    PUSH IX
    PUSH IY
    LD E, A
    LD C, 2
    CALL 5
    POP IY
    POP IX
    POP HL
    POP DE
    POP BC
    POP AF
    RET
__cpm_stack_limit EQU __cpm_stack+32

__cpm_stack_check:
 PUSH AF
 PUSH HL
 LD HL,0
 ADD HL,SP
 LD A,H
 CP __cpm_stack_limit^H
 JR C,__cpm_stack_overflow
 JR NZ,__cpm_stack_check_ok
 LD A,L
 CP __cpm_stack_limit^L
 JR C,__cpm_stack_overflow
__cpm_stack_check_ok:
 POP HL
 POP AF
 RET
__cpm_stack_overflow:
 LD A,1
 LD (__cpm_status),A
 LD SP,(__cpm_saved_sp)
 RET

__cpm_status:
 DB 0
__cpm_saved_sp:
    DW 0
__cpm_stack_guard:
    DB 0xA5
__cpm_stack:
    DS 1024
__cpm_stack_top:
__cpm_image_end:


__cpm_bound_board_1 EQU board+199

__cpm_memory_failure:
 LD A,2
 LD (__cpm_status),A
 LD SP,(__cpm_saved_sp)
 RET

