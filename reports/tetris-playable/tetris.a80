    JRS C, .board_get_loop_exit6
.board_get_loop_body5:
    INC HL
    INC C
    JRS .board_get_loop_head4
.board_get_loop_exit6:
    LD A, (HL)
    RET

; fun board_set(x: u8 = A, y: u8 = C, val: u8 = B) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1,dead-block-arg=1]
board_set:
    LD HL, board
    LD IXH, 0
.board_set_loop_head1:
    LD E, A    ; preserve live accumulator before CMP
    LD A, IXH
    CP C
    LD A, E
    ; restore live-out r235 from scratch
    JRS NC, .board_set_loop_exit3
.board_set_loop_body2:
    LD DE, 10
    ADD HL, DE
    LD D, 1
    LD E, A    ; preserve live r235 before ALU scratch
    LD A, IXH
    ADD A, 1
    LD D, A
    LD A, E
    ; restore live-out r235 from scratch
    LD IXH, D
    JRS .board_set_loop_head1
.board_set_loop_exit3:
    LD C, 0
.board_set_loop_head4:
    CP C
    JRS Z, .board_set_loop_exit6
    JRS C, .board_set_loop_exit6
.board_set_loop_body5:
    INC HL
    INC C
    JRS .board_set_loop_head4
.board_set_loop_exit6:
    CALL __cpm_stack_check
    PUSH AF
    PUSH HL
    LD A,board^H
    CP H
    JR C,.board_set_cpm_store_ok_6_0_lower
    JP NZ,__cpm_memory_failure
    LD A,board^L
    CP L
    JR C,.board_set_cpm_store_ok_6_0_lower
    JP NZ,__cpm_memory_failure
.board_set_cpm_store_ok_6_0_lower:
    LD A,__cpm_bound_board_1^H
    CP H
    JP C,__cpm_memory_failure
    JR NZ,.board_set_cpm_store_ok_6_0
    LD A,__cpm_bound_board_1^L
    CP L
    JP C,__cpm_memory_failure
.board_set_cpm_store_ok_6_0:
    POP HL
    POP AF
    LD (HL), B
    RET

; fun can_place(t: u8 = A, r: u8 = IXH, px: u8 = B, py: u8 = IXL) -> bool = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
