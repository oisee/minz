; ex18_user_console_io — generated by MIR2 Z80 codegen
; mze output: "AB\nERR\nsame thing!\n"

    JP main

; fun console_log(n: u8 = A)   — 3 bytes, 21 T-states per call
console_log:
    OUT (0x23), A
    RET

; fun console_err(n: u8 = A)   — 3 bytes, 21 T-states per call
console_err:
    OUT (0x25), A
    RET

; fun print_str(s: u16 = HL)   — NUL-terminated string to stdout
print_str:
    LD A, (HL)
    OR A
    JR Z, _ps_done
_ps_loop:
    OUT (0x23), A
    INC HL
    LD A, (HL)
    OR A
    JR NZ, _ps_loop
_ps_done:
    RET

; fun main()
main:
    LD A, 65
    CALL console_log        ; 'A'
    LD A, 66
    CALL console_log        ; 'B'
    LD A, 10
    CALL console_log        ; '\n'
    LD A, 69
    CALL console_err        ; 'E'
    LD A, 82
    CALL console_err        ; 'R'
    LD A, 82
    CALL console_err        ; 'R'
    LD A, 10
    CALL console_err        ; '\n'
    LD HL, _mir2_str_0
.print_str_0:
    LD A, (HL)
    AND A
    JR Z, .print_str_done_0
    OUT (0x23), A
    INC HL
    JR .print_str_0
.print_str_done_0:
    XOR A
    DI
    HALT

; strings
_mir2_str_0:
    DB "same thing!", 10, 0
