; generated by MIR2 Z80 codegen

; fun minmax(a: u16 = HL, b: u16 = DE) -> (u16 = HL, u16 = DE) ; clobbers: BC, F, IX
minmax:
    EX DE, HL
    PUSH HL
    OR A
    SBC HL, DE
    POP HL
    EX DE, HL
    PUSH DE
    POP BC
    PUSH HL
    POP IX
    JRS NC, .minmax_if_then1
    LD H, B
    LD L, C
    LD D, IXH
    LD E, IXL
    RET
.minmax_if_then1:
    RET

; fun swap(a: u16 = DE, b: u16 = HL) -> (u16 = HL, u16 = DE)
swap:
    RET

; fun min_of(a: u16 = HL, b: u16 = DE) -> u16 = HL
min_of    EQU minmax

; fun max_of(a: u16 = HL, b: u16 = DE) -> u16 = HL
max_of:
    CALL minmax
    LD H, D
    LD L, E
    RET

