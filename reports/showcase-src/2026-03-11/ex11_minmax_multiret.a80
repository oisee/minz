; generated by MIR2 Z80 codegen

; fun minmax(a: u16 = HL, b: u16 = DE) -> (u16 = HL, u16 = DE) ; clobbers: F
minmax:
    EX DE, HL
    PUSH HL
    OR A
    SBC HL, DE
    POP HL
    EX DE, HL
    EX DE, HL
    RET C
.minmax_if_then1:
    EX DE, HL
    RET

; fun swap(a: u16 = HL, b: u16 = DE) -> (u16 = DE, u16 = HL)
swap:
    EX DE, HL
    RET

; fun smaller(x: u16 = HL, y: u16 = DE) -> u16 = HL
smaller:
    JP minmax

; fun larger(x: u16 = HL, y: u16 = DE) -> u16 = HL
larger:
    CALL minmax
    EX DE, HL
    RET

