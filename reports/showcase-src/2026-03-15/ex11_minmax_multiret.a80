; generated by MIR2 Z80 codegen

; fun minmax(a: u16 = HL, b: u16 = DE) -> (u16 = HL, u16 = DE) ; clobbers: BC, F, IX
minmax:
    PUSH HL
    OR A
    SBC HL, DE
    POP HL
    PUSH DE
    POP BC
    PUSH HL
    POP IX
    RET C
    RET Z
    LD H, B
    LD L, C
    LD D, IXH
    LD E, IXL
    RET

; fun swap(a: u16 = DE, b: u16 = HL) -> (u16 = HL, u16 = DE)
swap:
    RET

; fun smaller(x: u16 = HL, y: u16 = DE) -> u16 = HL
smaller    EQU minmax

; fun larger(x: u16 = HL, y: u16 = DE) -> u16 = HL
larger:
    ; genCall: minmax dst=20
    CALL minmax
    LD H, D
    LD L, E
    RET

