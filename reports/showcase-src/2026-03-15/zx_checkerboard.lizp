;; ZX Spectrum Checkerboard — Lizp (Scheme for Z80)
;;
;; Draws a colorful checkerboard pattern on the ZX Spectrum screen
;; using only attribute writes. No arrays needed — pure arithmetic.
;;
;; Pipeline: .lizp → desugar → Lanz AST → HIR → MIR2 → PBQP → Z80 asm

;; ── Hardware primitives ──────────────────────────────────────────────

(defun zx-poke ((addr u16) (val u8)) -> void
  (asm "LD (HL), A" (in addr val)))

;; ── Attribute address: 0x5800 + row*32 + col ────────────────────────

(defun attr-addr ((col u8) (row u8)) -> u16
  (return (+ #x5800 (+ (* (cast row u16) 32) (cast col u16)))))

;; ── Make paper color (bits 3-5): paper << 3 ─────────────────────────

(defun make-attr ((paper u8) (ink u8)) -> u8
  (return (| (<< paper 3) ink)))

;; ── Main: 2×2 cell checkerboard, 8 colors cycling ──────────────────

(defun main () -> void
  ;; Clear pixel area first
  (var addr u16 #x4000)
  (while (< addr #x5800)
    (call zx-poke addr 0)
    (set addr (+ addr 1)))

  ;; Paint checkerboard: 24 rows × 32 cols
  (var row u8 0)
  (while (< row 24)
    (var col u8 0)
    (while (< col 32)
      ;; Checkerboard: alternate based on (row/3 + col/4) & 7
      (let ((cell u8 (& (+ (>> row 1) (>> col 2)) 7))
            (attr u8 (cond
                       ((= cell 0) (call make-attr 1 7))
                       ((= cell 1) (call make-attr 2 7))
                       ((= cell 2) (call make-attr 3 7))
                       ((= cell 3) (call make-attr 4 7))
                       ((= cell 4) (call make-attr 5 7))
                       ((= cell 5) (call make-attr 6 7))
                       ((= cell 6) (call make-attr 2 6))
                       (t          (call make-attr 1 6)))))
        (call zx-poke (call attr-addr col row) attr))
      (set col (+ col 1)))
    (set row (+ row 1)))

  (return))
