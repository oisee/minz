;; ZX Spectrum Rainbow — Lizp (Scheme-like) frontend for Z80
;;
;; Fills the ZX Spectrum attribute area with rainbow colors.
;; This is a REAL program that runs on a ZX Spectrum (or MZX emulator).
;;
;; Pipeline: Lizp → desugar → Lanz → HIR → MIR2 → PBQP → Z80 asm
;;
;; Usage:
;;   mz zx_rainbow.lizp -o rainbow.a80
;;   mza rainbow.a80 -o rainbow.bin
;;   mzx --run rainbow.bin@8000

;; ── ZX Spectrum hardware primitives ──────────────────────────────────

(defun zx-poke ((addr u16) (val u8)) -> void
  (asm "LD (HL), A" (in addr val)))

(defun zx-peek ((addr u16)) -> u8
  (asm "LD A, (HL)" (in addr)))

;; ── Color constants (ZX Spectrum attributes) ─────────────────────────

;; Attribute byte: FBPPPiii
;;   F=flash, B=bright, PPP=paper(bg), iii=ink(fg)

(defglobal BLACK   u8 0)
(defglobal BLUE    u8 1)
(defglobal RED     u8 2)
(defglobal MAGENTA u8 3)
(defglobal GREEN   u8 4)
(defglobal CYAN    u8 5)
(defglobal YELLOW  u8 6)
(defglobal WHITE   u8 7)

;; ── Rainbow palette ──────────────────────────────────────────────────

;; 8 colors as paper (background), shifted left by 3
(defglobal RAINBOW_COLORS  [u8 8]
  (array 0 8 16 24 32 40 48 56))

;; ── Screen clear ─────────────────────────────────────────────────────

(defun clear-pixels () -> void
  ;; Clear pixel area: 0x4000..0x5800 (6144 bytes)
  (var addr u16 #x4000)
  (while (< addr #x5800)
    (call zx-poke addr 0)
    (set addr (+ addr 1)))
  (return))

;; ── Main: paint rainbow stripes ──────────────────────────────────────

(defun main () -> void
  (call clear-pixels)

  ;; Fill 24 rows × 32 columns of attribute area
  ;; Each row gets a color from the rainbow palette (cycling)
  (var row u8 0)
  (while (< row 24)
    (let ((color_idx u8 (& row 7))
          (paper u8 (index RAINBOW_COLORS (cast color_idx u16)))
          (attr  u8 (| paper WHITE))
          (base  u16 (+ #x5800 (* (cast row u16) 32))))
      (var col u8 0)
      (while (< col 32)
        (call zx-poke (+ base (cast col u16)) attr)
        (set col (+ col 1))))
    (set row (+ row 1)))

  ;; Halt — we're done
  (return))
