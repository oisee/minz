    JRS Z, .check_tspin_if_join2
.check_tspin_if_then1:
    LD A, 0
    RET
.check_tspin_if_join2:
    LD HL, cur_x
    LD C, (HL)
    LD D, 1
    LD A, C
    ADD A, 1
    LD HL, cur_y
    LD D, (HL)
    LD E, 0
    AND A
    SBC A, A
    LD E, A
    LD A, D
    AND A
    LD A, E
    JR NZ, .check_tspin_orf_711_sk
    OR 1
.check_tspin_orf_711_sk:
    LD B, A
    AND A
    JRS Z, .check_tspin_if_else5
.check_tspin_if_then3:
    LD B, 1
    LD E, 1
.check_tspin_if_join4:
    CP 9
    SBC A, A
    LD H, A
    LD A, D
    AND A
    LD A, H
    JR NZ, .check_tspin_orf_731_sk
    OR 1
.check_tspin_orf_731_sk:
    LD B, A
    AND A
    JRS Z, .check_tspin_if_else10
.check_tspin_if_then8:
    LD C, 1
    LD A, E
    ADD A, 1
    LD B, A
    LD E, B
.check_tspin_if_join9:
    AND A
    SBC A, A
    LD L, A
    LD A, D
    CP 19
    LD A, L
    JR C, .check_tspin_orf_751_sk
    OR 1
.check_tspin_orf_751_sk:
    LD B, A
    AND A
    JRS Z, .check_tspin_if_else15
.check_tspin_if_then13:
    LD C, 1
    LD A, E
    ADD A, 1
    LD B, A
    LD C, B
.check_tspin_if_join14:
    CP 9
    SBC A, A
    LD C, A
    LD A, D
    CP 19
    LD A, C
    JR C, .check_tspin_orf_771_sk
    OR 1
.check_tspin_orf_771_sk:
    LD B, A
    AND A
    JRS Z, .check_tspin_if_else20
.check_tspin_if_then18:
    LD D, 1
    LD A, C
    ADD A, 1
.check_tspin_if_join19:
    CP 3
    LD A, 0
    RET C
.check_tspin_if_then23:
    LD A, 1
    RET
.check_tspin_if_else20:
    INC A
    LD E, 1
    LD A, D
    ADD A, 1
    LD B, A
    LD A, B
    CALL board_get
    LD A, ?
    AND A
    JRS Z, .check_tspin_trmp0
.check_tspin_if_then21:
    LD D, 1
    LD A, C
    ADD A, 1
.check_tspin_if_join22:
    JRS .check_tspin_if_join19
.check_tspin_if_else15:
    LD C, 1
    SUB C
    LD B, A
    LD C, 1
    LD A, D
    ADD A, 1
    LD C, A
    LD A, B
    LD A, C
    CALL board_get
    LD A, ?
    AND A
    JRS Z, .check_tspin_trmp1
.check_tspin_if_then16:
    LD C, 1
    LD A, E
    ADD A, 1
    LD B, A
    LD C, B
.check_tspin_if_join17:
    JRS .check_tspin_if_join14
.check_tspin_if_else10:
    LD C, 1
    ADD A, C
    LD B, A
    LD C, 1
    LD A, D
    SUB 1
    LD C, A
    LD A, B
    LD A, C
    CALL board_get
    LD A, ?
    AND A
    JRS Z, .check_tspin_if_join12
.check_tspin_if_then11:
    LD C, 1
    LD A, E
    ADD A, 1
    LD B, A
    LD E, B
.check_tspin_if_join12:
    JRS .check_tspin_if_join9
.check_tspin_if_else5:
    LD C, 1
    SUB C
    LD B, A
    LD C, 1
    LD A, D
    SUB 1
    LD C, A
    LD A, B
    LD A, C
    CALL board_get
    LD A, ?
    AND A
    JRS Z, .check_tspin_if_join7
.check_tspin_if_then6:
    LD B, 1
    LD E, 1
.check_tspin_if_join7:
    JRS .check_tspin_if_join4
.check_tspin_trmp0:
    LD A, C
    JRS .check_tspin_if_join22
.check_tspin_trmp1:
    LD C, E
    JRS .check_tspin_if_join17

; fun ghost_y() -> u8 = A ; clobbers: B, C, D, E, F, HL
ghost_y:
    LD A, (cur_y)
.ghost_y_loop_head1:
    LD HL, cur_type
    LD C, (HL)
    LD B, C
    LD HL, cur_rot
    LD D, (HL)
    LD HL, cur_x
    LD C, (HL)
    LD E, 1
    LD H, A
    ADD A, E
    LD E, A
    LD A, B
    LD A, D
    LD B, C
    LD A, E
    CALL can_place
    LD A, ?
    AND A
    LD A, H    ; restore block param from scratch
    JRS Z, .ghost_y_loop_exit3
.ghost_y_loop_body2:
    INC A
    JRS .ghost_y_loop_head1
.ghost_y_loop_exit3:
    RET

; fun board_get(x: u8 = A, y: u8 = C) -> u8 = A ; clobbers: DE, HL, mem
board_get:
    LD HL, board
    LD $0000, (HL)     ; lo
    INC HL
    LD $0000, (HL)     ; hi
    DEC HL
    LD L, C
    LD H, 0
    ; mul16 HL * DE → HL  (~320T, 16-iter shift-and-add)
    PUSH AF
    PUSH DE
    PUSH BC
    LD B, H
    LD C, L
    LD H, 0
    LD L, 0
    LD A, 16
.board_get_m16_815_lp:
    SRL D
    RR E
    JRS NC, .board_get_m16_815_sk
    ADD HL, BC
.board_get_m16_815_sk:
    SLA C
    RL B
    DEC A
    JRS NZ, .board_get_m16_815_lp
    POP BC
    POP DE
    POP AF
    LD E, A
    LD D, 0
    ADD HL, DE
    PUSH HL
    POP BC
    LD HL, ($0000)
    ADD HL, BC
    LD A, (HL)
    RET

; fun board_set(x: u8 = A, y: u8 = C, val: u8 = B) ; clobbers: DE, HL, mem
board_set:
    LD HL, board
    LD $0000, (HL)     ; lo
    INC HL
    LD $0000, (HL)     ; hi
    DEC HL
    LD L, C
    LD H, 0
    ; mul16 HL * DE → HL  (~320T, 16-iter shift-and-add)
    PUSH AF
    PUSH DE
    PUSH BC
    LD B, H
    LD C, L
    LD H, 0
    LD L, 0
    LD A, 16
.board_set_m16_827_lp:
    SRL D
    RR E
    JRS NC, .board_set_m16_827_sk
    ADD HL, BC
.board_set_m16_827_sk:
    SLA C
    RL B
    DEC A
    JRS NZ, .board_set_m16_827_lp
    POP BC
    POP DE
    POP AF
    LD E, A
    LD D, 0
    ADD HL, DE
    PUSH HL
    POP BC
    LD HL, ($0000)
    ADD HL, BC
    LD (HL), B
    RET

; fun can_place(t: u8 = A, r: u8 = C, px: u8 = B, py: u8 = D) -> bool = A ; clobbers: E, F, H, IXH, L
can_place:
    LD E, 0
    LD H, C
    LD C, B
    LD L, A
.can_place_loop_head1:
    LD A, E
    CP 4
    JRS NC, .can_place_trmp0
.can_place_loop_body2:
    LD A, L
    LD B, E
    LD A, H
    CALL piece_dx
    ADD A, C
    LD IXH, A
    LD A, L
    LD B, E
    LD A, H
    CALL piece_dy
    ADD A, D
    LD B, A
    LD A, IXH
    CP 10
    JRS C, .can_place_if_join5
.can_place_if_then4:
    LD C, 0
    LD A, C
    RET
.can_place_if_join5:
    LD A, B
    CP 20
    JRS C, .can_place_if_join7
.can_place_if_then6:
    LD C, 0
    LD A, C
    RET
.can_place_if_join7:
    LD A, IXH
    LD A, B
    CALL board_get
    AND A
    JRS Z, .can_place_if_join9
.can_place_if_then8:
    LD C, 0
    LD A, C
    RET
.can_place_if_join9:
    INC E
    JRS .can_place_loop_head1
.can_place_loop_exit3:
    LD C, 1
    LD A, C
    RET
.can_place_trmp0:
    LD E, D
    LD D, C
    LD C, 0
    JRS .can_place_loop_exit3

; fun lock_piece() ; clobbers: A, B, C, D, E, F, H, HL, IXH, L
lock_piece:
    LD HL, cur_type
    LD D, (HL)
    LD C, 1
    LD A, D
    ADD A, 1
    LD C, 0
    LD D, A
.lock_piece_loop_head1:
    LD A, C
    CP 4
    JRS NC, .lock_piece_loop_exit3
.lock_piece_loop_body2:
    LD HL, cur_x
    LD E, (HL)
    LD HL, cur_type
    LD H, (HL)
    LD A, H
    LD HL, cur_rot
    LD H, (HL)
    LD B, C
    LD A, H
    CALL piece_dx
    ADD A, E
    LD E, A
    LD HL, cur_y
    LD IXH, (HL)
    LD HL, cur_type
    LD H, (HL)
    LD A, H
    LD HL, cur_rot
    LD H, (HL)
    LD B, C
    LD A, H
    CALL piece_dy
    ADD A, IXH
    LD H, A
    LD A, E
    CP 10
    SBC A, A
    LD E, A
    LD A, H
    CP 20
    ; TODO: 8-bit AND E, A → L with A as rhs
    LD A, E
    AND A
    LD L, A
    AND A
    JRS Z, .lock_piece_if_join5
.lock_piece_if_then4:
    LD B, D
    LD A, E
    LD A, H
    CALL board_set
.lock_piece_if_join5:
    INC C
    JRS .lock_piece_loop_head1
.lock_piece_loop_exit3:
    RET

; fun clear_lines() -> u8 = A ; clobbers: B, C, D, E, F, H
clear_lines:
    LD A, 0
    LD H, 19
.clear_lines_loop_head1:
    LD E, A
    LD A, H
    CP 20
    LD A, E    ; restore block param from scratch
    JRS NC, .clear_lines_loop_exit3
.clear_lines_loop_body2:
    LD E, 1
    LD C, 0
.clear_lines_loop_head4:
    LD A, C
    CP 10
    JRS NC, .clear_lines_loop_exit6
.clear_lines_loop_body5:
    LD B, C
    LD A, B
    LD A, H
    CALL board_get
    LD A, B
    AND A
    JRS NZ, .clear_lines_if_join8
.clear_lines_if_then7:
    LD E, 0
.clear_lines_if_join8:
    INC C
    JRS .clear_lines_loop_head4
.clear_lines_loop_exit6:
    LD A, E
    CP 1
    JRS NZ, .clear_lines_if_else11
.clear_lines_if_then9:
.clear_lines_loop_head12:
    LD A, H
    AND A
    JRS Z, .clear_lines_trmp0
.clear_lines_loop_body13:
    LD D, 0
.clear_lines_loop_head15:
    LD A, D
    CP 10
    JRS NC, .clear_lines_trmp1
.clear_lines_loop_body16:
    LD B, D
    LD C, D
    LD E, 1
    LD A, H
    SUB 1
    LD E, A
    LD A, C
    LD A, E
    CALL board_get
    LD A, B
    LD A, H
    LD B, C
    CALL board_set
    INC D
    JRS .clear_lines_loop_head15
.clear_lines_loop_exit17:
    DEC H
    JRS .clear_lines_loop_head12
.clear_lines_loop_exit14:
    LD D, 0
.clear_lines_loop_head18:
    LD A, D
    CP 10
    JRS NC, .clear_lines_loop_exit20
.clear_lines_loop_body19:
    LD B, D
    LD E, 0
    LD C, 0
    LD A, B
    LD A, E
    LD B, C
    CALL board_set
    INC D
    JRS .clear_lines_loop_head18
.clear_lines_loop_exit20:
    INC A
.clear_lines_if_join10:
    JRS .clear_lines_loop_head1
.clear_lines_if_else11:
    DEC H
    JRS .clear_lines_if_join10
.clear_lines_loop_exit3:
    RET
.clear_lines_trmp0:
    LD C, 19
    JRS .clear_lines_loop_exit14
.clear_lines_trmp1:
    LD C, 0
    JRS .clear_lines_loop_exit17

; fun random_piece() -> u8 = A ; clobbers: C, F
random_piece:
    CALL rng_next
.random_piece_loop_head1:
    LD E, A
    LD A, E
    CP 7
    LD A, E    ; restore block param from scratch
    JRS C, .random_piece_loop_exit3
.random_piece_loop_body2:
    LD C, 7
    SUB C
    JRS .random_piece_loop_head1
.random_piece_loop_exit3:
    RET

; fun spawn_piece() ; clobbers: A, B, C, D, F, HL
spawn_piece:
    LD HL, next_type
    LD C, (HL)
    LD A, C
    LD (cur_type), A
    CALL random_piece
    LD (next_type), A
    LD HL, cur_rot
    LD (HL), 0
    LD HL, cur_x
    LD (HL), 3
    LD HL, cur_y
    LD (HL), 0
    LD HL, hold_used
    LD (HL), 0
    LD HL, last_was_tspin
    LD (HL), 0
    LD HL, cur_type
    LD C, (HL)
    LD A, C
    LD HL, cur_rot
    LD C, (HL)
    LD HL, cur_x
    LD D, (HL)
    LD B, D
    LD HL, cur_y
    LD D, (HL)
    LD A, C
    LD A, D
    CALL can_place
    AND A
    JRS NZ, .spawn_piece_if_join2
.spawn_piece_if_then1:
    LD HL, game_over
    LD (HL), 1
.spawn_piece_if_join2:
    RET

; fun hold_piece() ; clobbers: C, D, F, HL
hold_piece:
    LD HL, hold_used
    LD D, (HL)
    LD A, D
    CP 1
    JRS NZ, .hold_piece_if_join2
.hold_piece_if_then1:
    RET
.hold_piece_if_join2:
    LD HL, hold_used
    LD (HL), 1
    LD HL, hold_type
    LD C, (HL)
    LD A, C
    CP 255
    JRS NZ, .hold_piece_if_else5
.hold_piece_if_then3:
    LD HL, cur_type
    LD C, (HL)
    LD A, C
    LD (hold_type), A
    CALL spawn_piece
.hold_piece_if_join4:
    RET
.hold_piece_if_else5:
    LD HL, cur_type
    LD C, (HL)
    LD HL, hold_type
    LD D, (HL)
    LD A, D
    LD (cur_type), A
    LD A, C
    LD (hold_type), A
    LD HL, cur_rot
    LD (HL), 0
    LD HL, cur_x
    LD (HL), 3
    LD HL, cur_y
    LD (HL), 0
    JRS .hold_piece_if_join4

; fun color_attr(idx: u8 = A) -> u8 = A ; clobbers: C, F
color_attr:
    CP 1
    JRS NZ, .color_attr_if_join2
.color_attr_if_then1:
    LD A, 40
    RET
.color_attr_if_join2:
    CP 2
    JRS NZ, .color_attr_if_join4
.color_attr_if_then3:
    LD A, 48
    RET
.color_attr_if_join4:
    CP 3
    JRS NZ, .color_attr_if_join6
.color_attr_if_then5:
    LD A, 24
    RET
.color_attr_if_join6:
    CP 4
    JRS NZ, .color_attr_if_join8
.color_attr_if_then7:
    LD A, 32
    RET
.color_attr_if_join8:
    CP 5
    JRS NZ, .color_attr_if_join10
.color_attr_if_then9:
    LD A, 16
    RET
.color_attr_if_join10:
    CP 6
    JRS NZ, .color_attr_if_join12
.color_attr_if_then11:
    LD A, 112
    RET
.color_attr_if_join12:
    CP 7
    LD A, 0
    RET NZ
.color_attr_if_then13:
    LD A, 8
    RET

; fun fill_cell(cx: u8 = A, cy: u8 = C) ; clobbers: D, E, F, H, HL
fill_cell:
    LD A, C
    ADD A, A
    ADD A, A
    ADD A, A
    LD C, A
    LD D, 0
    LD E, A
.fill_cell_loop_head1:
    LD A, D
    CP 8
    JRS NC, .fill_cell_trmp0
.fill_cell_loop_body2:
    LD A, E
    LD A, C
    ADD A, 0
    LD H, A
    LD A, H
    CALL zx_screen_addr
    LD A, 255
    CALL zx_poke
    INC D
    JRS .fill_cell_loop_head1
.fill_cell_loop_exit3:
    RET
.fill_cell_trmp0:
    LD A, E
    LD E, C
    LD C, A
    JRS .fill_cell_loop_exit3

; fun init_screen() ; clobbers: A, C, D, DE, E, F, HL
init_screen:
    LD HL, 16384
.init_screen_loop_head1:
    PUSH HL
    OR A
    SBC HL, DE
    POP HL
    JRS NC, .init_screen_loop_exit3
.init_screen_loop_body2:
    LD C, 0
    LD A, C
    CALL zx_poke
    INC HL
    JRS .init_screen_loop_head1
.init_screen_loop_exit3:
    LD HL, 22528
.init_screen_loop_head4:
    PUSH HL
    OR A
    SBC HL, DE
    POP HL
    JRS NC, .init_screen_loop_exit6
.init_screen_loop_body5:
    LD C, 0
    LD A, C
    CALL zx_poke
    INC HL
    JRS .init_screen_loop_head4
.init_screen_loop_exit6:
    LD C, 2
.init_screen_loop_head7:
    LD A, C
    CP 22
    JRS NC, .init_screen_loop_exit9
.init_screen_loop_body8:
    LD D, 11
.init_screen_loop_head10:
    LD A, D
    CP 21
    JRS NC, .init_screen_loop_exit12
.init_screen_loop_body11:
    LD A, D
    LD A, C
    CALL fill_cell
    INC D
    JRS .init_screen_loop_head10
.init_screen_loop_exit12:
    INC C
    JRS .init_screen_loop_head7
.init_screen_loop_exit9:
    LD C, 2
.init_screen_loop_head13:
    LD A, C
    CP 22
    JRS NC, .init_screen_loop_exit15
.init_screen_loop_body14:
    LD A, 10
    LD A, C
    CALL fill_cell
    LD A, 10
    LD A, C
    CALL zx_attr_addr
    LD D, 56
    LD A, D
    CALL zx_poke
    INC C
    JRS .init_screen_loop_head13
.init_screen_loop_exit15:
    LD C, 2
.init_screen_loop_head16:
    LD A, C
    CP 22
    JRS NC, .init_screen_loop_exit18
.init_screen_loop_body17:
    LD A, 21
    LD A, C
    CALL fill_cell
    LD A, 21
    LD A, C
    CALL zx_attr_addr
    LD D, 56
    LD A, D
    CALL zx_poke
    INC C
    JRS .init_screen_loop_head16
.init_screen_loop_exit18:
    LD C, 10
.init_screen_loop_head19:
    LD A, 21
    CP C
    JRS C, .init_screen_loop_exit21
.init_screen_loop_body20:
    LD A, C
    LD D, 22
    LD A, D
    CALL fill_cell
    LD A, C
    LD D, 22
    LD A, D
    CALL zx_attr_addr
    LD D, 56
    LD A, D
    CALL zx_poke
    INC C
    JRS .init_screen_loop_head19
.init_screen_loop_exit21:
    LD A, 0
    JP zx_border

; fun render_preview(t: u8 = A, sx: u8 = C, sy: u8 = B) ; clobbers: D, E, F, H, HL, IXH, IXL, IYH
render_preview:
    LD D, 0
    LD E, B
.render_preview_loop_head1:
    LD A, D
    CP 4
    JRS NC, .render_preview_trmp0
.render_preview_loop_body2:
    LD IXH, 0
.render_preview_loop_head4:
    LD A, IXH
    CP 4
    JRS NC, .render_preview_trmp1
.render_preview_loop_body5:
    LD A, C
    ADD A, 0
    LD H, A
    LD B, H
    LD A, E
    ADD A, 0
    LD H, A
    LD A, B
    LD A, H
    CALL zx_attr_addr
    LD B, 0
    LD A, B
    CALL zx_poke
    INC IXH
    JRS .render_preview_loop_head4
.render_preview_loop_exit6:
    LD D, 1
    LD A, H
    ADD A, 1
    LD D, A
    JRS .render_preview_loop_head1
.render_preview_loop_exit3:
    CP 7
    JRS NC, .render_preview_if_join8
.render_preview_if_then7:
    LD B, A
    LD A, B
    CALL piece_color
    LD IXH, 0
    LD IXL, B
    LD IYH, A
.render_preview_loop_head9:
    LD A, IXH
    CP 4
    JRS NC, .render_preview_loop_exit11
.render_preview_loop_body10:
    LD A, IYH
    LD C, 0
    LD B, IXH
    LD A, C
    CALL piece_dx
    LD B, IYH
    LD H, 0
    LD C, IXH
    LD A, B
    LD A, H
    LD B, C
    CALL piece_dy
    ADD A, D
    LD A, E
    ADD A, B
    LD C, A
    LD A, C
    CALL zx_attr_addr
    LD A, IXL
    CALL zx_poke
    INC IXH
    JRS .render_preview_loop_head9
.render_preview_loop_exit11:
.render_preview_if_join8:
    RET
.render_preview_trmp0:
    LD D, C
    LD C, 0
    JRS .render_preview_loop_exit3
.render_preview_trmp1:
    LD H, 0
    JRS .render_preview_loop_exit6

; fun render() ; clobbers: A, B, C, D, E, F, H, HL, IXH, L
render:
    LD C, 0
.render_loop_head1:
    LD A, C
    CP 20
    JRS NC, .render_loop_exit3
.render_loop_body2:
    LD D, 0
.render_loop_head4:
    LD A, D
    CP 10
    JRS NC, .render_loop_exit6
.render_loop_body5:
    LD A, D
    LD A, C
    CALL board_get
    CALL color_attr
    LD E, 11
    LD A, E
    ADD A, 0
    LD E, A
    LD B, E
    LD E, 2
    LD A, E
    ADD A, 0
    LD E, A
    LD A, B
    LD A, E
    CALL zx_attr_addr
    CALL zx_poke
    INC D
    JRS .render_loop_head4
.render_loop_exit6:
    INC C
    JRS .render_loop_head1
.render_loop_exit3:
    CALL ghost_y
    LD HL, cur_y
    LD C, (HL)
    LD A, B
    CP C
    JRS Z, .render_if_join8
.render_if_then7:
    LD HL, cur_type
    LD C, (HL)
    LD A, C
    CALL piece_color
    LD C, A
    SRL C
    SRL C
    SRL C
    LD A, C
    AND 7
    LD C, 0
    LD D, A
    LD E, B
.render_loop_head9:
    LD A, C
    CP 4
    JRS NC, .render_loop_exit11
.render_loop_body10:
    LD HL, cur_x
    LD IXH, (HL)
    LD HL, cur_type
    LD H, (HL)
    LD A, H
    LD HL, cur_rot
    LD H, (HL)
    LD B, C
    LD A, H
    CALL piece_dx
    ADD A, IXH
    LD IXH, A
    LD HL, cur_type
    LD H, (HL)
    LD A, H
    LD HL, cur_rot
    LD H, (HL)
    LD B, C
    LD A, H
    CALL piece_dy
    ADD A, E
    LD H, A
    LD A, IXH
    CP 10
    SBC A, A
    LD E, A
    LD A, H
    CP 20
    ; TODO: 8-bit AND E, A → L with A as rhs
    LD A, E
    AND A
    LD L, A
    AND A
    JRS Z, .render_if_join13
.render_if_then12:
    LD A, IXH
    LD A, H
    CALL board_get
    AND A
    JRS NZ, .render_if_join15
.render_if_then14:
    LD L, 11
    LD A, L
    ADD A, IXH
    LD L, 2
    LD A, L
    ADD A, H
    LD H, A
    LD A, H
    CALL zx_attr_addr
    LD A, D
    CALL zx_poke
.render_if_join15:
.render_if_join13:
    INC C
    JRS .render_loop_head9
.render_loop_exit11:
.render_if_join8:
    LD HL, cur_type
    LD C, (HL)
    LD A, C
    CALL piece_color
    LD C, 0
    LD D, A
.render_loop_head16:
    LD A, C
    CP 4
    JRS NC, .render_trmp0
.render_loop_body17:
    LD HL, cur_x
    LD E, (HL)
    LD HL, cur_type
    LD H, (HL)
    LD A, H
    LD HL, cur_rot
    LD H, (HL)
    LD B, C
    LD A, H
    CALL piece_dx
    ADD A, E
    LD E, A
    LD HL, cur_y
    LD IXH, (HL)
    LD HL, cur_type
    LD H, (HL)
    LD A, H
    LD HL, cur_rot
    LD H, (HL)
    LD B, C
    LD A, H
    CALL piece_dy
    ADD A, IXH
    LD H, A
    LD A, E
    CP 10
    SBC A, A
    LD D, A
    LD A, H
    CP 20
    ; TODO: 8-bit AND D, A → L with A as rhs
    LD A, D
    AND A
    LD L, A
    AND A
    JRS Z, .render_if_join20
.render_if_then19:
    LD L, 11
    LD A, L
    ADD A, E
    LD E, 2
    LD A, E
    ADD A, H
    LD E, A
    LD A, E
    CALL zx_attr_addr
    LD A, D
    CALL zx_poke
.render_if_join20:
    INC C
    JRS .render_loop_head16
.render_loop_exit18:
    LD HL, next_type
    LD C, (HL)
    LD A, C
    LD C, 23
    LD B, 3
    LD A, C
    CALL render_preview
    LD HL, hold_type
    LD C, (HL)
    LD A, C
    LD C, 5
    LD B, 3
    LD A, C
    JP render_preview
.render_trmp0:
    LD C, D
    LD D, 0
    JRS .render_loop_exit18

; fun read_input() -> u8 = A ; clobbers: B, C, D, F
read_input:
    LD C, 0
    LD A, 223
    CALL zx_key_row
    LD A, B
    AND 2
    AND A
    JRS NZ, .read_input_trmp0
.read_input_if_then1:
    LD A, 1
.read_input_if_join2:
    LD E, A
    LD A, B
    AND 1
    LD B, A
    AND A
    LD A, E    ; restore block param from scratch
    JRS NZ, .read_input_trmp1
.read_input_if_then3:
    OR C
    LD B, A
.read_input_if_join4:
    LD A, 251
    CALL zx_key_row
    AND C
    AND A
    JRS NZ, .read_input_if_join6
.read_input_if_then5:
    LD A, B
    OR 4
    LD B, A
.read_input_if_join6:
    LD A, 253
    CALL zx_key_row
    AND C
    AND A
    JRS NZ, .read_input_if_join8
.read_input_if_then7:
    LD A, B
    OR 8
    LD B, A
.read_input_if_join8:
    LD A, 127
    CALL zx_key_row
    AND C
    AND A
    JRS NZ, .read_input_if_join10
.read_input_if_then9:
    LD A, B
    OR 16
    LD B, A
.read_input_if_join10:
    LD A, 191
    CALL zx_key_row
    AND C
    AND A
    JRS NZ, .read_input_if_join12
.read_input_if_then11:
    LD A, B
    OR 32
    LD B, A
.read_input_if_join12:
    LD A, B
    RET
.read_input_trmp0:
    LD A, 0
    JRS .read_input_if_join2
.read_input_trmp1:
    LD B, A
    JRS .read_input_if_join4

; fun score_lines(cl: u8 = A) ; clobbers: C, D, DE, F, HL
score_lines:
.score_lines_if_join2:
    LD HL, last_was_tspin
    LD C, (HL)
    LD A, C
    CP 1
    JRS NZ, .score_lines_if_else7
.score_lines_if_then5:
.score_lines_if_join9:
.score_lines_if_join11:
.score_lines_if_join13:
.score_lines_if_join6:
    LD HL, (lines_cleared)    ; u16 direct load (20T, no A clobber)
    LD E, A
    LD D, 0
    ADD HL, DE
    LD DE, lines_cleared
    LD (lines_cleared), HL    ; u16 direct store (16T, no A clobber)
    LD HL, drop_speed
    LD D, (HL)
    LD A, 5
    CP D
    JRS NC, .score_lines_if_join23
.score_lines_if_then22:
    LD HL, (lines_cleared)    ; u16 direct load (20T, no A clobber)
    LD C, L
    LD A, C
    AND 7
    AND A
    JRS NZ, .score_lines_if_join25
.score_lines_if_then24:
    LD HL, drop_speed
    LD D, (HL)
    LD C, 2
    LD A, D
    SUB 2
    LD (drop_speed), A
.score_lines_if_join25:
.score_lines_if_join23:
    RET
.score_lines_if_else7:
.score_lines_if_join15:
.score_lines_if_join17:
.score_lines_if_join19:
.score_lines_if_join21:
    JRS .score_lines_if_join6

; fun do_lock_and_clear() ; clobbers: A, HL
do_lock_and_clear:
    CALL check_tspin
    LD (last_was_tspin), A
    CALL lock_piece
    CALL clear_lines
    CALL score_lines
    JP spawn_piece

