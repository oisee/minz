    INC D
    JRS .sum_to_loop_head1
.sum_to_loop_exit3:
    RET
.sum_to_trmp0:
    LD D, C
    LD C, 1
    JRS .sum_to_loop_exit3

; fun abs_diff(a: u8 = A, b: u8 = C) -> u8 = A ; clobbers: F
abs_diff:
