; generated by MIR2 Z80 codegen

; fun main() ; clobbers: A, HL
main:
    LD A, 5
    CALL factorial
    LD HL, result
    LD (HL), ?     ; lo
    INC HL
    LD (HL), 0     ; hi (zero-extend u8→u16)
    DEC HL
    XOR A
    DI
    HALT

; fun factorial(n: u8 = A) -> u16 = HL ; clobbers: B, C, D, DE, E, F
factorial:
    LD C, 1
    LD B, 0
    LD C, A
    LD HL, 1
.factorial_loop_head2:
    LD A, B
    CP C
    JRS NC, .factorial_loop_exit4
.factorial_loop_body3:
    LD D, 1
    LD A, B
    ADD A, 1
    LD E, A
    LD D, 0
    ; TODO: general mul HL * DE → D
    INC B
    LD H, D
    LD L, D
    JRS .factorial_loop_head2
.factorial_loop_exit4:
    RET

; globals
result:
    DB 0, 0
