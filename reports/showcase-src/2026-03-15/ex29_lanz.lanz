; Lanz: Lisp-like S-expression frontend for HIR
; Compiles through the full pipeline: Lanz → HIR → MIR2 → Z80

; Double a value
(fun double ((x u8)) u8
  (return (+ x x)))

; Sum from 1 to n using a while loop
(fun sum_to ((n u8)) u8
  (var acc u8 0)
  (var i u8 1)
  (while (<= i n)
    (set acc (+ acc i))
    (set i (+ i 1)))
  (return acc))

; Absolute value using conditional expression
(fun abs_diff ((a u8) (b u8)) u8
  (if (>= a b)
    (return (- a b))
    (return (- b a))))
