// Pipe/Trans: named reusable iterator pipelines
// Compile-time construct — zero runtime overhead, fuses into DJNZ loops

fun add_acc(acc: u8, x: u8) -> u8 { return (acc + x) }

// Named pipe with map stage — doubles each element
pipe doubled { map(|x: u8| x + x) }

// Compose pipes with 'use' — snapshot at definition time
trans tripled { use doubled; map(|x: u8| x + 1) }

// Apply pipe to range source + fold terminal
// range(0..5) yields 0,1,2,3,4 → doubled → 0,2,4,6,8 → sum = 20
assert sum_doubled() == 20
fun sum_doubled() -> u8 {
    return range(0..5).apply(doubled).fold(0, add_acc)
}

// Composed pipe: doubled + add 1
// range(0..3) yields 0,1,2 → doubled → 0,2,4 → +1 → 1,3,5 → sum = 9
assert sum_tripled() == 9
fun sum_tripled() -> u8 {
    return range(0..3).apply(tripled).fold(0, add_acc)
}
