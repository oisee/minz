; generated by MIR2 Z80 codegen

set_rgb:
    LD HL, palette
    LD (HL), C
    INC HL
    LD (HL), D
    INC HL
    LD (HL), E
    RET

get_r:
    LD A, (palette__r)
    RET

get_g:
    LD A, (palette__g)
    RET

get_b:
    LD A, (palette__b)
    RET

; globals
palette:
    DB 0, 0, 0
palette__r    EQU  palette
palette__g    EQU  palette + 1
palette__b    EQU  palette + 2
