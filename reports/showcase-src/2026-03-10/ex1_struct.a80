; generated by MIR2 Z80 codegen

; fun set_rgb(rv: u8 = C, gv: u8 = D, bv: u8 = E) ; clobbers: HL
set_rgb:
    LD HL, palette
    LD (HL), C
    INC HL
    LD (HL), D
    INC HL
    LD (HL), E
    RET

; fun get_r() -> u8 = A ; clobbers: HL
get_r:
    LD A, (palette__r)
    RET

; fun get_g() -> u8 = A ; clobbers: HL
get_g:
    LD A, (palette__g)
    RET

; fun get_b() -> u8 = A ; clobbers: HL
get_b:
    LD A, (palette__b)
    RET

; globals
palette:
    DB 0, 0, 0
palette__r    EQU  palette
palette__g    EQU  palette + 1
palette__b    EQU  palette + 2
