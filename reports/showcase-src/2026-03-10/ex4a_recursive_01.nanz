fun multy(a:u8, b:u8) -> (u8, u8) {
    if (a == 0 ) {
        return (0, 0)
    }
    if (a == 1) {
        return (b, b)
    }
    if (b == 1) {
        return (a, a)
    }
    //(c, _) = multy(a-1, b)
    return (c + b, c + b)
}

fun main() -> u8 {
    (x, y) = multy(3; 4)
    return x
    
}