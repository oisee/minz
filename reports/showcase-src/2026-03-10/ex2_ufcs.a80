    CALL Acc_reset
    LD HL, acc_g
    LD A, C
    CALL Acc_add
    LD HL, acc_g
    LD A, mem
    CALL Acc_add
    LD A, (acc_g__val)
    RET

; globals
acc_g:
    DB 0
acc_g__val    EQU  acc_g
