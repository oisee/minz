; fun Acc_add(self: ptr = HL, amount: u8 = C) -> u8 = A ; clobbers: D
Acc_add:
    LD D, (HL)
    LD A, D
    ADD A, C
    LD (HL), A
    LD A, (HL)
    RET

; fun Acc_reset(self: ptr = HL) ; clobbers: C
Acc_reset:
    LD (HL), 0
    RET

; fun sum_two(a: u8 = C, b: u8 = mem) -> u8 = A ; clobbers: HL
sum_two:
