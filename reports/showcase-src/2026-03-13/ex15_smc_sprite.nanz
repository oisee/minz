// ex15 — @smc compiled sprite (demoscene quality from high-level source)
//
// @smc r0: u16 bakes the parameter as LD HL,imm16 inside the function body.
// No ABI slot consumed. Moving the sprite = calling draw_row_set_r0(new_addr).
// T-state cost: 44T to draw 2 bytes, 24T to repatch address — same as hand-ASM.

struct Row2 { b0: u8, b1: u8 }

fun draw_row(@smc r0: u16) -> void {
    r0^ = Row2{ b0: 195, b1: 60 }
}

// 4-row sprite variant — 4 independent patch slots
struct Row4 { b0: u8, b1: u8, b2: u8, b3: u8 }

fun draw_row4(@smc r0: u16) -> void {
    r0^ = Row4{ b0: 0xFF, b1: 0x81, b2: 0x81, b3: 0xFF }
}
