; fun sum_to(n: u8 = A) -> u8 = A ; clobbers: C, D, E, F, HL
sum_to:
    LD HL, acc_u8
    LD (HL), 0
    LD C, 0
    INC A
    LD C, A
    LD D, 0
.sum_to_loop_head2:
    LD A, D
    CP C
    JRS NC, .sum_to_trmp0
.sum_to_loop_body3:
    LD HL, acc_u8
    LD E, (HL)
    LD A, E
    ADD A, D
    LD (acc_u8), A
    LD E, 1
    LD A, D
    ADD A, 1
    LD D, A
    JRS .sum_to_loop_head2
.sum_to_loop_exit4:
    LD A, (acc_u8)
    RET
.sum_to_trmp0:
    LD A, C
    LD C, D
    LD D, A
    JRS .sum_to_loop_exit4

; fun factorial(n: u8 = A) -> u16 = HL ; clobbers: C, D, DE, F
factorial:
    LD C, 1
    LD HL, acc_u16
    LD (HL), C     ; lo
    INC HL
    LD (HL), 0     ; hi (zero-extend u8→u16)
    DEC HL
    LD C, 1
    INC A
    LD C, A
    LD A, 1
.factorial_loop_head2:
    LD E, A
    LD A, E
    CP C
    LD A, E    ; restore block param from scratch
    JRS NC, .factorial_trmp0
.factorial_loop_body3:
    LD HL, (acc_u16)    ; u16 direct load (20T, no A clobber)
    ; mul16 HL * A → HL  (~320T, 16-iter shift-and-add)
    PUSH AF
    PUSH DE
    LD E, A
    LD D, 0
    PUSH BC
    LD B, H
    LD C, L
    LD H, 0
    LD L, 0
    LD A, 16
.factorial_m16_31_lp:
    SRL D
    RR E
    JRS NC, .factorial_m16_31_sk
    ADD HL, BC
.factorial_m16_31_sk:
    SLA C
    RL B
    DEC A
    JRS NZ, .factorial_m16_31_lp
    POP BC
    POP DE
    POP AF
    LD DE, acc_u16
    LD (acc_u16), HL    ; u16 direct store (16T, no A clobber)
    INC A
    JRS .factorial_loop_head2
.factorial_loop_exit4:
    LD HL, (acc_u16)    ; u16 direct load (20T, no A clobber)
    RET
.factorial_trmp0:
    LD D, C
    JRS .factorial_loop_exit4

; fun count_in_range(arr_ptr: ptr = HL, len: u8 = C, lo: u8 = A, hi: u8 = B) -> u8 = A ; clobbers: BC, D, DE, E, F, IXH, IXL, IYH
count_in_range:
