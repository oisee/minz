; fun factorial_fold(n: u8 = A) -> u16 = HL ; clobbers: C, D, DE, F
factorial_fold:
    LD C, 1
    LD HL, acc
    LD (HL), C     ; lo
    INC HL
    LD (HL), 0     ; hi (zero-extend u8→u16)
    DEC HL
    LD C, 1
    INC A
.factorial_fold_loop_head2:
    LD E, A
    LD A, C
    CP E
    LD A, E    ; restore block param from scratch
    JRS NC, .factorial_fold_loop_exit4
.factorial_fold_loop_body3:
    LD HL, (acc)    ; u16 direct load (20T, no A clobber)
    LD DE, acc
    LD (acc), HL    ; u16 direct store (16T, no A clobber)
    INC C
    JRS .factorial_fold_loop_head2
.factorial_fold_loop_exit4:
    LD HL, (acc)    ; u16 direct load (20T, no A clobber)
    RET

; globals
acc:
    DB 1, 0
