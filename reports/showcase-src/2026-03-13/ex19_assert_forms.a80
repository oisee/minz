; generated by MIR2 Z80 codegen

; fun abs_diff(a: u8 = A, b: u8 = C) -> u8 = A ; clobbers: F
abs_diff:
    SUB C
    JRS C, .abs_diff_if_join2
.abs_diff_if_then1:
    RET
.abs_diff_if_join2:
    NEG
    RET

; fun clamp(v: u8 = A, lo: u8 = B, hi: u8 = C) -> u8 = A ; clobbers: F
clamp:
    CP B
    JRS NC, .clamp_if_join2
.clamp_if_then1:
    LD A, B
    RET
.clamp_if_join2:
    CP C
    JRS Z, .clamp_cret0
    JRS C, .clamp_cret0
.clamp_if_then3:
    LD A, C
    RET
.clamp_cret0:
    RET

; fun divmod(a: u8 = A, b: u8 = D) -> (u8 = C, u8 = A) ; clobbers: C
divmod:
    ; TODO: div
    ; TODO: general mul C * D → D
    SUB D
    LD B, A
    LD A, C
    RET

; fun minmax(a: u8 = A, b: u8 = D) -> (u8 = A, u8 = D) ; clobbers: C, F
minmax:
    CP D
    LD B, D
    LD C, A
    JRS C, .minmax_if_then1
    JRS Z, .minmax_if_then1
    LD A, B
    LD B, C
    RET
.minmax_if_then1:
    LD B, D
    RET

; fun manhattan(px: u8 = C, py: u8 = A, qx: u8 = IXH, qy: u8 = IXL) -> u8 = A ; clobbers: BC, D, DE, H, HL
manhattan:
    DEC SP
    DEC SP
    LD HL, 0
    ADD HL, SP
    EX DE, HL
    LD (DE), C
    LD H, D
    LD L, E
    INC HL
    LD (HL), A
    DEC SP
    DEC SP
    LD HL, 0
    ADD HL, SP
    LD B, H
    LD C, L
    LD (BC), IXH
    PUSH BC
    POP HL
    INC HL
    LD (HL), IXL
    LD A, (DE)
    LD H, A
    LD A, H
    LD A, (BC)
    LD H, A
    LD A, H
    CALL abs_diff
    LD H, D
    LD L, E
    INC HL
    LD D, (HL)
    PUSH BC
    POP HL
    INC HL
    LD C, (HL)
    LD A, D
    LD A, C
    CALL abs_diff
    ADD A, IXH
    RET

