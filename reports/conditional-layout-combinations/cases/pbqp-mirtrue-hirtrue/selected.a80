; fun emit(tokens: ptr = HL, typ: u8 = A, str_ptr: u16 = BC) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
emit:
    LD DE, (tok_count)    ; u16 direct load, no scratch clobber
    PUSH HL
    LD H, D
    LD L, E
    ADD HL, HL
    ADD HL, HL
    LD D, H
    LD E, L
    POP HL
    PUSH HL
    ADD HL, DE
    LD (HL), A
    POP HL         ; restore base ptr after store
    PUSH HL
    PUSH BC
    POP HL
    LD A, L
    AND 255
    LD L, A
    LD H, 0
    PUSH HL
    POP IX
    POP HL
    LD A, IXL
    LD IX, 1
    LD IXH, D
    LD IXL, E
    INC IX
    PUSH HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    PUSH HL
    POP IX
    POP DE
    POP HL
    LD (IX+0), A
    PUSH HL
    PUSH BC
    POP HL
    LD L, H
    LD H, 0
    PUSH HL
    POP BC
    POP HL
    LD A, C
    LD BC, 2
    PUSH HL
    LD H, D
    LD L, E
    ADD HL, BC
    PUSH HL
    POP BC
    POP HL
    PUSH HL
    PUSH DE
    PUSH BC
    POP DE
    ADD HL, DE
    PUSH HL
    POP BC
    POP DE
    POP HL
    LD (BC), A
    LD BC, 3
    PUSH HL
    EX DE, HL
    ADD HL, BC
    EX DE, HL
    POP HL
    ADD HL, DE
    LD (HL), 0
    LD DE, (tok_count)    ; u16 direct load, no scratch clobber
    INC DE
    LD HL, tok_count
    LD (HL), E     ; lo
    INC HL
    LD (HL), D     ; hi
    DEC HL
    RET

