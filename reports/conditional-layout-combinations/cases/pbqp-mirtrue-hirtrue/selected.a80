; fun tokenize_all(src: ptr = HL, arena: ptr = DE, tokens: ptr = BC) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dead-block-arg=1]
tokenize_all:
    LD A, 0
    LD IX, pos
    LD (IX+0), A     ; lo
    LD (IX+1), 0     ; hi (zero-extend)
    LD A, 0
    LD IX, tok_count
    LD (IX+0), A     ; lo
    LD (IX+1), 0     ; hi (zero-extend)
    PUSH HL
    POP IX
    LD IYH, D
    LD IYL, E
    LD (_spill_tokenize_all_r908), BC
    ; genCall: scan dst=909
    PUSH BC
    PUSH DE
    PUSH HL
    PUSH IX
    POP HL
    LD D, IYH
    LD E, IYL
    LD BC, (_spill_tokenize_all_r908)
    CALL scan
    POP HL
    POP DE
    POP BC
    LD IXH, D
    LD IXL, E
    PUSH HL
    POP IY
    LD (_spill_tokenize_all_r913), BC
.tokenize_all_loop_head1:
    LD HL, TOK_EOF
    LD D, (HL)
    CP D
    JRS Z, .tokenize_all_loop_exit3
.tokenize_all_loop_body2:
    PUSH IY
    POP HL
    LD D, IXH
    LD E, IXL
    LD BC, (_spill_tokenize_all_r913)
    ; genCall: scan dst=920
    PUSH HL
    LD HL, (_spill_tokenize_all_r913)
    EX (SP), HL
    PUSH IX
    PUSH IY
    CALL scan
    POP IY
    POP IX
    EX (SP), HL
    LD (_spill_tokenize_all_r913), HL
    POP HL
    JRS .tokenize_all_loop_head1
.tokenize_all_loop_exit3:
    LD HL, (tok_count)    ; u16 direct load (20T, no A clobber)
    RET
; — spill slots for tokenize_all (1 spills)
_spill_tokenize_all_r913: DW 0
; — extra spill slots for tokenize_all (1 rescued)
_spill_tokenize_all_r908: DB 0, 0

; fun copy_forward(dst: ptr = DE, src: ptr = HL, n: u8 = B) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dead-block-arg=1,split-join-ret=1,condret-sink=1,cond-rets=1]
copy_forward:
    LD A, 0
    LD IXH, B
    LD B, H
    LD C, L
.copy_forward_loop_head1:
    LD H, A
    ; materialize r926 (pendingAcc)
    LD A, H
    CP IXH
    LD A, H
    ; restore block param from scratch
    RET NC
.copy_forward_loop_body2:
    LD L, A
    LD H, 0
    PUSH DE
    LD D, H
    LD E, L
    PUSH BC
    POP HL
    ADD HL, DE
    POP DE
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (HL)
    LD IXL, A
    EX AF, AF'      ; restore byte-load scratch
    PUSH BC
    PUSH AF
    PUSH AF
    LD A, 0
    LD B, A
    POP AF
    LD C, A
    POP AF
    LD H, D
    LD L, E
    ADD HL, BC
    POP BC
    EX AF, AF'
    LD A, IXL
    LD (HL), A
    EX AF, AF'
    INC A
    JRS .copy_forward_loop_head1

; fun checksum_records(tokens: ptr = BC, bytes: u16 = IX) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1,dead-block-arg=1,split-join-ret=1,condret-sink=1,cond-rets=1]
checksum_records:
    LD DE, 0
    LD HL, 0
    LD IYH, B
    LD IYL, C
    LD B, IXH
    LD C, IXL
.checksum_records_loop_head1:
    PUSH HL
    OR A
    SBC HL, BC
    POP HL
    JRS C, .checksum_records_loop_body2
    LD H, D
    LD L, E
    RET
.checksum_records_loop_body2:
    PUSH HL
    PUSH DE
    LD D, H
    LD E, L
    PUSH IY
    POP HL
    ADD HL, DE
    PUSH HL
    POP IX
    POP DE
    POP HL
    LD A, (IX+0)
    LD IXL, A
    LD IXH, 0
    PUSH HL
    PUSH BC
    EX DE, HL
    PUSH BC
    LD B, IXH
    LD C, IXL
    ADD HL, BC
    POP BC
    EX DE, HL
    POP BC
    POP HL
    INC HL
    JRS .checksum_records_loop_head1

; fun tokenizer_checked(src: ptr = BC, arena: ptr = HL, tokens: ptr = DE, length: u16 = IX) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
tokenizer_checked:
    LD IY, src_len
    LD A, IXL
    LD (IY+0), A     ; lo
    LD A, IXH
    LD (IY+1), A     ; hi
    LD A, (keywords_ready)
    AND A
    JRS NZ, .tokenizer_checked_if_join2
.tokenizer_checked_if_then1:
    PUSH HL
    POP IX
    ; genCall: init_keywords dst=0
    PUSH BC
    PUSH DE
    PUSH HL
    PUSH IX
    POP HL
    CALL init_keywords
    POP HL
    POP DE
    POP BC
    PUSH HL    ; preserve live HL across direct constant store
    LD HL, keywords_ready
    LD (HL), 1
    POP HL
.tokenizer_checked_if_join2:
    LD IXH, D
    LD IXL, E
    ; genCall: tokenize_all dst=967
    PUSH DE
    LD D, H
    LD E, L
    LD H, B
    LD L, C
    LD B, IXH
    LD C, IXL
    CALL tokenize_all
    POP DE
    PUSH HL
    ADD HL, HL
    ADD HL, HL
    LD B, H
    LD C, L
    POP HL
    ; genCall: checksum_records dst=972
    PUSH HL
    LD IXH, B
    LD IXL, C
    LD B, D
    LD C, E
    CALL checksum_records
    LD D, H
    LD E, L
    POP HL
    LD BC, token_checksum
    LD A, E
    LD (BC), A     ; lo
    INC BC
    LD A, D
    LD (BC), A     ; hi
    DEC BC
    RET

; fun scan$split_19(arena: ptr = HL, c: u8 = A, src: ptr = DE, tokens: ptr = BC) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP split-from=scan(pressure=9)
scan_split_19:
    CP 34
    JRS NZ, .scan_split_19_if_join2
.scan_split_19_if_then1:
    LD IX, pos
    PUSH AF          ; preserve word-load scratch
    LD A, (IX+0)     ; lo
    PUSH AF          ; stage low byte before replacing address
    LD A, (IX+1)     ; hi
    LD IXH, A
    POP AF
    LD IXL, A
    POP AF           ; restore word-load scratch
    INC IX
    LD IY, pos
    LD A, IXL
    LD (IY+0), A     ; lo
    LD A, IXH
    LD (IY+1), A     ; hi
    LD IX, pos
    PUSH AF          ; preserve word-load scratch
    LD A, (IX+0)     ; lo
    PUSH AF          ; stage low byte before replacing address
    LD A, (IX+1)     ; hi
    LD IXH, A
    POP AF
    LD IXL, A
    POP AF           ; restore word-load scratch
    LD (_spill_scan_split_19_r987), DE
.scan_split_19_loop_head3:
    LD DE, (_spill_scan_split_19_r987)
    ; genCall: peek_char dst=989
    PUSH HL
    LD HL, (_spill_scan_split_19_r987)
    EX (SP), HL
    PUSH BC
    PUSH HL
    PUSH IX
    LD B, D
    LD C, E
    CALL peek_char
    POP IX
    POP HL
    POP BC
    EX (SP), HL
    LD (_spill_scan_split_19_r987), HL
    POP HL
    CP 34
    JRS Z, .scan_split_19_trmp0
.scan_split_19_loop_body4:
    LD DE, (_spill_scan_split_19_r987)
    ; genCall: peek_char dst=993
    PUSH HL
    LD HL, (_spill_scan_split_19_r987)
    EX (SP), HL
    PUSH BC
    PUSH HL
    PUSH IX
    LD B, D
    LD C, E
    CALL peek_char
    POP IX
    POP HL
    POP BC
    EX (SP), HL
    LD (_spill_scan_split_19_r987), HL
    POP HL
    AND A
    JRS NZ, .scan_split_19_if_join7
.scan_split_19_if_then6:
    LD A, (TOK_EOF)
    RET
.scan_split_19_if_join7:
    LD DE, (pos)    ; u16 direct load, no scratch clobber
    INC DE
    LD IY, pos
    LD (IY+0), E     ; lo
    LD (IY+1), D     ; hi
    JRS .scan_split_19_loop_head3
.scan_split_19_loop_exit5:
    LD DE, (pos)    ; u16 direct load, no scratch clobber
    PUSH HL
    OR A
    LD H, D
    LD L, E
    PUSH DE
    LD D, IXH
    LD E, IXL
    SBC HL, DE
    POP DE
    LD D, H
    LD E, L
    POP HL
    LD A, E
    LD DE, (_spill_scan_split_19_r1003)
    ; genCall: intern dst=1011
    PUSH BC
    LD B, H
    LD C, L
    CALL intern
    POP BC
    LD DE, (pos)    ; u16 direct load, no scratch clobber
    INC DE
    LD IX, pos
    LD (IX+0), E     ; lo
    LD (IX+1), D     ; hi
    PUSH BC
    POP DE
    LD BC, TOK_STRING
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (BC)
    LD C, A
    EX AF, AF'      ; restore byte-load scratch
    ; genCall: emit dst=0
    LD A, C
    LD B, H
    LD H, D
    LD C, L
    LD L, E
    CALL emit
    LD A, (TOK_STRING)
    RET
.scan_split_19_if_join2:
    LD IX, pos
    PUSH AF          ; preserve word-load scratch
    LD A, (IX+0)     ; lo
    PUSH AF          ; stage low byte before replacing address
    LD A, (IX+1)     ; hi
    LD IXH, A
    POP AF
    LD IXL, A
    POP AF           ; restore word-load scratch
    INC IX
    LD IY, pos
    LD A, IXL
    LD (IY+0), A     ; lo
    LD A, IXH
    LD (IY+1), A     ; hi
    ; genCall: scan dst=1031
    EX DE, HL
    JP scan
.scan_split_19_trmp0:
    PUSH HL
    LD HL, (_spill_scan_split_19_r987)
    LD (_spill_scan_split_19_r1003), HL
    POP HL
    JRS .scan_split_19_loop_exit5
; — spill slots for scan_split_19 (1 spills)
_spill_scan_split_19_r987: DW 0
; — extra spill slots for scan_split_19 (1 rescued)
_spill_scan_split_19_r1003: DB 0, 0

