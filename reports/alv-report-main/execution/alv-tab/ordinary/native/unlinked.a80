        POP BC
        POP HL
        INC HL          ; advance string pointer
        DJNZ .loop
        RET
        .pad:
        ; Fill remaining width with spaces
        LD E, 32
        PUSH HL         ; save pointer (not advancing, but keep stack balanced)
        PUSH BC         ; save counter
        LD C, 2
        CALL 5
        POP BC
        POP HL
        DJNZ .pad
    RET

tui_clear:

tui_goto:

tui_color:

tui_reset:

tui_putch:

tui_puts:

tui_read_key:

tui_width:

tui_height:

