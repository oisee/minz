; fun _scr_puts_padded(str: ptr = HL, width: u8 = C) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
_scr_puts_padded:
    ; HL = str, width = C (PFCCO: ptr→HL, u8→C)
        LD B, C
        LD A, C
        OR A
        RET Z
        .loop:
        LD A, (HL)
        OR A
        JR Z, .pad
        LD E, A
        PUSH HL
        PUSH BC
        LD C, 2
        CALL 5
        POP BC
        POP HL
        INC HL
        DJNZ .loop
        RET
        .pad:
        LD E, 32
        PUSH HL
        PUSH BC
        LD C, 2
        CALL 5
        POP BC
        POP HL
        DJNZ .pad
    RET

