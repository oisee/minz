    PUSH HL
    POP BC
    ADD HL, HL
    ADD HL, HL
    ADD HL, BC
    ADD HL, HL
    POP BC
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (BC)
    LD D, A
    EX AF, AF'      ; restore byte-load scratch
    LD E, D
    LD D, 0
    ADD HL, DE
    LD DE, 48
    OR A
    SBC HL, DE
    LD DE, 1
    PUSH HL
    PUSH BC
    POP HL
    ADD HL, DE
    LD D, H
    LD E, L
    POP HL
    LD B, D
    LD C, E
    JRS ._scr_atoi_loop_head1

