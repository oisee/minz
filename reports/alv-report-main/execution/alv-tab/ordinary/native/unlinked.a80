    LD HL, 0
    LD B, D
    LD C, E
._scr_atoi_loop_head1:
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (BC)
    LD D, A
    EX AF, AF'      ; restore byte-load scratch
    LD A, D
    CP 48
    RET C
._scr_atoi_loop_body2:
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (BC)
    LD D, A
    EX AF, AF'      ; restore byte-load scratch
