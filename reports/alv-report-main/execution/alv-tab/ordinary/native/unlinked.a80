        PUSH HL
        LD HL, _tbl_data
        LD B, 0
        ADD HL, BC
        LD BC, 23
        OR A
        JR Z, .mul_done
        .mul_loop:
        ADD HL, BC
        DEC A
        JR NZ, .mul_loop
