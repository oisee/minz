; fun table_set_id(row: u8 = A, val: ptr = HL) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
table_set_id:
    ; A=row, HL=val (source string)
        PUSH HL
        LD HL, _tbl_data
        LD BC, 59
        OR A
        JR Z, .md
        .ml:
        ADD HL, BC
        DEC A
        JR NZ, .ml
        .md:
        EX DE, HL
        POP HL
        .cp:
        LD A, (HL)
        OR A
        JR Z, .nu
        LD (DE), A
        INC HL
        INC DE
        JR .cp
        .nu:
        XOR A
        LD (DE), A
    RET

