string @mir2.str.7 = "Carrier Name"
string @mir2.str.8 = "URL"
string @mir2.str.9 = "CREATE TABLE scarr (carrid TEXT, carrname TEXT, url TEXT)"
string @mir2.str.10 = "INSERT INTO scarr VALUES ('AA', 'American Airlines', 'http://www.aa.com')"
string @mir2.str.11 = "INSERT INTO scarr VALUES ('BA', 'British Airways', 'http://www.ba.com')"
string @mir2.str.12 = "INSERT INTO scarr VALUES ('LH', 'Lufthansa', 'http://www.lufthansa.com')"
string @mir2.str.13 = "INSERT INTO scarr VALUES ('SQ', 'Singapore Airlines', 'http://www.singaporeair.com')"
string @mir2.str.14 = "INSERT INTO scarr VALUES ('UA', 'United Airlines', 'http://www.united.com')"
string @mir2.str.15 = "INSERT INTO scarr VALUES ('QF', 'Qantas', 'http://www.qantas.com.au')"
string @mir2.str.16 = "INSERT INTO scarr VALUES ('EK', 'Emirates', 'http://www.emirates.com')"
string @mir2.str.17 = "INSERT INTO scarr VALUES ('AF', 'Air France', 'http://www.airfrance.com')"
string @mir2.str.18 = "SELECT carrid, carrname, url FROM scarr ORDER BY carrid"
string @mir2.str.19 = "carrid"
string @mir2.str.20 = "Filter: "
string @mir2.str.21 = " -> "
