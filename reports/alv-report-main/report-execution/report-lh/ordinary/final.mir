string @mir2.str.15 = "INSERT INTO scarr VALUES ('QF', 'Qantas', 'http://www.qantas.com.au')"
string @mir2.str.16 = "INSERT INTO scarr VALUES ('EK', 'Emirates', 'http://www.emirates.com')"
string @mir2.str.17 = "INSERT INTO scarr VALUES ('AF', 'Air France', 'http://www.airfrance.com')"
string @mir2.str.18 = "SELECT carrid, carrname, url FROM scarr ORDER BY carrid"
string @mir2.str.19 = "carrid"
