; generated by VIR unified solver (Z3-PFCCO + Z3 joint isel+regalloc)
; calling conventions optimized by Z3 SMT solver

; gcd: params=[A,B] ret=A (Z3-PFCCO)

; VIR→PBQP fallback for gcd
; fun gcd(a: u8 = A, b: u8 = C) -> u8 = A [recursive] ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
gcd:
    LD E, A    ; preserve live accumulator before CMP
    LD A, C
    AND A
    LD A, E
    ; restore live-out r1 from scratch
    JRS NZ, .gcd_if_join2
.gcd_if_then1:
    RET
.gcd_if_join2:
    LD B, C
    LD B, A
    XOR A
    LD D, 8
.div8_0:
    SLA B
    RLA
    CP C
    JR C, .div8_skip_0
    SUB C
    INC B
.div8_skip_0:
    DEC D
    JR NZ, .div8_0
    LD C, A
    ; genCall: gcd dst=7
    LD A, B
    JP gcd


