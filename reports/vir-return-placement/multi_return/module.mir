; MIR2 module: multi_return.nanz
fun @abs_val(%r1: u8 [acc], %r2: u8 [general]) -> u8 [acc]
  block @entry:
    %r3 = const 0 : u8 [general]
    %r4 = cmp.ugt %r2, %r3 : bool [flag]
    br_if %r4, @if_then1(), @if_join2()
  block @if_then1:
    %r5 = const 0 : u8 [general]
    %r6 = sub %r5, %r1 : u8 [acc]
    ret %r6
  block @if_join2:
    ret %r1

fun @safe_sub(%r7: u8 [acc], %r8: u8 [general]) -> u8 [acc]
  block @entry:
    %r9 = cmp.uge %r7, %r8 : bool [flag]
    br_if %r9, @if_then1(), @if_join2()
  block @if_then1:
    %r10 = sub %r7, %r8 : u8 [acc]
    ret %r10
  block @if_join2:
    %r11 = const 0 : u8 [acc]
    ret %r11

