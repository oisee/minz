; generated by VIR unified solver (Z3-PFCCO + Z3 joint isel+regalloc)
; calling conventions optimized by Z3 SMT solver

; abs_val: params=[A,B] ret=A (Z3-PFCCO)
; safe_sub: params=[A,B] ret=A (Z3-PFCCO)

; fun safe_sub(a: u8 = A, b: u8 = C) -> u8 = A ; clobbers: F
safe_sub:
    CP C
    JR C, .safe_sub_if_join2
.safe_sub_if_then1:
    SUB C
    RET
.safe_sub_if_join2:
    LD A, 0
    RET

; fun abs_val(x: u8 = acc, is_neg: u8 = general) -> u8 = A ; clobbers: F
abs_val:
    ; adapter: caller→standalone convention
    LD L, A
    LD A, C
    OR A
    JR Z, .abs_val_if_join2
    JR C, .abs_val_if_join2
.abs_val_if_then1:
    LD IXL, A
    LD IXH, 0
    LD A, L
    NEG
    RET
.abs_val_if_join2:
    LD C, A
    LD A, L
    RET


