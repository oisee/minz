
global DATA: [u8; 8] = [ 10, 20, 30, 40, 50, 60, 70, 80 ]

fun lookup(idx: u8) -> u8 {
    var p: ^u8 = &DATA
    var i: u8 = 0
    while i < idx {
        p = p + 1
        i = i + 1
    }
    return p^
}

assert lookup(0) == 10
assert lookup(1) == 20
assert lookup(3) == 40
assert lookup(7) == 80
