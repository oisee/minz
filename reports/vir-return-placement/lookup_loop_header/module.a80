; lookup: params=[A] ret=A (Z3-PFCCO)

; fun lookup(idx: u8 = A) -> u8 = A ; clobbers: F
lookup:
    LD HL, DATA
    XOR A
.lookup_loop_head1:
    LD D, H
    LD E, L
    LD IXL, A
    LD IXH, 0
    LD B, C
    LD A, L
    LD IYH, A
    LD IXH, A
    CP C
    JR NC, .lookup_loop_exit3
.lookup_loop_body2:
    LD D, H
    LD E, L
