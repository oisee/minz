; fun spawn_piece() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
spawn_piece:
    LD HL, next_type
    LD C, (HL)
    LD A, C
    LD (cur_type), A
    ; genCall: random_piece dst=337
    CALL random_piece
    LD (next_type), A
    LD HL, cur_rot
    LD (HL), 0
    LD HL, cur_x
    LD (HL), 3
    LD HL, cur_y
    LD (HL), 0
    LD HL, hold_used
    LD (HL), 0
    LD HL, cur_type
    LD C, (HL)
    LD A, C
    LD HL, cur_rot
    LD C, (HL)
    LD HL, cur_x
    LD D, (HL)
    LD B, D
    LD HL, cur_y
    LD D, (HL)
    ; genCall: can_place dst=357
    CALL can_place
    AND A
    RET NZ
.spawn_piece_if_then1:
    LD HL, game_over
    LD (HL), 1
.spawn_piece_if_join2:
    RET

; fun hold_piece() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
hold_piece:
    LD HL, hold_used
    LD D, (HL)
    LD A, D
    CP 1
    JRS NZ, .hold_piece_if_join2
.hold_piece_if_then1:
    RET
.hold_piece_if_join2:
    LD HL, hold_used
    LD (HL), 1
    LD HL, hold_type
    LD D, (HL)
    LD A, D
    CP 255
    JRS NZ, .hold_piece_if_else5
.hold_piece_if_then3:
    LD HL, cur_type
    LD C, (HL)
    LD A, C
    LD (hold_type), A
    ; genCall: spawn_piece dst=0
    CALL spawn_piece
.hold_piece_if_join4:
    RET
.hold_piece_if_else5:
    LD HL, cur_type
    LD C, (HL)
    LD HL, hold_type
    LD D, (HL)
    LD A, D
    LD (cur_type), A
    LD A, C
    LD (hold_type), A
    LD HL, cur_rot
    LD (HL), 0
    LD HL, cur_x
    LD (HL), 3
    LD HL, cur_y
    LD (HL), 0
    JRS .hold_piece_if_join4

; fun score_lines(cl: u8 = A) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
score_lines:
    AND A
    JRS NZ, .score_lines_if_join2
.score_lines_if_then1:
    RET
.score_lines_if_join2:
    CP 1
    JRS NZ, .score_lines_if_join4
.score_lines_if_then3:
    LD HL, (score)    ; u16 direct load (20T, no A clobber)
    LD DE, 100
    ADD HL, DE
    LD DE, score
    LD (score), HL    ; u16 direct store (16T, no A clobber)
.score_lines_if_join4:
    CP 2
    JRS NZ, .score_lines_if_join6
.score_lines_if_then5:
    LD HL, (score)    ; u16 direct load (20T, no A clobber)
    LD DE, 300
    ADD HL, DE
    LD DE, score
    LD (score), HL    ; u16 direct store (16T, no A clobber)
.score_lines_if_join6:
    CP 3
    JRS NZ, .score_lines_if_join8
.score_lines_if_then7:
    LD HL, (score)    ; u16 direct load (20T, no A clobber)
    LD DE, 500
    ADD HL, DE
    LD DE, score
    LD (score), HL    ; u16 direct store (16T, no A clobber)
.score_lines_if_join8:
    CP 4
    JRS NZ, .score_lines_if_join10
.score_lines_if_then9:
    LD HL, (score)    ; u16 direct load (20T, no A clobber)
    LD DE, 800
    ADD HL, DE
    LD DE, score
    LD (score), HL    ; u16 direct store (16T, no A clobber)
.score_lines_if_join10:
    LD HL, (lines_cleared)    ; u16 direct load (20T, no A clobber)
    LD E, A
    LD D, 0
    ADD HL, DE
    LD D, H
    LD E, L
    LD HL, lines_cleared
    LD (HL), E     ; lo
    INC HL
    LD (HL), D     ; hi
    DEC HL
    LD HL, drop_speed
    LD D, (HL)
    LD A, 2
    CP D
    RET NC
.score_lines_if_then11:
    LD HL, (lines_cleared)    ; u16 direct load (20T, no A clobber)
    LD D, L
    LD A, D
    AND 7
    AND A
    RET NZ
.score_lines_if_then13:
    LD HL, drop_speed
    LD D, (HL)
    LD C, 1
    LD A, D
    SUB 1
    LD (drop_speed), A
.score_lines_if_join12:
    RET

; fun do_lock_and_clear() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
do_lock_and_clear:
    ; genCall: lock_piece dst=0
    CALL lock_piece
    ; genCall: clear_lines dst=439
    CALL clear_lines
    ; genCall: score_lines dst=0
    CALL score_lines
    ; genCall: spawn_piece dst=0
    JP spawn_piece

; fun draw_cell(sx: u8 = A, sy: u8 = C, color_idx: u8 = B) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=2]
draw_cell:
    ; genCall: tui_goto dst=0
    PUSH BC
    CALL tui_goto
    POP BC
    LD A, B
    AND A
    JRS NZ, .draw_cell_if_else3
.draw_cell_if_then1:
    LD HL, FG_BLACK
    LD C, (HL)
    LD A, C
    LD HL, BG_BLACK
    LD C, (HL)
    LD B, 0
    ; genCall: tui_color dst=0
    CALL tui_color
    LD A, 32
    ; genCall: tui_putch dst=0
    CALL tui_putch
    LD A, 32
    ; genCall: tui_putch dst=0
    CALL tui_putch
.draw_cell_if_join2:
    RET
.draw_cell_if_else3:
    LD HL, PIECE_FG
    LD C, 1
    LD A, B
    SUB 1
    LD E, A
    LD D, 0
    ADD HL, DE
    LD C, (HL)
    LD HL, PIECE_BR
    LD D, 1
    LD A, B
    SUB 1
    LD E, A
    LD D, 0
    ADD HL, DE
    LD D, (HL)
    LD HL, FG_BLACK
    LD E, (HL)
    ; genCall: tui_color dst=0
    LD A, E
    LD B, D
    CALL tui_color
    LD A, 32
    ; genCall: tui_putch dst=0
    CALL tui_putch
    LD A, 32
    ; genCall: tui_putch dst=0
    CALL tui_putch
    JRS .draw_cell_if_join2

