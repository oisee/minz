    LD C, (HL)
    ; genCall: tui_putch dst=0
    LD A, C
    CALL tui_putch
    LD A, 0
    LD D, 20
.draw_border_loop_head6:
    CP D
    JRS NC, .draw_border_loop_exit8
.draw_border_loop_body7:
    LD HL, BOX_H
    LD E, (HL)
    ; genCall: tui_putch dst=0
    PUSH AF
    PUSH DE
    LD A, E
    CALL tui_putch
