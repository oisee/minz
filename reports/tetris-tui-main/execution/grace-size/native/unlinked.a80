; fun ghost_y() -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[split-join-ret=1,condret-sink=1,cond-rets=1]
ghost_y:
    LD A, (cur_y)
.ghost_y_loop_head1:
    LD HL, cur_type
    LD C, (HL)
    LD B, C
    LD HL, cur_rot
    LD D, (HL)
    LD HL, cur_x
    LD C, (HL)
    LD E, 1
    LD H, A
    ; materialize r225 (pendingAcc)
    LD L, A
    ; save r225 before ALU overwrite
    ADD A, 1
    LD E, A
    LD A, L
    ; genCall: can_place dst=237
    PUSH AF
    LD A, B
    LD B, C
    LD C, D
    LD D, E
    CALL can_place
    LD B, A
    POP AF
    LD E, A    ; preserve live accumulator before CMP
    LD A, B
    AND A
    LD A, E
    ; restore block param from scratch
    RET Z
.ghost_y_loop_body2:
    INC A
    JRS .ghost_y_loop_head1

; fun try_rotate() -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
try_rotate:
    LD HL, cur_rot
    LD D, (HL)
    LD C, 1
    LD A, D
    ADD A, 1
    AND 3
    LD HL, cur_type
    LD C, (HL)
    LD B, C
    LD HL, cur_x
    LD C, (HL)
    LD HL, cur_y
    LD D, (HL)
    ; genCall: can_place dst=256
    PUSH AF
    PUSH HL
    LD H, B
    LD B, C
    LD C, A
    LD A, H
    POP HL
    CALL can_place
    LD B, A
    POP AF
    LD E, A    ; preserve live accumulator before CMP
    LD A, B
    AND A
    LD A, E
    ; restore live-out r247 from scratch
    JRS Z, .try_rotate_if_join2
.try_rotate_if_then1:
    LD (cur_rot), A
    LD A, 1
    RET
.try_rotate_if_join2:
    LD HL, cur_x
    LD C, (HL)
    LD E, A    ; preserve live accumulator before CMP
    LD A, C
    CP 9
    LD A, E
    ; restore live-out r247 from scratch
    JRS NC, .try_rotate_if_join4
.try_rotate_if_then3:
    LD HL, cur_type
    LD C, (HL)
    LD B, C
    LD HL, cur_x
    LD C, (HL)
    INC C
    LD HL, cur_y
    LD D, (HL)
    ; genCall: can_place dst=275
    PUSH AF
    PUSH HL
    LD H, B
    LD B, C
    LD C, A
    LD A, H
    POP HL
    CALL can_place
    LD B, A
    POP AF
    LD E, A    ; preserve live accumulator before CMP
    LD A, B
    AND A
    LD A, E
    ; restore live-out r247 from scratch
    JRS Z, .try_rotate_if_join4
.try_rotate_if_then5:
    LD HL, cur_x
    LD C, (HL)
    LD D, 1
    LD E, A    ; preserve live r247 before ALU scratch
    LD A, C
    ADD A, 1
    LD B, A
    LD A, E
    PUSH AF    ; preserve live A across direct store
    LD A, B
    LD (cur_x), A
    POP AF
    LD (cur_rot), A
    LD A, 1
    RET
.try_rotate_if_join4:
    LD HL, cur_x
    LD C, (HL)
    LD E, A    ; preserve live accumulator before CMP
    LD A, C
    AND A
    LD A, E
    ; restore live-out r247 from scratch
    JRS Z, .try_rotate_if_join8
.try_rotate_if_then7:
    LD HL, cur_type
    LD C, (HL)
    LD B, C
    LD HL, cur_x
    LD C, (HL)
    DEC C
    LD HL, cur_y
    LD D, (HL)
    ; genCall: can_place dst=299
    PUSH AF
    PUSH HL
    LD H, B
    LD B, C
    LD C, A
    LD A, H
    POP HL
    CALL can_place
    LD B, A
    POP AF
    LD E, A    ; preserve live accumulator before CMP
    LD A, B
    AND A
    LD A, E
    ; restore live-out r247 from scratch
    JRS Z, .try_rotate_if_join8
.try_rotate_if_then9:
    LD HL, cur_x
    LD C, (HL)
    LD D, 1
    LD E, A    ; preserve live r247 before ALU scratch
    LD A, C
    SUB 1
    LD B, A
    LD A, E
    PUSH AF    ; preserve live A across direct store
    LD A, B
    LD (cur_x), A
    POP AF
    LD (cur_rot), A
    LD A, 1
    RET
.try_rotate_if_join8:
    LD HL, cur_y
    LD C, (HL)
    LD E, A    ; preserve live accumulator before CMP
    LD A, C
    AND A
    LD A, E
    ; restore live-out r247 from scratch
    JRS Z, .try_rotate_if_join12
.try_rotate_if_then11:
    LD HL, cur_type
    LD C, (HL)
    LD B, C
    LD HL, cur_x
    LD C, (HL)
    LD HL, cur_y
    LD D, (HL)
    DEC D
    ; genCall: can_place dst=323
    PUSH AF
    PUSH HL
    LD H, B
    LD B, C
    LD C, A
    LD A, H
    POP HL
    CALL can_place
    LD B, A
    POP AF
    LD E, A    ; preserve live accumulator before CMP
    LD A, B
    AND A
    LD A, E
    ; restore live-out r247 from scratch
    JRS Z, .try_rotate_if_join12
.try_rotate_if_then13:
    LD HL, cur_y
    LD C, (HL)
    LD D, 1
    LD E, A    ; preserve live r247 before ALU scratch
    LD A, C
    SUB 1
    LD B, A
    LD A, E
    PUSH AF    ; preserve live A across direct store
    LD A, B
    LD (cur_y), A
    POP AF
    LD (cur_rot), A
