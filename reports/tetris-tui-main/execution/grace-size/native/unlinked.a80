; fun draw_number(val: u16 = HL) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
draw_number:
    LD A, 0
.draw_number_loop_head1:
    LD DE, 10000
    LD B, A
    ; materialize r563 (pendingAcc)
    PUSH HL
    OR A
    SBC HL, DE
    POP HL
    LD A, B
    ; restore block param from scratch
    JRS C, .draw_number_trmp0
.draw_number_loop_body2:
    INC A
    LD DE, 10000
    OR A
    SBC HL, DE
    JRS .draw_number_loop_head1
.draw_number_loop_exit3:
    LD A, 0
.draw_number_loop_head4:
    LD DE, 1000
    LD B, A
    ; materialize r574 (pendingAcc)
    PUSH HL
    OR A
    SBC HL, DE
    POP HL
    LD A, B
    ; restore block param from scratch
