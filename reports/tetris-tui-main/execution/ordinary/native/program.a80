    LD C, A
    LD A, H
    POP HL
    CALL can_place
    LD B, A
    POP AF
    LD E, A    ; preserve live accumulator before CMP
    LD A, B
    AND A
    LD A, E
    ; restore live-out r249 from scratch
    JRS Z, .try_rotate_if_join10
.try_rotate_if_then9:
    LD HL, cur_x
    LD C, (HL)
    LD D, 1
