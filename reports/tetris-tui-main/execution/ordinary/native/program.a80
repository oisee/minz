    LD A, C
    ADD A, 1
    LD B, A
    LD A, E
    PUSH AF    ; preserve live A across direct store
    LD A, B
    LD (cur_x), A
    POP AF
    LD (cur_rot), A
    LD A, 1
    RET
.try_rotate_if_join6:
.try_rotate_if_join4:
    LD HL, cur_x
    LD C, (HL)
    LD E, A    ; preserve live accumulator before CMP
    LD A, C
    AND A
    LD A, E
    ; restore live-out r249 from scratch
    JRS Z, .try_rotate_if_join8
.try_rotate_if_then7:
    LD HL, cur_type
