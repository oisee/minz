    POP AF
    LD A, L
    AND H
    AND A
    JRS Z, .render_if_join24
.render_if_then23:
    LD HL, DRAW_X
    LD H, (HL)
    LD A, E
    ADD A, A
    LD E, A
    ADD A, H
    LD HL, DRAW_Y
    LD E, (HL)
    LD H, A
    ; save r977 before A overwrite
    LD A, E
    ADD A, B
    LD E, A
    LD A, H
    LD HL, cur_type
    LD H, (HL)
    INC H
    ; genCall: draw_cell dst=0
    PUSH BC
    PUSH DE
    LD C, E
    LD B, H
    CALL draw_cell
    POP DE
    POP BC
.render_if_join24:
    LD E, 1
    LD A, C
    ADD A, 1
    LD C, A
    JRS .render_loop_head20
.render_loop_exit22:
    ; genCall: draw_info dst=0
    CALL draw_info
    ; genCall: tui_reset dst=0
    JP tui_reset
.render_trmp0:
    JRS .render_loop_exit8

