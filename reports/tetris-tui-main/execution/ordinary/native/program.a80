    JRS .ghost_y_loop_head1

; fun try_rotate() -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
try_rotate:
