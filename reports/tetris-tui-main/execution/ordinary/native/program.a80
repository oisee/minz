; fun spawn_piece() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
spawn_piece:
    LD HL, next_type
    LD C, (HL)
    LD A, C
    LD (cur_type), A
    ; genCall: random_piece dst=339
    CALL random_piece
    LD (next_type), A
    LD HL, cur_rot
    LD (HL), 0
    LD HL, cur_x
    LD (HL), 3
    LD HL, cur_y
    LD (HL), 0
    LD HL, hold_used
    LD (HL), 0
    LD HL, cur_type
    LD C, (HL)
    LD A, C
    LD HL, cur_rot
    LD C, (HL)
    LD HL, cur_x
    LD D, (HL)
    LD B, D
    LD HL, cur_y
    LD D, (HL)
    ; genCall: can_place dst=359
    CALL can_place
    AND A
    RET NZ
.spawn_piece_if_then1:
    LD HL, game_over
    LD (HL), 1
.spawn_piece_if_join2:
    RET

; fun hold_piece() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
hold_piece:
    LD HL, hold_used
    LD D, (HL)
    LD A, D
    CP 1
    JRS NZ, .hold_piece_if_join2
.hold_piece_if_then1:
    RET
.hold_piece_if_join2:
    LD HL, hold_used
