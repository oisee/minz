// StrRef primitives test — mem_eq + hash
// Core building blocks for string interning.

fun mem_eq_3(a1: u8, a2: u8, a3: u8, b1: u8, b2: u8, b3: u8) -> u8 {
    if (a1 != b1) { return 0 }
    if (a2 != b2) { return 0 }
    if (a3 != b3) { return 0 }
    return 1
}

// XOR-rotate hash: simple but effective on u8
fun hash3(a: u8, b: u8, c: u8) -> u8 {
    var h: u8 = a
    h = h + b + b
    h = h + c + c + c
    return h
}

// "abc" == "abc"
fun test_eq() -> u8 {
    return mem_eq_3(97, 98, 99, 97, 98, 99)
}

// "abc" != "abd"
fun test_neq() -> u8 {
    return mem_eq_3(97, 98, 99, 97, 98, 100)
}

// hash("abc") == hash("abc")
fun test_hash_eq() -> u8 {
    var h1: u8 = hash3(97, 98, 99)
    var h2: u8 = hash3(97, 98, 99)
    if (h1 == h2) { return 1 }
    return 0
}

// hash("abc") != hash("xyz") — very different inputs
fun test_hash_neq() -> u8 {
    var h1: u8 = hash3(97, 98, 99)
    var h2: u8 = hash3(120, 121, 122)
    if (h1 != h2) { return 1 }
    return 0
}

// hash nonzero
fun test_hash_nz() -> u8 {
    if (hash3(97, 98, 99) != 0) { return 1 }
    return 0
}

// hash order matters: hash("abc") != hash("bac")
fun test_hash_order() -> u8 {
    var h1: u8 = hash3(97, 98, 99)
    var h2: u8 = hash3(98, 97, 99)
    if (h1 != h2) { return 1 }
    return 0
}

assert test_eq() == 1
assert test_neq() == 0
assert test_hash_eq() == 1
assert test_hash_neq() == 1
assert test_hash_nz() == 1
assert test_hash_order() == 1
