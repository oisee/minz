fun @sum_data() -> u8 [acc]
  block @entry:
    %r15 = const 0 : u8 [general]
    %r16 = addr_of @data : ptr [pointer]
    %r17 = move %r16 : ptr [pointer]
    %r18 = const 4 : u8 [general]
    jmp @fe_body1(%r18, %r17, %r15)
  block @fe_body1(%r19: u8 [counter], %r17: ptr [pointer], %r15: u8 [general]):
    %r22 = load %r17 : u8 [general]
