; fun tui_color(fg: u8 = A, bg: u8 = C, bright: u8 = B) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
tui_color    EQU tui__render__tui_color

; fun tui_reset() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
tui_reset    EQU tui__render__tui_reset

; fun tui_read_key() -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
tui_read_key    EQU tui__render__tui_read_key

; fun _generated_screen() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1]
_generated_screen:
    ; genCall: tui_clear dst=0
    CALL tui_clear
    LD A, 7
    LD C, 4
    LD B, 1
    ; genCall: tui_color dst=0
    CALL tui_color
    LD A, 0
    LD C, 0
    ; genCall: tui_goto dst=0
    CALL tui_goto
    LD HL, _mir2_str_0
    ; genCall: tui_puts dst=0
    CALL tui_puts
    ; genCall: tui_reset dst=0
    CALL tui_reset
    LD A, 2
    LD C, 2
    ; genCall: tui_goto dst=0
    CALL tui_goto
    LD A, 6
    LD C, 0
    LD B, 0
    ; genCall: tui_color dst=0
    CALL tui_color
    LD HL, _mir2_str_1
    ; genCall: tui_puts dst=0
    CALL tui_puts
    LD A, 7
    LD C, 0
    LD B, 0
    ; genCall: tui_color dst=0
    CALL tui_color
    LD HL, _mir2_str_2
    ; genCall: tui_puts dst=0
    CALL tui_puts
    ; genCall: tui_reset dst=0
    CALL tui_reset
    LD A, 2
    LD C, 3
    ; genCall: tui_goto dst=0
    CALL tui_goto
    LD A, 6
    LD C, 0
    LD B, 0
    ; genCall: tui_color dst=0
    CALL tui_color
    LD HL, _mir2_str_3
    ; genCall: tui_puts dst=0
    CALL tui_puts
    LD A, 7
    LD C, 0
    LD B, 0
    ; genCall: tui_color dst=0
    CALL tui_color
    LD HL, _mir2_str_2
    ; genCall: tui_puts dst=0
    CALL tui_puts
    ; genCall: tui_reset dst=0
    CALL tui_reset
    LD A, 2
    LD C, 4
    ; genCall: tui_goto dst=0
    CALL tui_goto
    LD A, 6
    LD C, 0
    LD B, 0
    ; genCall: tui_color dst=0
    CALL tui_color
    LD HL, _mir2_str_4
    ; genCall: tui_puts dst=0
    CALL tui_puts
    LD A, 7
    LD C, 0
    LD B, 0
    ; genCall: tui_color dst=0
    CALL tui_color
    LD HL, _mir2_str_2
    ; genCall: tui_puts dst=0
    CALL tui_puts
    ; genCall: tui_reset dst=0
    CALL tui_reset
    LD A, 2
    LD C, 5
    ; genCall: tui_goto dst=0
    CALL tui_goto
    LD A, 0
    LD C, 7
    LD B, 1
    ; genCall: tui_color dst=0
    CALL tui_color
    LD HL, _mir2_str_5
    ; genCall: tui_puts dst=0
    CALL tui_puts
    ; genCall: tui_reset dst=0
    CALL tui_reset
    ; genCall: tui_read_key dst=177
    CALL tui_read_key
    ; genCall: tui_clear dst=0
    CALL tui_clear
    ; genCall: tui_reset dst=0
    JP tui_reset

; strings
_mir2_str_0:
    DB "  Material Report", 0
_mir2_str_1:
    DB "Material    ", 0
_mir2_str_2:
    DB "[__________]", 0
_mir2_str_3:
    DB "Plant    ", 0
_mir2_str_4:
    DB "Count    ", 0
_mir2_str_5:
    DB "[Execute]", 0
