  block @if_join2(%r29: u8 [general]):
    %r30 = const 0 : u8 [general]
    %r31 = cmp.ne %r20, %r30 : bool [flag]
    br_if %r31, @if_then3(), @if_join4(%r24)
  block @if_then3:
    %r32 = const 60 : u8 [general]
    %r33 = add %r24, %r32 : u8 [acc]
    jmp @if_join4(%r33)
  block @if_join4(%r34: u8 [general]):
    call @_esc()
    %r35 = const 91 : u8 [general]
    %r36 = move %r35 : u8 [acc]
    call @_putch(%r36)
    %r37 = move %r29 : u8 [acc]
    call @_dec(%r37)
    %r38 = const 59 : u8 [general]
    %r39 = move %r38 : u8 [acc]
    call @_putch(%r39)
    %r40 = move %r34 : u8 [acc]
    call @_dec(%r40)
    %r41 = const 109 : u8 [general]
    %r42 = move %r41 : u8 [acc]
    call @_putch(%r42)
    ret void

