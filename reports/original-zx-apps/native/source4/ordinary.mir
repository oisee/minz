fun @_zxch(%r27: u8 [acc])
  block @entry:
    asm "CP 13\n    JR Z, ._nl\n    CP 10\n    JR Z, ._nl\n        SUB 32\n    LD L, A\n    LD H, 0\n        ADD HL, HL\n    ADD HL, HL\n    ADD HL, HL\n        LD DE, 0x3D00\n    ADD HL, DE\n        PUSH HL\n        LD A, (_zx_row)\n    LD C, A\n        LD A, (_zx_col)\n    LD B, A\n        LD A, C\n    AND 0x07\n    RRCA\n    RRCA\n    RRCA\n    AND 0xE0\n        OR B\n    LD L, A\n        LD A, C\n    AND 0x18\n    OR 0x40\n    LD H, A\n        POP DE\n        LD B, 8\n        ._cp: LD A, (DE)\n    LD (HL), A\n    INC DE\n    INC H\n    DJNZ ._cp\n        LD HL, _zx_col\n    INC (HL)\n    LD A, (HL)\n    CP 32\n    RET NZ\n        LD (HL), 0\n    DEC HL\n    INC (HL)\n    RET\n        ._nl: LD HL, _zx_row\n    INC (HL)\n    INC HL\n    LD (HL), 0"
    ret void

