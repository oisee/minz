fun @sql__sqlite___sql_send_str(%r1: ptr [pointer])
  block @entry:
    asm ".loop:\n        LD A, (HL)\n        OUT (0x45), A\n        OR A\n        RET Z\n        INC HL\n        JR .loop"
    ret void

fun @sql__sqlite___sql_recv_str(%r2: ptr [pointer]) -> ptr [pointer]
  block @entry:
    %r3 = asm "PUSH HL\n        .loop:\n        IN A, (0x45)\n        LD (HL), A\n        OR A\n        JR Z, .done\n        INC HL\n        JR .loop\n        .done:\n        POP HL"
    ret void

fun @sql__sqlite__sqlite_open(%r4: ptr [pointer]) -> u16 [pointer]
  block @entry:
    %r5 = move %r4 : ptr [pointer]
    call @sql__sqlite___sql_send_str(%r5)
    %r6 = asm "LD A, 1\n        OUT (0x41), A\n        IN A, (0x43)\n        LD L, A\n        LD H, 0"
    ret void

fun @sql__sqlite__sqlite_close(%r7: u16 [pointer]) -> u8 [acc]
  block @entry:
    %r8 = asm "LD A, L\n        OUT (0x45), A\n        LD A, 2\n        OUT (0x41), A\n        IN A, (0x43)"
    ret void

fun @sql__sqlite__sqlite_exec(%r9: u16 [pointer], %r10: ptr [pointer]) -> u8 [acc]
  block @entry:
    %r11 = asm "; HL=db, DE=sql\n        LD A, L\n        OUT (0x47), A       ; handle via hi port\n        ; Send SQL string from DE\n        EX DE, HL           ; HL = sql\n        .send:\n        LD A, (HL)\n        OUT (0x45), A\n        OR A\n        JR Z, .exec\n        INC HL\n        JR .send\n        .exec:\n        LD A, 8\n        OUT (0x41), A\n        IN A, (0x43)"
    ret void

fun @sql__sqlite__sqlite_query(%r12: u16 [pointer], %r13: ptr [pointer]) -> u16 [pointer]
  block @entry:
    %r14 = asm "LD A, L\n        OUT (0x47), A       ; handle via hi port\n        EX DE, HL\n        .send:\n        LD A, (HL)\n        OUT (0x45), A\n        OR A\n        JR Z, .qry\n        INC HL\n        JR .send\n        .qry:\n        LD A, 3\n        OUT (0x41), A\n        IN A, (0x43)\n        LD L, A\n        LD H, 0"
    ret void

fun @sql__sqlite__sqlite_step(%r15: u16 [pointer]) -> u8 [acc]
  block @entry:
    %r16 = asm "LD A, L\n        OUT (0x45), A\n        LD A, 4\n        OUT (0x41), A\n        IN A, (0x43)"
