    ret void

fun @zx_readline() -> u8 [acc]
  block @entry:
    %r32 = asm "LD IX, _zx_inbuf\n        LD B, 0\n        ._poll: IN A, (0x23)\n        OR A\n        JR Z, ._poll\n        AND 0x7F\n        CP 13\n        JR Z, ._done\n        CP 10\n        JR Z, ._done\n        LD (IX+0), A\n        INC IX\n        INC B\n        PUSH BC\n        CALL _zxch\n        POP BC\n        LD A, B\n        CP 60\n        JR NZ, ._poll\n        ._done: LD (IX+0), 0\n        PUSH BC\n        LD A, 13\n        CALL _zxch\n        POP BC\n        LD A, B"
    ret void

