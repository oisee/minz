fun @sql__sqlite__sqlite_exec(%r9: u16 [pointer], %r10: ptr [pointer]) -> u8 [acc]
  block @entry:
    %r11 = asm "; HL=db, DE=sql\n        LD A, L\n        OUT (0x47), A       ; handle via hi port\n        ; Send SQL string from DE\n        EX DE, HL           ; HL = sql\n        .send:\n        LD A, (HL)\n        OUT (0x45), A\n        OR A\n        JR Z, .exec\n        INC HL\n        JR .send\n        .exec:\n        LD A, 8\n        OUT (0x41), A\n        IN A, (0x43)"
    ret void

fun @sql__sqlite__sqlite_query(%r12: u16 [pointer], %r13: ptr [pointer]) -> u16 [pointer]
  block @entry:
