string @mir2.str.0 = "=== Z80 System Report ==="
string @mir2.str.1 = "CPU:      "
string @mir2.str.2 = "Z80A"
string @mir2.str.3 = "Clock:    "
string @mir2.str.4 = "3.5 MHz"
string @mir2.str.5 = "RAM:      "
string @mir2.str.6 = "48 KB"
string @mir2.str.7 = "ROM:      "
string @mir2.str.8 = "16 KB"
string @mir2.str.9 = "Kernel:   "
string @mir2.str.10 = "MinZ v0.21"
string @mir2.str.11 = "Runtime:  "
string @mir2.str.12 = "ABAP on Z80"
string @mir2.str.13 = "========================="
string @mir2.str.14 = "STATUS: ALL SYSTEMS GO"
string @mir2.str.15 = "Press any key..."
string @mir2.str.16 = "Hello from ABAP on ZX!"
