fun @zx__console__zx_poke(%r1: u16 [pointer], %r2: u8 [acc])
  block @entry:
    asm "LD (HL), A"
    ret void

fun @zx__console__zx_peek(%r3: u16 [pointer]) -> u8 [acc]
  block @entry:
    asm "LD A, (HL)"
    ret void

fun @zx__console__zx_in_fe(%r4: u8 [acc]) -> u8 [acc]
  block @entry:
    asm "IN A, (0xFE)"
    ret void

fun @zx__console__zx_border(%r5: u8 [acc])
  block @entry:
    asm "OUT (0xFE), A"
    ret void

fun @zx__console__screen_addr(%r6: u8 [acc], %r7: u8 [counter], %r8: u8 [regC]) -> u16 [pointer]
  block @entry:
    %r9 = asm "LD D, A         ; D = col\n        LD A, B         ; A = row\n        AND 0x18        ; TT bits\n        OR C            ; combine with line\n        OR 0x40         ; screen base\n        LD H, A\n        LD A, B         ; A = row\n        AND 0x07        ; sub-row\n        RRCA\n        RRCA\n        RRCA            ; shift left 5\n        OR D            ; combine with col\n        LD L, A"
    ret void

fun @zx__console__attr_addr(%r10: u8 [acc], %r11: u8 [counter]) -> u16 [pointer]
  block @entry:
    %r12 = asm "LD D, A         ; D = col\n        LD A, B         ; A = row\n        RRCA\n        RRCA\n        RRCA            ; row * 32\n        LD L, A\n        AND 0xE0\n        OR D\n        LD L, A\n        LD A, B         ; A = row again\n        RRCA\n        RRCA\n        RRCA\n        AND 0x03\n        OR 0x58         ; attr base\n        LD H, A"
    ret void

fun @zx__console__con_init(%r13: u8 [acc], %r14: u8 [general])
  block @entry:
    %r15 = const 3 : u8 [general]
    %r16 = shl %r14, %r15 : u8 [general]
    %r17 = or %r16, %r13 : u8 [acc]
    %r18 = addr_of @zx__console__con_attr : ptr [pointer]
    store %r18, %r17 : u8
    %r19 = const 0 : u8 [general]
    %r20 = addr_of @zx__console__con_col : ptr [pointer]
    store %r20, %r19 : u8
    %r21 = const 0 : u8 [general]
    %r22 = addr_of @zx__console__con_row : ptr [pointer]
    store %r22, %r21 : u8
    ret void

fun @zx__console__con_clear()
  block @entry:
    asm "; Clear pixel RAM: $4000-$57FF (6144 bytes) → 0\n        LD HL, 0x4000\n        LD DE, 0x4001\n        LD BC, 6143\n        LD (HL), 0\n        LDIR\n        ; Set attributes: $5800-$5AFF (768 bytes) → con_attr\n        LD HL, 0x5800\n        LD DE, 0x5801\n        LD BC, 767\n        LD A, (zx__console__con_attr)\n        LD (HL), A\n        LDIR\n        ; Reset cursor\n        XOR A\n        LD (zx__console__con_col), A\n        LD (zx__console__con_row), A"
    ret void

