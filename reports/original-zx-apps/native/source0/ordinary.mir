fun @zx__console__con_draw_char(%r112: u8 [counter], %r113: u8 [regD], %r114: u8 [regC])
  block @entry:
    asm "; Entry: B=col, D=row, C=ch\n        LD IYL, B           ; IYL = col\n        LD IYH, D           ; IYH = row\n\n        ; Compute font_ptr = $3D00 + (ch - 32) * 8\n        LD A, C             ; A = ch\n        SUB 32\n        LD L, A\n        LD H, 0\n        ADD HL, HL\n        ADD HL, HL\n        ADD HL, HL\n        LD DE, 0x3D00\n        ADD HL, DE\n        EX DE, HL           ; DE = font_ptr\n\n        ; Draw 8 pixel lines\n        LD B, 8\n        LD C, 0\n    .line_loop:\n        PUSH DE\n        PUSH BC\n        LD A, IYH\n        AND 0x18\n        OR C\n        OR 0x40\n        LD H, A\n        LD A, IYH\n        AND 0x07\n        RRCA\n        RRCA\n        RRCA\n        OR IYL\n        LD L, A\n        POP BC\n        POP DE\n        LD A, (DE)\n        LD (HL), A\n        INC DE\n        INC C\n        DJNZ .line_loop\n\n        ; Set attribute\n        LD A, IYH\n        RRCA\n        RRCA\n        RRCA\n        LD L, A\n        AND 0xE0\n        OR IYL\n        LD L, A\n        LD A, IYH\n        RRCA\n        RRCA\n        RRCA\n        AND 0x03\n        OR 0x58\n        LD H, A\n        LD A, (zx__console__con_attr)\n        LD (HL), A"
    ret void

