; fun poke(addr: u16 = HL, val: u8 = C) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
poke:
    ; HL=addr, C=val (PFCCO: u16, u8)
        LD (HL), C
    RET

; fun attr_row(row: u8 = A, attr: u8 = C) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
attr_row:
    ; A=row, C=attr
        LD H, 0
        LD L, A
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        LD DE, 0x5800
        ADD HL, DE
        LD B, 32
        .f: LD (HL), C
        INC HL
        DJNZ .f
    RET

; fun print_at(row: u8 = A, col: u8 = C, str: ptr = HL) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
print_at:
    ; A=row, C=col, DE=str (PFCCO: u8, u8, ptr → A, C, DE... actually ptr→HL)
        ; Wait — PFCCO for (u8, u8, ^u8): first u8→A, second u8→C, ptr→DE?
        ; Actually for 3 params it depends. Let's handle manually.
        ; For asm blocks with (in row, col, str): row=A, col=C, str=DE
        ; But actually the calling convention may put str in HL (first ptr).
        ; Let's use a simpler approach: pass row*32+col as u16, str as ptr
        RET  ; stub — we'll use a different approach
    RET

; fun fill_cell(row: u8 = A, col: u8 = C) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
fill_cell:
    PUSH BC
        LD D, A
        AND 0x07
        LD L, A
        LD H, 0
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        POP BC
        LD B, 0
        ADD HL, BC
        LD A, D
        AND 0x18
        OR 0x40
        ADD A, H
        LD H, A
        LD B, 8
        .sc: LD (HL), 0xFF
        INC H
        DJNZ .sc
    RET

