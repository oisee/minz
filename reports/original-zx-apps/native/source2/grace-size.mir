fun @_zxch(%r1: u8 [acc])
  block @entry:
    asm "CP 13\n    JR Z, ._nl\n    CP 10\n    JR Z, ._nl\n        SUB 32\n    LD L, A\n    LD H, 0\n        ADD HL, HL\n    ADD HL, HL\n    ADD HL, HL\n        LD DE, _zx_font\n    ADD HL, DE\n        PUSH HL\n        LD A, (_zx_row)\n    LD C, A\n        LD A, (_zx_col)\n    LD B, A\n        LD A, C\n    AND 0x07\n    RRCA\n    RRCA\n    RRCA\n    AND 0xE0\n        OR B\n    LD L, A\n        LD A, C\n    AND 0x18\n    OR 0x40\n    LD H, A\n        POP DE\n        LD B, 8\n        ._cp: LD A, (DE)\n    LD (HL), A\n    INC DE\n    INC H\n    DJNZ ._cp\n        LD HL, _zx_col\n    INC (HL)\n    LD A, (HL)\n    CP 32\n    RET NZ\n        LD (HL), 0\n    DEC HL\n    INC (HL)\n    RET\n        ._nl: LD HL, _zx_row\n    INC (HL)\n    INC HL\n    LD (HL), 0"
    ret void

fun @zx_puts(%r2: ptr [pointer])
  block @entry:
    asm "PUSH IX\n    PUSH HL\n    POP IX\n        .lp: LD A, (IX+0)\n    OR A\n    JR Z, .dn\n        PUSH IX\n    CALL _zxch\n    POP IX\n    INC IX\n    JR .lp\n        .dn: LD A, 13\n    PUSH IX\n    CALL _zxch\n    POP IX\n    POP IX"
    ret void

fun @zx_cls()
  block @entry:
    asm "LD HL, 0x4000\n    LD DE, 0x4001\n    LD BC, 6143\n    LD (HL), 0\n    LDIR\n        LD HL, 0x5800\n    LD DE, 0x5801\n    LD BC, 767\n    LD (HL), 0x07\n    LDIR\n        LD HL, _zx_row\n    LD (HL), 0\n    INC HL\n    LD (HL), 0"
    ret void

fun @zx_attr_row(%r3: u8 [acc], %r4: u8 [general])
  block @entry:
    asm "LD H, 0\n    LD L, A\n        ADD HL, HL\n    ADD HL, HL\n    ADD HL, HL\n    ADD HL, HL\n    ADD HL, HL\n        LD DE, 0x5800\n    ADD HL, DE\n        LD B, 32\n        .f: LD (HL), C\n    INC HL\n    DJNZ .f"
    ret void

fun @main()
  block @entry:
    call @zx_cls()
    asm "LD A, 1\n    OUT (0xFE), A"
    %r5 = const 0 : u8 [acc]
    %r6 = const 79 : u8 [general]
    call @zx_attr_row(%r5, %r6)
    %r7 = const 1 : u8 [acc]
