; MIR2 module: examples/abap/zsql_mara_color_zx.nanz
string @mir2.str.0 = " ZSQL - Z80 SQLite on Spectrum"
string @mir2.str.1 = " =============================="
string @mir2.str.2 = " "
string @mir2.str.3 = " zsql> CREATE TABLE mara"
string @mir2.str.4 = "   (matnr, mtart, meins, maktx)"
string @mir2.str.5 = " OK"
string @mir2.str.6 = " zsql> INSERT INTO mara VALUES"
string @mir2.str.7 = "   100-100 FERT ST Pump Assy"
string @mir2.str.8 = "   100-300 FERT ST Valve Unit"
string @mir2.str.9 = "   200-100 ROH  KG Raw Steel"
string @mir2.str.10 = "   200-200 HALB KG Steel Plate"
string @mir2.str.11 = " OK (4 rows)"
string @mir2.str.12 = " zsql> SELECT * FROM mara"
string @mir2.str.13 = "   WHERE mtart = FERT"
string @mir2.str.14 = " matnr   |mtart|meins|maktx"
string @mir2.str.15 = " --------|-----|-----|----------"
string @mir2.str.16 = " 100-100 |FERT |ST   |Pump Assy"
string @mir2.str.17 = " 100-300 |FERT |ST   |Valve Unit"
string @mir2.str.18 = " 2 rows. SQL on Z80!"
