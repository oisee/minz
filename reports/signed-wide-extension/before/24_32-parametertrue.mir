; MIR2 module: signed_embedding.nanz
global @input : i24
global @result : i32

fun @convert(%r1: i24 [acc]) -> i32 [acc]
  block @entry:
    %r2 = sext %r1 : i24 -> i32 [general]
    ret %r2

fun @embed()
  block @entry:
    %r3 = addr_of @input : ptr [pointer]
    %r4 = load %r3 : i24 [general]
    %r5 = sext %r4 : i24 -> i32 [general]
    %r6 = addr_of @result : ptr [pointer]
    store %r6, %r5 : i32
    ret void

