    PUSH HL
    ADD HL, BC
    PUSH HL
    POP BC
    POP HL
    PUSH AF
    LD A, IYH
    PUSH AF
    LD A, 0
    LD IXH, A
    POP AF
    LD IXL, A
    POP AF
