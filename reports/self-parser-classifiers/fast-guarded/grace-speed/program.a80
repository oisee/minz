    LD A, IYH
    PUSH AF
    LD A, 0
    LD IXH, A
    POP AF
    LD IXL, A
    POP AF
    PUSH HL
    PUSH DE
    PUSH BC
    POP HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    POP DE
    PUSH HL
    POP BC
    POP DE
    POP HL
