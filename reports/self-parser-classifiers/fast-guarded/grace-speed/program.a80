    LD A, 0
    LD IXH, A
    POP AF
    LD IXL, A
    POP AF
    PUSH HL
    PUSH DE
    PUSH BC
    POP HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    POP DE
    PUSH HL
    POP BC
    POP DE
    POP HL
    LD IX, src_buf
    PUSH AF          ; preserve word-load scratch
    LD A, (IX+0)     ; lo
    PUSH AF          ; stage low byte before replacing address
    LD A, (IX+1)     ; hi
    LD IXH, A
    POP AF
    LD IXL, A
    POP AF           ; restore word-load scratch
    PUSH HL
    PUSH DE
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    POP DE
    PUSH HL
    POP IX
    POP DE
