    LD A, 101
    LD C, 108
    LD B, 115
    ; genCall: str_alloc_3 dst=1454
    CALL str_alloc_3
    LD D, H
    LD E, L
    LD HL, KW_ELSE
    LD (HL), E     ; lo
    INC HL
    LD (HL), D     ; hi
    DEC HL
    RET

