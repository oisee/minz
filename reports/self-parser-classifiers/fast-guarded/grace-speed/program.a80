    PUSH DE
    PUSH HL
    PUSH IX
    LD H, D
    LD L, E
    LD D, B
    LD E, C
    LD B, IXH
    CALL region_eq
    LD B, A
    POP IX
    POP HL
    POP DE
    POP AF
    LD IYH, A    ; preserve live accumulator before CMP
    LD A, B
    CP 1
    LD A, IYH
    ; restore live-out r169 from scratch
    JRS NZ, .intern_if_join5
.intern_if_then6:
    RET
.intern_if_join5:
    INC HL
    LD C, A
    LD B, 0
    ADD HL, BC
    JRS .intern_loop_head1
.intern_loop_exit3:
    LD DE, (str_bump)    ; u16 direct load, no scratch clobber
    LD BC, (str_bump)    ; u16 direct load, no scratch clobber
    ; genCall: poke dst=0
    PUSH HL
    PUSH AF
    LD A, (_spill_intern_r180)
    LD L, A
    POP AF
    EX (SP), HL
    PUSH DE
    PUSH HL
    LD H, B
    LD L, C
    EX AF, AF'
    LD A, (_spill_intern_r180)
    LD C, A
    EX AF, AF'
    CALL poke
    POP HL
    POP DE
    EX (SP), HL
    PUSH AF
    LD A, L
    LD (_spill_intern_r180), A
    POP AF
    POP HL
    PUSH AF
    LD A, 0
    LD (_spill_intern_r186), A
    POP AF
