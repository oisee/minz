const REPS: u8 = 250

global acc: u16 = 0

fun zv_vec(i: u8) -> ^u8 {
    return &zv_vecs[u16(i) * 32]
}

// The kernel scan: sum popcount(a[k] XOR b[k]) over 32 bytes.
fun zv_score_pv(a: ^u8, b: ^u8) -> u16 {
    var ham: u16 = 0
    var k: u8 = 0
    while k < 32 {
        ham = ham + u16(zv_pop[a^ xor b^])
        a = a + 1
        b = b + 1
        k = k + 1
    }
    return 256 - ham
}

// 34 scans per rep, like one zvdb top_k pass over the 35-record demo data set.
fun main() -> void {
    var r: u8 = 0
    while r < REPS {
        var j: u8 = 0
        while j < 35 {
            acc = acc + zv_score_pv(zv_vec(0), zv_vec(j))
            j = j + 1
        }
        r = r + 1
    }
}
