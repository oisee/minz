// repro-const-expr.nanz — any non-literal `const` initialiser emits 0
// (task Z1, round 2; scope widened in round 3).
//
//   const P:   u8 = 10            -> P:   DB 10     correct
//   const Q:   u8 = P + 5         -> Q:   DB 0      wrong
//   const LW:  u8 = 36 - 3 - 1    -> LW:  DB 0      wrong, no const referenced
//   const SUM: u8 = 1 + 2         -> SUM: DB 0      wrong, no const referenced
//   const NEG: u8 = 48            -> NEG: DB 48     correct
//
// So the rule is not "a const that references another const": EVERY const whose
// initialiser is not a single literal is emitted as 0, including pure-literal
// arithmetic. The emitted values above are from the .a80 (see below); the
// asserts fail on both backends identically.
//
//   mz repro-const-expr.nanz --assert-receipt --asserts-force mir2 -o /dev/null
//   mz repro-const-expr.nanz --asserts none -o repro.a80 && grep -A1 '^SUM:' repro.a80
//   -> Error: assert "assert getSUM() == 3 via z80": got 0, want 3
//   -> SUM:
//          DB 0
//
// Found in round 2 when the layout widths were first written as const
// expressions: the divider moved to column 0 and puts_padded() with a derived
// width printed nothing, on a program that compiled cleanly and passed every
// assert. A compiler fix scoped to "const referencing const" would leave
// `36 - 3 - 1` broken, so the workaround covers all non-literal forms.
//
// Workaround used by the demo: only literal consts, and every derived width is
// computed at run time in layout_init().

const P: u8 = 10
const Q: u8 = P + 5
const LW: u8 = 36 - 3 - 1
const SUM: u8 = 1 + 2
const NEG: u8 = 48

fun getP() -> u8 {
    return P
}

fun getQ() -> u8 {
    return Q
}

fun getLW() -> u8 {
    return LW
}

fun getSUM() -> u8 {
    return SUM
}

fun getNEG() -> u8 {
    return NEG
}

fun getSumRuntime() -> u8 {
    return 1 + 2
}

assert getP() == 10 via mir2
assert getP() == 10 via z80
assert getNEG() == 48 via mir2
assert getNEG() == 48 via z80
assert getSumRuntime() == 3 via mir2
assert getSumRuntime() == 3 via z80
assert getSUM() == 3 via mir2
assert getSUM() == 3 via z80
assert getLW() == 32 via mir2
assert getLW() == 32 via z80
assert getQ() == 15 via mir2
assert getQ() == 15 via z80
fun main() -> void { }
