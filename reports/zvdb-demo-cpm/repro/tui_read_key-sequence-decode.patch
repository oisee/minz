+// Read one key (blocking).
+// Uses BDOS 1 for blocking console input and decodes VT100 arrow sequences:
+//   ESC [ A/B/C/D  -> KEY_UP/DOWN/RIGHT/LEFT (128..131)
+//   ESC O A/B/C/D  -> same, SS3 form (some terminals and the application keypad)
+// A whole CSI sequence is consumed - parameters (0x30-0x3F), intermediates
+// (0x20-0x2F) and the final byte - so PageUp, Home, Delete, F-keys and friends
+// are swallowed instead of being reported as a stray ESC that quits the caller.
+//   returns 27  for a lone ESC (nothing follows it)
+//   returns 255 for a complete but undecoded sequence
+fun tui_read_key() -> u8 {
+    asm z80 (ret A) (clob all) {
+        ; BDOS 1: blocking console input, char returned in A.
+        LD C, 1
+        CALL 5
+        CP 27              ; ESC?
+        RET NZ
+
+        ; ESC on its own, or the start of a sequence? BDOS 11 (console status)
+        ; tells us whether another byte is already waiting.
+        LD C, 11
+        CALL 5
+        OR A
+        JR Z, .lone
+
+        ; A byte follows ESC: CSI is "ESC [", SS3 is "ESC O".
+        LD C, 1
+        CALL 5
+        CP 91              ; '['
+        JR Z, .csi
+        CP 79              ; 'O'
+        JR Z, .ss3
+        JR .unknown        ; some other two-byte sequence
+
+    .lone:
+        LD A, 27
+        RET
+    .unknown:
+        LD A, 255
+        RET
+
+    ; CSI: consume parameter and intermediate bytes until the final byte
+    ; (0x40-0x7E), then map it to an arrow code.
+    .csi:
+        LD C, 1
+        CALL 5
+        CP 0x40
+        JR NC, .final
+        CP 0x30
+        JR NC, .csi        ; 0x30-0x3F parameter byte
+        CP 0x20
+        JR NC, .csi        ; 0x20-0x2F intermediate byte
+        JR .unknown        ; control byte inside CSI: malformed
+
+    ; SS3: one final byte.
+    .ss3:
+        LD C, 1
+        CALL 5
+        CP 0x40
+        JR NC, .final
+        JR .unknown
+
+    .final:
+        CP 65              ; 'A'
+        JR Z, .up
+        CP 66              ; 'B'
+        JR Z, .down
+        CP 67              ; 'C'
+        JR Z, .right
+        CP 68              ; 'D'
+        JR Z, .left
+        JR .unknown
+
+        .up:
+        LD A, 128
+        RET
+        .down:
+        LD A, 129
+        RET
+        .left:
+        LD A, 130
+        RET
+        .right:
+        LD A, 131
+        RET
+    }
+}
