         JR Z, .up
         CP 66              ; 'B'
@@ -281,8 +323,7 @@ fun tui_read_key() -> u8 {
         JR Z, .right
         CP 68              ; 'D'
         JR Z, .left
-        LD A, 27
-        RET
+        JR .unknown
 
