const REPS: u8 = 250

global acc: u16 = 0

fun zv_vec(i: u8) -> ^u8 {
    return &zv_vecs[u16(i) * 32]
}

// The kernel scan: sum popcount(a[k] XOR b[k]) over 32 bytes.
fun zv_score_pv(a: ^u8, b: ^u8) -> u16 {
    var ham: u16 = 0
    var k: u8 = 0
    while k < 32 {
        ham = ham + u16(zv_pop[a^ xor b^])
        a = a + 1
        b = b + 1
        k = k + 1
    }
    return 256 - ham
}

// The same scan in inline Z80. NOT used by the demo: an asm body cannot be
// evaluated by the MIR2 VM, so `assert ... via mir2` on score/top_k would stop
// working. It is here to measure what the codegen leaves on the table.
//
//   LD A,(DE) / XOR (HL) / LD C,A / LD A,(BC)   one byte, LUT lookup
//   ADD A,IXL / LD IXL,A / JR NC                16-bit accumulate in IX
//   IYL counts 1..32
fun zv_score_pv_asm(va: ^u8, vb: ^u8) -> u16 {
    asm z80 (in va, vb) (ret HL) (clob all) {
        LD BC, zv_pop
        LD IX, 0
        LD IY, 0
    .scan:
        LD A, (DE)
        XOR (HL)
        LD C, A
        LD A, (BC)
        ADD A, IXL
        LD IXL, A
        JR NC, .nc
        INC IXH
    .nc:
        INC HL
        INC DE
        INC IYL
        LD A, IYL
        CP 32
        JR NZ, .scan
        LD A, IXH
        LD D, A
        LD A, IXL
        LD E, A          ; DE = hamming distance
        LD HL, 256
        OR A
        SBC HL, DE       ; HL = 256 - hamming = score
    }
}

// 34 scans per rep, like one zvdb top_k pass over the 35-record demo data set.
fun main() -> void {
    var r: u8 = 0
    while r < REPS {
        var j: u8 = 0
        while j < 35 {
            acc = acc + zv_score_pv_asm(zv_vec(0), zv_vec(j))
            j = j + 1
        }
        r = r + 1
    }
}
