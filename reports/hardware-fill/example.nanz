// Declarative fills: addresses and bounds are resolved at compile time.
import hw.fill

fun clear_bitmap() {
    @fill() {
        layout "zx_bitmap_bytes" 0x4000
        traversal "storage"
        value 0
    }
}

fun paint_panel() {
    @fill() {
        layout "linear" 0x5800 32 24 32
        region 4 3 20 16
        value 0x47
    }
}

fun main() {
    clear_bitmap()
    paint_panel()
}
