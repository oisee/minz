; lookup: params=[A] ret=A (Z3-PFCCO)

; fun lookup(idx: u8 = A) -> u8 = A ; clobbers: F
lookup:
    LD HL, DATA
    LD D, A
    XOR A
.lookup_loop_head1:
    CP D
    LD C, A
    JR NC, .lookup_loop_exit3
.lookup_loop_body2:
    INC HL
    LD C, A
    LD B, 0
    ; trunc BC->C (alias)
