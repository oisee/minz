; fun screen_handle_key(key: u8 = A) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=2,condret-sink=1,cond-rets=1]
screen_handle_key:
    CP 147
    JRS NZ, .screen_handle_key_if_join2
.screen_handle_key_if_then1:
    LD A, 1
    RET
.screen_handle_key_if_join2:
    CP 142
    JRS NZ, .screen_handle_key_if_join4
.screen_handle_key_if_then3:
    LD A, 2
    RET
.screen_handle_key_if_join4:
    CP 27
    JRS NZ, .screen_handle_key_if_join6
.screen_handle_key_if_then5:
    LD A, 2
    RET
.screen_handle_key_if_join6:
    CP 9
    JRS NZ, .screen_handle_key_if_join8
.screen_handle_key_if_then7:
    LD HL, scr_focus
    LD D, (HL)
    LD C, 1
    LD A, D
    ADD A, 1
    LD (scr_focus), A
    LD HL, scr_focus
    LD C, (HL)
    LD HL, scr_nfields
    LD D, (HL)
    LD A, C
    CP D
    JRS C, .screen_handle_key_if_join10
.screen_handle_key_if_then9:
    LD HL, scr_focus
    LD (HL), 0
.screen_handle_key_if_join10:
    LD A, 0
    RET
.screen_handle_key_if_join8:
    CP 13
    LD A, 0
    RET NZ
.screen_handle_key_if_then11:
    LD HL, scr_focus
    LD D, (HL)
    LD A, D
    CP 3
    JRS NZ, .screen_handle_key_if_join14
.screen_handle_key_if_then13:
    LD A, 1
    RET
.screen_handle_key_if_join14:
    LD HL, scr_focus
    LD D, (HL)
    LD A, D
    CP 4
    JRS NZ, .screen_handle_key_if_join16
.screen_handle_key_if_then15:
    LD A, 2
    RET
.screen_handle_key_if_join16:
    LD HL, scr_focus
    LD D, (HL)
    LD A, D
    AND A
    JRS NZ, .screen_handle_key_if_join18
.screen_handle_key_if_then17:
    LD A, 15
    LD C, 2
    ; genCall: tui_goto dst=0
    CALL tui_goto
    LD A, 7
    LD C, 4
    LD B, 1
    ; genCall: tui_color dst=0
    CALL tui_color
    LD HL, buf_material
    LD C, 10
    ; genCall: tui_read_line dst=306
    CALL tui_read_line
    ; genCall: tui_reset dst=0
    CALL tui_reset
.screen_handle_key_if_join18:
    LD HL, scr_focus
    LD D, (HL)
    LD A, D
    CP 1
    JRS NZ, .screen_handle_key_if_join20
.screen_handle_key_if_then19:
    LD A, 15
    LD C, 3
    ; genCall: tui_goto dst=0
    CALL tui_goto
    LD A, 7
    LD C, 4
    LD B, 1
    ; genCall: tui_color dst=0
    CALL tui_color
    LD HL, buf_plant
    LD C, 6
    ; genCall: tui_read_line dst=319
    CALL tui_read_line
    ; genCall: tui_reset dst=0
    CALL tui_reset
.screen_handle_key_if_join20:
    LD A, 0
    RET

; fun screen_show() -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1]
screen_show:
    LD A, 0
.screen_show_loop_head1:
    LD E, A
    ; materialize r321 (pendingAcc)
    LD A, E
    AND A
    LD A, E
    ; restore block param from scratch
    JRS NZ, .screen_show_trmp0
.screen_show_loop_body2:
    ; genCall: screen_render dst=0
    CALL screen_render
    ; genCall: tui_read_key dst=325
    CALL tui_read_key
    ; genCall: screen_handle_key dst=327
    CALL screen_handle_key
    JRS .screen_show_loop_head1
.screen_show_loop_exit3:
    ; genCall: tui_clear dst=0
    PUSH AF
    CALL tui_clear
    POP AF
    LD B, 0
    LD C, 0
    ; genCall: tui_goto dst=0
    PUSH AF
    LD A, B
    CALL tui_goto
    POP AF
    ; genCall: tui_reset dst=0
    PUSH AF
    CALL tui_reset
    POP AF
    RET
.screen_show_trmp0:
    JRS .screen_show_loop_exit3

