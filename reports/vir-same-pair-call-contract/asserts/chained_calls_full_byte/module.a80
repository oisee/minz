; generated by VIR unified solver (Z3-PFCCO + Z3 joint isel+regalloc)
; calling conventions optimized by Z3 SMT solver

; add: params=[A,B] ret=A (Z3-PFCCO)
; mul2: params=[A] ret=A (Z3-PFCCO)
; compute: params=[A] ret=A (Z3-PFCCO)

; fun compute(x: u8 = A) -> u8 = A ; clobbers: F
compute:
    LD D, A
    LD E, 1
    LD A, D
    LD C, E
    PUSH IX
    PUSH IY
    CALL add
    POP IY
    POP IX
    LD L, A
    PUSH IX
    PUSH IY
    CALL mul2
    POP IY
    POP IX
    RET

; fun mul2(x: u8 = A) -> u8 = A ; clobbers: F
mul2:
    ADD A, A
    RET

; fun add(a: u8 = A, b: u8 = C) -> u8 = A ; clobbers: F
add:
    ADD A, C
    RET

