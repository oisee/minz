global board:[u8;25]
fun board_get(x:u8,y:u8)->u8 { return board[y*5+x] }
fun board_set(x:u8,y:u8,v:u8)->void { board[y*5+x]=v }
fun combine(v:u8)->u8 {
 board_set(0,0,v)
 board_set(3,2,9)
 return board_get(0,0)+board_get(3,2)
}
assert combine(0) == 9
assert combine(1) == 10
