; MIR2 module: examples/zx/console_demo.nanz
string @mir2.str.0 = "Hello from MinZ!"
string @mir2.str.1 = "Standalone ZX console"
string @mir2.str.2 = "No ROM calls, no IM1"
string @mir2.str.3 = "Just font data at $3D00"
string @mir2.str.4 = "Score: "
string @mir2.str.5 = "Lives: "
string @mir2.str.6 = "Press any key..."
string @mir2.str.7 = "You pressed: "
