// Hello World for Agon Light 2
// Demonstrates basic MOS API usage
//
// Compile: minzc hello_world.nanz -b ez80 -t agon -o hello.bin
// Run: Load hello.bin on Agon and execute

import stdlib.agon.mos

fun main() {
    // Print greeting using MOS RST 0x18
    mos_puts(c"Hello, Agon Light 2!\r\n")
    mos_puts(c"MinZ running on eZ80 at 18.432 MHz\r\n")

    // Print some formatted output
    mos_puts(c"Press any key to continue...\r\n")

    // Wait for keypress
    let key = getkey()

    // Echo the key pressed
    mos_puts(c"You pressed: ")
    mos_putchar(key)
    newline()

    // Return to MOS
    mos_puts(c"Goodbye!\r\n")
}
