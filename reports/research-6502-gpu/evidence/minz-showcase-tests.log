    m6502_showcase_test.go:127: ; generated by MIR2 6502 codegen
        ;
            .cpu "6502"
            * = $0200

        ; fun abs_diff(a: u8 = A, b: u8 = X) -> u8
        abs_diff:
            STA $F0                    ; Store Accumulator — A → memory
            STX $F1                    ; Store X — X → memory
            LDA $F0                    ; Load Accumulator — value → A register
            CMP $F1                    ; Compare A — sets Z (equal), C (A≥operand), N (sign of A-operand)
            BCS .ct_1                  ; Branch if Carry Set (C=1) — used for 'greater or equal' (unsigned)
            LDA #$00                   ; Load Accumulator — value → A register
            JMP .cd_2                  ; Jump — unconditional jump to absolute address (3 cycles)
        .ct_1:
            LDA #$01                   ; Load Accumulator — value → A register
        .cd_2:
            STA P                      ; Store Accumulator — A → memory
            LDX P                      ; Load X register — value → X
            BNE .a_ge_b                ; Branch if Not Equal (Z=0) — relative jump if last result was non-zero
            JMP .b_gt_a                ; Jump — unconditional jump to absolute address (3 cycles)
        .a_ge_b:
            LDA $F0                    ; Load Accumulator — value → A register
            SEC                        ; Set Carry flag — must precede SBC for clean subtraction
            SBC $F1                    ; Subtract with Borrow — A = A - operand - (1-C)
            RTS                        ; Return from Subroutine — pull PC, jump to PC+1 (6 cycles)
        .b_gt_a:
            LDA $F1                    ; Load Accumulator — value → A register
            SEC                        ; Set Carry flag — must precede SBC for clean subtraction
            SBC $F0                    ; Subtract with Borrow — A = A - operand - (1-C)
            RTS                        ; Return from Subroutine — pull PC, jump to PC+1 (6 cycles)



