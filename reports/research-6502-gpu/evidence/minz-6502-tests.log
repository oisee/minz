        ; fun fib(n: u8 = A) -> u8
        fib:
            STA $F0
            LDX #$00
            LDY #$01
            LDA #$00
            STA $02
            STX $D0
            STY $D1
            LDA $02
            STA $D2
            LDA $F0
            STA $D3
            LDA $D0
            STA $02
            LDY $D2
            LDX $D3
            LDA $D1
        .loop:
            STA $F1
            STY $F2
            STX $F3
            LDA $F2
            CMP $F3
            BEQ .eq_t_1
            BCC .body
            JMP .gt_t_3
        .eq_t_1:
            LDA $02
            JMP .done
        .gt_t_3:
            LDA $02
            JMP .done
        .body:
            LDA $02
            CLC
            ADC $F1
            STA $02
            LDA #$01
            STA $03
            LDA $F2
            CLC
            ADC $03
            TAY
            LDA $F1
            STA $D0
            LDA $02
            STA $D1
            LDA $F3
            STA $D2
            LDA $D0
            STA $02
            LDX $D2
            LDA $D1
            JMP .loop
        .done:
            RTS


