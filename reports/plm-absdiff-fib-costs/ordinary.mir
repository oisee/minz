; MIR2 module: DEMO
fun @ABS_DIFF(%r1: u8 [acc], %r2: u8 [general]) -> u8 [acc]
  block @entry:
    %r3 = cmp.ugt %r1, %r2 : bool [flag]
    br_if %r3, @if_then1(), @if_else3()
  block @if_then1:
    %r4 = sub %r1, %r2 : u8 [acc]
    ret %r4
  block @if_else3:
    %r5 = sub %r2, %r1 : u8 [acc]
    ret %r5

fun @FIB(%r6: u8 [general]) -> u8 [acc]
  block @entry:
    %r7 = const 0 : u8 [general]
    %r8 = const 0 : u8 [general]
    %r9 = const 1 : u8 [general]
    jmp @loop_head1(%r8, %r9, %r6, %r7)
  block @loop_head1(%r8: u8 [general], %r9: u8 [general], %r12: u8 [general], %r7: u8 [general]):
    %r14 = const 0 : u8 [general]
    %r15 = cmp.ugt %r12, %r14 : bool [flag]
    cond_ret %r15, [%r8], @loop_body2()
  block @loop_body2:
    %r16 = add %r8, %r9 : u8 [general]
    %r17 = const 1 : u8 [general]
    %r18 = sub %r12, %r17 : u8 [general]
    jmp @loop_head1(%r9, %r16, %r18, %r9)

