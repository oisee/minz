    LD A, IXH
    CP IXL
    LD A, 1
    RET NC
.region_match_loop_body2:
    PUSH AF
    LD A, IXH
    PUSH AF
    LD A, 0
    LD D, A
    POP AF
    LD E, A
    POP AF
    PUSH HL
    ADD HL, DE
    LD D, H
    LD E, L
    POP HL
    LD A, (DE)
    PUSH AF
    LD A, IXH
    PUSH AF
    LD A, 0
    LD D, A
    POP AF
    LD E, A
    POP AF
    PUSH HL
    PUSH BC
    POP HL
    ADD HL, DE
    LD D, H
    LD E, L
    POP HL
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (DE)
    LD D, A
    EX AF, AF'      ; restore byte-load scratch
    CP D
    JRS Z, .region_match_if_join5
.region_match_if_then4:
    LD A, 0
    RET
.region_match_if_join5:
    LD D, 1
    LD A, IXH
    ADD A, 1
    LD IXH, A
    JRS .region_match_loop_head1

; fun buf_starts_with(buf: ptr = HL, prefix: ptr = DE) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=2,dead-block-arg=1,condret-sink=1,cond-rets=1]
buf_starts_with:
    LD IYH, 0
    LD B, H
    LD C, L
    LD IXH, D
    LD IXL, E
.buf_starts_with_loop_head1:
    PUSH AF
    LD A, IYH
    PUSH AF
    LD A, 0
    LD D, A
    POP AF
    LD E, A
    POP AF
    PUSH IX
    POP HL
    ADD HL, DE
    LD D, (HL)
    LD A, D
    AND A
    LD A, 1
    JRS NZ, .buf_starts_with_trmp0
    RET
.buf_starts_with_loop_body2:
    PUSH AF
    LD A, IYH
    PUSH AF
    LD A, 0
    LD D, A
    POP AF
    LD E, A
    POP AF
    PUSH BC
    POP HL
    ADD HL, DE
    LD D, (HL)
    CP D
    JRS Z, .buf_starts_with_if_join5
.buf_starts_with_if_then4:
    LD A, 0
    RET
.buf_starts_with_if_join5:
    LD D, 1
    LD A, IYH
    ADD A, 1
    LD IYH, A
    JRS .buf_starts_with_loop_head1
.buf_starts_with_trmp0:
    LD A, D
    JRS .buf_starts_with_loop_body2

; fun print_region(buf: ptr = HL, start: u16 = DE, len: u8 = C) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dead-block-arg=1,condret-sink=1,cond-rets=1]
print_region:
    LD A, 0
    PUSH HL
    POP IX
    LD IYH, C
    LD H, D
    LD L, E
.print_region_loop_head1:
    CP IYH
    RET NC
.print_region_loop_body2:
    PUSH HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    POP DE
    LD D, H
    LD E, L
    POP HL
    LD C, A
    LD B, 0
    PUSH HL
    EX DE, HL
    ADD HL, BC
    EX DE, HL
    POP HL
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (DE)
    LD C, A
    EX AF, AF'      ; restore byte-load scratch
    ; genCall: tui__render__tui_putch dst=0
    PUSH AF
    PUSH HL
    PUSH IX
    PUSH IY
    LD A, C
    CALL tui__render__tui_putch
    POP IY
    POP IX
    POP HL
    POP AF
    INC A
    JRS .print_region_loop_head1

; fun print_from(buf: ptr = HL, pos: u16 = DE) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dead-block-arg=1,condret-sink=1,cond-rets=1]
print_from:
    ADD HL, DE
.print_from_loop_head1:
    LD C, (HL)
    LD A, C
    AND A
    RET Z
.print_from_loop_body2:
    LD C, (HL)
    ; genCall: tui__render__tui_putch dst=0
    PUSH HL
    LD A, C
    CALL tui__render__tui_putch
    POP HL
    INC HL
    JRS .print_from_loop_head1

; fun net_send(s: ptr = HL) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dead-block-arg=1,condret-sink=1,cond-rets=1]
net_send:
    LD A, 0
    LD B, H
    LD C, L
.net_send_loop_head1:
    LD E, A
    LD D, 0
    PUSH BC
    POP HL
    ADD HL, DE
    LD D, (HL)
    LD H, A    ; preserve live accumulator before CMP
    LD A, D
    AND A
    LD A, H
    ; restore block param from scratch
    RET Z
.net_send_loop_body2:
    LD E, A
    LD D, 0
    PUSH BC
    POP HL
    ADD HL, DE
    LD D, (HL)
    ; genCall: net_write dst=0
    PUSH AF
    PUSH BC
    LD A, D
    CALL net_write
    POP BC
    POP AF
    INC A
    JRS .net_send_loop_head1

; fun send_from(buf: ptr = HL, offset: u16 = DE) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dead-block-arg=1,condret-sink=1,cond-rets=1]
send_from:
    ADD HL, DE
.send_from_loop_head1:
    LD C, (HL)
    LD A, C
    AND A
    RET Z
.send_from_loop_body2:
    LD C, (HL)
    ; genCall: net_write dst=0
    PUSH HL
    LD A, C
    CALL net_write
    POP HL
    INC HL
    JRS .send_from_loop_head1

; fun send_buf(buf: ptr = HL) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1]
send_buf:
    LD DE, 0
    ; genCall: send_from dst=0
    JP send_from

