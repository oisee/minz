; fun tui__render__tui_read_key() -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
tui__render__tui_read_key:
    ; BDOS 1: blocking console input, char returned in A.
        LD C, 1
        CALL 5
        CP 27              ; ESC?
        RET NZ

        ; Try to decode VT100 escape sequence ESC [ X
        LD C, 1
        CALL 5
        CP 91              ; '['
        LD A, 27
        RET NZ

        LD C, 1
        CALL 5
        CP 65              ; 'A'
        JR Z, .up
        CP 66              ; 'B'
        JR Z, .down
        CP 67              ; 'C'
        JR Z, .right
        CP 68              ; 'D'
        JR Z, .left
        LD A, 27
        RET

        .up:
        LD A, 128
        RET
        .down:
        LD A, 129
        RET
        .left:
        LD A, 130
        RET
        .right:
        LD A, 131
        RET
    RET

; fun tui__render__tui_read_line(buf: ptr = HL, maxlen: u8 = C) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
tui__render__tui_read_line:
    ; HL=buf, C=maxlen
        PUSH HL         ; save buf base
        LD (HL), C      ; buf[0] = maxlen (BDOS header)
        EX DE, HL       ; DE = buf
        LD C, 10
        CALL 5          ; BDOS 0x0A: buffered line input
        ; buf[0]=max, buf[1]=actual, buf[2..]=text
        POP HL          ; HL = buf
        INC HL
        LD A, (HL)      ; A = actual length
        INC HL          ; HL = buf+2 (source)
        PUSH AF         ; save length for return
        ; Copy buf[2..2+len] → buf[0..len] using LDIR
        LD D, H
        LD E, L
        DEC DE
        DEC DE          ; DE = buf (destination)
        LD C, A
        LD B, 0         ; BC = length
        OR A
        JR Z, .done
        LDIR
        .done:
        XOR A
        LD (DE), A      ; null-terminate buf[len]
        POP AF          ; A = actual length
    RET

