.net_connect_cret_else12:
    LD A, C
    CP 4
    LD A, 0
    RET NZ
.net_connect_cret_then13:
    LD A, 4
    RET
.net_connect_trmp0:
    LD C, A
    JRS .net_connect_loop_exit6

