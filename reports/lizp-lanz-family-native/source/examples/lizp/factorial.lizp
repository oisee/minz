;; Factorial in Lizp — tests defun, let, cond, setq, dotimes, arithmetic.

(defglobal result u16)

(defun factorial ((n u8)) -> u16
  (let ((acc u16 1)
        (i u8 0))
    (dotimes (i n)
      (setq acc (* acc (cast (1+ i) u16))))
    (return acc)))

(defun main () -> void
  (set result (call factorial 5))
  (return))
