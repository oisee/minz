global @a : u8
global @b : u8
global @result : u16

fun @abs_diff(%r1: u8 [acc], %r2: u8 [general]) -> u8 [acc]
  block @entry:
    %r3 = sub %r1, %r2 : u8 [general]
    %r4 = cmp.sub_carry %r3, %r2 : bool [flag]
    cond_ret %r4, [%r3], @if_join2()
  block @if_join2:
    %r5 = neg %r3 : u8 [general]
    ret %r5

fun @execute()
  block @entry:
    %r6 = addr_of @a : ptr [pointer]
    %r7 = load %r6 : u8 [acc]
    %r8 = addr_of @b : ptr [pointer]
    %r9 = load %r8 : u8 [general]
    %r10 = call @abs_diff(%r7, %r9) : u8 [acc]
    %r11 = ext %r10 : u8 -> u16 [pointer]
    %r12 = addr_of @result : ptr [pointer]
    store %r12, %r11 : u16
    ret void

