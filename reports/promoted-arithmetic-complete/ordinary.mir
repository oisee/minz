fun @add(%r1: u8 [general], %r2: u8 [general]) -> u8 [acc]
  block @entry:
    %r3 = ext %r1 : u8 -> i16 [pointer]
    %r4 = ext %r2 : u8 -> i16 [pointer]
    %r5 = add %r3, %r4 : i16 [pointer]
    %r6 = trunc %r5 : i16 -> u8 [general]
    ret %r6

