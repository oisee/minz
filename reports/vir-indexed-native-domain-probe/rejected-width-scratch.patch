diff --git a/minzc/pkg/vir/z80.go b/minzc/pkg/vir/z80.go
index 25b7529f..0562611b 100644
--- a/minzc/pkg/vir/z80.go
+++ b/minzc/pkg/vir/z80.go
@@ -639,6 +639,17 @@ func generateZ80Patterns(m *MachineDesc) []Pattern {
 			Template: "", Cost: 10, Bytes: 0,
 			Flags: PatCall}, // treated like a call (has clobbers)
 	}
+	// Prefix-conflicting transfers use A internally, although A is neither
+	// endpoint. Preserve AF in the pattern so all emission paths share its
+	// semantics and the solver accounts for the scratch save.
+	for i := range pats {
+		p := &pats[i]
+		if p.Op == OpMove && strings.Contains(p.Template, "LD A,") && !p.DstLocs.Has(m.LocByName("A")) && !p.SrcLocs[0].Has(m.LocByName("A")) {
+			p.Template = "PUSH AF\n    " + p.Template + "\n    POP AF"
+			p.Cost += 21
+			p.Bytes += 2
+		}
+	}
 	pats = append(pats, generateBitPatterns()...)
 	return pats
 }
