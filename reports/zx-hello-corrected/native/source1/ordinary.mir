; MIR2 module: examples/abap/sap_report_zx.nanz
fun @poke(%r1: u16 [pointer], %r2: u8 [general])
  block @entry:
    asm "; HL=addr, C=val (PFCCO: u16, u8)\n        LD (HL), C"
    ret void

fun @attr_row(%r3: u8 [acc], %r4: u8 [general])
  block @entry:
    asm "; A=row, C=attr\n        LD H, 0\n        LD L, A\n        ADD HL, HL\n        ADD HL, HL\n        ADD HL, HL\n        ADD HL, HL\n        ADD HL, HL\n        LD DE, 0x5800\n        ADD HL, DE\n        LD B, 32\n        .f: LD (HL), C\n        INC HL\n        DJNZ .f"
    ret void

fun @print_at(%r5: u8 [acc], %r6: u8 [general], %r7: ptr [pointer])
  block @entry:
    asm "; A=row, C=col, DE=str (PFCCO: u8, u8, ptr → A, C, DE... actually ptr→HL)\n        ; Wait — PFCCO for (u8, u8, ^u8): first u8→A, second u8→C, ptr→DE?\n        ; Actually for 3 params it depends. Let's handle manually.\n        ; For asm blocks with (in row, col, str): row=A, col=C, str=DE\n        ; But actually the calling convention may put str in HL (first ptr).\n        ; Let's use a simpler approach: pass row*32+col as u16, str as ptr\n        RET  ; stub — we'll use a different approach"
    ret void

fun @fill_cell(%r8: u8 [acc], %r9: u8 [general])
  block @entry:
    asm "PUSH BC\n        LD D, A\n        AND 0x07\n        LD L, A\n        LD H, 0\n        ADD HL, HL\n        ADD HL, HL\n        ADD HL, HL\n        ADD HL, HL\n        ADD HL, HL\n        POP BC\n        LD B, 0\n        ADD HL, BC\n        LD A, D\n        AND 0x18\n        OR 0x40\n        ADD A, H\n        LD H, A\n        LD B, 8\n        .sc: LD (HL), 0xFF\n        INC H\n        DJNZ .sc"
    ret void

