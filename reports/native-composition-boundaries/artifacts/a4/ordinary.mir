; MIR2 module: critic.nanz
fun @a4(%r1: u8 [general], %r2: u8 [general], %r3: u8 [acc]) -> u8 [acc]
  block @entry:
    %r4 = const 1 : u8 [general]
    %r5 = shr %r1, %r4 : u8 [general]
    %r6 = const 1 : u8 [general]
    %r7 = shl %r2, %r6 : u8 [general]
    %r8 = sub %r5, %r7 : u8 [acc]
    %r9 = sub %r3, %r8 : u8 [acc]
    ret %r9

