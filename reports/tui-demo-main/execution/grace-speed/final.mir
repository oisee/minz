; MIR2 module: tui_demo.nanz
string @mir2.str.0 = "COUNT"

extern fun @sel_register_int(%r1: ptr [pointer], %r2: u16 [index])

extern fun @sel_show() -> u8 [acc]

extern fun @sel_get_int(%r3: u8 [acc]) -> u16 [pointer]

fun @main()
  block @entry:
    %r4 = addr_of @@mir2.str.0 : ptr [pointer]
    %r5 = move %r4 : ptr [pointer]
    %r6 = const 42 : u16 [index]
    call @sel_register_int(%r5, %r6)
    %r7 = call @sel_show() : u8 [acc]
    %r8 = const 0 : u8 [acc]
    %r9 = call @sel_get_int(%r8) : u16 [pointer]
    %r10 = trunc %r9 : u16 -> u8 [general]
    %r11 = move %r10 : u8 [acc]
    call @@mir.io.print.u8(%r11)
    ret void

