/* PL/M assert test - compile-time verification */
TEST: DO;

DOUBLE: PROCEDURE (X) BYTE;
    DECLARE X BYTE;
    RETURN X + X;
END DOUBLE;

ADD$BYTES: PROCEDURE (A, B) BYTE;
    DECLARE (A, B) BYTE;
    RETURN A + B;
END ADD$BYTES;

MAX$BYTE: PROCEDURE (A, B) BYTE;
    DECLARE (A, B) BYTE;
    IF A > B THEN RETURN A;
    RETURN B;
END MAX$BYTE;

ASSERT DOUBLE(0) = 0;
ASSERT DOUBLE(5) = 10;
ASSERT DOUBLE(127) = 254;

ASSERT ADD$BYTES(3, 4) = 7;
ASSERT ADD$BYTES(0, 0) = 0;
ASSERT ADD$BYTES(100, 55) = 155;

ASSERT MAX$BYTE(10, 20) = 20;
ASSERT MAX$BYTE(99, 1) = 99;
ASSERT MAX$BYTE(42, 42) = 42;

END TEST;
