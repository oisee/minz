; MIR2 module: TEST
fun @DOUBLE(%r1: u8 [acc]) -> u8 [acc]
  block @entry:
    %r2 = add %r1, %r1 : u8 [acc]
    ret %r2

fun @ADDBYTES(%r3: u8 [acc], %r4: u8 [general]) -> u8 [acc]
  block @entry:
    %r5 = add %r3, %r4 : u8 [acc]
    ret %r5

fun @MAXBYTE(%r6: u8 [acc], %r7: u8 [general]) -> u8 [acc]
  block @entry:
    %r8 = cmp.ugt %r6, %r7 : bool [flag]
    cond_ret %r8, [%r7], @if_then1()
  block @if_then1:
    ret %r6

