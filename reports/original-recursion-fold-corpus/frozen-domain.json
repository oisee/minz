  "semantics": "Explicit for i in lo..hi is ascending half-open per lowerForRange/Book chapter4. range(lo..hi).fold is countdown per Book6; these originals use explicit for, not range iterator. u8 n+1 wraps to0 at n255.",
  "domains": {
    "factorial_rec": "alln0..255, arithmetic modulo65536",
    "factorial_fold": "alln0..255, n255 endwrap means zero iterations returns1",
    "fib_rec": "prefixn0..20 only, exponential largerinputs excluded explicitly",
    "fib_iter": "alln0..255, modulo65536 fib(n)",
    "fib_fold": "alln0..255; n0/n1 emptyloop returns1, otherwisefib(n)",
    "sum_to": "alln0..255; n255 n+1wrap emptyloop returns0",
    "count_in_range": {
      "len": "all0..255",
      "seeds": [
        0,
        1,
        127,
        255
      ],
      "byte_array": "byte(seed+73*i), i=-1..256 guard included",
