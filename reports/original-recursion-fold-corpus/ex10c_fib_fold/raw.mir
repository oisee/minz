; MIR2 module: reports/showcase-src/2026-03-11/ex10c_fib_fold.nanz
fun @fib_fold(%r1: u8 [acc]) -> u16 [pointer]
  block @entry:
    %r2 = const 0 : u8 [general]
    %r3 = ext %r2 : u8 -> u16 [pointer]
    %r4 = const 1 : u8 [general]
    %r5 = ext %r4 : u8 -> u16 [pointer]
