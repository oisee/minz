    jmp @loop_head2(%r1, %r3, %r5, %r6)
  block @loop_head2(%r7: u8 [general], %r8: u16 [pointer], %r9: u16 [pointer], %r10: u8 [general]):
    %r11 = cmp.ult %r10, %r7 : bool [flag]
    br_if %r11, @loop_body3(), @loop_exit4(%r7, %r8, %r9, %r10)
  block @loop_body3:
