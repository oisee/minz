.bool_done_0:
    LD H, A
    POP AF
    LD A, H
    AND A
    PUSH HL
    PUSH AF
    JP NZ, .bool_true_1
.bool_false_1:
    LD A, 0
    JP .bool_done_1
.bool_true_1:
    LD A, 1
.bool_done_1:
    LD C, A
    POP HL
    LD A, H
    POP HL
.append_cond_join6:
    LD A, C
    AND A
    RET Z
.append_loop_body2:
    LD HL, (used)    ; u16 direct load (20T, no A clobber)
    LD BC, 1
    PUSH HL
    POP BC
    INC BC
    LD (used), BC    ; u16 direct store, no scratch clobber
    LD BC, output
    PUSH DE
    LD D, H
    LD E, L
    PUSH BC
    POP HL
    ADD HL, DE
    POP DE
    LD BC, 1
    PUSH DE
    POP BC
    INC BC
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (DE)
    LD D, A
    EX AF, AF'      ; restore byte-load scratch
    LD (HL), D
    LD D, B
    LD E, C
    JRS .append_loop_head1
.append_cond_else5:
    LD C, 0
    JRS .append_cond_join6

; fun record(user: ptr = HL, section: ptr = DE, name: ptr = IY, value: ptr = IX) -> i16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
record:
    ; genCall: append dst=0
    PUSH IX
    PUSH IY
    LD H, D
    LD L, E
    CALL append
    POP IY
    POP IX
    LD HL, _mir2_str_5
    ; genCall: append dst=0
    PUSH IX
    PUSH IY
    CALL append
    POP IY
    POP IX
    ; genCall: append dst=0
    PUSH IX
    PUSH IY
    POP HL
    CALL append
    POP IX
    LD HL, _mir2_str_6
    ; genCall: append dst=0
    PUSH IX
    CALL append
    POP IX
    ; genCall: append dst=0
    PUSH IX
    POP HL
    CALL append
    LD HL, _mir2_str_0
    ; genCall: append dst=0
    CALL append
    LD HL, 1
    RET

; fun execute() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1,dead-block-arg=1]
execute:
    LD DE, 0
.execute_loop_head1:
    LD HL, 256
    PUSH DE
    EX DE, HL
    OR A
    SBC HL, DE
    EX DE, HL
    POP DE
    JRS NC, .execute_loop_exit3
.execute_loop_body2:
    LD HL, output
    ADD HL, DE
    LD (HL), 0
    LD HL, 1
    LD H, D
    LD L, E
    INC HL
    LD D, H
    LD E, L
    JRS .execute_loop_head1
.execute_loop_exit3:
    LD DE, 0
    LD (used), DE    ; u16 direct store, no scratch clobber
    LD HL, input
    LD DE, record
    LD BC, 0
    ; genCall: ini_parse_string dst=981
    CALL ini_parse_string
    LD D, H
    LD E, L
    LD (result), DE    ; u16 direct store, no scratch clobber
    RET

; fun memcpy(dst: ptr = HL, src: ptr = DE, n: u16 = BC) -> ptr = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1,dead-block-arg=1]
memcpy:
    PUSH HL
    POP IX
    LD IYH, D
    LD IYL, E
    LD D, B
    LD E, C
.memcpy_loop_head1:
.memcpy_loop_body2:
    LD BC, -1
    PUSH HL
    LD H, D
    LD L, E
    ADD HL, BC
    PUSH HL
    POP BC
    POP HL
    LD A, 0
    PUSH HL
    PUSH BC
    LD H, D
    LD L, E
    LD C, A
    LD B, 0
    OR A
    SBC HL, BC
    POP BC
    POP HL
    LD D, 0
    PUSH AF
    JP Z, .bool_true_0
.bool_false_0:
    LD A, 0
    JP .bool_done_0
.bool_true_0:
    LD A, 1
.bool_done_0:
    LD E, A
    POP AF
    LD A, E
    AND A
    JRS Z, .memcpy_if_join5
.memcpy_if_then4:
.memcpy_loop_exit3:
    RET
.memcpy_if_join5:
    LD DE, 1
    LD D, IXH
    LD E, IXL
    INC DE
    PUSH HL
    PUSH AF
    LD HL, 1
    LD A, L
    LD (_spill_memcpy_r997), A
    LD A, H
    LD (_spill_memcpy_r997+1), A
    POP AF
    POP HL
    PUSH HL
    PUSH IY
    POP HL
    INC HL
    LD (_spill_memcpy_r998), HL
    POP HL
    LD A, (IY+0)
    LD (IX+0), A
    LD IXH, D
    LD IXL, E
    LD D, B
    LD E, C
    LD IY, (_spill_memcpy_r998)
    JRS .memcpy_loop_head1
; — spill slots for memcpy (1 spills)
_spill_memcpy_r998: DW 0
; — extra spill slots for memcpy (1 rescued)
_spill_memcpy_r997: DB 0, 0

