    LD A, (IY+0)
    LD (IX+0), A
    LD IXH, D
    LD IXL, E
    LD D, B
    LD E, C
    LD IY, (_spill_memcpy_r992)
    JRS .memcpy_loop_head1
; — spill slots for memcpy (1 spills)
_spill_memcpy_r992: DW 0
; — extra spill slots for memcpy (1 rescued)
_spill_memcpy_r991: DB 0, 0

; fun memset(dst: ptr = HL, c: i16 = DE, n: u16 = BC) -> ptr = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1,dead-block-arg=1]
memset:
    PUSH HL
    POP IY
.memset_loop_head1:
    LD IX, -1
    PUSH HL
    PUSH DE
    PUSH BC
    POP HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    POP DE
    PUSH HL
    POP IX
    POP DE
    POP HL
    LD A, 0
    PUSH HL
    LD H, B
    LD L, C
    LD C, A
    LD B, 0
    OR A
    SBC HL, BC
    POP HL
    LD C, 0
    PUSH AF
    JP Z, .bool_true_0
.bool_false_0:
    LD A, 0
    JP .bool_done_0
.bool_true_0:
    LD A, 1
.bool_done_0:
    LD B, A
    POP AF
    LD A, B
    AND A
    JRS Z, .memset_if_join5
.memset_loop_exit3:
    RET
.memset_if_join5:
    LD BC, 1
    LD B, IYH
    LD C, IYL
    INC BC
    LD A, E
    LD (IY+0), A
    LD IYH, B
    LD IYL, C
    LD B, IXH
    LD C, IXL
    JRS .memset_loop_head1

; fun strlen(s: ptr = DE) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dead-block-arg=1,split-join-ret=1,condret-sink=1,cond-rets=1]
strlen:
    LD HL, 0
    LD B, D
    LD C, E
.strlen_loop_head1:
    PUSH HL
    LD D, H
    LD E, L
    PUSH BC
    POP HL
    ADD HL, DE
    LD D, H
    LD E, L
    POP HL
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (DE)
    LD D, A
    EX AF, AF'      ; restore byte-load scratch
    LD A, D
    AND A
    RET Z
.strlen_loop_body2:
    INC HL
    JRS .strlen_loop_head1

; fun strchr(s: ptr = HL, c: i16 = DE) -> ptr = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1]
strchr:
    PUSH HL
    POP IX
    LD H, D
    LD L, E
.strchr_loop_head1:
    LD A, (IX+0)
    PUSH AF
    PUSH AF
    RLCA
    SBC A, A
    LD D, A
    POP AF
    LD E, A
    POP AF
    LD C, L
    PUSH AF
    LD A, C
    PUSH AF
    RLCA
    SBC A, A
    LD B, A
    POP AF
    LD C, A
    POP AF
    LD IYH, A    ; preserve live accumulator before CMP
    PUSH HL
    LD H, D
    LD L, E
    OR A
    SBC HL, BC
    POP HL
    LD A, IYH
    ; restore live-out r1023 from scratch
    JRS NZ, .strchr_if_join5
.strchr_if_then4:
    PUSH IX
    POP HL
    RET
.strchr_if_join5:
    AND A
    LD C, 0
    PUSH AF
    JP Z, .bool_true_0
.bool_false_0:
    LD A, 0
    JP .bool_done_0
.bool_true_0:
    LD A, 1
.bool_done_0:
    LD E, A
    POP AF
    LD A, E
    AND A
    JRS Z, .strchr_if_join7
.strchr_if_then6:
    LD HL, 0
    RET
.strchr_if_join7:
    LD DE, 1
    LD D, IXH
    LD E, IXL
    INC DE
    LD IXH, D
    LD IXL, E
    JRS .strchr_loop_head1

