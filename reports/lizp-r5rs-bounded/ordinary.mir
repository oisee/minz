fun @clamp(%r69: u8 [acc], %r70: u8 [general], %r71: u8 [general]) -> u8 [acc]
  block @entry:
    %r72 = cmp.ult %r69, %r70 : bool [flag]
    br_if %r72, @if_then1(), @if_else3()
  block @if_then1:
