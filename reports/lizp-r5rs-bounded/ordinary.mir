  block @loop_body2:
    %r28 = add %r23, %r23 : u8 [general]
    %r29 = const 1 : u8 [general]
    %r30 = add %r22, %r29 : u8 [general]
    jmp @loop_head1(%r28, %r30, %r26)

fun @triangle(%r31: u8 [acc]) -> u8 [acc]
  block @entry:
    %r32 = const 1 : u8 [general]
    %r33 = add %r31, %r32 : u8 [acc]
    %r34 = mul %r31, %r33 : u8 [general]
    %r35 = const 2 : u8 [general]
    %r36 = div %r34, %r35 : u8 [general]
    ret %r36

fun @is_divisible(%r37: u8 [general], %r38: u8 [general]) -> u8 [acc]
  block @entry:
    %r39 = mod %r37, %r38 : u8 [general]
    %r40 = const 0 : u8 [general]
    %r41 = cmp.eq %r39, %r40 : bool [flag]
    %r42 = const 0 : u8 [general]
    cond_ret %r41, [%r42], @if_then1()
  block @if_then1:
    %r43 = const 1 : u8 [general]
    ret %r43

