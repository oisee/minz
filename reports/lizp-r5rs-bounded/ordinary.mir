; MIR2 module: scheme_r5rs.lizp
fun @sum_loop(%r1: u8 [general]) -> u8 [acc]
  block @entry:
    %r2 = const 0 : u8 [general]
    %r3 = const 0 : u8 [general]
    jmp @loop_head1(%r3, %r2, %r1)
  block @loop_head1(%r3: u8 [general], %r2: u8 [general], %r6: u8 [general]):
    %r7 = cmp.ult %r2, %r6 : bool [flag]
    cond_ret %r7, [%r3], @loop_body2()
  block @loop_body2:
    %r8 = add %r3, %r2 : u8 [general]
    %r9 = const 1 : u8 [general]
    %r10 = add %r2, %r9 : u8 [general]
    jmp @loop_head1(%r8, %r10, %r6)

