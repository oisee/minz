fun @sum_loop(%r1: u8 [acc]) -> u8 [acc]
  block @entry:
    %r2 = const 0 : u8 [general]
    %r3 = const 0 : u8 [general]
    jmp @loop_head1(%r3, %r2, %r1)
  block @loop_head1(%r4: u8 [general], %r5: u8 [general], %r6: u8 [general]):
    %r7 = cmp.ult %r5, %r6 : bool [flag]
    br_if %r7, @loop_body2(), @loop_exit3(%r4, %r5, %r6)
  block @loop_body2:
    %r8 = add %r4, %r5 : u8 [general]
    %r9 = const 1 : u8 [general]
    %r10 = add %r5, %r9 : u8 [general]
    jmp @loop_head1(%r8, %r10, %r6)
  block @loop_exit3(%r11: u8 [general], %r12: u8 [general], %r13: u8 [general]):
    ret %r11

