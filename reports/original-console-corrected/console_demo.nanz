// console_demo.nanz — Demo of standalone ZX console (no ROM calls)
//
// Run:
//   mz examples/zx/console_demo.nanz -o /tmp/console_demo.a80
//   mza /tmp/console_demo.a80 -o /tmp/console_demo.bin
//   mzx --run /tmp/console_demo.bin@8000

import zx.console { * }

fun main() -> void {
    con_init(7, 1)          // white ink on blue paper
    con_clear()

    con_print(c"Hello from MinZ!")
    con_newline()
    con_newline()
    con_print(c"Standalone ZX console")
    con_newline()
    con_print(c"No ROM calls, no IM1")
    con_newline()
    con_print(c"Just font data at $3D00")
    con_newline()
    con_newline()

    con_set_attr(6, 0)      // cyan on black
    con_print(c"Score: ")
    con_print_u16(12345)
    con_newline()

    con_set_attr(3, 0)      // yellow on black
    con_print(c"Lives: ")
    con_print_u8(3)
    con_newline()
    con_newline()

    con_set_attr(7, 1)      // white on blue
    con_print(c"Press any key...")
    let ch: u8 = con_getchar()
    con_newline()
    con_print(c"You pressed: ")
    con_putchar(ch)
    con_newline()
}
