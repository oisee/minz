; fun zx__console__con_show_cursor() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1]
zx__console__con_show_cursor:
    LD HL, zx__console__con_col
    LD C, (HL)
    LD A, C
    LD HL, zx__console__con_row
    LD C, (HL)
    LD B, 95
    ; genCall: zx__console__con_draw_char dst=0
    LD D, C
    LD C, B
    LD B, A
    JP zx__console__con_draw_char

; fun zx__console__con_hide_cursor() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1]
zx__console__con_hide_cursor:
    LD HL, zx__console__con_col
    LD C, (HL)
    LD A, C
    LD HL, zx__console__con_row
    LD C, (HL)
    LD B, 32
    ; genCall: zx__console__con_draw_char dst=0
    LD D, C
    LD C, B
    LD B, A
    JP zx__console__con_draw_char

