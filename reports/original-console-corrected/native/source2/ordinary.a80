; fun zx__console__con_draw_char(col: u8 = B, row: u8 = D, ch: u8 = C) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
zx__console__con_draw_char:
    ; Entry: B=col, D=row, C=ch
        LD IYL, B           ; IYL = col
        LD IYH, D           ; IYH = row

        ; Compute font_ptr = $3D00 + (ch - 32) * 8
        LD A, C             ; A = ch
        SUB 32
        LD L, A
        LD H, 0
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        LD DE, 0x3D00
        ADD HL, DE
        EX DE, HL           ; DE = font_ptr

        ; Draw 8 pixel lines
        LD B, 8
        LD C, 0
    .line_loop:
        PUSH DE
        PUSH BC
        LD A, IYH
        AND 0x18
        OR C
        OR 0x40
        LD H, A
        LD A, IYH
        AND 0x07
        RRCA
        RRCA
        RRCA
        OR IYL
        LD L, A
        POP BC
        POP DE
        LD A, (DE)
        LD (HL), A
        INC DE
        INC C
        DJNZ .line_loop

        ; Set attribute
        LD A, IYH
        RRCA
        RRCA
        RRCA
        LD L, A
        AND 0xE0
        OR IYL
        LD L, A
        LD A, IYH
        RRCA
        RRCA
        RRCA
        AND 0x03
        OR 0x58
        LD H, A
        LD A, (zx__console__con_attr)
        LD (HL), A
    RET

