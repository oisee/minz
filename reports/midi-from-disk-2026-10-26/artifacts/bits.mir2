    %r8 = const 0 : u16 [pointer]
    %r9 = shr %r1, %r8 : u16 [pointer]
    %r10 = const 31 : u16 [pointer]
    %r11 = and %r9, %r10 : u16 [pointer]
    %r12 = trunc %r11 : u16 -> u8 [general]
    %r13 = field %r2, +1 : ptr [pointer]
    store %r13, %r12 : u8
    ret void

fun @kind(%r14: u8 [acc]) -> u8 [acc]
