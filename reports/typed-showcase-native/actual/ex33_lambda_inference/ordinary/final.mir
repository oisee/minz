; MIR2 module: reports/showcase-src/2026-03-15/ex33_lambda_inference.nanz
fun @add_acc(%r1: u8 [acc], %r2: u8 [general]) -> u8 [acc]
  block @entry:
    %r3 = add %r1, %r2 : u8 [acc]
    ret %r3

fun @sum_doubled() -> u8 [acc]
  block @entry:
    %r4 = const 0 : u8 [general]
    %r5 = const 5 : u8 [general]
    jmp @rng_body1(%r5, %r4)
  block @rng_body1(%r6: u8 [counter], %r4: u8 [acc]):
    %r8 = add %r6, %r6 : u8 [acc]
    %r9 = add %r4, %r8 : u8 [acc]
    djnz %r6, @rng_body1(%r9), @rng_exit2(%r9)
  block @rng_exit2(%r9: u8 [acc]):
    ret %r9

