    JRS NC, .tui__render__clear_rect_trmp0
.tui__render__clear_rect_loop_body5:
    LD A, 32
    ; genCall: tui__render__tui_putch dst=0
    PUSH BC
    PUSH DE
    PUSH HL
    CALL tui__render__tui_putch
    POP HL
    POP DE
    POP BC
    LD A, 1
    ADD A, B
    LD B, A
    JRS .tui__render__clear_rect_loop_head4
.tui__render__clear_rect_loop_exit6:
    LD A, 1
    ADD A, L
    LD L, A
    JRS .tui__render__clear_rect_loop_head1
.tui__render__clear_rect_trmp0:
    JRS .tui__render__clear_rect_loop_exit6

; fun tui__render__puts_padded(str: ptr = HL, width: u8 = C) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
tui__render__puts_padded:
    ; HL = str, width = C (PFCCO: ptr→HL, u8→C)
        LD B, C         ; B = remaining width (loop counter)
        LD A, C
        OR A
        RET Z           ; width == 0 → nothing to do
        .loop:
        LD A, (HL)      ; load current char
        OR A
        JR Z, .pad      ; hit null → switch to padding
        ; Print character from string
        LD E, A
        PUSH HL         ; save string pointer
        PUSH BC         ; save width counter
        LD C, 2
        CALL 5
        POP BC
        POP HL
        INC HL          ; advance string pointer
        DJNZ .loop
        RET
        .pad:
        ; Fill remaining width with spaces
        LD E, 32
        PUSH HL         ; save pointer (not advancing, but keep stack balanced)
        PUSH BC         ; save counter
        LD C, 2
        CALL 5
        POP BC
        POP HL
        DJNZ .pad
    RET

; fun sql__sqlite___sql_send_str(str: ptr = HL) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
sql__sqlite___sql_send_str:
    .loop:
        LD A, (HL)
        OUT (0x45), A
        OR A
        RET Z
        INC HL
        JR .loop
    RET

; fun sql__sqlite___sql_recv_str(buf: ptr = HL) -> ptr = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
sql__sqlite___sql_recv_str:
    PUSH HL
        .loop:
        IN A, (0x45)
        LD (HL), A
        OR A
        JR Z, .done
        INC HL
        JR .loop
        .done:
        POP HL
    RET

; fun sql__sqlite__sqlite_open(path: ptr = HL) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
sql__sqlite__sqlite_open:
    LD D, H
    LD E, L
    ; genCall: sql__sqlite___sql_send_str dst=0
    PUSH HL
    LD H, D
    LD L, E
    CALL sql__sqlite___sql_send_str
    POP HL
    LD A, 1
        OUT (0x41), A
        IN A, (0x43)
        LD L, A
        LD H, 0
    RET

; fun sql__sqlite__sqlite_close(db: u16 = HL) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
sql__sqlite__sqlite_close:
    LD A, L
        OUT (0x45), A
        LD A, 2
        OUT (0x41), A
        IN A, (0x43)
    RET

; fun sql__sqlite__sqlite_exec(db: u16 = HL, sql: ptr = DE) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
sql__sqlite__sqlite_exec:
    ; HL=db, DE=sql
        LD A, L
        OUT (0x47), A       ; handle via hi port
        ; Send SQL string from DE
        EX DE, HL           ; HL = sql
        .send:
        LD A, (HL)
        OUT (0x45), A
        OR A
        JR Z, .exec
        INC HL
        JR .send
        .exec:
        LD A, 8
        OUT (0x41), A
        IN A, (0x43)
    RET

; fun sql__sqlite__sqlite_query(db: u16 = HL, sql: ptr = DE) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
sql__sqlite__sqlite_query:
    LD A, L
        OUT (0x47), A       ; handle via hi port
        EX DE, HL
        .send:
        LD A, (HL)
        OUT (0x45), A
        OR A
        JR Z, .qry
        INC HL
        JR .send
        .qry:
        LD A, 3
        OUT (0x41), A
        IN A, (0x43)
        LD L, A
        LD H, 0
    RET

; fun sql__sqlite__sqlite_step(q: u16 = HL) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
sql__sqlite__sqlite_step:
    LD A, L
        OUT (0x45), A
        LD A, 4
        OUT (0x41), A
        IN A, (0x43)
    RET

; fun sql__sqlite__sqlite_column_text(q: u16 = HL, col: u8 = A) -> ptr = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
sql__sqlite__sqlite_column_text:
    ; HL=q, A=col
        PUSH AF
        LD A, L
        OUT (0x45), A
        POP AF
        OUT (0x47), A
        LD A, 5
        OUT (0x41), A
    LD HL, sql__sqlite___sql_buf
    ; genCall: sql__sqlite___sql_recv_str dst=136
    JP sql__sqlite___sql_recv_str

; fun sql__sqlite__sqlite_column_int(q: u16 = HL, col: u8 = A) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
sql__sqlite__sqlite_column_int:
    PUSH AF
        LD A, L
        OUT (0x45), A
        POP AF
        OUT (0x47), A
        LD A, 6
        OUT (0x41), A
        IN A, (0x45)
        LD L, A
        IN A, (0x47)
        LD H, A
    RET

; fun sql__sqlite__sqlite_finalize(q: u16 = HL) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
sql__sqlite__sqlite_finalize:
    LD A, L
        OUT (0x45), A
        LD A, 7
        OUT (0x41), A
        IN A, (0x43)
    RET

; globals
sql__sqlite__SQLITE_OK:
    DB 0
sql__sqlite__SQLITE_ERROR:
