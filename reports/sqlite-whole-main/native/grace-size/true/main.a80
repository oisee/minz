; fun tui__render__tui_read_key() -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
tui__render__tui_read_key:
    ; BDOS 1: blocking console input, char returned in A.
        LD C, 1
        CALL 5
        CP 27              ; ESC?
        RET NZ

        ; Try to decode VT100 escape sequence ESC [ X
        LD C, 1
        CALL 5
        CP 91              ; '['
        LD A, 27
        RET NZ

        LD C, 1
        CALL 5
        CP 65              ; 'A'
        JR Z, .up
        CP 66              ; 'B'
        JR Z, .down
        CP 67              ; 'C'
        JR Z, .right
        CP 68              ; 'D'
        JR Z, .left
        LD A, 27
        RET

        .up:
        LD A, 128
        RET
        .down:
        LD A, 129
        RET
        .left:
        LD A, 130
        RET
        .right:
        LD A, 131
        RET
    RET

