; MIR2 module: erased-callback.lizp
fun @apply(%r1: ptr [pointer], %r2: u8 [general]) -> u8 [acc]
  block @entry:
    %r3 = move %r2 : u8 [acc]
    %r4 = call_indirect %r1(%r3) : u8 [acc]
    ret %r4

fun @word(%r5: u16 [pointer]) -> u16 [pointer]
  block @entry:
    %r6 = const 256 : u16 [pointer]
    %r7 = add %r5, %r6 : u16 [pointer]
    ret %r7

fun @probe(%r8: u8 [general]) -> u8 [acc]
  block @entry:
    %r9 = addr_of @word : ptr [pointer]
    %r10 = move %r9 : ptr [pointer]
    %r11 = call @apply(%r10, %r8) : u8 [acc]
    ret %r11

