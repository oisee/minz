; MIR2 module: wide_compare.nanz
global @a : i32
global @b : i32
global @result : u8

fun @execute()
  block @entry:
    %r1 = addr_of @a : ptr [pointer]
    %r2 = load %r1 : i32 [general]
    %r3 = addr_of @b : ptr [pointer]
    %r4 = load %r3 : i32 [general]
    %r5 = cmp.lt %r2, %r4 : bool [flag]
    %r6 = ext %r5 : bool -> u8 [general]
    %r7 = addr_of @result : ptr [pointer]
    store %r7, %r6 : u8
    ret void

