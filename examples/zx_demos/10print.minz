// 10PRINT Effect - MinZ Idiomatic Version
// Classic maze pattern using zero-cost abstractions
//
// C version uses: for loops, rand(), plot(), drawr()
// MinZ version uses: DJNZ-optimized loops, inline RNG, direct screen access

const ATTR_MEM: u16 = 22528
const SCREEN_MEM: u16 = 16384
const BLUE: u8 = 1

// LFSR random - inlined for zero overhead
global seed: u16 = 0xACE1

@inline
fun rand_bit() -> u8 {
    let bit: u8 = ((seed >> 0) ^ (seed >> 2) ^ (seed >> 3) ^ (seed >> 5)) & 1
    seed = (seed >> 1) | (bit << 15)
    return bit
}

// Plot pixel - direct screen calculation
@inline  
fun plot(x: u8, y: u8) -> void {
    let addr: u16 = SCREEN_MEM
    addr = addr + ((y & 0xC0) << 5)
    addr = addr + ((y & 0x38) << 2)
    addr = addr + ((y & 0x07) << 8)
    addr = addr + (x >> 3)
    let mask: u8 = 0x80 >> (x & 7)
    let ptr: ^u8 = addr
    *ptr = *ptr | mask
}

// Draw diagonals - DJNZ loops for 8 pixels each
@inline
fun draw_slash(x: u8, y: u8) -> void {
    for i in 0..8 { plot(x + i, y + i) }
}

@inline
fun draw_backslash(x: u8, y: u8) -> void {
    for i in 0..8 { plot(x + 7 - i, y + i) }
}

fun clear_screen() -> void {
    let ptr: ^u8 = SCREEN_MEM
    for block in 0..24 {
        for i in 0..255 { *ptr = 0; ptr = ptr + 1 }
    }
}

// Main - nested DJNZ loops for 24x32 grid
fun main() -> void {
    clear_screen()
    
    loop {
        for row in 0..24 {
            let y: u8 = row << 3
            for col in 0..32 {
                let x: u8 = col << 3
                if rand_bit() == 0 { draw_slash(x, y) }
                else { draw_backslash(x, y) }
            }
        }
    }
}
