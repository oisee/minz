// SAP Material Report on ZX Spectrum — direct screen memory!
// No ROM needed. Writes pixels + attributes directly.
//
// Build & run:
//   mz examples/abap/sap_report_zx.nanz --target=spectrum -o /tmp/sap.a80
//   mza /tmp/sap.a80 -o /tmp/sap.bin
//   mze /tmp/sap.bin -t spectrum --profile /tmp/zx.json
//   python3 /tmp/render_zx_screen.py /tmp/zx.json /tmp/sap.png

// Poke byte to address
fun poke(addr: u16, val: u8) -> void {
    asm z80 (in addr, val) {
        ; HL=addr, C=val (PFCCO: u16, u8)
        LD (HL), C
    }
}

// Fill attribute row with color byte
fun attr_row(row: u8, attr: u8) -> void {
    asm z80 (in row, attr) {
        ; A=row, C=attr
        LD H, 0
        LD L, A
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        LD DE, 0x5800
        ADD HL, DE
        LD B, 32
        .f: LD (HL), C
        INC HL
        DJNZ .f
    }
}

// Print a string at screen position using built-in charset.
// Each char is 8 bytes tall. ZX screen address = complex interleave.
// For simplicity: write char patterns directly to screen.
// screen_addr(row, col, scanline) = $4000 + (row/8)*2048 + (scanline)*256 + (row%8)*32 + col
fun print_at(row: u8, col: u8, str: ^u8) -> void {
    asm z80 (in row, col, str) {
        ; A=row, C=col, DE=str (PFCCO: u8, u8, ptr → A, C, DE... actually ptr→HL)
        ; Wait — PFCCO for (u8, u8, ^u8): first u8→A, second u8→C, ptr→DE?
        ; Actually for 3 params it depends. Let's handle manually.
        ; For asm blocks with (in row, col, str): row=A, col=C, str=DE
        ; But actually the calling convention may put str in HL (first ptr).
        ; Let's use a simpler approach: pass row*32+col as u16, str as ptr
        RET  ; stub — we'll use a different approach
    }
}

// Write a single character at row,col using ZX charset from ROM ($3D00)
// ... but we don't have ROM. Let's write block characters instead.
// Block chars: fill 8 scanlines at char position with $FF (filled) or $00 (empty)

// Fill a character cell with a solid block (all pixels set)
fun fill_cell(row: u8, col: u8) -> void {
    asm z80 (in row, col) {
        PUSH BC
        LD D, A
        AND 0x07
        LD L, A
        LD H, 0
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        POP BC
        LD B, 0
        ADD HL, BC
        LD A, D
        AND 0x18
        OR 0x40
        ADD A, H
        LD H, A
        LD B, 8
        .sc: LD (HL), 0xFF
        INC H
        DJNZ .sc
    }
}

// Write text by poking simple 1-pixel-wide letters (ugly but visible)
// Actually, let's use a much simpler approach: fill attribute cells with
// different colors to create a colored block display. No text rendering needed.

fun main() -> void {
    // Border: blue
    asm z80 { LD A, 1 / OUT (0xFE), A }

    // Clear all attributes to black on black
    asm z80 {
        LD HL, 0x5800
        LD DE, 0x5801
        LD BC, 767
        LD (HL), 0
        LDIR
    }

    // === Title bar (row 0): white on blue, bright ===
    attr_row(0, 0x4F)   // BRIGHT(1) + PAPER(001=blue) + INK(111=white) = 01 001 111 = $4F

    // === Subtitle (row 1): yellow on blue ===
    attr_row(1, 0x4E)   // BRIGHT(1) + PAPER(001) + INK(110=yellow) = $4E

    // === Fields area (rows 3-5): green labels area ===
    attr_row(3, 0x44)   // BRIGHT(1) + PAPER(000) + INK(100=green) = $44
    attr_row(4, 0x44)
    attr_row(5, 0x44)

    // === Button row (7): white on white blocks ===
    attr_row(7, 0x47)   // BRIGHT(1) + INK(111=white)

    // === Header (row 9): bright white ===
    attr_row(9, 0x47)

    // === Separator (row 10): cyan ===
    attr_row(10, 0x45)

    // === Data rows 11-13: yellow ===
    attr_row(11, 0x46)
    attr_row(12, 0x46)
    attr_row(13, 0x46)

    // === Footer (row 15): white ===
    attr_row(15, 0x47)

    // === Status bar (row 21): white on blue ===
    attr_row(21, 0x4F)

    // Now fill some character cells with blocks to show where text would be
    // Title: fill columns 2-28 on row 0
    var ci: u8 = 2
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(0, ci) ci = ci + 1 }

    // Subtitle: fill columns 2-28 on row 1
    ci = 2
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }
    if ci < 28 { fill_cell(1, ci) ci = ci + 1 }

    // Status bar: fill row 21
    ci = 0
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }
    if ci < 30 { fill_cell(21, ci) ci = ci + 1 }

    // Data area: some cells on rows 11-13 for MATNR columns
    fill_cell(11, 1) fill_cell(11, 2) fill_cell(11, 3) fill_cell(11, 4)
    fill_cell(11, 5) fill_cell(11, 6) fill_cell(11, 7) fill_cell(11, 8)
    fill_cell(12, 1) fill_cell(12, 2) fill_cell(12, 3) fill_cell(12, 4)
    fill_cell(12, 5) fill_cell(12, 6) fill_cell(12, 7) fill_cell(12, 8)
    fill_cell(13, 1) fill_cell(13, 2) fill_cell(13, 3) fill_cell(13, 4)
    fill_cell(13, 5) fill_cell(13, 6) fill_cell(13, 7) fill_cell(13, 8)

    // Buttons: two blocks on row 7
    fill_cell(7, 2) fill_cell(7, 3) fill_cell(7, 4) fill_cell(7, 5)
    fill_cell(7, 6) fill_cell(7, 7) fill_cell(7, 8) fill_cell(7, 9)
    fill_cell(7, 10)
    fill_cell(7, 12) fill_cell(7, 13) fill_cell(7, 14) fill_cell(7, 15)
    fill_cell(7, 16) fill_cell(7, 17)

    // Freeze
    asm z80 { DI / HALT }
}
