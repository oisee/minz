// Plasma Demo - Simple Working Version
// Beautiful interference patterns on ZX Spectrum

const ATTR_BASE: u16 = 0x5800

global phase: u8 = 0
global sin_table: [u8; 256]
global attr_ptr: u16 = 0x5800

// Triangle wave sine (0-7 range for colors)
fun init_sine() -> void {
    for i in 0..256 {
        let q: u8 = i & 0xC0
        let v: u8 = 0

        if q == 0    { v = (i >> 3) & 7; }
        if q == 0x40 { v = ((127 - i) >> 3) & 7; }
        if q == 0x80 { v = ((i - 128) >> 3) & 7; }
        if q == 0xC0 { v = ((255 - i) >> 3) & 7; }

        sin_table[i] = v
    }
}

fun cls() -> void {
    asm {
        LD HL, 0x4000
        LD DE, 0x4001
        LD BC, 6143
        LD (HL), 0
        LDIR
        LD HL, 0x5800
        LD DE, 0x5801
        LD BC, 767
        LD (HL), 0
        LDIR
    }
}

fun poke(addr: u16, val: u8) -> void {
    asm {
        ; Poke val to addr
        POP HL          ; return addr
        POP DE          ; addr param
        POP BC          ; val in C
        PUSH HL         ; restore return
        LD A, C
        LD (DE), A
    }
}

// Direct plasma rendering
fun render_plasma() -> void {
    var yval: u8 = phase
    var col: u8 = 0
    var ptr: u16 = ATTR_BASE

    for idx in 0..768 {
        let xval: u8 = (col * 8) + phase
        let s1: u8 = sin_table[xval]
        let s2: u8 = sin_table[yval]
        let s3: u8 = sin_table[xval + yval]

        let color: u8 = ((s1 + s2 + s3) & 7) | 0x40

        poke(ptr, color)
        ptr = ptr + 1

        col = col + 1
        if col == 32 {
            col = 0
            yval = yval + 11
        }
    }
}

fun main() -> void {
    asm { DI }
    cls()
    init_sine()
    asm { EI }

    while true {
        asm { HALT }
        phase = phase + 3
        render_plasma()
    }
}
