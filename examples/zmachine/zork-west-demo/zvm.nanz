fun print_text(addr: u32) -> u32 {
    var at: u32 = addr
    var shift: u8 = 0
    var abbrev: u8 = 0
    var escape: u8 = 0
    var high: u16 = 0
    var done: u8 = 0
    while done == 0 {
        let w: u16 = code_word_at(at)
        at = at + 2
        if (w & 32768) != 0 { done = 1 }
        var part: u8 = 0
        while part < 3 {
            if part == 0 { zc = u8((w / 1024) & 31) }
            else if part == 1 { zc = u8((w / 32) & 31) }
            else { zc = u8(w & 31) }
            if abbrev != 0 {
                let table: u16 = word_at(24)
                print_text(u32(word_at(table + (u16(abbrev - 1) * 32 + u16(zc)) * 2)) * 2)
                abbrev = 0
            } else if escape == 1 {
                high = u16(zc) * 32
                escape = 2
            } else if escape == 2 {
                put_zscii(high + u16(zc))
                escape = 0
                shift = 0
            } else if zc == 0 {
                put_zscii(32)
                shift = 0
            }
            else if zc <= 3 {
                abbrev = zc
                shift = 0
            }
            else if zc == 4 { shift = 1 }
            else if zc == 5 { shift = 2 }
            else if shift == 2 {
                if zc == 6 { escape = 1 }
                else if zc == 7 {
                    put_zscii(13)
                    shift = 0
                }
                else {
                    put_zscii(u16(symbol(zc)))
                    shift = 0
                }
            }
            else {
                if shift == 0 { put_zscii(u16(zc) + 91) }
                else if shift == 1 { put_zscii(u16(zc) + 59) }
                shift = 0
            }
            part = part + 1
        }
    }
    return at
}

fun operand(kind: u8) -> u16 {
    if kind == 0 { return next_word() }
    if kind == 1 { return u16(next_byte()) }
    return read_var(next_byte())
}
fun zchar_at(start: u8, length: u8, index: u8) -> u8 {
    var pos: u8 = 0
    var encoded: u8 = 0
    while pos < length {
        let ch: u8 = input[start + pos]
        if ch >= 97 {
            if ch <= 122 {
                if encoded == index { return ch - 91 }
                encoded = encoded + 1
            } else {
                if encoded == index { return 5 }
                encoded = encoded + 1
                if encoded == index { return 6 }
                encoded = encoded + 1
                if encoded == index { return ch / 32 }
                encoded = encoded + 1
                if encoded == index { return ch & 31 }
                encoded = encoded + 1
            }
        } else {
            var code: u8 = 0
            var z: u8 = 8
            while z < 32 {
                if symbol(z) == ch { code = z }
                z = z + 1
            }
            if encoded == index { return 5 }
            encoded = encoded + 1
            if code == 0 {
                if encoded == index { return 6 }
                encoded = encoded + 1
                if encoded == index { return ch / 32 }
                encoded = encoded + 1
                if encoded == index { return ch & 31 }
                encoded = encoded + 1
            } else {
                if encoded == index { return code }
                encoded = encoded + 1
            }
        }
        pos = pos + 1
    }
    return 5
}
fun word_code(start: u8, length: u8, half: u8) -> u16 {
    var result: u16 = 0
    var j: u8 = 0
    while j < 3 {
        result = result * 32 + u16(zchar_at(start, length, half * 3 + j))
        j = j + 1
    }
    if half == 1 { result = result + 32768 }
    return result
}
fun is_separator(ch: u8) -> u8 {
    let dict: u16 = word_at(8)
    var i: u16 = 0
    while i < u16(story[dict]) {
        if story[dict + 1 + i] == ch { return 1 }
        i = i + 1
    }
    return 0
}
fun dictionary_lookup(start: u8, length: u8) -> u16 {
    let dict: u16 = word_at(8)
    let separators: u8 = story[dict]
    let stride: u8 = story[dict + u16(separators) + 1]
    let entries: u16 = magnitude(word_at(dict + u16(separators) + 2))
    let base: u16 = dict + u16(separators) + 4
    let first: u16 = word_code(start, length, 0)
    let second: u16 = word_code(start, length, 1)
    var i: u16 = 0
    while i < entries {
        let at: u16 = base + i * u16(stride)
        if word_at(at) == first {
            if word_at(at + 2) == second { return at }
        }
        i = i + 1
    }
    return 0
}
// Convert UTF-8 input in place before Z3 text buffering/tokenisation.
fun decode_input_utf8(length: u8) -> u8 {
    var src: u16 = 0
    var dst: u16 = 0
    while src < u16(length) {
        let lead: u8 = input[src]
        var code: u16 = u16(lead)
        if lead >= 194 {
            if lead <= 223 {
                if src + 1 < u16(length) {
                    let tail: u8 = input[src + 1]
                    if tail >= 128 {
                        if tail < 192 {
                            code = u16(lead & 31) * 64 + u16(tail & 63)
                            src = src + 1
                        }
                    }
                }
            }
            else if lead <= 239 {
                if src + 2 < u16(length) {
                    let middle: u8 = input[src + 1]
                    let tail: u8 = input[src + 2]
                    if middle >= 128 {
                        if middle < 192 {
                            if tail >= 128 {
                                if tail < 192 {
                                    let decoded: u16 = u16(lead & 15) * 4096 + u16(middle & 63) * 64 + u16(tail & 63)
                                    if decoded >= 2048 {
                                        code = decoded
                                        src = src + 2
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        src = src + 1
        var ch: u8 = 63
        if code < 128 { ch = u8(code) }
        else { ch = z3_lower(z3_from_unicode(code)) }
        input[dst] = ch
        dst = dst + 1
    }
    return u8(dst)
}
fun read_input(text: u16, parse: u16) {
    var n: u8 = 0
    var from_playback: u8 = 0
    if input_mode == 1 {
        let length: u16 = file_read_line(&command_path, &input, story[text], &command_offset)
        if length == 65535 { input_mode = 0 }
        else {
            n = u8(length)
            from_playback = 1
        }
    }
    if from_playback == 0 { n = tui_read_line_or_eof(&input, story[text]) }
    if n == 255 {
        running = 0
        return
    }
    if (story[17] & 1) != 0 {
        var copied: u8 = 0
        while copied < n {
            file_append_byte(&transcript_path, input[copied])
            copied = copied + 1
        }
        file_append_byte(&transcript_path, 13)
    }
    if record_commands != 0 {
        if from_playback == 0 {
            var copied: u8 = 0
            while copied < n {
                file_append_byte(&command_path, input[copied])
                copied = copied + 1
            }
            file_append_byte(&command_path, 10)
        }
    }
    n = decode_input_utf8(n)
    var i: u8 = 0
    while i < n {
        var ch: u8 = input[i]
        if ch >= 65 {
            if ch <= 90 { ch = ch + 32 }
        }
        input[i] = ch
        story[text + u16(i) + 1] = ch
        i = i + 1
    }
    story[text + u16(n) + 1] = 0
    i = 0
    var words: u8 = 0
    while i < n {
        if words >= story[parse] { break }
        if input[i] == 32 { i = i + 1 }
        else {
            let start: u8 = i
            if is_separator(input[i]) != 0 { i = i + 1 }
            else {
                while i < n {
                    if input[i] == 32 { break }
                    if is_separator(input[i]) != 0 { break }
                    i = i + 1
                }
            }
            let length: u8 = i - start
            let entry: u16 = parse + 2 + u16(words) * 4
            put_word(entry, dictionary_lookup(start, length))
            story[entry + 2] = length
            story[entry + 3] = start + 1
            words = words + 1
        }
    }
    story[parse + 1] = words
    steps = 0
}
fun print_error_prefix(code: u8) {
    @print_char(90)
    @print_char(51)
    @print_char(32)
    @print_char(101)
    @print_char(114)
    @print_char(114)
    @print_char(111)
    @print_char(114)
    @print_char(32)
    @print_u8(code)
}
fun fail_opcode(form: u8, op: u8) {
    print_error_prefix(1)
    @print_char(58)
    @print_u8(form)
    @print_char(58)
    @print_u8(op)
    @print_char(58)
    @print_u8(u8(pc >> 16))
    @print_char(58)
    @print_u8(u8(pc / 256))
    @print_char(58)
    @print_u8(u8(pc))
    @print_char(10)
    running = 0
}
fun restart_story() {
    let flags_hi: u8 = story[16]
    let flags_lo: u8 = story[17]
    let capacity: u32 = 131072
    story_size = file_read_bounded(&story_path, &story, capacity)
    if story_size == 0 {
        running = 0
        return
    }
    story[16] = flags_hi
    story[17] = flags_lo
    story[1] = (story[1] & 15) | 16
    globals_at = word_at(12)
    pc = u32(word_at(6))
    frame = 0
    sp = 0
    steps = 0
    random_state = 1
    screen_enabled = 1
    stream3_depth = 0
    input_mode = 0
    record_commands = 0
}
fun snapshot_identity() {
    snapshot[0] = 77
    snapshot[1] = 90
    snapshot[2] = 51
    snapshot[3] = 83
    snapshot[4] = story[2]
    snapshot[5] = story[3]
    var i: u16 = 0
    while i < 6 {
        snapshot[6 + i] = story[18 + i]
        i = i + 1
    }
    snapshot[12] = story[28]
    snapshot[13] = story[29]
    snapshot[14] = story[14]
    snapshot[15] = story[15]
}
fun save_state() -> u8 {
    snapshot_identity()
    snapshot[16] = u8(pc)
    snapshot[17] = u8(pc / 256)
    let bank: u32 = pc >> 16
    snapshot[18] = u8(bank)
    snapshot[19] = frame
    snapshot[20] = u8(sp)
    snapshot[21] = u8(sp / 256)
    snapshot[22] = u8(random_state)
    snapshot[23] = u8(random_state / 256)
    snapshot[24] = screen_enabled
    snapshot[25] = stream3_depth
    var i: u16 = 0
    while i < 16 {
        snapshot[26 + i] = stream3_table_lo[i]
        snapshot[42 + i] = stream3_table_hi[i]
        i = i + 1
    }
    i = 0
    while i < 2048 {
        let offset: u16 = i * 2
        let value: u16 = local_words[i]
        snapshot[58 + offset] = u8(value)
        snapshot[59 + offset] = u8(value / 256)
        i = i + 1
    }
    i = 0
    while i < 128 {
        snapshot[4154 + i] = ret_pc_lo[i]
        snapshot[4282 + i] = ret_pc_hi[i]
        snapshot[4410 + i] = ret_pc_bank[i]
        snapshot[4538 + i] = ret_store[i]
        snapshot[4666 + i] = ret_sp_lo[i]
        snapshot[4794 + i] = ret_sp_hi[i]
        i = i + 1
    }
    i = 0
    while i < 2048 {
        let offset: u16 = i * 2
        let value: u16 = stack_words[i]
        snapshot[4922 + offset] = u8(value)
        snapshot[4923 + offset] = u8(value / 256)
        i = i + 1
    }
    return file_write_pair(&save_path, &snapshot, 9018, &story, word_at(14))
}
fun restore_state() -> u8 {
    snapshot_identity()
    let dynamic_size: u16 = word_at(14)
    let flags_hi: u8 = story[16]
    let flags_lo: u8 = story[17]
    if file_read_pair_checked(&save_path, &snapshot, 9018, &story, dynamic_size) == 0 { return 0 }
    story[16] = flags_hi
    story[17] = flags_lo
    pc = u32(snapshot[16]) + u32(snapshot[17]) * 256
    let top: u32 = u32(snapshot[18]) << 16
    pc = pc + top
    frame = snapshot[19]
    sp = u16(snapshot[20]) + u16(snapshot[21]) * 256
    var i: u16 = 0
    while i < 2048 {
        let offset: u16 = i * 2
        local_words[i] = u16(snapshot[58 + offset]) + u16(snapshot[59 + offset]) * 256
        i = i + 1
    }
    i = 0
    while i < 128 {
        ret_pc_lo[i] = snapshot[4154 + i]
        ret_pc_hi[i] = snapshot[4282 + i]
        ret_pc_bank[i] = snapshot[4410 + i]
        ret_store[i] = snapshot[4538 + i]
        ret_sp_lo[i] = snapshot[4666 + i]
        ret_sp_hi[i] = snapshot[4794 + i]
        i = i + 1
    }
    i = 0
    while i < 2048 {
        let offset: u16 = i * 2
        stack_words[i] = u16(snapshot[4922 + offset]) + u16(snapshot[4923 + offset]) * 256
        i = i + 1
    }
    return 1
}
fun step() {
    let code: u8 = next_byte()
    var form: u8 = 0
    var op: u8 = 0
    var count: u8 = 0
    var a: u16 = 0
    var b: u16 = 0
    var c: u16 = 0
    var d: u16 = 0
    if code < 128 {
        form = 2
        op = code & 31
        if (code & 64) == 0 { a = u16(next_byte()) }
        else { a = read_var(next_byte()) }
        if (code & 32) == 0 { b = u16(next_byte()) }
        else { b = read_var(next_byte()) }
        count = 2
    } else if code < 176 {
        form = 1
        op = code & 15
        let kind: u8 = (code / 16) & 3
        if kind != 3 {
            a = operand(kind)
            count = 1
        }
    } else if code < 192 {
        form = 0
        op = code & 15
    } else {
        if code < 224 { form = 2 } else { form = 3 }
        op = code & 31
        let types: u8 = next_byte()
        var j: u8 = 0
        while j < 4 {
            let kind: u8 = (types >> (6 - j * 2)) & 3
            if kind != 3 {
                let value: u16 = operand(kind)
                if j == 0 { a = value }
                else if j == 1 { b = value }
                else if j == 2 { c = value }
                else { d = value }
                count = count + 1
            }
            j = j + 1
        }
    }
    if form == 0 {
        if op == 0 { finish(1) }
        else if op == 1 { finish(0) }
        else if op == 2 { pc = print_text(pc) }
        else if op == 3 {
            pc = print_text(pc)
            emit_zscii(13)
            finish(1)
        }
        else if op == 4 { }
        else if op == 5 { branch(save_state()) }
        else if op == 6 {
            if restore_state() != 0 { branch(1) }
            else { branch(0) }
        }
        else if op == 7 { restart_story() }
        else if op == 13 { branch(story_verified) }
        else if op == 8 { finish(read_var(0)) }
        else if op == 9 { read_var(0) }
        else if op == 10 { running = 0 }
        else if op == 11 { emit_zscii(13) }
        else if op == 12 { }
        else { fail_opcode(form, op) }
    } else if form == 1 {
        if op == 0 { if a == 0 { branch(1) } else { branch(0) } }
        else if op == 1 {
            let value: u16 = object_sibling(a)
            write_var(next_byte(), value)
            if value == 0 { branch(0) }
            else { branch(1) }
        }
        else if op == 2 {
            let value: u16 = object_child(a)
            write_var(next_byte(), value)
            if value == 0 { branch(0) }
            else { branch(1) }
        }
        else if op == 3 { write_var(next_byte(), object_parent(a)) }
        else if op == 4 { write_var(next_byte(), property_length(a)) }
        else if op == 5 { overwrite_var(u8(a), peek_var(u8(a)) + 1) }
        else if op == 6 { overwrite_var(u8(a), peek_var(u8(a)) - 1) }
        else if op == 7 { print_text(u32(a)) }
        else if op == 9 { remove_object(a) }
        else if op == 10 { print_text(u32(word_at(object_at(a) + 7)) + 1) }
        else if op == 11 { finish(a) }
        else if op == 12 {
            if a >= 32768 {
                let distance: u16 = 0 - a
                pc = pc - u32(distance) - 2
            }
            else { pc = pc + u32(a) - 2 }
        }
        else if op == 13 { print_text(u32(a) * 2) }
        else if op == 14 { write_var(next_byte(), peek_var(u8(a))) }
        else if op == 15 { write_var(next_byte(), a xor 65535) }
        else { fail_opcode(form, op) }
    } else if form == 2 {
        if op == 1 {
            var equal: u8 = 0
            if a == b { equal = 1 }
            if count > 2 { if a == c { equal = 1 } }
            if count > 3 { if a == d { equal = 1 } }
            branch(equal)
        }
        else if op == 2 { branch(signed_less(a, b)) }
        else if op == 3 { branch(signed_less(b, a)) }
        else if op == 4 {
            let value: u16 = peek_var(u8(a)) - 1
            overwrite_var(u8(a), value)
            branch(signed_less(value, b))
        }
        else if op == 5 {
            let value: u16 = peek_var(u8(a)) + 1
            overwrite_var(u8(a), value)
            branch(signed_less(b, value))
        }
        else if op == 6 {
            if object_parent(a) == b { branch(1) }
            else { branch(0) }
        }
        else if op == 7 {
            if (a & b) == b { branch(1) }
            else { branch(0) }
        }
        else if op == 8 { write_var(next_byte(), a | b) }
        else if op == 9 { write_var(next_byte(), a & b) }
        else if op == 10 {
            if (story[attribute_address(a, b)] & attribute_mask(b)) != 0 { branch(1) }
            else { branch(0) }
        }
        else if op == 11 {
            let addr: u16 = attribute_address(a, b)
            story[addr] = story[addr] | attribute_mask(b)
        }
        else if op == 12 {
            let addr: u16 = attribute_address(a, b)
            story[addr] = story[addr] & (attribute_mask(b) xor 255)
        }
        else if op == 13 { overwrite_var(u8(a), b) }
        else if op == 14 { insert_object(a, b) }
        else if op == 15 { write_var(next_byte(), word_at(a + b * 2)) }
        else if op == 16 { write_var(next_byte(), u16(byte_at(a + b))) }
        else if op == 17 { write_var(next_byte(), property_value(a, b)) }
        else if op == 18 { write_var(next_byte(), property_at(a, b)) }
        else if op == 19 { write_var(next_byte(), next_property(a, b)) }
        else if op == 20 { write_var(next_byte(), a + b) }
        else if op == 21 { write_var(next_byte(), a - b) }
        else if op == 22 { write_var(next_byte(), a * b) }
        else if op == 23 { write_var(next_byte(), signed_div(a, b)) }
        else if op == 24 { write_var(next_byte(), signed_mod(a, b)) }
        else { fail_opcode(form, op) }
    } else {
        if op == 0 { enter(a, next_byte(), count - 1, b, c, d) }
        else if op == 1 { put_word(a + b * 2, c) }
        else if op == 2 { story[a + b] = u8(c) }
        else if op == 3 { put_property(a, b, c) }
        else if op == 4 { read_input(a, b) }
        else if op == 5 { put_zscii(a) }
        else if op == 6 { print_num(a) }
        else if op == 7 { write_var(next_byte(), random_number(a)) }
        else if op == 8 { write_var(0, a) }
        else if op == 9 { overwrite_var(u8(a), read_var(0)) }
        else if op == 19 { output_stream(a, b) }
        else if op == 20 {
            if a == 0 { input_mode = 0 }
            else if a == 1 {
                input_mode = 1
                command_offset[0] = 0
                command_offset[1] = 0
                command_offset[2] = 0
                command_offset[3] = 0
            }
        }
        else { fail_opcode(form, op) }
    }
}

fun main() {
    let capacity: u32 = 131072
    story_size = file_read_bounded(&story_path, &story, capacity)
    if story_size == 0 {
        print_error_prefix(2)
        @print_char(10)
        return
    }
    if story[0] != 3 {
        print_error_prefix(2)
        @print_char(10)
        return
    }
    globals_at = word_at(12)
    pc = u32(word_at(6))
    story_verified = verify_story()
    story[1] = (story[1] & 15) | 16
    while running != 0 {
        if steps >= 1000000 {
            print_error_prefix(3)
            @print_char(10)
            running = 0
        }
        else {
            step()
            steps = steps + 1
        }
    }
}
