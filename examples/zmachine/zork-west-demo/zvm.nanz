// Experimental Z-machine v3 core. The story is data; instruction decoding,
// variables, calls and text decoding run in Nanz on MIR2, not in a Go host.
// Run from this directory: mzv -H zvm.nanz
import text.print

@extern fun file_read_bounded(path: ^u8, buf: ^u8, capacity: u32) -> u32
@extern fun file_write_pair(path: ^u8, first: ^u8, first_len: u16, second: ^u8, second_len: u16) -> u8
@extern fun file_read_pair_checked(path: ^u8, first: ^u8, first_len: u16, second: ^u8, second_len: u16) -> u8
@extern fun file_append_byte(path: ^u8, ch: u8) -> u8
@extern fun file_append_utf8(path: ^u8, codepoint: u16) -> u8
@extern fun print_utf8(codepoint: u16) -> void
@extern fun file_read_line(path: ^u8, buf: ^u8, maxlen: u8, offset: ^u8) -> u16
@extern fun tui_read_line_or_eof(buf: ^u8, maxlen: u8) -> u8

global story_path: [u8; 18] = c"zork-west-demo.z3"
global save_path: [u8; 13] = c"zvm-save.dat"
global transcript_path: [u8; 19] = c"zvm-transcript.txt"
global command_path: [u8; 17] = c"zvm-commands.txt"
global number_bytes: [u8; 5]
global number_writer: BufWriter
global number_value: Dec16
global command_offset: [u8; 4]
global snapshot: [u8; 9018]
global input: [u8; 256]
global local_words: [u16; 2048]
global ret_pc_lo: [u8; 128]
global ret_pc_hi: [u8; 128]
global ret_pc_bank: [u8; 128]
global ret_store: [u8; 128]
global ret_sp_lo: [u8; 128]
global ret_sp_hi: [u8; 128]
global stack_words: [u16; 2048]
global pc: u32 = 0
global story_size: u32 = 0
global globals_at: u16 = 0
global frame: u8 = 0
global sp: u16 = 0
global running: u8 = 1
global steps: u32 = 0
global zc: u8 = 0
global random_state: u16 = 1
global story_verified: u8 = 0
global screen_enabled: u8 = 1
global stream3_depth: u8 = 0
global input_mode: u8 = 0
global record_commands: u8 = 0
global stream3_table_lo: [u8; 16]
global stream3_table_hi: [u8; 16]
// Keep the large story allocation last: host-visible pointers are currently
// 16-bit in the Nanz/MIR2 ABI, although array indices can be u32.
global story: [u8; 131072]

fun byte_at(addr: u16) -> u8 { return story[addr] }
fun code_byte_at(addr: u32) -> u8 { return story[addr] }
fun code_word_at(addr: u32) -> u16 {
    return u16(story[addr]) * 256 + u16(story[addr + 1])
}
fun word_at(addr: u16) -> u16 {
    return u16(story[addr]) * 256 + u16(story[addr + 1])
}
fun put_word(addr: u16, value: u16) {
    story[addr] = u8(value / 256)
    story[addr + 1] = u8(value)
}
fun local_at(slot: u16) -> u16 {
    return local_words[slot]
}
fun put_local(slot: u16, value: u16) {
    local_words[slot] = value
}
fun stack_at(slot: u16) -> u16 {
    return stack_words[slot]
}
fun put_stack(slot: u16, value: u16) {
    stack_words[slot] = value
}
fun next_byte() -> u8 {
    let b: u8 = code_byte_at(pc)
    pc = pc + 1
    return b
}
fun next_word() -> u16 {
    let w: u16 = code_word_at(pc)
    pc = pc + 2
    return w
}
fun frame_sp_base() -> u16 {
    if frame == 0 { return 0 }
    return u16(ret_sp_lo[frame]) + u16(ret_sp_hi[frame]) * 256
}
fun read_var(n: u8) -> u16 {
    if n == 0 {
        if sp == frame_sp_base() {
            running = 0
            return 0
        }
        sp = sp - 1
        return stack_at(sp)
    }
    if n < 16 { return local_at(u16(frame) * 16 + u16(n)) }
    return word_at(globals_at + u16(n - 16) * 2)
}
fun peek_var(n: u8) -> u16 {
    if n == 0 {
        if sp == frame_sp_base() {
            running = 0
            return 0
        }
        return stack_at(sp - 1)
    }
    if n < 16 { return local_at(u16(frame) * 16 + u16(n)) }
    return word_at(globals_at + u16(n - 16) * 2)
}
fun write_var(n: u8, value: u16) {
    if n == 0 {
        if sp >= 2048 {
            running = 0
            return
        }
        put_stack(sp, value)
        sp = sp + 1
    } else if n < 16 {
        put_local(u16(frame) * 16 + u16(n), value)
    } else {
        put_word(globals_at + u16(n - 16) * 2, value)
    }
}
fun overwrite_var(n: u8, value: u16) {
    if n == 0 {
        if sp > frame_sp_base() { put_stack(sp - 1, value) }
    } else { write_var(n, value) }
}
fun finish(value: u16) {
    if frame == 0 {
        running = 0
        return
    }
    let store: u8 = ret_store[frame]
    pc = u32(ret_pc_lo[frame]) + u32(ret_pc_hi[frame]) * 256
    let top: u32 = u32(ret_pc_bank[frame]) << 16
    pc = pc + top
    sp = u16(ret_sp_lo[frame]) + u16(ret_sp_hi[frame]) * 256
    frame = frame - 1
    write_var(store, value)
}
fun enter(packed: u16, store: u8, argc: u8, a1: u16, a2: u16, a3: u16) {
    if packed == 0 {
        write_var(store, 0)
        return
    }
    if frame >= 127 {
        running = 0
        return
    }
    frame = frame + 1
    ret_pc_lo[frame] = u8(pc)
    ret_pc_hi[frame] = u8(pc / 256)
    let bank: u32 = pc >> 16
    ret_pc_bank[frame] = u8(bank)
    ret_store[frame] = store
    ret_sp_lo[frame] = u8(sp)
    ret_sp_hi[frame] = u8(sp / 256)
    pc = u32(packed) * 2
    let count: u8 = next_byte()
    var i: u8 = 1
    while i <= count {
        put_local(u16(frame) * 16 + u16(i), next_word())
        i = i + 1
    }
    if argc > 0 { if count > 0 { put_local(u16(frame) * 16 + 1, a1) } }
    if argc > 1 { if count > 1 { put_local(u16(frame) * 16 + 2, a2) } }
    if argc > 2 { if count > 2 { put_local(u16(frame) * 16 + 3, a3) } }
}
fun branch(test: u8) {
    let b: u8 = next_byte()
    var offset: u16 = u16(b & 63)
    if (b & 64) == 0 {
        offset = offset * 256 + u16(next_byte())
        if offset >= 8192 { offset = offset + 49152 }
    }
    if ((b & 128) != 0) == (test != 0) {
        if offset == 0 { finish(0) }
        else if offset == 1 { finish(1) }
        else if offset >= 32768 {
            let distance: u16 = 0 - offset
            pc = pc - u32(distance) - 2
        }
        else { pc = pc + u32(offset) - 2 }
    }
}
fun signed_less(a: u16, b: u16) -> u8 {
    if (a xor 32768) < (b xor 32768) { return 1 }
    return 0
}
fun magnitude(value: u16) -> u16 {
    if value >= 32768 { return 0 - value }
    return value
}
fun signed_div(a: u16, b: u16) -> u16 {
    if b == 0 { return 0 }
    let q: u16 = magnitude(a) / magnitude(b)
    if (a >= 32768) != (b >= 32768) { return 0 - q }
    return q
}
fun signed_mod(a: u16, b: u16) -> u16 {
    if b == 0 { return 0 }
    let r: u16 = magnitude(a) % magnitude(b)
    if a >= 32768 { return 0 - r }
    return r
}
fun random_number(range: u16) -> u16 {
    if range >= 32768 {
        random_state = 0 - range
        return 0
    }
    if range == 0 {
        random_state = 1
        return 0
    }
    let limit: u16 = 65535 - ((65535 % range + 1) % range)
    var sample: u16 = 0
    while true {
        random_state = random_state * 25173 + 13849
        sample = random_state
        if sample <= limit { break }
    }
    return sample % range + 1
}
fun verify_story() -> u8 {
    let length: u32 = u32(word_at(26)) * 2
    if length > story_size { return 0 }
    var checksum: u16 = 0
    var at: u32 = 64
    while at < length {
        checksum = checksum + u16(story[at])
        at = at + 1
    }
    if checksum == word_at(28) { return 1 }
    return 0
}
fun object_at(number: u16) -> u16 {
    if number == 0 { return 0 }
    return word_at(10) + 62 + (number - 1) * 9
}
fun object_parent(number: u16) -> u16 {
    if number == 0 { return 0 }
    return u16(story[object_at(number) + 4])
}
fun object_sibling(number: u16) -> u16 {
    if number == 0 { return 0 }
    return u16(story[object_at(number) + 5])
}
fun object_child(number: u16) -> u16 {
    if number == 0 { return 0 }
    return u16(story[object_at(number) + 6])
}
fun remove_object(number: u16) {
    let parent: u16 = object_parent(number)
    if parent == 0 { return }
    let sibling: u8 = u8(object_sibling(number))
    if object_child(parent) == number {
        story[object_at(parent) + 6] = sibling
    } else {
        var previous: u16 = object_child(parent)
        while previous != 0 {
            if object_sibling(previous) == number {
                story[object_at(previous) + 5] = sibling
                break
            }
            previous = object_sibling(previous)
        }
    }
    story[object_at(number) + 4] = 0
    story[object_at(number) + 5] = 0
}
fun insert_object(number: u16, parent: u16) {
    remove_object(number)
    story[object_at(number) + 4] = u8(parent)
    story[object_at(number) + 5] = u8(object_child(parent))
    story[object_at(parent) + 6] = u8(number)
}
fun attribute_address(number: u16, attribute: u16) -> u16 {
    return object_at(number) + attribute / 8
}
fun attribute_mask(attribute: u16) -> u8 {
    return u8(128 >> (attribute & 7))
}
fun property_list_at(number: u16) -> u16 {
    let table: u16 = word_at(object_at(number) + 7)
    return table + 1 + u16(story[table]) * 2
}
fun property_at(number: u16, property: u16) -> u16 {
    var at: u16 = property_list_at(number)
    while story[at] != 0 {
        let header: u8 = story[at]
        if u16(header & 31) == property { return at + 1 }
        at = at + 2 + u16(header / 32)
    }
    return 0
}
fun property_length(data: u16) -> u16 {
    if data == 0 { return 0 }
    return u16(story[data - 1] / 32) + 1
}
fun property_value(number: u16, property: u16) -> u16 {
    let data: u16 = property_at(number, property)
    if data == 0 { return word_at(word_at(10) + (property - 1) * 2) }
    if property_length(data) == 1 { return u16(story[data]) }
    return word_at(data)
}
fun next_property(number: u16, property: u16) -> u16 {
    if property == 0 { return u16(story[property_list_at(number)] & 31) }
    let data: u16 = property_at(number, property)
    if data == 0 { return 0 }
    return u16(story[data + property_length(data)] & 31)
}
fun put_property(number: u16, property: u16, value: u16) {
    let data: u16 = property_at(number, property)
    if data == 0 {
        running = 0
        return
    }
    if property_length(data) == 1 { story[data] = u8(value) }
    else { put_word(data, value) }
}
fun stream3_table() -> u16 {
    return u16(stream3_table_lo[stream3_depth - 1]) + u16(stream3_table_hi[stream3_depth - 1]) * 256
}
fun emit_zscii(ch: u16) {
    if stream3_depth != 0 {
        let table: u16 = stream3_table()
        let count: u16 = word_at(table)
        story[table + 2 + count] = u8(ch)
        put_word(table, count + 1)
        return
    }
    if ch == 0 { return }
    if (story[17] & 1) != 0 {
        if ch >= 155 {
            if ch <= 223 { file_append_utf8(&transcript_path, z3_unicode(ch)) }
        }
        else { file_append_byte(&transcript_path, u8(ch)) }
    }
    if screen_enabled == 0 { return }
    if ch == 13 { @print_char(10) }
    else if ch >= 32 {
        if ch < 127 { @print_char(u8(ch)) }
        else if ch >= 155 {
            if ch <= 223 { print_utf8(z3_unicode(ch)) }
        }
    }
}
fun put_zscii(ch: u16) { emit_zscii(ch) }
fun output_stream(number: u16, table: u16) {
    switch number {
        case 1:
            screen_enabled = 1
        case 65535:
            screen_enabled = 0
        case 2:
            story[17] = story[17] | 1
        case 65534:
            story[17] = story[17] & 254
        case 3:
            if stream3_depth >= 16 {
                running = 0
                return
            }
            stream3_table_lo[stream3_depth] = u8(table)
            stream3_table_hi[stream3_depth] = u8(table / 256)
            stream3_depth = stream3_depth + 1
            put_word(table, 0)
        case 65533:
            if stream3_depth > 0 { stream3_depth = stream3_depth - 1 }
        case 4:
            record_commands = 1
        case 65532:
            record_commands = 0
    }
}
fun print_num(value: u16) {
    var n: u16 = value
    if n >= 32768 {
        emit_zscii(45)
        n = 0 - n
    }
    number_writer.init(&number_bytes, 5)
    number_value.value = n
    number_value.write_to(&number_writer)
    var i: u16 = 0
    while i < number_writer.len {
        emit_zscii(u16(number_bytes[i]))
        i = i + 1
    }
}
// The A2 alphabet is data in the Z3 specification. Generate its decoder at
// compile time in Nanz, leaving only ordinary typed code in the runtime VM.
fun @z3_symbols() -> void {
    emit(c"fun symbol(z: u8) -> u8 {")
    emit(c"if z >= 8 { if z <= 17 { return z + 40 } }")
    for i in 0..block_len() {
        if str_eq(node_keyword(i), c"glyph") == 1 {
            let code: u8 = node_arg_int(i, 0)
            let ascii: u8 = node_arg_int(i, 1)
            emit(str_concat(c"if z == ", str_concat(str_from_int(code),
                str_concat(c" { return ", str_concat(str_from_int(ascii), c" }")))))
        }
    }
    emit(c"return 41")
    emit(c"}")
}
@z3_symbols() {
    glyph 18 46  // .
    glyph 19 44  // ,
    glyph 20 33  // !
    glyph 21 63  // ?
    glyph 22 95  // _
    glyph 23 35  // #
    glyph 24 39  // '
    glyph 25 34  // double quote
    glyph 26 47  // /
    glyph 27 92  // backslash
    glyph 28 45  // -
    glyph 29 58  // :
    glyph 30 40  // (
    glyph 31 41  // )
}
// Z3 always uses the default Unicode translation table. Keeping its data in
// this Nanz metafunction makes the emitted interpreter independent of the host.
fun @z3_unicode_table() -> void {
    emit(c"fun z3_unicode(ch: u16) -> u16 {")
    for i in 0..block_len() {
        if str_eq(node_keyword(i), c"glyph") == 1 {
            let code: u16 = node_arg_int(i, 0)
            let unicode: u16 = node_arg_int(i, 1)
            emit(str_concat(c"if ch == ", str_concat(str_from_int(code),
                str_concat(c" { return ", str_concat(str_from_int(unicode), c" }")))))
        }
    }
    emit(c"return 63")
    emit(c"}")
    emit(c"fun z3_from_unicode(ch: u16) -> u8 {")
    for i in 0..block_len() {
        if str_eq(node_keyword(i), c"glyph") == 1 {
            let code: u16 = node_arg_int(i, 0)
            let unicode: u16 = node_arg_int(i, 1)
            emit(str_concat(c"if ch == ", str_concat(str_from_int(unicode),
                str_concat(c" { return ", str_concat(str_from_int(code), c" }")))))
        }
    }
    emit(c"return 63")
    emit(c"}")
    emit(c"fun z3_lower(ch: u8) -> u8 {")
    for i in 0..block_len() {
        if str_eq(node_keyword(i), c"lower") == 1 {
            let upper: u8 = node_arg_int(i, 0)
            let lower: u8 = node_arg_int(i, 1)
            emit(str_concat(c"if ch == ", str_concat(str_from_int(upper),
                str_concat(c" { return ", str_concat(str_from_int(lower), c" }")))))
        }
    }
    emit(c"return ch")
    emit(c"}")
}
