! Z-machine Standard 1.1 8.6: upper window is optional, signalled by Flags1 bit5.
[ Main i;
 if ((0->1 & 32)==0) { print "windows unavailable^"; quit; }
 @split_window 2;
 @set_window 1;
 print "UPPER";
 @set_window 0;
 for (i=0:i<25:i++) print "lower^";
 @set_window 1;
 print "RESET";
 @set_window 0;
 print "done^";
 quit;
];
