! Standard1.1 read permits input in any window; upper must not scroll (8.6.2).
Global location = Room;
Global score;
Global turns;
Global window_height = 1;
Global window_choice = 1;
Global input_count = 40;
Array text -> 82;
Array parse -> 10;
Object Room "Input room";
[ Main i;
 text->0=79; parse->0=2;
 @split_window window_height;
 @set_window window_choice;
 print "123456789012345678901234567890";
 @sread text parse;
 for (i=1: i<=input_count: i++) if (text->i~='a') print "bad input";
 if (text->(input_count+1)~=0) print "bad input";
 quit;
];
