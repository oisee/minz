// E2E Test: forEach iterator with DJNZ optimization
// Expected output: ABCDE (newline)
// Run: mz iter_foreach.minz -o t.a80 && mza t.a80 -o t.bin && mzx --run t.bin@8000 --frames DI:HALT --console-io

fun console_log(c: u8) -> void {
    asm {
        OUT ($23), A
    }
}

fun main() -> void {
    asm {
        LD HL, _data
        LD ($F002), HL
    }
    let arr: [u8; 5] = [65, 66, 67, 68, 69];
    arr.forEach(console_log);
    console_log(10);
    asm {
        DI
        HALT
    _data:
        DB 65, 66, 67, 68, 69
    }
}
