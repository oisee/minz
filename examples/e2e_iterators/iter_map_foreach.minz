// E2E Test: map + forEach chain — doubles values then outputs
// Input: [1, 2, 3, 4, 5] -> map(double) -> forEach(console_log)
// Expected output: chr(2) chr(4) chr(6) chr(8) chr(10) = raw bytes 02 04 06 08 0A 0A
// Run: mz iter_map_foreach.minz -o t.a80 && mza t.a80 -o t.bin && mzx --run t.bin@8000 --frames DI:HALT --console-io

fun double(x: u8) -> u8 { return x * 2; }

fun console_log(c: u8) -> void {
    asm {
        OUT ($23), A
    }
}

fun main() -> void {
    asm {
        LD HL, _data
        LD ($F002), HL
    }
    let arr: [u8; 5] = [1, 2, 3, 4, 5]
    arr.map(double).forEach(console_log)
    console_log(10)
    asm {
        DI
        HALT
    _data:
        DB 1, 2, 3, 4, 5
    }
}
