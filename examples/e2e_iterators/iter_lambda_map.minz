// E2E Test: map with lambda — shifts ASCII codes up by 1
// Input: [65, 66, 67, 68, 69] -> map(|x| x + 1) -> forEach(console_log)
// Expected output: BCDEF (each letter shifted +1)
// Run: mz iter_lambda_map.minz -o t.a80 && mza t.a80 -o t.bin && mzx --run t.bin@8000 --frames DI:HALT --console-io

fun console_log(c: u8) -> void {
    asm {
        OUT ($23), A
    }
}

fun main() -> void {
    asm {
        LD HL, _data
        LD ($F002), HL
    }
    let arr: [u8; 5] = [65, 66, 67, 68, 69]
    arr.iter().map(|x| => u8 { x + 1 }).forEach(console_log)
    console_log(10)
    asm {
        DI
        HALT
    _data:
        DB 65, 66, 67, 68, 69
    }
}
