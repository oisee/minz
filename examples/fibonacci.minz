// Fibonacci sequence calculator
fun fibonacci(n: u8) -> u16 {
    if n <= 1 {
        return n
    }
    
    var a: u16 = 0
    var b: u16 = 1
    var i: u8 = 2
    
    while i <= n {
        let temp: u16 = a + b
        a = b
        b = temp
        i = i + 1
    }
    
    return b
}

fun main() -> void {
    // Calculate 10th Fibonacci number
    let result = fibonacci(10)
}