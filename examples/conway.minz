// Conway's Game of Life - Literal port from ZXSpeculator
// Original: https://github.com/oisee/ZXSpeculator/blob/main/Experiments/GameOfLife/Conway.c
// Author: @DeanTheCoder
// zcc +zx -lndos -create-app -o Conway Conway.c

const CELL_SET: u8 = 0      // Black (INK 0)
const CELL_UNSET: u8 = 56   // White paper (PAPER 7)
const ATTR_MEM: u16 = 22528 // ZX Spectrum attribute memory

global grid: [u8; 768]
global backup: [u8; 768]

// Random seed for LFSR
global seed: u8 = 0x42

// Simple LFSR random number generator
fun rand() -> u8 {
    asm {
        ld a, (seed)
        ld b, a
        rrca
        rrca
        rrca
        xor b
        rrca
        xor b
        ld (seed), a
    }
    return seed
}

// Advance one generation
fun advance() -> void {
    // Copy grid to backup
    asm {
        ld hl, grid
        ld de, backup
        ld bc, 768
        ldir
    }

    // Process cells (skip edges: 33 to 735)
    for i in 33..735 {
        // Count neighbors (broken into steps for MinZ)
        let sum: u8 = 0
        sum = sum + backup[i - 33]
        sum = sum + backup[i - 32]
        sum = sum + backup[i - 31]
        sum = sum + backup[i - 1]
        sum = sum + backup[i + 1]
        sum = sum + backup[i + 31]
        sum = sum + backup[i + 32]
        sum = sum + backup[i + 33]

        // Apply Conway's rules
        if backup[i] == 0 {
            // Dead cell: birth if exactly 3 neighbors
            if sum == 3 {
                grid[i] = 1
            } else {
                grid[i] = 0
            }
        } else {
            // Alive cell: survive if 2 or 3 neighbors
            if sum == 2 {
                grid[i] = 1
            } else if sum == 3 {
                grid[i] = 1
            } else {
                grid[i] = 0
            }
        }
    }
}

// Set border color
fun set_border(color: u8) -> void {
    asm {
        ld a, (color)
        out ($FE), a
    }
}

// Clear screen
fun clear_screen() -> void {
    asm {
        ld hl, $4000
        ld de, $4001
        ld bc, 6911
        ld (hl), 0
        ldir
    }
}

// Check if any key pressed
fun key_pressed() -> bool {
    asm {
        xor a
        in a, ($FE)
        cpl
        and $1F
    }
    // Returns non-zero if key pressed
    return false // Placeholder - asm handles it
}

fun main() -> void {
    set_border(6)  // Yellow border
    clear_screen()

    // Initialize grid to zero
    for i in 0..768 {
        grid[i] = 0
    }

    // Seed grid randomly (skip edges)
    for i in 33..735 {
        let r: u8 = rand()
        if r < 128 {
            grid[i] = 1
        } else {
            grid[i] = 0
        }
    }

    // Main loop
    while true {
        // Display grid to attribute memory
        for i in 33..736 {
            let attr_addr: u16 = ATTR_MEM + i
            let value: u8 = 0
            if grid[i] != 0 {
                value = CELL_SET
            } else {
                value = CELL_UNSET
            }
            asm {
                ld hl, (attr_addr)
                ld a, (value)
                ld (hl), a
            }
        }

        // Advance generation
        advance()

        // Small delay
        asm {
            halt
        }
    }
}
