// TUI Hello World for Agon Light 2
//
// Draws a box with "Hello from MinZ on Agon!" using the TUI library.
// Compile: minzc tui_hello.nanz -b ez80 -o tui_hello.bin

import agon.tui_render

fun main() -> void {
    tui_clear()
    tui_color(2, 0, 1)   // bright green on black
    draw_box(5, 3, 40, 7)

    tui_goto(8, 5)
    tui_color(7, 0, 1)   // bright white
    tui_puts(c"Hello from MinZ on Agon!")

    tui_goto(8, 7)
    tui_color(3, 0, 0)   // cyan
    tui_puts(c"eZ80 ADL mode @ 18.432 MHz")

    tui_goto(0, 12)
    tui_reset()
    tui_puts(c"Press any key...")
    tui_read_key()
}
