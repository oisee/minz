// meta_screen.nanz — Level 3 declarative TUI via compile-time metafunction
//
// The @screen metafunction runs on the MIR2 VM at compile time.
// Block nodes are a BlockNode struct array on the VM heap — iterated
// with native Nanz pointer-to-struct `for node: ^BlockNode in nodes[0..n]`.
//
// Run: echo "" | mzv -H examples/nanz/meta_screen.nanz

@extern fun tui_clear() -> void
@extern fun tui_puts(str: ^u8) -> void
@extern fun tui_goto(x: u8, y: u8) -> void
@extern fun tui_color(fg: u8, bg: u8, bright: u8) -> void
@extern fun tui_reset() -> void
@extern fun tui_read_key() -> u8

// ── BlockNode struct: matches 8-byte layout on VM heap ───────
struct BlockNode {
    keyword: ^u8
    label:   ^u8
    value:   ^u8
    length:  u8
    fkey:    u8
}

// ── @screen metafunction ─────────────────────────────────────
//
// Iterates block as ^BlockNode array using native struct pointer
// iteration. No host function calls for field access — just
// node.keyword, node.label, etc.

fun @screen(title: ^u8) -> void {
    emit(c"fun _generated_screen() -> void {")
    emit(c"    tui_clear()")

    // Title bar: white on blue
    emit_tui_color(7, 4, 1)
    emit_tui_goto(0, 0)
    emit_tui_puts(str_concat(c"  ", title))
    emit(c"    tui_reset()")

    // Iterate block nodes as typed struct pointers
    var nodes: ^BlockNode = block_nodes()
    var n: u8 = block_len()
    var row: u8 = 2

    for node: ^BlockNode in nodes[0..n] {
        if str_eq(node.keyword, c"field") == 1 {
            emit_tui_goto(2, row)
            emit_tui_color(6, 0, 0)
            emit_tui_puts(str_concat(node.label, c"    "))
            emit_tui_color(7, 0, 0)
            emit_tui_puts(c"[__________]")
            emit(c"    tui_reset()")
        }

        if str_eq(node.keyword, c"button") == 1 {
            emit_tui_goto(2, row)
            emit_tui_color(0, 7, 1)
            emit_tui_puts(str_concat(c"[", str_concat(node.label, c"]")))
            emit(c"    tui_reset()")
        }

        row = row + 1
    }

    emit(c"    var key: u8 = tui_read_key()")
    emit(c"    tui_clear()")
    emit(c"    tui_reset()")
    emit(c"}")
}

// ── Declarative usage ─────────────────────────────────────────

@screen("Material Report") {
    field "Material"
    field "Plant"
    field "Count"
    button "Execute"
}

fun main() -> void {
    _generated_screen()
}
