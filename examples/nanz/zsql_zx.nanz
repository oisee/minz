    DB $00, $18, $28, $08, $08, $08, $3E, $00
    DB $00, $3C, $42, $02, $3C, $40, $7E, $00
    DB $00, $3C, $42, $0C, $02, $42, $3C, $00
    DB $00, $08, $18, $28, $48, $7E, $08, $00
    DB $00, $7E, $40, $7C, $02, $42, $3C, $00
