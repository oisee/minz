// Self-hosting tokenizer — Nanz tokenizes Nanz source on MZV!
// Uses @file_read host function for source access.
// Arena allocator for token storage.
//
// Run: mzv self_tokenizer.nanz -v

// ── Host functions ──────────────────────────────────────

// ── Token types ─────────────────────────────────────────
// Using constants (enum not needed for self-host MVP)
global TOK_EOF: u8 = 0
global TOK_IDENT: u8 = 1
global TOK_INT: u8 = 2
global TOK_LPAREN: u8 = 3
global TOK_RPAREN: u8 = 4
global TOK_LBRACE: u8 = 5
global TOK_RBRACE: u8 = 6
global TOK_COLON: u8 = 7
global TOK_COMMA: u8 = 8
global TOK_ARROW: u8 = 9
global TOK_EQ: u8 = 10
global TOK_PLUS: u8 = 11
global TOK_MINUS: u8 = 12
global TOK_STAR: u8 = 13
global TOK_SLASH: u8 = 14
global TOK_LT: u8 = 15
global TOK_GT: u8 = 16
global TOK_STRING: u8 = 17
global TOK_KEYWORD: u8 = 18
global TOK_SEMI: u8 = 19

// ── Character classification ────────────────────────────

fun is_digit(c: u8) -> u8 {
    if c >= 48 {
        if c <= 57 { return 1 }
    }
    return 0
}

fun is_alpha(c: u8) -> u8 {
    if c >= 65 {
        if c <= 90 { return 1 }
    }
    if c >= 97 {
        if c <= 122 { return 1 }
    }
    if c == 95 { return 1 }  // underscore
    return 0
}

fun is_alnum(c: u8) -> u8 {
    if is_digit(c) == 1 { return 1 }
    return is_alpha(c)
}

fun is_space(c: u8) -> u8 {
    if c == 32 { return 1 }   // space
    if c == 9 { return 1 }    // tab
    if c == 10 { return 1 }   // newline
    if c == 13 { return 1 }   // CR
    return 0
}

// ── Tokenizer state ─────────────────────────────────────

global src_buf: u16 = 0xC000   // source buffer in high memory
global src_len: u16 = 0
global pos: u16 = 0

// ── Core tokenizer ──────────────────────────────────────

fun peek_char() -> u8 {
    if pos >= src_len { return 0 }
    return peek(src_buf + pos)
}

fun next_char() -> u8 {
    let c: u8 = peek_char()
    pos = pos + 1
    return c
}

fun skip_whitespace() -> void {
    while is_space(peek_char()) == 1 {
        pos = pos + 1
    }
}

fun skip_line_comment() -> void {
    while peek_char() != 10 {
        if peek_char() == 0 { return }
        pos = pos + 1
    }
    pos = pos + 1  // skip newline
}

// Return token type for current position
fun next_token() -> u8 {
    skip_whitespace()
    let c: u8 = peek_char()
    
    if c == 0 { return TOK_EOF }
    
    // Line comment
    if c == 47 {  // '/'
        if peek(src_buf + pos + 1) == 47 {
            skip_line_comment()
            return next_token()  // recursive skip
        }
        pos = pos + 1
        return TOK_SLASH
    }
    
    // Single-char tokens
    if c == 40 { pos = pos + 1
        return TOK_LPAREN }
    if c == 41 { pos = pos + 1
        return TOK_RPAREN }
    if c == 123 { pos = pos + 1
        return TOK_LBRACE }
    if c == 125 { pos = pos + 1
        return TOK_RBRACE }
    if c == 58 { pos = pos + 1
        return TOK_COLON }
    if c == 44 { pos = pos + 1
        return TOK_COMMA }
    if c == 59 { pos = pos + 1
        return TOK_SEMI }
    if c == 43 { pos = pos + 1
        return TOK_PLUS }
    if c == 42 { pos = pos + 1
        return TOK_STAR }
    if c == 60 { pos = pos + 1
        return TOK_LT }
    if c == 62 { pos = pos + 1
        return TOK_GT }
    
    // Arrow ->
    if c == 45 {  // '-'
        if peek(src_buf + pos + 1) == 62 {  // '>'
            pos = pos + 2
            return TOK_ARROW
        }
        pos = pos + 1
        return TOK_MINUS
    }
    
    // == 
    if c == 61 {  // '='
        if peek(src_buf + pos + 1) == 61 {
            pos = pos + 2
            return TOK_EQ
        }
        pos = pos + 1
        return TOK_EQ
    }
    
    // Number
    if is_digit(c) == 1 {
        while is_digit(peek_char()) == 1 {
            pos = pos + 1
        }
        return TOK_INT
    }
    
    // Identifier or keyword
    if is_alpha(c) == 1 {
        while is_alnum(peek_char()) == 1 {
            pos = pos + 1
        }
        return TOK_IDENT
    }
    
    // String literal
    if c == 34 {  // '"'
        pos = pos + 1
        while peek_char() != 34 {
            if peek_char() == 0 { return TOK_EOF }
            pos = pos + 1
        }
        pos = pos + 1  // skip closing quote
        return TOK_STRING
    }
    
    // Unknown — skip
    pos = pos + 1
    return next_token()
}

// ── Test: count tokens in a hardcoded string ────────────

fun count_tokens_in(s: ^u8, len: u16) -> u16 {
    // Copy string to src_buf
    var i: u16 = 0
    while i < len {
        poke(src_buf + i, peek(s + i))
        i = i + 1
    }
    poke(src_buf + len, 0)  // null terminate
    src_len = len
    pos = 0
    
    var count: u16 = 0
    while next_token() != TOK_EOF {
        count = count + 1
    }
    return count
}

// ── Asserts ─────────────────────────────────────────────

// ── Token name for display ──────────────────────────────

fun print_tok_name(tok: u8) -> void {
    if tok == 0 { @print("EOF") }
    if tok == 1 { @print("IDENT") }
    if tok == 2 { @print("INT") }
    if tok == 3 { @print("LPAREN") }
    if tok == 4 { @print("RPAREN") }
    if tok == 5 { @print("LBRACE") }
    if tok == 6 { @print("RBRACE") }
    if tok == 7 { @print("COLON") }
    if tok == 8 { @print("COMMA") }
    if tok == 9 { @print("ARROW") }
    if tok == 10 { @print("EQ") }
    if tok == 11 { @print("PLUS") }
    if tok == 12 { @print("MINUS") }
    if tok == 13 { @print("STAR") }
    if tok == 14 { @print("SLASH") }
    if tok == 17 { @print("STRING") }
    if tok == 19 { @print("SEMI") }
}

// ── Print token text from source ────────────────────────

// ── Main: tokenize hardcoded source and print tokens ────

fun tokenize_buffer(len: u16) -> u16 {
    src_len = len
    pos = 0
    var count: u16 = 0
    var tok: u8 = next_token()
    while tok != TOK_EOF {
        print_tok_name(tok)
        @print(" ")
        count = count + 1
        tok = next_token()
    }
    return count
}

fun main() -> void {
    // Hardcode tiny source: "fun add(a: u8) -> u8 { return a + a }"
    // ASCII: fun=102,117,110 add=97,100,100 etc
    poke(src_buf, 102) poke(src_buf+1, 117) poke(src_buf+2, 110)  // fun
    poke(src_buf+3, 32)                                             // space
    poke(src_buf+4, 97) poke(src_buf+5, 100) poke(src_buf+6, 100)  // add
    poke(src_buf+7, 40)                                             // (
    poke(src_buf+8, 97)                                             // a
    poke(src_buf+9, 58)                                             // :
    poke(src_buf+10, 32)                                            // space
    poke(src_buf+11, 117) poke(src_buf+12, 56)                     // u8
    poke(src_buf+13, 41)                                            // )
    poke(src_buf+14, 32)                                            // space
    poke(src_buf+15, 45) poke(src_buf+16, 62)                      // ->
    poke(src_buf+17, 32)                                            // space
    poke(src_buf+18, 117) poke(src_buf+19, 56)                     // u8
    poke(src_buf+20, 32)                                            // space
    poke(src_buf+21, 123)                                           // {
    poke(src_buf+22, 32)                                            // space
    poke(src_buf+23, 97)                                            // a
    poke(src_buf+24, 32)                                            // space
    poke(src_buf+25, 43)                                            // +
    poke(src_buf+26, 32)                                            // space
    poke(src_buf+27, 97)                                            // a
    poke(src_buf+28, 32)                                            // space
    poke(src_buf+29, 125)                                           // }
    poke(src_buf+30, 0)                                             // null

    @print("Tokenizing: fun add(a: u8) -> u8 { a + a }")
    @print_nl()
    let count: u16 = tokenize_buffer(30)
    @print_nl()
    @print("Tokens: ")
    @print_u8(count)
    @print_nl()
}

// ── Asserts ─────────────────────────────────────────────

assert is_digit(48) == 1 via mir2
assert is_digit(57) == 1 via mir2
assert is_digit(65) == 0 via mir2
assert is_alpha(65) == 1 via mir2
assert is_alpha(48) == 0 via mir2
assert is_alpha(95) == 1 via mir2
assert is_space(32) == 1 via mir2
assert is_space(65) == 0 via mir2
