// Both return values must be checked by the assertion judges.
fun divmod(a: u8, b: u8) -> (u8, u8) {
    var q: u8 = 0
    var r: u8 = a
    while r >= b {
        r = r - b
        q = q + 1
    }
    return (q, r)
}
assert divmod(17, 5) == (3, 2) via mir2
assert divmod(17, 5) == (3, 2) via z80
// Same quotient, different remainder: controls mutate only the last value.
assert divmod(19, 5) == (3, 4) via mir2
assert divmod(19, 5) == (3, 4) via z80
