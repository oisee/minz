// zvdb_demo_cpm.nanz — zvdb master-detail vector-similarity demo for CP/M
//
// In the spirit of zvdb (ABAP vector DB, https://github.com/oisee/zvdb-z80):
// 35 sentence embeddings quantised to 256 bits by random-hyperplane hashing,
// searched by brute force with a 256-byte popcount LUT.
//
// Layout: master list on the left, top-K nearest *other* records on the right,
// full label of the selection under the title, search cost in the status line.
// Only what changed is redrawn after each keypress; the screen is never
// cleared outside startup and shutdown.
//
// Build:  mz examples/nanz/zvdb_demo_cpm.nanz -t cpm -o zvdb_demo_cpm.com
// Run:    mze zvdb_demo_cpm.com -t cpm
// Headless: printf 'jjjkq' | mze zvdb_demo_cpm.com -t cpm --cpm-no-echo
//          (always end a key script with q: mze's BDOS 1 returns 0 at EOF and
//           the demo ignores keys it does not know, so it would never exit)
//
// I/O is stdlib/tui/render.nanz (BDOS + VT100) — the same layer tetris_cpm.nanz
// uses. The similarity kernel lives in zvdb_kernel.nanz and is asserted there.

import tui.render
import zvdb_demo_data
import zvdb_kernel

// ── Screen layout ────────────────────────────────────────────────────────────
// Everything is derived from these constants: a ZX Spectrum port sets
// SCR_W = 51 / SCR_H = 24, an Agon port picks its own numbers, and the panes
// follow. Only these constants encode the 80-column assumption.

const SCR_W: u8 = 80          // terminal columns
const SCR_H: u8 = 24          // terminal rows

const ROW_TITLE: u8 = 0       // application title
const ROW_LABEL: u8 = 1       // full label of the selected record
const ROW_HEAD: u8 = 2        // pane column headers
const ROW_ITEMS: u8 = 3       // first item row of both panes
const N_ROWS: u8 = 19         // visible rows per pane == K nearest shown
const ROW_SEP: u8 = 22        // horizontal rule above the status line
const ROW_STATUS: u8 = 23     // key help + cost of the last search

const LEFT_X: u8 = 0          // master pane origin
const LEFT_W: u8 = 36         // master pane width
const SEP_X: u8 = 36          // vertical rule column
const RIGHT_X: u8 = 38        // detail pane origin
const RIGHT_W: u8 = 42        // detail pane width

const IDX_W: u8 = 2           // record index field
const SCORE_W: u8 = 3         // score field (0..256)
const LABEL_L_W: u8 = 32      // master label field, one column short of the divider
const LABEL_R_W: u8 = 35      // detail label field  = RIGHT_W - IDX_W - 1 - SCORE_W

// ── Keys (tui_read_key maps ESC [ A/B to 128/129) ───────────────────────────

const KEY_UP: u8 = 128
const KEY_DOWN: u8 = 129
const KEY_ESC: u8 = 27
const KEY_J: u8 = 106         // down
const KEY_K: u8 = 107         // up
const KEY_Q: u8 = 113         // quit

// ── Colours ──────────────────────────────────────────────────────────────────

const FG_CYAN: u8 = 6
const FG_WHITE: u8 = 7
const FG_YELLOW: u8 = 3
const FG_BLACK: u8 = 0
const BG_BLUE: u8 = 4
const BG_CYAN: u8 = 6
const BG_BLACK: u8 = 0

// ── State ────────────────────────────────────────────────────────────────────

global cursor: u8 = 0         // selected record
global top: u8 = 0            // first visible record in the master pane
global last_scan: u8 = 0      // records walked by the last search
global old_row: u8 = 0        // master row the cursor just left
global numbuf: [u8; 6]        // zv_fmt_u16 scratch

// ── Small output helpers, layered on stdlib/tui/render ──────────────────────

// ESC [ ? 25 l  — hide the cursor while the screen is live.
fun ui_cursor_hide() -> void {
    tui_putch(27)
    tui_putch(91)
    tui_putch(63)
    tui_putch(50)
    tui_putch(53)
    tui_putch(108)
}

// ESC [ ? 25 h  — show it again on exit.
fun ui_cursor_show() -> void {
    tui_putch(27)
    tui_putch(91)
    tui_putch(63)
    tui_putch(50)
    tui_putch(53)
    tui_putch(104)
}

// n spaces.
fun ui_put_spaces(n: u8) -> void {
    var i: u8 = 0
    while i < n {
        tui_putch(32)
        i = i + 1
    }
}

// val right-aligned in a width-wide field.
fun ui_put_num(val: u16, width: u8) -> void {
    var n: u8 = zv_fmt_u16(val, &numbuf)
    ui_put_spaces(width - n)
    tui_puts(&numbuf)
}

// Blank field of exactly width columns.
fun ui_put_blank(width: u8) -> void {
    ui_put_spaces(width)
}

// ── Static chrome ────────────────────────────────────────────────────────────

fun draw_title() -> void {
    tui_color(FG_BLACK, BG_CYAN, 1)
    tui_goto(0, ROW_TITLE)
    puts_padded(c" zvdb - vector similarity on Z80 (CP/M)  records:", 52)
    ui_put_num(u16(zv_n), 3)
    puts_padded(c"  quantised: 256 bits", 25)
}

fun draw_sep() -> void {
    tui_color(FG_CYAN, BG_BLUE, 0)
    tui_goto(0, ROW_SEP)
    tui_puts(c"--------------------------------------------------------------------------------")
}

fun draw_status() -> void {
    tui_color(FG_BLACK, BG_CYAN, 0)
    tui_goto(0, ROW_STATUS)
    puts_padded(c" j/k or UP/DN move   q/ESC quit   last search:", 46)
    ui_put_num(u16(last_scan), 3)
    puts_padded(c" recs", 5)
    // 46 + 3 + 5 = 54; pad the rest of the line
    ui_put_blank(SCR_W - 54)
}

// Row 1: the selection's full label (longest label is 61 chars, so it always
// fits; the truncation is kept so other data sets cannot overflow the row).
fun draw_label_line() -> void {
    tui_color(FG_WHITE, BG_BLUE, 1)
    tui_goto(0, ROW_LABEL)
    puts_padded(c"Rec ", 4)
    ui_put_num(u16(cursor), 2)
    puts_padded(c": ", 2)
    puts_padded(zv_label(cursor), SCR_W - 8)
}

// ── Master pane (left) ───────────────────────────────────────────────────────

fun draw_head() -> void {
    tui_color(FG_YELLOW, BG_BLUE, 1)
    tui_goto(LEFT_X, ROW_HEAD)
    puts_padded(c"#   record", LEFT_W)
    tui_putch(124)             // pane divider at SEP_X
    tui_goto(RIGHT_X, ROW_HEAD)
    puts_padded(c"#  scr  nearest records", RIGHT_W)
}

// One master row: `top + row`, highlighted when it is the cursor row.
fun draw_master_row(row: u8) -> void {
    var idx: u8 = top + row
    tui_goto(LEFT_X, ROW_ITEMS + row)
    if idx < zv_n {
        if idx == cursor {
            tui_color(FG_BLACK, BG_CYAN, 1)
        } else {
            tui_color(FG_CYAN, BG_BLUE, 0)
        }
        ui_put_num(u16(idx), IDX_W)
        tui_putch(32)
        puts_padded(zv_label(idx), LABEL_L_W)
        tui_putch(124)         // pane divider at SEP_X
    } else {
        tui_color(FG_CYAN, BG_BLUE, 0)
        ui_put_blank(LEFT_W)
        tui_putch(124)
    }
}

fun draw_master_all() -> void {
    var row: u8 = 0
    while row < N_ROWS {
        draw_master_row(row)
        row = row + 1
    }
}

// ── Detail pane (right): top K nearest other records ────────────────────────

fun draw_detail_all() -> void {
    var row: u8 = 0
    while row < N_ROWS {
        tui_goto(RIGHT_X, ROW_ITEMS + row)
        if row < zv_rank_count() {
            if row == 0 {
                tui_color(FG_WHITE, BG_BLACK, 1)
            } else {
                tui_color(FG_WHITE, BG_BLACK, 0)
            }
            var idx: u8 = zv_rank_index(row)
            ui_put_num(u16(idx), IDX_W)
            tui_putch(32)
            ui_put_num(zv_rank_score(row), SCORE_W)
            tui_putch(32)
            puts_padded(zv_label(idx), LABEL_R_W)
        } else {
            tui_color(FG_WHITE, BG_BLACK, 0)
            ui_put_blank(RIGHT_W)
        }
        row = row + 1
    }
}

// ── Search ───────────────────────────────────────────────────────────────────

// Brute force over every record (see zvdb_kernel.zv_top_k). The T-state cost is
// not printed: mze reports whole-process T-states only, which the program
// cannot read back, so the status line sticks to the record count.
fun do_search() -> void {
    zv_top_k(cursor)
    last_scan = zv_n
}

fun draw_all() -> void {
    draw_title()
    draw_label_line()
    draw_head()
    draw_sep()
    draw_master_all()
    draw_detail_all()
    draw_status()
}

// ── Main ─────────────────────────────────────────────────────────────────────

fun main() -> void {
    tui_clear()
    ui_cursor_hide()
    do_search()
    draw_all()
    tui_reset()

    var running: u8 = 1
    while running != 0 {
        var key: u8 = tui_read_key()
        var moved: u8 = 0
        var scrolled: u8 = 0

        if (key == KEY_DOWN) | (key == KEY_J) {
            if cursor + 1 < zv_n {
                old_row = cursor - top
                cursor = cursor + 1
                if cursor >= top + N_ROWS {
                    top = top + 1
                    scrolled = 1
                }
                moved = 1
                if scrolled == 0 {
                    draw_master_row(old_row)
                    draw_master_row(cursor - top)
                }
            }
        }
        if (key == KEY_UP) | (key == KEY_K) {
            if cursor > 0 {
                old_row = cursor - top
                cursor = cursor - 1
                if cursor < top {
                    top = cursor
                    scrolled = 1
                }
                moved = 1
                if scrolled == 0 {
                    draw_master_row(old_row)
                    draw_master_row(cursor - top)
                }
            }
        }
        if key == KEY_Q {
            running = 0
        }
        if key == KEY_ESC {
            running = 0
        }

        if moved != 0 {
            if scrolled != 0 {
                draw_master_all()
            }
            do_search()
            draw_label_line()
            draw_detail_all()
            draw_status()
            tui_reset()
        }
    }

    tui_reset()
    ui_cursor_show()
    tui_clear()
}

// ── Kernel asserts through this module's imports ────────────────────────────
// Same dual-backend convention as zvdb_kernel.nanz: the values below are the
// Python reference's numbers for this data set (examples/zvdb_demo_expected.txt).

assert zv_score(0, 1) == 214 via mir2
assert zv_score(0, 1) == 214 via z80
assert zv_score(0, 0) == 256 via mir2
assert zv_score(0, 0) == 256 via z80
assert zv_top_count(0) == 34 via mir2
assert zv_top_count(0) == 34 via z80
assert zv_top_index(0, 0) == 1 via mir2
assert zv_top_index(0, 0) == 1 via z80
assert zv_top_score(0, 0) == 214 via mir2
assert zv_top_score(0, 0) == 214 via z80
assert zv_top_index(0, 1) == 3 via mir2
assert zv_top_index(0, 1) == 3 via z80
assert zv_top_index(34, 0) == 25 via mir2
assert zv_top_index(34, 0) == 25 via z80
