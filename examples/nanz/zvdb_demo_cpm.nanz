// zvdb_demo_cpm.nanz — zvdb master-detail vector-similarity demo for CP/M
//
// In the spirit of zvdb (ABAP vector DB, https://github.com/oisee/zvdb-z80):
// 35 sentence embeddings quantised to 256 bits by random-hyperplane hashing,
// searched by brute force with a 256-byte popcount LUT.
//
// Layout: master list on the left, top-K nearest *other* records on the right,
// full label of the selection under the title, search cost in the status line.
// Only what changed is redrawn after each keypress; the screen is never
// cleared outside startup and shutdown.
//
// Build:  mz examples/nanz/zvdb_demo_cpm.nanz -t cpm -o zvdb_demo_cpm.com
// Run:    mze zvdb_demo_cpm.com -t cpm
// Headless: printf 'jjjkq' | mze zvdb_demo_cpm.com -t cpm --cpm-no-echo
//          (always end a key script with q: mze's BDOS 1 returns 0 at EOF and
//           the demo ignores keys it does not know, so it would never exit)
//
// I/O is stdlib/tui/render.nanz (BDOS + VT100) — the same layer tetris_cpm.nanz
// uses. The similarity kernel lives in zvdb_kernel.nanz and is asserted there.

import tui.render
import zvdb_demo_data
import zvdb_kernel

// ── Screen layout ────────────────────────────────────────────────────────────
// A port edits the *literal* constants below (SCR_W, SCR_H, LEFT_W, GAP_W,
// N_ROWS and the field widths); layout_init() derives every other width from
// them at startup, so no other line encodes the 80-column assumption.
//
// The derived values cannot be `const` expressions: `const X: u8 = LEFT_W - 1`
// compiles but silently reads back as 0 on both backends — see
// reports/zvdb-demo-cpm/repro/repro-const-expr.nanz. Hence runtime globals.
//
// Constraints: SCR_W > LEFT_W + GAP_W + IDX_W + SCORE_W + 2, and
// SCR_H >= ROW_ITEMS + N_ROWS + 2. A ZX Spectrum port sets SCR_W = 51 with
// LEFT_W = 24 and gets sep_x 24, right_x 26, label fields 20 and 17 wide.

const SCR_W: u8 = 80          // terminal columns
const SCR_H: u8 = 24          // terminal rows
const LEFT_X: u8 = 0          // master pane origin
const LEFT_W: u8 = 36         // master pane width (per-port choice)
const GAP_W: u8 = 2           // blank columns between divider and detail pane
const N_ROWS: u8 = 19         // visible rows per pane == K nearest shown
const IDX_W: u8 = 3           // record index field, 0..254
const SCORE_W: u8 = 3         // score field, 0..256
const NUM_W: u8 = 3           // record-count field in the title/status rows

const ROW_TITLE: u8 = 0       // application title
const ROW_LABEL: u8 = 1       // full label of the selected record
const ROW_HEAD: u8 = 2        // pane column headers
const ROW_ITEMS: u8 = 3       // first item row of both panes

// Derived once by layout_init(). The title and status rows are
// [head literal][number][tail], with the head field exactly as wide as its own
// literal so the text stays contiguous and the tail field absorbing the rest of
// the row. SCR_W must therefore be at least 49 columns (the status literal plus
// NUM_W); the narrowest target, the ZX Spectrum's 51, clears it.
global sep_x: u8 = 0          // pane divider column = LEFT_X + LEFT_W
global right_x: u8 = 0        // detail pane origin
global right_w: u8 = 0        // detail pane width
global row_sep: u8 = 0        // rule above the status line
global row_status: u8 = 0     // key help + cost of the last search
global label_l_w: u8 = 0      // master label field
global label_r_w: u8 = 0      // detail label field
global label_w: u8 = 0        // label field on ROW_LABEL ("Rec " + IDX_W + ": ")
global title_head_w: u8 = 0   // width of the title head literal
global title_tail_w: u8 = 0   // title tail field, absorbs the remainder
global status_head_w: u8 = 0  // width of the status head literal
global status_tail_w: u8 = 0  // status tail field, absorbs the remainder

fun layout_init() -> void {
    sep_x = LEFT_X + LEFT_W
    right_x = sep_x + GAP_W
    right_w = SCR_W - right_x
    row_sep = ROW_ITEMS + N_ROWS
    row_status = SCR_H - 1
    label_l_w = LEFT_W - IDX_W - 1
    label_r_w = right_w - IDX_W - SCORE_W - 2
    label_w = SCR_W - 6 - IDX_W
    title_head_w = 46   // " zvdb - Z80 vector similarity (CP/M)  records:"
    title_tail_w = SCR_W - title_head_w - NUM_W
    status_head_w = 46   // " j/k or UP/DN move   q/ESC quit   last search:"
    status_tail_w = SCR_W - status_head_w - NUM_W
}

// ── Keys (tui_read_key maps ESC [ A/B to 128/129) ───────────────────────────

const KEY_UP: u8 = 128
const KEY_DOWN: u8 = 129
const KEY_ESC: u8 = 27
const KEY_J: u8 = 106         // down
const KEY_K: u8 = 107         // up
const KEY_Q: u8 = 113         // quit

// ── Colours ──────────────────────────────────────────────────────────────────

const FG_CYAN: u8 = 6
const FG_WHITE: u8 = 7
const FG_YELLOW: u8 = 3
const FG_BLACK: u8 = 0
const BG_BLUE: u8 = 4
const BG_CYAN: u8 = 6
const BG_BLACK: u8 = 0

// ── State ────────────────────────────────────────────────────────────────────

global cursor: u8 = 0         // selected record
global top: u8 = 0            // first visible record in the master pane
global last_scan: u8 = 0      // records walked by the last search
global numbuf: [u8; 6]        // zv_fmt_u16 scratch

// ── Small output helpers, layered on stdlib/tui/render ──────────────────────

// ESC [ ? 25 l  — hide the cursor while the screen is live.
fun ui_cursor_hide() -> void {
    tui_putch(27)
    tui_putch(91)
    tui_putch(63)
    tui_putch(50)
    tui_putch(53)
    tui_putch(108)
}

// ESC [ ? 25 h  — show it again on exit.
fun ui_cursor_show() -> void {
    tui_putch(27)
    tui_putch(91)
    tui_putch(63)
    tui_putch(50)
    tui_putch(53)
    tui_putch(104)
}

// n spaces.
fun ui_put_spaces(n: u8) -> void {
    var i: u8 = 0
    while i < n {
        tui_putch(32)
        i = i + 1
    }
}

// val right-aligned in a width-wide field. A value wider than the field is
// printed unpadded rather than wrapping: u8 arithmetic would make
// `width - n` underflow to ~255 spaces and destroy the screen (this is exactly
// what happened for record indices >= 100 when IDX_W was 2).
fun ui_put_num(val: u16, width: u8) -> void {
    var n: u8 = zv_fmt_u16(val, &numbuf)
    if n < width {
        ui_put_spaces(width - n)
    }
    tui_puts(&numbuf)
}

// ── Static chrome ────────────────────────────────────────────────────────────

fun draw_title() -> void {
    tui_color(FG_BLACK, BG_CYAN, 1)
    tui_goto(0, ROW_TITLE)
    puts_padded(c" zvdb - Z80 vector similarity (CP/M)  records:", title_head_w)
    ui_put_num(u16(zv_n), NUM_W)
    puts_padded(c"  256-bit hyperplanes", title_tail_w)
}

fun draw_sep() -> void {
    tui_color(FG_CYAN, BG_BLUE, 0)
    tui_goto(0, row_sep)
    var i: u8 = 0
    while i < SCR_W {
        tui_putch(5)          // BOX_H -> '-'
        i = i + 1
    }
}

fun draw_status() -> void {
    tui_color(FG_BLACK, BG_CYAN, 0)
    tui_goto(0, row_status)
    puts_padded(c" j/k or UP/DN move   q/ESC quit   last search:", status_head_w)
    ui_put_num(u16(last_scan), NUM_W)
    puts_padded(c" recs scanned", status_tail_w)
}

// Row 1: the selection's full label, truncated to the row. "Rec " + IDX_W
// digits + ": " is 6 + IDX_W columns, so the label gets the rest.
fun draw_label_line() -> void {
    tui_color(FG_WHITE, BG_BLUE, 1)
    tui_goto(0, ROW_LABEL)
    puts_padded(c"Rec ", 4)
    ui_put_num(u16(cursor), IDX_W)
    puts_padded(c": ", 2)
    puts_padded(zv_label(cursor), label_w)
}

// ── Master pane (left) ───────────────────────────────────────────────────────

fun draw_head() -> void {
    tui_color(FG_YELLOW, BG_BLUE, 1)
    tui_goto(LEFT_X, ROW_HEAD)
    puts_padded(c"#   record", LEFT_W)
    tui_putch(124)             // divider: column LEFT_X + LEFT_W = sep_x
    tui_goto(right_x, ROW_HEAD)
    puts_padded(c"#  scr  nearest records", right_w)
}

// One master row: `top + row`, highlighted when it is the cursor row.
fun draw_master_row(row: u8) -> void {
    var idx: u8 = top + row
    tui_goto(LEFT_X, ROW_ITEMS + row)
    if idx < zv_n {
        if idx == cursor {
            tui_color(FG_BLACK, BG_CYAN, 1)
        } else {
            tui_color(FG_CYAN, BG_BLUE, 0)
        }
        ui_put_num(u16(idx), IDX_W)
        tui_putch(32)
        puts_padded(zv_label(idx), label_l_w)
        tui_putch(124)         // divider: column LEFT_X + LEFT_W = sep_x
    } else {
        tui_color(FG_CYAN, BG_BLUE, 0)
        ui_put_spaces(LEFT_W)
        tui_putch(124)
    }
}

fun draw_master_all() -> void {
    var row: u8 = 0
    while row < N_ROWS {
        draw_master_row(row)
        row = row + 1
    }
}

// ── Detail pane (right): top K nearest other records ────────────────────────

fun draw_detail_all() -> void {
    var row: u8 = 0
    while row < N_ROWS {
        tui_goto(right_x, ROW_ITEMS + row)
        if row < zv_rank_count() {
            if row == 0 {
                tui_color(FG_WHITE, BG_BLACK, 1)
            } else {
                tui_color(FG_WHITE, BG_BLACK, 0)
            }
            var idx: u8 = zv_rank_index(row)
            ui_put_num(u16(idx), IDX_W)
            tui_putch(32)
            ui_put_num(zv_rank_score(row), SCORE_W)
            tui_putch(32)
            puts_padded(zv_label(idx), label_r_w)
        } else {
            tui_color(FG_WHITE, BG_BLACK, 0)
            ui_put_spaces(right_w)
        }
        row = row + 1
    }
}

// ── Search ───────────────────────────────────────────────────────────────────

// Brute force over every record (see zvdb_kernel.zv_top_k). The T-state cost is
// not printed: mze reports whole-process T-states only, which the program
// cannot read back, so the status line sticks to the record count.
fun do_search() -> void {
    zv_top_k(cursor)
    last_scan = zv_n
}

fun draw_all() -> void {
    draw_title()
    draw_label_line()
    draw_head()
    draw_sep()
    draw_master_all()
    draw_detail_all()
    draw_status()
}

// ── Main ─────────────────────────────────────────────────────────────────────

fun main() -> void {
    layout_init()
    tui_clear()
    ui_cursor_hide()
    do_search()
    draw_all()
    tui_reset()

    var running: u8 = 1
    while running != 0 {
        var key: u8 = tui_read_key()
        var moved: u8 = 0
        var scrolled: u8 = 0

        if (key == KEY_DOWN) | (key == KEY_J) {
            if cursor + 1 < zv_n {
                let old_row: u8 = cursor - top
                cursor = cursor + 1
                if cursor >= top + N_ROWS {
                    top = top + 1
                    scrolled = 1
                }
                moved = 1
                if scrolled == 0 {
                    draw_master_row(old_row)
                    draw_master_row(cursor - top)
                }
            }
        }
        if (key == KEY_UP) | (key == KEY_K) {
            if cursor > 0 {
                let old_row: u8 = cursor - top
                cursor = cursor - 1
                if cursor < top {
                    top = cursor
                    scrolled = 1
                }
                moved = 1
                if scrolled == 0 {
                    draw_master_row(old_row)
                    draw_master_row(cursor - top)
                }
            }
        }
        // Real CP/M console input never returns 0, so this only fires when the
        // host reports end of input (mze at EOF) and stops a key script without
        // a trailing q from spinning forever.
        if key == 0 {
            running = 0
        }
        if key == KEY_Q {
            running = 0
        }
        if key == KEY_ESC {
            running = 0
        }

        if moved != 0 {
            if scrolled != 0 {
                draw_master_all()
            }
            do_search()
            draw_label_line()
            draw_detail_all()
            draw_status()
            tui_reset()
        }
    }

    tui_reset()
    ui_cursor_show()
    tui_clear()
}

// ── Kernel asserts through this module's imports ────────────────────────────
// Same dual-backend convention as zvdb_kernel.nanz: the values below are the
// Python reference's numbers for this data set (examples/zvdb_demo_expected.txt).

assert zv_score(0, 1) == 214 via mir2
assert zv_score(0, 1) == 214 via z80
assert zv_score(0, 0) == 256 via mir2
assert zv_score(0, 0) == 256 via z80
assert zv_top_count(0) == 34 via mir2
assert zv_top_count(0) == 34 via z80
assert zv_top_index(0, 0) == 1 via mir2
assert zv_top_index(0, 0) == 1 via z80
assert zv_top_score(0, 0) == 214 via mir2
assert zv_top_score(0, 0) == 214 via z80
assert zv_top_index(0, 1) == 3 via mir2
assert zv_top_index(0, 1) == 3 via z80
assert zv_top_index(34, 0) == 25 via mir2
assert zv_top_index(34, 0) == 25 via z80
