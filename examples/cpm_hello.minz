// CP/M Hello World - Minimal Version
// Uses direct assembly for guaranteed correctness

fun main() -> void {
    // Print "Hi!" followed by newline
    asm {
        ; Print 'H'
        LD E, 'H'
        LD C, 2
        CALL 5

        ; Print 'i'
        LD E, 'i'
        LD C, 2
        CALL 5

        ; Print '!'
        LD E, '!'
        LD C, 2
        CALL 5

        ; Print CR
        LD E, 13
        LD C, 2
        CALL 5

        ; Print LF
        LD E, 10
        LD C, 2
        CALL 5

        ; Print "Press key..."
        LD E, 'P'
        LD C, 2
        CALL 5
        LD E, 'r'
        LD C, 2
        CALL 5
        LD E, 'e'
        LD C, 2
        CALL 5
        LD E, 's'
        LD C, 2
        CALL 5
        LD E, 's'
        LD C, 2
        CALL 5
        LD E, ' '
        LD C, 2
        CALL 5
        LD E, 'k'
        LD C, 2
        CALL 5
        LD E, 'e'
        LD C, 2
        CALL 5
        LD E, 'y'
        LD C, 2
        CALL 5
        LD E, '.'
        LD C, 2
        CALL 5
        LD E, '.'
        LD C, 2
        CALL 5
        LD E, '.'
        LD C, 2
        CALL 5

        ; Wait for key
        LD C, 1
        CALL 5
        ; Key is now in A

        ; Print newline
        PUSH AF     ; Save key
        LD E, 13
        LD C, 2
        CALL 5
        LD E, 10
        LD C, 2
        CALL 5
        POP AF      ; Restore key

        ; Print the key
        LD E, A
        LD C, 2
        CALL 5
    }
}
