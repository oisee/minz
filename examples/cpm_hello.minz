// CP/M Hello World Example
// Demonstrates basic CP/M BDOS console I/O
//
// To compile: minzc cpm_hello.minz -o hello.com
// To run: Load in CP/M and type HELLO

import cpm.bdos;

fun main() -> void {
    // Print hello message
    bdos.putchar('H');
    bdos.putchar('e');
    bdos.putchar('l');
    bdos.putchar('l');
    bdos.putchar('o');
    bdos.putchar(',');
    bdos.putchar(' ');
    bdos.putchar('C');
    bdos.putchar('P');
    bdos.putchar('/');
    bdos.putchar('M');
    bdos.putchar('!');
    bdos.newline();

    // Show current drive
    let drive = bdos.get_drive();
    bdos.putchar('D');
    bdos.putchar('r');
    bdos.putchar('i');
    bdos.putchar('v');
    bdos.putchar('e');
    bdos.putchar(':');
    bdos.putchar(' ');
    bdos.putchar(65 + drive);  // 'A' + drive number
    bdos.newline();

    // Show CP/M version
    let ver = bdos.get_version();
    let major = (ver >> 4) & 0x0F;
    let minor = ver & 0x0F;
    bdos.putchar('C');
    bdos.putchar('P');
    bdos.putchar('/');
    bdos.putchar('M');
    bdos.putchar(' ');
    bdos.putchar(48 + major as u8);  // '0' + major
    bdos.putchar('.');
    bdos.putchar(48 + minor as u8);  // '0' + minor
    bdos.newline();

    // Wait for keypress
    bdos.putchar('P');
    bdos.putchar('r');
    bdos.putchar('e');
    bdos.putchar('s');
    bdos.putchar('s');
    bdos.putchar(' ');
    bdos.putchar('a');
    bdos.putchar('n');
    bdos.putchar('y');
    bdos.putchar(' ');
    bdos.putchar('k');
    bdos.putchar('e');
    bdos.putchar('y');
    bdos.putchar('.');
    bdos.putchar('.');
    bdos.putchar('.');

    let ch = bdos.getchar();
    bdos.newline();

    bdos.putchar('Y');
    bdos.putchar('o');
    bdos.putchar('u');
    bdos.putchar(' ');
    bdos.putchar('p');
    bdos.putchar('r');
    bdos.putchar('e');
    bdos.putchar('s');
    bdos.putchar('s');
    bdos.putchar('e');
    bdos.putchar('d');
    bdos.putchar(':');
    bdos.putchar(' ');
    bdos.putchar(ch);
    bdos.newline();
}
