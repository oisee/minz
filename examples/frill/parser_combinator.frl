(* Parser Combinator — functional parsing on Z80!
 *
 * Pure functions that parse byte streams.
 * Each parser returns: result (u8) or error code.
 * Combinators compose small parsers into larger ones.
 *
 * Compile: mz parser_combinator.frl -o out.a80
 *)

-- ═══════════════════════════════════════════
-- Character classification (like ctype.h)
-- ═══════════════════════════════════════════

let is_digit (c : u8) : u8 =
  if c > 47 then
    if c < 58 then 1 else 0
  else 0

let is_alpha (c : u8) : u8 =
  if c > 64 then
    if c < 91 then 1      (* A-Z *)
    else if c > 96 then
      if c < 123 then 1   (* a-z *)
      else 0
    else 0
  else 0

let is_alnum (c : u8) : u8 =
  if is_digit c == 1 then 1
  else is_alpha c

let is_space (c : u8) : u8 =
  if c == 32 then 1        (* space *)
  else if c == 9 then 1    (* tab *)
  else if c == 10 then 1   (* newline *)
  else 0

let is_upper (c : u8) : u8 =
  if c > 64 then if c < 91 then 1 else 0 else 0

let is_lower (c : u8) : u8 =
  if c > 96 then if c < 123 then 1 else 0 else 0

let to_lower (c : u8) : u8 =
  if is_upper c == 1 then c + 32 else c

let to_upper (c : u8) : u8 =
  if is_lower c == 1 then c - 32 else c

-- ═══════════════════════════════════════════
-- Digit parsing
-- ═══════════════════════════════════════════

(* Parse single digit: '0'-'9' → 0-9, else 255 (error) *)
let parse_digit (c : u8) : u8 =
  if is_digit c == 1 then c - 48 else 255

(* Parse hex digit: '0'-'9','a'-'f','A'-'F' → 0-15, else 255 *)
let parse_hex (c : u8) : u8 =
  if is_digit c == 1 then c - 48
  else if c > 64 then
    if c < 71 then c - 55   (* A-F → 10-15 *)
    else if c > 96 then
      if c < 103 then c - 87  (* a-f → 10-15 *)
      else 255
    else 255
  else 255

(* Parse two decimal digits into a byte: "42" → 42 *)
let parse_two_digits (tens : u8) (ones : u8) : u8 =
  let t = parse_digit tens in
  let o = parse_digit ones in
  if t == 255 then 255
  else if o == 255 then 255
  else t * 10 + o

(* Parse hex byte: "FF" → 255 *)
let parse_hex_byte (hi : u8) (lo : u8) : u8 =
  let h = parse_hex hi in
  let l = parse_hex lo in
  if h == 255 then 255
  else if l == 255 then 255
  else h * 16 + l

-- ═══════════════════════════════════════════
-- Token classification
-- ═══════════════════════════════════════════

type Token = Number | Ident | Operator | LParen | RParen | Unknown

let classify_token (c : u8) : u8 =
  if is_digit c == 1 then 0        (* Number *)
  else if is_alpha c == 1 then 1   (* Ident *)
  else if c == 43 then 2           (* '+' → Operator *)
  else if c == 45 then 2           (* '-' → Operator *)
  else if c == 42 then 2           (* '*' → Operator *)
  else if c == 47 then 2           (* '/' → Operator *)
  else if c == 40 then 3           (* '(' → LParen *)
  else if c == 41 then 4           (* ')' → RParen *)
  else 5                           (* Unknown *)

let is_operator (c : u8) : u8 =
  if c == 43 then 1
  else if c == 45 then 1
  else if c == 42 then 1
  else if c == 47 then 1
  else 0

-- ═══════════════════════════════════════════
-- Operator precedence
-- ═══════════════════════════════════════════

let precedence (op : u8) : u8 =
  if op == 43 then 1       (* '+' → 1 *)
  else if op == 45 then 1  (* '-' → 1 *)
  else if op == 42 then 2  (* '*' → 2 *)
  else if op == 47 then 2  (* '/' → 2 *)
  else 0

let is_left_assoc (op : u8) : u8 =
  if is_operator op == 1 then 1 else 0

-- ═══════════════════════════════════════════
-- Expression evaluator (single-operator)
-- ═══════════════════════════════════════════

let eval_op (a : u8) (op : u8) (b : u8) : u8 =
  if op == 43 then a + b        (* + *)
  else if op == 45 then a - b   (* - *)
  else if op == 42 then a * b   (* * *)
  else if op == 47 then
    if b == 0 then 0 else a / b (* / with div-by-zero guard *)
  else 0

-- ═══════════════════════════════════════════
-- String matching helpers
-- ═══════════════════════════════════════════

(* Case-insensitive character comparison *)
let char_eq_ci (a : u8) (b : u8) : u8 =
  if to_lower a == to_lower b then 1 else 0

-- ═══════════════════════════════════════════
-- Assertions
-- ═══════════════════════════════════════════

-- Character classification
assert is_digit 48 == 1
assert is_digit 57 == 1
assert is_digit 65 == 0
assert is_alpha 65 == 1
assert is_alpha 122 == 1
assert is_alpha 48 == 0
assert is_alnum 65 == 1
assert is_alnum 48 == 1
assert is_alnum 32 == 0
assert is_space 32 == 1
assert is_space 65 == 0
assert to_lower 65 == 97
assert to_lower 97 == 97
assert to_upper 97 == 65
assert to_upper 65 == 65

-- Digit parsing
assert parse_digit 48 == 0
assert parse_digit 57 == 9
assert parse_digit 65 == 255
assert parse_hex 48 == 0
assert parse_hex 65 == 10
assert parse_hex 102 == 15
assert parse_two_digits 52 50 == 42
assert parse_two_digits 48 48 == 0
assert parse_two_digits 57 57 == 99
assert parse_hex_byte 70 70 == 255
assert parse_hex_byte 48 48 == 0
assert parse_hex_byte 65 66 == 171

-- Token classification
assert classify_token 48 == 0
assert classify_token 65 == 1
assert classify_token 43 == 2
assert classify_token 40 == 3
assert classify_token 41 == 4
assert classify_token 33 == 5

-- Precedence
assert precedence 43 == 1
assert precedence 42 == 2
assert is_left_assoc 43 == 1
assert is_left_assoc 33 == 0

-- Expression evaluation
assert eval_op 3 43 4 == 7
assert eval_op 10 45 3 == 7
assert eval_op 6 42 7 == 42
assert eval_op 100 47 10 == 10
assert eval_op 10 47 0 == 0

-- Case-insensitive compare
assert char_eq_ci 65 97 == 1
assert char_eq_ci 65 65 == 1
assert char_eq_ci 65 66 == 0
