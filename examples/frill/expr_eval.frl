(* Frill expression evaluator — recursive descent, compile-time verified *)
(* Evaluates arithmetic expressions: +, -, *, /, parentheses, integers *)
(* Result packed as u16: high byte = value, low byte = new position *)

import "../../stdlib/frill/tokenizer.frl"

(* Pack/unpack: value in high byte, position in low byte *)
let pack (val : u16) (pos : u16) : u16 = val * 256 + pos
let unpack_val (packed : u16) : u8 = packed / 256
let unpack_pos (packed : u16) : u8 = packed % 256

(* ── Atom: number literal or parenthesized expression ────────── *)

(* Parse a bare integer at position p *)
let parse_num (src : u16) (p : u8) : u16 =
  let v = read_int src p in
  let n = read_int_len src p in
  pack v (p + n)

(* Parse a parenthesized expression: skip '(', parse expr, skip ')' *)
let parse_paren (src : u16) (p : u8) : u16 =
  let inner = eval_expr src (p + 1) in
  let p2 = skip_spaces src (unpack_pos inner) in
  pack (unpack_val inner) (p2 + 1)

(* eval_atom dispatches to parse_num or parse_paren *)
let eval_atom (src : u16) (pos : u8) : u16 =
  let p = skip_spaces src pos in
  let ch = peek (src + p) in
  if ch == 40 then parse_paren src p
  else parse_num src p

(* ── Term: handles * and / ───────────────────────────────────── *)

let eval_term (src : u16) (pos : u8) : u16 =
  let left = eval_atom src pos in
  let acc = unpack_val left in
  let p = skip_spaces src (unpack_pos left) in
  let ch = peek (src + p) in
  if ch == 42 then
    eval_term_mul src acc (p + 1)
  else if ch == 47 then
    eval_term_div src acc (p + 1)
  else pack acc p

let eval_term_mul (src : u16) (acc : u8) (pos : u8) : u16 =
  let right = eval_term src pos in
  pack (acc * unpack_val right) (unpack_pos right)

let eval_term_div (src : u16) (acc : u8) (pos : u8) : u16 =
  let right = eval_term src pos in
  pack (acc / unpack_val right) (unpack_pos right)

(* ── Expr: handles + and - ───────────────────────────────────── *)

let eval_expr (src : u16) (pos : u8) : u16 =
  let left = eval_term src pos in
  let acc = unpack_val left in
  let p = skip_spaces src (unpack_pos left) in
  let ch = peek (src + p) in
  if ch == 43 then
    eval_expr_add src acc (p + 1)
  else if ch == 45 then
    eval_expr_sub src acc (p + 1)
  else pack acc p

let eval_expr_add (src : u16) (acc : u8) (pos : u8) : u16 =
  let right = eval_expr src pos in
  pack (acc + unpack_val right) (unpack_pos right)

let eval_expr_sub (src : u16) (acc : u8) (pos : u8) : u16 =
  let right = eval_expr src pos in
  pack (acc - unpack_val right) (unpack_pos right)

(* ── Top-level eval ──────────────────────────────────────────── *)

let eval (src : u16) : u8 = unpack_val (eval_expr src 0)

(* ── Tests ───────────────────────────────────────────────────── *)

(* Pack/unpack *)
assert pack 11 0 == 2816
assert unpack_val 2816 == 11
assert unpack_pos 2816 == 0

(* Single numbers *)
assert eval "5" == 5
assert eval "42" == 42
assert eval "0" == 0

(* Addition *)
assert eval "3+4" == 7
assert eval "1+2+3" == 6

(* Subtraction *)
assert eval "10-3" == 7

(* Multiplication *)
assert eval "3*4" == 12

(* Precedence: * before + *)
assert eval "3+4*2" == 11
assert eval "2*3+4" == 10

(* Parentheses *)
assert eval "2*(3+4)" == 14
assert eval "(1+2)*3" == 9

(* Whitespace *)
assert eval " 3 + 4 " == 7

let main (x : u8) = 0
