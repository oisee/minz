// CP/M Hello World using stdlib BDOS
import stdlib.cpm.bdos

fun main() -> void {
    putchar('H')
    putchar('e')
    putchar('l')
    putchar('l')
    putchar('o')
    putchar(',')
    putchar(' ')
    putchar('C')
    putchar('P')
    putchar('/')
    putchar('M')
    putchar('!')
    newline()
