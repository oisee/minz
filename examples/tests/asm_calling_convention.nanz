// asm_calling_convention.nanz — Z80 assert tests for inline asm register contracts
//
// Tests verify that @z80_a, @z80_b, @z80_c, @z80_hl, @z80_de annotations
// result in correct physical register assignments at call sites.

// ── Single-register: @z80_a (ClassAcc → A) ──────────────────────────────────

fun ident_a(@z80_a x: u8) -> u8 {
    asm z80 (in x) { NOP }
}

assert ident_a(0x42) == 0x42 via z80
assert ident_a(0) == 0 via z80
assert ident_a(0xFF) == 0xFF via z80

// ── Single-register: @z80_b (ClassCounter → B) ─────────────────────────────

fun read_b(@z80_b x: u8) -> u8 {
    asm z80 (in x) { LD A, B }
}

assert read_b(0x55) == 0x55 via z80
assert read_b(0) == 0 via z80
assert read_b(0xFF) == 0xFF via z80

// ── Two-register: @z80_a + @z80_b (A + B) ──────────────────────────────────

fun add_ab(@z80_a a: u8, @z80_b b: u8) -> u8 {
    asm z80 (in a, b) { ADD A, B }
}

assert add_ab(10, 20) == 30 via z80
assert add_ab(0, 0) == 0 via z80
assert add_ab(0xFF, 1) == 0 via z80
assert add_ab(1, 0) == 1 via z80
assert add_ab(0, 1) == 1 via z80

// Bug 2 reproducer: caller must emit LD A, imm for first const argument
assert add_ab(0x11, 0x22) == 0x33 via z80

// ── 16-bit: @z80_hl (ClassPointer → HL) ────────────────────────────────────

fun ident_hl(@z80_hl x: u16) -> u16 {
    asm z80 (in x) { NOP }
}

assert ident_hl(0x1234) == 0x1234 via z80
assert ident_hl(0) == 0 via z80
assert ident_hl(0xFFFF) == 0xFFFF via z80

// ── 16-bit: @z80_de (ClassIndex → DE) ──────────────────────────────────────

fun ident_de(@z80_de x: u16) -> u16 {
    asm z80 (in x) { EX DE, HL }
}

assert ident_de(0xABCD) == 0xABCD via z80
assert ident_de(0) == 0 via z80

// ── 16-bit: @z80_hl + @z80_de (HL + DE) ────────────────────────────────────

fun add16(@z80_hl a: u16, @z80_de b: u16) -> u16 {
    asm z80 (in a, b) { ADD HL, DE }
}

assert add16(0x1000, 0x0234) == 0x1234 via z80
assert add16(0, 0) == 0 via z80
assert add16(0xFFF0, 0x0010) == 0 via z80

// ── Mixed: @z80_hl + @z80_a (HL base + A offset) ───────────────────────────

fun ptr_offset(@z80_hl base: u16, @z80_a offset: u8) -> u16 {
    asm z80 (in base, offset) { LD D, 0 / LD E, A / ADD HL, DE }
}

assert ptr_offset(0x4000, 0) == 0x4000 via z80
assert ptr_offset(0x4000, 0x20) == 0x4020 via z80
assert ptr_offset(0x5800, 0xFF) == 0x58FF via z80

// ── Poke/Peek: classic ZX Spectrum primitives ───────────────────────────────

fun poke(@z80_hl addr: u16, @z80_a val: u8) -> void {
    asm z80 (in addr, val) { LD (HL), A }
}

fun peek(@z80_hl addr: u16) -> u8 {
    asm z80 (in addr) { LD A, (HL) }
}

// Store a value via poke, read it back via peek
// Note: address 0xFE00 is safe scratch RAM in our test harness
fun poke_peek_test() -> u8 {
    poke(0xFE00, 0x42)
    return peek(0xFE00)
}

assert poke_peek_test() == 0x42 via z80

// ── Swap bytes via asm (tests multi-register output) ────────────────────────

fun swap_bytes(@z80_hl val: u16) -> u16 {
    asm z80 (in val) { LD A, H / LD H, L / LD L, A }
}

assert swap_bytes(0x1234) == 0x3412 via z80
assert swap_bytes(0x00FF) == 0xFF00 via z80
assert swap_bytes(0xABCD) == 0xCDAB via z80

