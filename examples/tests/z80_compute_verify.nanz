assert sum_to(0) == 0 via z80
assert sum_to(1) == 1 via z80
assert sum_to(10) == 55 via z80
// count_bits skipped
// is_power_of_2 skipped

// ── Nested calls ────────────────────────────────────────────────────────────

fun double_it(x: u8) -> u8 { return x + x }
fun quad(x: u8) -> u8 { return double_it(double_it(x)) }
// fun compose(x: u8) -> u8 { return add8(mul3(x), mul2(x)) }  // depends on mul3

assert double_it(21) == 42 via z80
assert quad(5) == 20 via z80
assert quad(0) == 0 via z80
assert quad(1) == 4 via z80
// compose skipped — depends on mul3

// ── Mixed width ─────────────────────────────────────────────────────────────

fun widen(x: u8) -> u16 { return u16(x) }
fun narrow(x: u16) -> u8 { return u8(x) }

assert widen(0) == 0 via z80
assert widen(255) == 255 via z80
assert widen(42) == 42 via z80
