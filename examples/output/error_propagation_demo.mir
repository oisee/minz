Function .home.alice.dev.minz.examples.error_propagation_demo.safe_divide$u8$u8(a: u8, b: u8) -> u8
  @smc
  Instructions:
      0: TRUE_SMC_LOAD ; Load from anchor b$imm0
      1: TEST
      2: jump_if_not r5, else_1
      3: SET_ERROR ; @error() - set carry flag with error code in A
      4: return ; Return with error (CY=1, A=error code)
      5: else_1:
      6: TRUE_SMC_LOAD ; Load from anchor a$imm0
      7: return r7

Function .home.alice.dev.minz.examples.error_propagation_demo.checked_add$u8$u8(a: u8, b: u8) -> u8
  @smc
  Locals:
    r3 = result: u16
  Instructions:
      0: TRUE_SMC_LOAD ; Load from anchor a$imm0
      1: TRUE_SMC_LOAD ; Load from anchor b$imm0
      2: r7 = load result
      3: TRUE_SMC_LOAD ; Load from anchor a$imm0
      4: r9 = r7 < r8
      5: jump_if_not r9, else_3
      6: ASM
      7: r10 = 0
      8: return r10
      9: else_3:
     10: r11 = load result
     11: return r11

