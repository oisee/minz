// MOS Hello World for Agon Light 2
// Uses direct assembly for minimal overhead
//
// MOS API:
//   RST 0x10 - OSWRCH: Output character in A
//   RST 0x00 with A=0x00 - Get key (blocking)
//
// To compile: minzc mos_hello.minz -o hello.bin --target=agon

fun main() -> void {
    asm {
        ; Print "Hello, Agon!"
        LD A, 'H'
        RST $10
        LD A, 'e'
        RST $10
        LD A, 'l'
        RST $10
        LD A, 'l'
        RST $10
        LD A, 'o'
        RST $10
        LD A, ','
        RST $10
        LD A, ' '
        RST $10
        LD A, 'A'
        RST $10
        LD A, 'g'
        RST $10
        LD A, 'o'
        RST $10
        LD A, 'n'
        RST $10
        LD A, '!'
        RST $10

        ; Newline
        LD A, 13
        RST $10
        LD A, 10
        RST $10

        ; Print "Press key..."
        LD A, 'P'
        RST $10
        LD A, 'r'
        RST $10
        LD A, 'e'
        RST $10
        LD A, 's'
        RST $10
        LD A, 's'
        RST $10
        LD A, ' '
        RST $10
        LD A, 'k'
        RST $10
        LD A, 'e'
        RST $10
        LD A, 'y'
        RST $10
        LD A, '.'
        RST $10
        LD A, '.'
        RST $10
        LD A, '.'
        RST $10

        ; Wait for key (MOS_GETKEY)
        XOR A           ; A = 0 (function number)
        RST $00         ; MOS API call, key returned in A

        ; Save key
        PUSH AF

        ; Newline
        LD A, 13
        RST $10
        LD A, 10
        RST $10

        ; Echo the key
        POP AF
        RST $10

        ; Final newline
        LD A, 13
        RST $10
        LD A, 10
        RST $10
    }
}
