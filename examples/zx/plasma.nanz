// ============================================================================
// zx/plasma.nanz — Procedural plasma renderer for ZX Spectrum
// ============================================================================
//
// A GLSL-style shader running entirely on Z80 at 3.5 MHz.
// No GPU. No floating point. No runtime.
//
// The shader math (sin tables, dithering) is computed at COMPILE TIME
// via LUTGen and the MIR2 VM. The rendered image is stored in the
// ZX Spectrum framebuffer at 0x4000 (bitmap) and 0x5800 (attributes).
//
// Build:
//   cd minzc && ./mz ../examples/zx/plasma.nanz -o /tmp/plasma.bin --target=zxspectrum
//
// Run and screenshot:
//   ./mzx --run /tmp/plasma.bin@8000 --frames DI:HALT --screenshot /tmp/plasma.png
//
// ============================================================================
// PART 1 — Type system showcase: structs, operator overloading, UFCS, interfaces
// ============================================================================

// Vec2 — 2D vector, u8 components (screen space 0..255)
struct Vec2 {
    x: u8,
    y: u8
}

// UFCS method — v.dot(w): zero-cost, compiles to direct CALL Vec2_dot
fun Vec2.dot(self: Vec2, other: Vec2) -> u8 {
    return self.x * other.x + self.y * other.y
}

// Manhattan length approximation — no sqrt needed
fun Vec2.length(self: Vec2) -> u8 {
    let cx: u8 = if self.x > 127 { 255 - self.x } else { self.x }
    let cy: u8 = if self.y > 127 { 255 - self.y } else { self.y }
    return cx + cy
}

// Color — RGB with ZX Spectrum attribute quantizer
struct Color {
    r: u8,
    g: u8,
    b: u8
}

// UFCS: c.to_attr() → ZX attribute byte; GRB encoding, bright bit
fun Color.to_attr(self: Color) -> u8 {
    let r1: u8 = if self.r > 127 { 1 } else { 0 }
    let g1: u8 = if self.g > 127 { 1 } else { 0 }
    let b1: u8 = if self.b > 127 { 1 } else { 0 }
    let ink: u8 = (g1 << 2) | (r1 << 1) | b1
    let bright: u8 = if (self.r > 200) | (self.g > 200) | (self.b > 200) { 0x40 } else { 0 }
    return bright | ink
}

// Scalar wrapper for assert infrastructure (assert only accepts integer literal args).
// Mirrors Color.to_attr exactly — key test cases verify the multi-flag OR bug fix
// (bright = (r>200)|(g>200)|(b>200)) where each branch is a ClassFlag value.
fun color_to_attr_s(r: u8, g: u8, b: u8) -> u8 {
    let r1: u8 = if r > 127 { 1 } else { 0 }
    let g1: u8 = if g > 127 { 1 } else { 0 }
    let b1: u8 = if b > 127 { 1 } else { 0 }
    let ink: u8 = (g1 << 2) | (r1 << 1) | b1
    let bright: u8 = if (r > 200) | (g > 200) | (b > 200) { 0x40 } else { 0 }
    return bright | ink
}
// ZX color encoding: bit2=G, bit1=R, bit0=B; bit6=bright
assert color_to_attr_s(201, 0, 0) == 0x42    // r>200 → bright(0x40)|red(0x02)
assert color_to_attr_s(0, 201, 0) == 0x44    // g>200 → bright(0x40)|green(0x04)
assert color_to_attr_s(0, 0, 201) == 0x41    // b>200 → bright(0x40)|blue(0x01)
assert color_to_attr_s(201, 201, 201) == 0x47 // all>200 → bright white
assert color_to_attr_s(200, 200, 200) == 0x07 // exactly 200 (not >200) → dim white
assert color_to_attr_s(0, 0, 0) == 0          // all zero → dim black

// Shader interface — polymorphic pixel sampler.
// Any struct implementing sample() satisfies Shader.
// CTIE monomorphizes to a direct CALL at compile time — no vtable, zero cost.
interface Shader {
    sample
}

// ============================================================================
// PART 2 — sin/cos via LUTGen (MIR2 VM synthesises the table at compile time)
//
// The ranged parameter u8<0..255> triggers LUTGen: the MIR2 VM evaluates
// glsl_sin() for every angle 0..255 at compile time, emits a 256-byte table,
// and replaces every call site with a 6-instruction lookup (~39T constant).
//
// No hand-rolled global array needed — the table is computed from the formula.
//
// Algorithm: quarter-wave parabolic approximation
//   Biased range: 128 = zero-crossing, 240 ≈ peak (+1), 16 ≈ trough (-1)
//   corr(param) = (64 - param)^2 * 7 >> 8   →  0..112
//   Quarters 0,1 (0..180°): return 240 - corr    →  128..240
//   Quarters 2,3 (180..360°): return corr + 16   →  16..128
//   Quarters 1,3 mirror param: param = 63 - q
// ============================================================================

fun glsl_sin(angle: u8<0..255>) -> u8 {
    let q: u8 = angle & 63           // position within quarter: 0..63
    let oct: u8 = angle >> 6         // which quarter: 0, 1, 2, 3
    // Mirror quarters 1 and 3: use nested if-else (avoids | in expression context)
    let p1: u8 = if oct == 1 { 63 - q } else { q }
    let param: u8 = if oct == 3 { 63 - q } else { p1 }
    // Quadratic correction: amplitude 0 at param=63, 112 at param=0
    let d: u16 = u16(64 - param)     // 1..64
    let corr: u8 = u8((d * d * 7) >> 8)   // 0..112
    if (oct == 0) | (oct == 1) { return 240 - corr }
    return corr + 16
}

// cos(x) = sin(x + 64) — quarter-cycle phase shift, zero extra instructions
fun glsl_cos(a: u8) -> u8 {
    return glsl_sin(a + 64)
}

// ============================================================================
// PART 3 — LUTGen: dither_pattern(v: u8<0..255>) -> u8
//
// The ranged parameter u8<0..255> tells the MIR2 VM: evaluate this pure
// function for all 256 inputs at compile time, emit a 256-byte table, and
// replace every call site with a 6-instruction table lookup (~39T constant).
// ============================================================================

fun dither_pattern(v: u8<0..255>) -> u8 {
    if v < 28  { return 0x00 }   // very dark    ........
    if v < 56  { return 0x08 }   //              ....X...
    if v < 85  { return 0x22 }   //              ..X...X.
    if v < 113 { return 0x55 }   // mid          .X.X.X.X  checkerboard
    if v < 141 { return 0x6B }   //              .XX.X.XX
    if v < 170 { return 0xAA }   //              X.X.X.X.
    if v < 198 { return 0xBB }   //              X.XXXXXX
    if v < 227 { return 0xDD }   //              XX.XXXXX
    return 0xFF                  // very bright  XXXXXXXX
}

// ============================================================================
// PART 4 — ZX Spectrum screen primitives
// ============================================================================

// Scrambled ZX pixel address: H = 0x40 + y[7:6]<<3 + y[2:0], L = y[5:3]<<5 + x[4:0]
// Written with right-shifts and multiply to avoid u16-SHL and u16-OR codegen issues.
fun zx_screen_addr(x_byte: u8, y: u8) -> u16 {
    let h: u8 = 0x40 + (y >> 6) * 8 + (y & 7)   // bits disjoint → + == |
    let l: u8 = ((y >> 3) & 7) * 32 + (x_byte & 31)
    return u16(h) * 256 + u16(l)                  // combine bytes via multiply
}

// Attribute RAM: 0x5800 + cy*32 + cx
fun zx_attr_addr(cx: u8, cy: u8) -> u16 {
    return 0x5800 + u16(cy) * 32 + u16(cx)
}

// Direct memory write: addr in HL (ClassPointer), val in A (ClassAcc).
// Uses inline Z80 LD (HL),A — the canonical single-instruction ZX screen write.
fun zx_poke(addr: u16, val: u8) -> void {
    asm { LD (HL), A }
}

// ============================================================================
// PART 5 — PlasmaShader: type-system showcase (CTIE / interface dispatch)
// ============================================================================
// The struct + UFCS method + Shader interface below demonstrate Nanz features.
// The actual render path uses plasma_sample() with scalar u8 parameters to
// avoid struct-pointer calling-convention limitations in the current compiler.

struct PlasmaShader {
    phase: u8
}

// sample(uv) implements Shader — monomorphized to direct CALL by CTIE.
// (Showcase only — render path calls plasma_sample directly.)
fun PlasmaShader.sample(self: PlasmaShader, uv: Vec2) -> u8 {
    let v1: u8 = glsl_sin(uv.x)
    let v2: u8 = glsl_sin(uv.y + 43)                  // +43 ≈ 60° phase shift
    let v3: u8 = glsl_sin(((uv.x >> 1) + (uv.y >> 1)) + self.phase)
    return v1 + v2 + v3    // wrapping u8 sum = interference pattern
}

// ============================================================================
// PART 6 — Scalar pixel shader and attribute plasma
// ============================================================================

// Three-wave plasma pixel brightness: scalar version avoids struct params.
// x, y: pixel coords; phase: animation frame offset.
fun plasma_sample(x: u8, y: u8, phase: u8) -> u8 {
    let v1: u8 = glsl_sin(x)
    let v2: u8 = glsl_sin(y + 43)
    let v3: u8 = glsl_sin(((x >> 1) + (y >> 1)) + phase)
    return v1 + v2 + v3
}

// Attribute color plasma (32×24 cell grid)
fun plasma_attr(cx: u8, cy: u8) -> u8 {
    let ax: u8 = cx * 8        // cx 0..31 → angle 0..248
    let ay: u8 = cy * 11       // cy 0..23 → angle 0..253 (different frequency)
    let wave: u8 = glsl_sin(ax) + glsl_cos(ay)
    let color: u8 = wave >> 5          // top 3 bits → ZX color 0..7
    let bright: u8 = if wave > 210 { 0x40 } else { 0 }
    return bright | color
}

// ============================================================================
// PART 7 — Render engine: two-pass pixel + attribute
// ============================================================================

fun render(phase: u8) -> void {
    // Pass 1: dithered pixel plasma — 192 rows × 32 bytes = 6144 writes
    var y: u8 = 0
    while y < 192 {
        var xb: u8 = 0
        while xb < 32 {
            let x: u8 = xb * 8                             // left-edge pixel x of byte column
            let brightness: u8 = plasma_sample(x, y, phase)
            let pixels: u8 = dither_pattern(brightness)   // LUTGen: ~39T, constant
            zx_poke(zx_screen_addr(xb, y), pixels)
            xb = xb + 1
        }
        y = y + 1
    }
    // Pass 2: color attribute plasma — 24 rows × 32 cells = 768 writes
    var cy: u8 = 0
    while cy < 24 {
        var cx: u8 = 0
        while cx < 32 {
            zx_poke(zx_attr_addr(cx, cy), plasma_attr(cx, cy))
            cx = cx + 1
        }
        cy = cy + 1
    }
}

// ============================================================================
// PART 8 — Entry point
// ============================================================================

fun main() -> void {
    render(0)
    // DI + HALT: mzx --frames DI:HALT captures the frozen frame as screenshot
}
