/* PL/M-80 Hello World for CP/M */
/* mz hello.plm --target=cpm --runtime=cpm --runtime-stack=1024 -o hello.a80 && mza hello.a80 -o HELLO.COM */

HELLO: DO;

DECLARE CR LITERALLY '0DH';
DECLARE LF LITERALLY '0AH';

PRINT$CHAR: PROCEDURE (C);
    DECLARE C BYTE;
    /* Compiler CP/M console intrinsic: emitted runtime calls BDOS function 2. */
    CALL BDOS(2, C);
END PRINT$CHAR;

PRINT$MSG: PROCEDURE (PTR);
    DECLARE PTR WORD;
    DECLARE C BYTE;
    C = PTR(0);
    DO WHILE C <> 0;
        CALL PRINT$CHAR(C);
        PTR = PTR + 1;
        C = PTR(0);
    END;
END PRINT$MSG;

/* Main program */
CALL PRINT$MSG(.('Hello from PL/M-80!', 0));
CALL PRINT$CHAR(CR);
CALL PRINT$CHAR(LF);

END HELLO;
