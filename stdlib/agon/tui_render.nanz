// stdlib/agon/tui_render — TUI rendering primitives for Agon Light 2
//
// Agon MOS API:
//   RST.LIL $10  — output character (A = char)
//   RST.LIL $18  — print string (HL = pointer to null-terminated string)
//   RST.LIL $08  — MOS API call (A = function number)
//
// Native VDU works in ordinary MOS mode; ANSI requires terminal mode
// and changes keyboard transport. These primitives retain MOS key input.
//
// Usage:
//   import stdlib.agon.tui_render
//   (replaces stdlib.tui.render for Agon target)

// =============================================================================
// Internal: MOS output helpers
// =============================================================================

// MOS putchar: RST $10 with char in A
fun _tui_mos_putchar(ch: u8) -> void {
    asm z80 (in ch) {
        RST.LIL $10
    }
}

global _tui_fg: u8 = 7
global _tui_bg: u8 = 0
global _tui_reversed: u8 = 0

// Print null-terminated string via loop + RST $10 (more reliable than RST $18)
fun _tui_mos_puts(str: ^u8) -> void {
    asm z80 (in str) {
        .loop: LD A, (HL) / OR A / RET Z
        RST.LIL $10
        INC HL
        JR .loop
    }
}

// Send raw VDU byte (for VDP commands)
fun _tui_vdu(byte: u8) -> void {
    asm z80 (in byte) {
        RST.LIL $10
    }
}

// =============================================================================
// TUI primitives — native VDU, default16-color palette
// =============================================================================

// Position cursor at (x, y) — 0-based.
// VDU31,x,y uses zero-based coordinates.
fun tui_goto(x: u8, y: u8) -> void {
    _tui_vdu(31)
    _tui_vdu(x)
    _tui_vdu(y)
}

// Set text color: fg (0-7), bg (0-7), bright (0 or 1).
// VDU17 logical foreground/background; bright adds8.
fun tui_color(fg: u8, bg: u8, bright: u8) -> void {
    var intensity: u8 = 0
    if bright != 0 { intensity = 8 }
    _tui_reversed = 0
    _tui_fg = (fg & 7) + intensity
    _tui_bg = (bg & 7) + intensity
    _tui_vdu(17)
    _tui_vdu(_tui_fg)
    _tui_vdu(17)
    _tui_vdu(128 + _tui_bg)
}

// Reset logical white7 on black0.
fun tui_reset() -> void {
    tui_color(7, 0, 0)
}

// VDU12 clears and homes the current text viewport.
fun tui_clear() -> void {
    _tui_vdu(12)
}

// Print a single character. Codes 1-6 → box-drawing (ASCII fallback).
// TODO: Agon VDP supports UTF-8 box-drawing characters natively.
fun tui_putch(ch: u8) -> void {
    if ch == 1 { _tui_mos_putchar(43) }  // top-left corner → +
    if ch == 2 { _tui_mos_putchar(43) }  // top-right corner → +
    if ch == 3 { _tui_mos_putchar(43) }  // bottom-left corner → +
    if ch == 4 { _tui_mos_putchar(43) }  // bottom-right corner → +
    if ch == 5 { _tui_mos_putchar(45) }  // horizontal → -
    if ch == 6 { _tui_mos_putchar(124) } // vertical → |
    if ch > 6 {
        _tui_mos_putchar(ch)
    }
}

// Print a null-terminated string.
fun tui_puts(str: ^u8) -> void {
    _tui_mos_puts(str)
}

// Read one key (blocking). MOS function 0x00 via RST $08.
fun tui_read_key() -> u8 {
    asm z80 (ret A) {
        LD A, $00     ; MOS_GETKEY
        RST.LIL $08
    }
}

// Read a line into buffer. MOS function 0x09 (editline).
// HL = buffer, B = max length. Returns actual length in A.
fun tui_read_line(buf: ^u8, maxlen: u8) -> u8 {
    asm z80 (in buf, maxlen) (ret A) {
        ; HL = buf (from param 0), A = maxlen (from param 1)
        LD B, A        ; B = maxlen
        LD C, 1        ; C = 1 (clear buffer before use)
        LD A, $09      ; MOS_EDITLINE
        RST.LIL $08
        ; On return: A = length of string entered
    }
}

// Terminal dimensions — Agon default: 80x30 (mode 0) or 40x25 (mode 1)
fun tui_width() -> u8 {
    asm z80 (ret A) { LD A, 80 }
}

fun tui_height() -> u8 {
    asm z80 (ret A) { LD A, 30 }
}

// =============================================================================
// VDP control — Agon-specific (no CP/M equivalent)
// =============================================================================

// Set screen mode: VDU 22, mode
//   Mode 0: 80x30, 16 colors (default)
//   Mode 1: 40x25, 16 colors
//   Mode 3: 80x25, 64 colors (double height)
//   Mode 8: 40x25, 64 colors
fun tui_set_mode(mode: u8) -> void {
    _tui_vdu(22)
    _tui_vdu(mode)
}

// Cursor visibility: VDU23,1,0.
fun tui_hide_cursor() -> void {
    _tui_vdu(23)
    _tui_vdu(1)
    _tui_vdu(0)
}

// Cursor visibility: VDU23,1,1.
fun tui_show_cursor() -> void {
    _tui_vdu(23)
    _tui_vdu(1)
    _tui_vdu(1)
}

// Native full-width text viewport, inclusive zero-based rows.
// Coordinates become relative to viewport (differs from ANSI margins).
fun tui_scroll_region(top: u8, bottom: u8) -> void {
    _tui_vdu(28)
    _tui_vdu(0)
    _tui_vdu(bottom)
    _tui_vdu(tui_width() - 1)
    _tui_vdu(top)
}

// Swap the last foreground/background selected through this library.
fun tui_reverse() -> void {
    if _tui_reversed != 0 { return }
    _tui_reversed = 1
    let previous_fg = _tui_fg
    _tui_fg = _tui_bg
    _tui_bg = previous_fg
    _tui_vdu(17)
    _tui_vdu(_tui_fg)
    _tui_vdu(17)
    _tui_vdu(128 + _tui_bg)
}

// =============================================================================
// Box drawing helpers (identical to CP/M version — uses tui_* primitives)
// =============================================================================

fun draw_box(x: u8, y: u8, w: u8, h: u8) -> void {
    tui_goto(x, y)
    tui_putch(1)
    var i: u8 = 0
    while i < w - 2 {
        tui_putch(5)
        i = i + 1
    }
    tui_putch(2)

    var row: u8 = 1
    while row < h - 1 {
        tui_goto(x, y + row)
        tui_putch(6)
        tui_goto(x + w - 1, y + row)
        tui_putch(6)
        row = row + 1
    }

    tui_goto(x, y + h - 1)
    tui_putch(3)
    i = 0
    while i < w - 2 {
        tui_putch(5)
        i = i + 1
    }
    tui_putch(4)
}

fun clear_rect(x: u8, y: u8, w: u8, h: u8) -> void {
    var row: u8 = 0
    while row < h {
        tui_goto(x, y + row)
        var col: u8 = 0
        while col < w {
            tui_putch(32)
            col = col + 1
        }
        row = row + 1
    }
}

fun puts_padded(str: ^u8, width: u8) -> void {
    var i: u8 = 0
    var ptr: ^u8 = str
    while i < width {
        if ptr^ != 0 {
            tui_putch(ptr^)
            ptr = ptr + 1
        } else {
            tui_putch(32)
        }
        i = i + 1
    }
}
