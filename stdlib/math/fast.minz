// ============================================================================
// MinZ Fast Math Library
// ============================================================================
// High-performance math using 256-byte lookup tables.
// All angles are 0-255 (256 = full circle = 360°)
// Results are signed: -128 to +127 (scaled by 127)
//
// Memory: ~768 bytes for all tables
// Speed: 12-20 T-states per lookup (vs 1000+ for calculation)
// ============================================================================

// ============================================================================
// Sine Table (256 entries, signed -128 to +127)
// ============================================================================
// sin(angle) where angle 0-255 maps to 0°-360°
// Result scaled: actual_sin * 127

global SIN_TABLE: [u8; 256] = [
    // 0-15: 0° to 22.5°
    0, 3, 6, 9, 12, 16, 19, 22, 25, 28, 31, 34, 37, 40, 43, 46,
    // 16-31: 22.5° to 45°
    49, 51, 54, 57, 60, 63, 65, 68, 71, 73, 76, 78, 81, 83, 85, 88,
    // 32-47: 45° to 67.5°
    90, 92, 94, 96, 98, 100, 102, 104, 106, 107, 109, 111, 112, 113, 115, 116,
    // 48-63: 67.5° to 90°
    117, 118, 120, 121, 122, 122, 123, 124, 125, 125, 126, 126, 126, 127, 127, 127,
    // 64-79: 90° to 112.5° (mirror)
    127, 127, 127, 127, 126, 126, 126, 125, 125, 124, 123, 122, 122, 121, 120, 118,
    // 80-95: 112.5° to 135°
    117, 116, 115, 113, 112, 111, 109, 107, 106, 104, 102, 100, 98, 96, 94, 92,
    // 96-111: 135° to 157.5°
    90, 88, 85, 83, 81, 78, 76, 73, 71, 68, 65, 63, 60, 57, 54, 51,
    // 112-127: 157.5° to 180°
    49, 46, 43, 40, 37, 34, 31, 28, 25, 22, 19, 16, 12, 9, 6, 3,
    // 128-143: 180° to 202.5° (negative mirror)
    0, 253, 250, 247, 244, 240, 237, 234, 231, 228, 225, 222, 219, 216, 213, 210,
    // 144-159: 202.5° to 225°
    207, 205, 202, 199, 196, 193, 191, 188, 185, 183, 180, 178, 175, 173, 171, 168,
    // 160-175: 225° to 247.5°
    166, 164, 162, 160, 158, 156, 154, 152, 150, 149, 147, 145, 144, 143, 141, 140,
    // 176-191: 247.5° to 270°
    139, 138, 136, 135, 134, 134, 133, 132, 131, 131, 130, 130, 130, 129, 129, 129,
    // 192-207: 270° to 292.5°
    129, 129, 129, 129, 130, 130, 130, 131, 131, 132, 133, 134, 134, 135, 136, 138,
    // 208-223: 292.5° to 315°
    139, 140, 141, 143, 144, 145, 147, 149, 150, 152, 154, 156, 158, 160, 162, 164,
    // 224-239: 315° to 337.5°
    166, 168, 171, 173, 175, 178, 180, 183, 185, 188, 191, 193, 196, 199, 202, 205,
    // 240-255: 337.5° to 360°
    207, 210, 213, 216, 219, 222, 225, 228, 231, 234, 237, 240, 244, 247, 250, 253
];

// ============================================================================
// Cosine Table (256 entries, signed -128 to +127)
// ============================================================================
// cos(angle) = sin(angle + 64)

global COS_TABLE: [u8; 256] = [
    // cos = sin shifted by 64 (90°)
    127, 127, 127, 127, 126, 126, 126, 125, 125, 124, 123, 122, 122, 121, 120, 118,
