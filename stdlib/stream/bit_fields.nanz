// MSB-first fields in an 8- or 16-bit word. Generation runs on the meta VM;
// the target receives concrete masks/shifts and a byte-field result struct.
fun @bit_fields(name: ^u8) {
    let fields: u16 = block_len()
    if fields == 0 { meta_error(c"bit_fields needs 1..8 fields") }
    if fields > 8 { meta_error(c"bit_fields needs 1..8 fields") }
    var total: u16 = 0
    var i: u16 = 0
    while i < fields {
        if str_eq(node_keyword(i), c"bits") != 1 { meta_error(c"expected bits name width") }
        if node_arg_count(i) != 2 { meta_error(c"expected bits name width") }
        let width: i32 = node_arg_int(i, 1)
        if width < 1 { meta_error(c"field width must be 1..8") }
        if width > 8 { meta_error(c"field width must be 1..8") }
        total = total + u16(width)
        var j: u16 = 0
        while j < i {
            if str_eq(node_arg_str(i, 0), node_arg_str(j, 0)) == 1 {
                meta_error(c"duplicate bit field")
            }
            j = j + 1
        }
        i = i + 1
    }
    if total != 8 { if total != 16 { meta_error(c"bit fields must total 8 or 16") } }
    // Validate every emitted identifier, including the type name.
    i = 0
    while i <= fields {
        var text: ^u8 = name
        if i != 0 { text = node_arg_str(i - 1, 0) }
        if text[0] == 0 { meta_error(c"empty bit schema identifier") }
        var k: u16 = 0
        while text[k] != 0 {
            let c: u8 = text[k]
            var valid: u8 = 0
            if c >= 65 { if c <= 90 { valid = 1 } }
            if c >= 97 { if c <= 122 { valid = 1 } }
            if c == 95 { valid = 1 }
            if k != 0 { if c >= 48 { if c <= 57 { valid = 1 } } }
            if valid == 0 { meta_error(c"invalid bit schema identifier") }
            k = k + 1
        }
        i = i + 1
    }
    emit(str_concat(c"struct ", str_concat(name, c" {")))
    i = 0
    while i < fields {
        emit(str_concat(node_arg_str(i, 0), c": u8"))
        i = i + 1
    }
    emit(c"}")
    emit(str_concat(c"fun ", str_concat(name, str_concat(c"_decode(raw: u16, dest: ^", str_concat(name, c") {")))))
    var shift: u16 = total
    i = 0
    while i < fields {
        let width: u16 = u16(node_arg_int(i, 1))
        shift = shift - width
        var mask: u16 = 1
        var bit: u16 = 0
        while bit < width { mask = mask * 2
            bit = bit + 1 }
        mask = mask - 1
        let line: ^u8 = str_concat(c"dest.", str_concat(node_arg_str(i, 0), c" = u8((raw >> "))
        let shifted: ^u8 = str_concat(line, str_concat(str_from_int(shift), c") & "))
        emit(str_concat(shifted, str_concat(str_from_int(mask), c")")))
        i = i + 1
    }
    emit(c"}")
}
