// trig.minz - Trigonometric Functions with Lookup Tables
// Uses 64-entry quarter-wave table for sin/cos
// Angle format: 0-1024 = 0-2π (256 = 90°, 512 = 180°, 1024 = 360°)

import glsl.fp;

// ============================================
// Angle Constants (1024 = 2π)
// ============================================

const ANGLE_0: i16 = 0;
const ANGLE_45: i16 = 1 << 7;      // 128
const ANGLE_90: i16 = 1 << 8;      // 256
const ANGLE_180: i16 = 1 << 9;     // 512
const ANGLE_270: i16 = 3 << 8;     // 768
const ANGLE_360: i16 = 1 << 10;    // 1024

// ============================================
// Sine Lookup Table (first quadrant, 0-90°)
// 64 entries, values in 8.8 fixed-point
// sin(i * 90° / 64) * 256
// ============================================

global SIN_TABLE: [i16; 65] = [
    0,    6,   13,   19,   25,   31,   38,   44,    // 0-7
   50,   56,   62,   68,   74,   80,   86,   92,    // 8-15
   98,  103,  109,  115,  120,  126,  131,  136,    // 16-23
  142,  147,  152,  157,  162,  167,  171,  176,    // 24-31
  181,  185,  189,  193,  197,  201,  205,  209,    // 32-39
  212,  216,  219,  222,  225,  228,  231,  234,    // 40-47
  236,  238,  241,  243,  245,  247,  248,  250,    // 48-55
  251,  252,  253,  254,  255,  255,  256,  256,    // 56-63
  256                                               // 64 (90°)
];

// ============================================
// Sine Function
// Input: angle in 0-1024 format (1024 = 2π)
// Output: 8.8 fixed-point (-256 to +256)
// ============================================

fun fp_sin(angle: i16) -> i16 {
    // Normalize angle to 0-1023
    let mask: i16 = (1 << 10) - 1;  // 0x03FF = 1023
    angle = angle & mask;

    // Determine quadrant (0-3)
    let quadrant = (angle >> 8) & 3;

    // Index within quadrant (0-255)
    let idx_full = angle & 127;  // 0-127 for i16 safe

    // Scale to table index (0-64)
    let idx = idx_full >> 2;

    // Interpolation fraction (0-3)
    let frac = idx_full & 0x03;

    let val: i16 = 0;

    if quadrant == 0 {
        // 0-90°: ascending
        val = SIN_TABLE[idx];
        if frac > 0 {
            if idx < 64 {
                val = val + ((SIN_TABLE[idx + 1] - val) * frac) >> 2;
            }
        }
    }
    if quadrant == 1 {
        // 90-180°: descending from 1
        val = SIN_TABLE[64 - idx];
        if frac > 0 {
            if idx > 0 {
                val = val - ((val - SIN_TABLE[64 - idx - 1]) * frac) >> 2;
            }
        }
    }
    if quadrant == 2 {
        // 180-270°: negative ascending
        val = 0 - SIN_TABLE[idx];
        if frac > 0 {
            if idx < 64 {
                val = val - ((SIN_TABLE[idx + 1] - SIN_TABLE[idx]) * frac) >> 2;
            }
        }
    }
    if quadrant == 3 {
        // 270-360°: negative descending
        val = 0 - SIN_TABLE[64 - idx];
        if frac > 0 {
            if idx > 0 {
                val = val + ((SIN_TABLE[64 - idx] - SIN_TABLE[64 - idx - 1]) * frac) >> 2;
            }
        }
    }

    return val;
}

// ============================================
// Cosine Function
// cos(x) = sin(x + 90°)
// ============================================

fun fp_cos(angle: i16) -> i16 {
    return fp_sin(angle + ANGLE_90);
}

// ============================================
// Tangent Function
// tan(x) = sin(x) / cos(x)
// ============================================

fun fp_tan(angle: i16) -> i16 {
    let c = fp_cos(angle);
    if fp_abs(c) < 4 {  // Near 90° or 270°
        if c >= 0 { return 32767; }
        return 0 - 32767;
    }
    return fp_div(fp_sin(angle), c);
}

// ============================================
// Inverse Trig (approximate)
// ============================================

// Arcsine: returns angle in 0-1024 format
// Input: x in range -256 to +256 (i.e., -1 to +1)
fun fp_asin(x: i16) -> i16 {
    // Clamp input
    if x >= FP_ONE { return ANGLE_90; }
    if x <= FP_NEG_ONE { return 0 - ANGLE_90; }

    // Use polynomial approximation
    // asin(x) ≈ x + x³/6 + 3x⁵/40 (for small x)
    // Then scale to our angle format

    let x2 = fp_mul(x, x);
    let x3 = fp_mul(x2, x);

    // Approximate: result ≈ x * (256/π) * correction
    // Simplified: just linear + cubic term
    let six_fp: i16 = 6 << 8;  // 1536
    let result = x + fp_div(x3, six_fp);

    // Scale from radians to 1024 format
    // 1 radian = 1024/(2π) ≈ 163
    let scale: i16 = 163;
    return fp_mul(result, scale);
}

// Arccosine
fun fp_acos(x: i16) -> i16 {
    return ANGLE_90 - fp_asin(x);
}

// Arctangent
fun fp_atan(x: i16) -> i16 {
    // atan(x) ≈ x - x³/3 + x⁵/5 for |x| < 1
    // For |x| > 1: atan(x) = π/2 - atan(1/x)

    if fp_abs(x) > FP_ONE {
        let sign: i16 = 1;
        if x < 0 { sign = 0 - 1; x = 0 - x; }
        let inv = fp_div(FP_ONE, x);
        return sign * (ANGLE_90 - fp_atan(inv));
    }

    let x2 = fp_mul(x, x);
    let x3 = fp_mul(x2, x);
    let x5 = fp_mul(x3, x2);

    let three_fp: i16 = 3 << 8;  // 768
    let five_fp: i16 = 5 << 8;   // 1280
    let result = x - fp_div(x3, three_fp) + fp_div(x5, five_fp);

    // Scale to 1024 format
    let scale: i16 = 163;
    return fp_mul(result, scale);
}

// atan2(y, x) - angle from positive x-axis
fun fp_atan2(y: i16, x: i16) -> i16 {
    if x > 0 {
        return fp_atan(fp_div(y, x));
    }
    if x < 0 {
        if y >= 0 {
            return fp_atan(fp_div(y, x)) + ANGLE_180;
        }
        return fp_atan(fp_div(y, x)) - ANGLE_180;
    }
    // x == 0
    if y > 0 { return ANGLE_90; }
    if y < 0 { return 0 - ANGLE_90; }
    return 0;  // undefined
}

// ============================================
// Degrees/Radians Conversion
// Our angle format: 1024 = 2π = 360°
// ============================================

// Convert degrees (0-360 as integer) to angle format
fun deg_to_angle(deg: i16) -> i16 {
    // angle = deg * 1024 / 360 ≈ deg * 2.844
    // Approximate: deg * 3 - deg/8
    return (deg * 3) - (deg >> 3);
}

// Convert radians (8.8 fixed) to angle format
fun rad_to_angle(rad: i16) -> i16 {
    // angle = rad * 1024 / (2π) = rad * 163
    let scale: i16 = 163;
    return fp_mul(rad, scale);
}

// Convert angle format to radians (8.8 fixed)
fun angle_to_rad(angle: i16) -> i16 {
    // rad = angle * 2π / 1024 = angle / 163
    let scale: i16 = 163;
    return fp_div(angle, scale);
}

