// ============================================
// Post-Processing
// ============================================

// Gamma correction (approximate)
fun gammaCorrect(c: i16) -> i16 {
    // sqrt approximation for gamma 2.0
    return fp_sqrt(c);
}

// Contrast adjustment
fun adjustContrast(c: i16, contrast: i16) -> i16 {
    // (c - 0.5) * contrast + 0.5
    let centered = c - FP_HALF;
    return fp_mul(centered, contrast) + FP_HALF;
}

// Vignette effect (darker at edges)
fun applyVignette(c: i16, uv: vec2, strength: i16) -> i16 {
    let dist = v2_length(uv);
    let vig = FP_ONE - fp_mul(fp_mul(dist, dist), strength);
    return fp_mul(c, fp_max(vig, 0));
}

