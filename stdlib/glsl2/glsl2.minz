// ============================================
// Color/Shade Helpers
// ============================================

// Convert diffuse (0..FP_ONE) to ZX Spectrum bright level (0..7)
fun shade_to_bright(shade: i16) -> u8 {
    let clamped = fp_clamp(shade, 0, FP_ONE);
    return (clamped >> 5) as u8;  // Divide by 32: 256 levels -> 8 levels
}

// Convert diffuse to grayscale byte (0..255)
fun shade_to_gray(shade: i16) -> u8 {
    let clamped = fp_clamp(shade, 0, FP_ONE);
    return (clamped >> 0) as u8;  // High byte is already 0..255 range
}

// Fog effect: mix color with fog based on distance
fun apply_fog(color: i16, dist: i16, fog_density: i16) -> i16 {
    let fog_amount = fp_clamp(fp_mul(dist, fog_density), 0, FP_ONE);
    return fp_mix(color, FP_HALF, fog_amount);  // Fade to gray
}
