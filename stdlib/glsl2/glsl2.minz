// glsl2.minz - Idiomatic GLSL Library for MinZ v0.17.0
// Natural syntax via operator overloading and UFCS
//
// Usage:
//   import glsl2;
//
// Then write natural vector math and CSG:
//   let result = normal * intensity + ambient;
//   let scene = sphere(p, 1.0) - box(p, size) | cylinder(p, 0.5);

// Re-export all modules
import glsl.fp;          // Fixed-point math (fp_mul, fp_div, fp_sqrt, etc.)
import glsl.trig;        // Trigonometry (fp_sin, fp_cos, lookup tables)
import glsl2.vec;        // Vectors with operators (vec2, vec3, vec4)
import glsl2.dist;       // Distance type with CSG operators
import glsl2.sdf;        // SDF primitives returning Dist

// ============================================
// Raymarching Helpers
// ============================================

// Standard epsilon for surface detection
const RAYMARCH_EPS: i16 = 2;      // ~0.008 in 8.8
const RAYMARCH_MAX_DIST: i16 = 20 << 8;  // 20.0 units
const RAYMARCH_MAX_STEPS: u8 = 64;

