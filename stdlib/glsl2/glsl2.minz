// ============================================
// Lighting Helpers
// ============================================

// Simple diffuse lighting
fun diffuse(normal: vec3, light_dir: vec3) -> i16 {
    return fp_max(normal.dot(light_dir), 0);
}

// Specular highlight (Blinn-Phong)
fun specular(normal: vec3, light_dir: vec3, view_dir: vec3, shininess: i16) -> i16 {
    let half_vec = (light_dir + view_dir).normalize();
    let spec = fp_max(normal.dot(half_vec), 0);
    return fp_powi(spec, fp_to_int(shininess));
}

// Fresnel (rim lighting)
fun fresnel(normal: vec3, view_dir: vec3, power: i16) -> i16 {
    let ndv = fp_max(normal.dot(view_dir), 0);
    return fp_powi(FP_ONE - ndv, fp_to_int(power));
}

// Ambient occlusion approximation (simple)
// Returns 0..FP_ONE based on how enclosed the point is
fun ao(p: vec3, normal: vec3, step: i16, iterations: u8) -> i16 {
