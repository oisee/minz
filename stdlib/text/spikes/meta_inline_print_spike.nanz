// A user metafunction expands in main's scope to direct formatter calls.
import text.print

struct Game { moves: u16 }
global game: Game
global output: [u8; 48]
global writer: BufWriter
global text_value: CText
global number_value: Dec16

fun @print() -> void {
    var i: u8 = 0
    while i < block_len() {
        let kind: ^u8 = node_keyword(i)
        let value: ^u8 = node_arg_str(i, 0)
        if str_eq(kind, c"text") == 1 {
            let quoted: ^u8 = str_concat(str_chr(34), str_concat(value, str_chr(34)))
            emit(str_concat(c"text_value.ptr = c", quoted))
            emit(c"text_value.write_to(&writer)")
        }
        if str_eq(kind, c"decimal") == 1 {
            emit(str_concat(c"number_value.value = ", value))
            emit(c"number_value.write_to(&writer)")
        }
        i = i + 1
    }
}

fun main() -> u16 {
    let score: u16 = 65535
    game.moves = 7
    writer.init(&output, 48)
    @print() {
        text "score="
        decimal "score"
        text " moves="
        decimal "game.moves"
    }
    writer.finish_c()
    return writer.len
}
