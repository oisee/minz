// strref.nanz — Zero-copy string references + intern table
//
// StrRef is a (offset, len) pair pointing into a source buffer.
// No copying — identifiers are slices of the original source text.
//
// InternTable deduplicates strings: same content → same index.
// Arena-backed, open-addressing with FNV-1a hash.
//
// Usage:
//   var arena: Arena
//   arena.init(0xC000, 4096)
//   var tab: InternTable
//   intern_init(&tab, &arena, 64)           // 64 slots
//   let src: ^u8 = ...                       // source buffer
//   let id1 = intern(&tab, src, 5, 3)       // intern src[5..8]
//   let id2 = intern(&tab, src, 20, 3)      // intern src[20..23]
//   // if src[5..8] == src[20..23], then id1 == id2

// StrRef: reference into a buffer. 4 bytes.
struct StrRef {
    off: u16    // byte offset in source buffer
    len: u16    // length in bytes
}

// InternTable: deduplicating string table.
// Stores StrRef entries, returns u16 index (0-based).
// Open addressing with linear probing, power-of-2 capacity.
struct InternTable {
    src: ^u8        // source buffer (read-only)
    refs: ^u8       // arena: array of StrRef (4 bytes each)
    hashes: ^u8     // arena: array of u16 hash values (for fast reject)
    used: ^u8       // arena: occupancy bitmap (1 byte per slot)
    count: u16      // number of interned strings
    cap: u16        // capacity (power of 2)
}

// FNV-1a hash for a byte range. Fast, good distribution.
fun fnv1a(buf: ^u8, off: u16, len: u16) -> u16 {
    var h: u16 = 0x811C   // FNV offset basis (truncated to 16-bit)
    var i: u16 = 0
    while (i < len) {
        var b: u8 = buf[off + i]
        h = h xor u16(b)
        // FNV multiply: h * 0x0193 — approximate with shifts
        // h * 403 = h * 256 + h * 128 + h * 16 + h * 2 + h
        var h2: u16 = h << 8
        var h3: u16 = h << 7
        var h4: u16 = h << 4
        var h5: u16 = h << 1
        h = h2 + h3 + h4 + h5 + h
        i = i + 1
    }
    return h
}

// Compare two byte ranges for equality.
fun mem_eq(buf: ^u8, off1: u16, buf2: ^u8, off2: u16, len: u16) -> u8 {
    var i: u16 = 0
    while (i < len) {
        if (buf[off1 + i] != buf2[off2 + i]) {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Initialize intern table with given capacity (must be power of 2).
// Allocates from arena: cap * (4 + 2 + 1) = 7 bytes per slot.
fun intern_init(tab: ^InternTable, arena: ^Arena, src: ^u8, cap: u16) {
    tab.src = src
    tab.count = 0
    tab.cap = cap
    // Allocate arrays from arena
    tab.refs = ptr(Arena.alloc(arena, cap * 4))     // StrRef = 4 bytes each
    tab.hashes = ptr(Arena.alloc(arena, cap * 2))   // u16 hash each
    tab.used = ptr(Arena.alloc(arena, cap))          // u8 flag each
    // Zero the used flags
    var i: u16 = 0
    while (i < cap) {
        tab.used[i] = 0
        i = i + 1
    }
}

// Read a StrRef from the refs array at index idx.
fun ref_off(tab: ^InternTable, idx: u16) -> u16 {
    var base: u16 = idx * 4
    var lo: u8 = tab.refs[base]
    var hi: u8 = tab.refs[base + 1]
    return u16(lo) + u16(hi) * 256
}

fun ref_len(tab: ^InternTable, idx: u16) -> u16 {
    var base: u16 = idx * 4 + 2
    var lo: u8 = tab.refs[base]
    var hi: u8 = tab.refs[base + 1]
    return u16(lo) + u16(hi) * 256
}

// Write a StrRef to the refs array at index idx.
fun ref_set(tab: ^InternTable, idx: u16, off: u16, len: u16) {
    var base: u16 = idx * 4
    tab.refs[base] = u8(off)           // off lo
    tab.refs[base + 1] = u8(off / 256) // off hi
    tab.refs[base + 2] = u8(len)       // len lo
    tab.refs[base + 3] = u8(len / 256) // len hi
}

// Read hash at slot.
fun hash_at(tab: ^InternTable, idx: u16) -> u16 {
    var base: u16 = idx * 2
    var lo: u8 = tab.hashes[base]
    var hi: u8 = tab.hashes[base + 1]
    return u16(lo) + u16(hi) * 256
}

// Write hash at slot.
fun hash_set(tab: ^InternTable, idx: u16, h: u16) {
    var base: u16 = idx * 2
    tab.hashes[base] = u8(h)
    tab.hashes[base + 1] = u8(h / 256)
}

// Intern a string: returns index if already exists, or inserts and returns new index.
// Returns 0xFFFF on table full.
fun intern(tab: ^InternTable, off: u16, len: u16) -> u16 {
    var h: u16 = fnv1a(tab.src, off, len)
    var mask: u16 = tab.cap - 1
    var slot: u16 = h & mask

    // Linear probe
    var probes: u16 = 0
    while (probes < tab.cap) {
        if (tab.used[slot] == 0) {
            // Empty slot — insert here
            tab.used[slot] = 1
            ref_set(tab, slot, off, len)
            hash_set(tab, slot, h)
            var result: u16 = tab.count
            tab.count = tab.count + 1
            return result
        }
        // Occupied — check if same string
        if (hash_at(tab, slot) == h) {
            var existing_off: u16 = ref_off(tab, slot)
            var existing_len: u16 = ref_len(tab, slot)
            if (existing_len == len) {
                if (mem_eq(tab.src, off, tab.src, existing_off, len) == 1) {
                    // Found! Return existing count-index.
                    // We need to find what count-index this slot maps to.
                    // For simplicity, the slot IS the index in the refs array.
                    // Return a marker that means "already exists at this slot".
                    return slot
                }
            }
        }
        slot = (slot + 1) & mask
        probes = probes + 1
    }
    return 0xFFFF  // table full
}

// Lookup: returns slot index if found, 0xFFFF if not found.
fun intern_find(tab: ^InternTable, off: u16, len: u16) -> u16 {
    var h: u16 = fnv1a(tab.src, off, len)
    var mask: u16 = tab.cap - 1
    var slot: u16 = h & mask

    var probes: u16 = 0
    while (probes < tab.cap) {
        if (tab.used[slot] == 0) {
            return 0xFFFF  // not found
        }
        if (hash_at(tab, slot) == h) {
            var existing_off: u16 = ref_off(tab, slot)
            var existing_len: u16 = ref_len(tab, slot)
            if (existing_len == len) {
                if (mem_eq(tab.src, off, tab.src, existing_off, len) == 1) {
                    return slot
                }
            }
        }
        slot = (slot + 1) & mask
        probes = probes + 1
    }
    return 0xFFFF
}

// Get the byte at position within an interned string.
fun intern_char(tab: ^InternTable, slot: u16, pos: u16) -> u8 {
    var off: u16 = ref_off(tab, slot)
    return tab.src[off + pos]
}
