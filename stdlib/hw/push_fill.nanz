// Named SMC fill in owned RAM. Caller holds DI throughout; non-reentrant.
// The destination is contiguous, even-sized and disjoint from code/caller stack.
fun @push_fill(name: ^u8) -> void {
 var base: i32 = 0
 var seen_region: u8 = 0
 var length: i32 = 0
 var value: i32 = 0
 var seen_value: u8 = 0
 var unroll: i32 = 32
 var irq_disabled: u8 = 0
 var seen_unroll: u8 = 0
 var seen_irq: u8 = 0
 var i: u16 = 0
 while i < block_len() {
  let key: ^u8 = node_keyword(i)
  if str_eq(key, c"region") == 1 {
   if seen_region != 0 { meta_error(c"push_fill: duplicate region") }
   if node_arg_count(i) != 2 { meta_error(c"push_fill: region needs base and byte length") }
   seen_region = 1
   base = node_arg_int(i, 0)
   length = node_arg_int(i, 1)
  } else if str_eq(key, c"value") == 1 {
   if seen_value != 0 { meta_error(c"push_fill: duplicate value") }
   if node_arg_count(i) != 1 { meta_error(c"push_fill: value needs one byte") }
   seen_value = 1
   value = node_arg_int(i, 0)
  } else if str_eq(key, c"unroll") == 1 {
   if seen_unroll != 0 { meta_error(c"push_fill: duplicate unroll") }
   if node_arg_count(i) != 1 { meta_error(c"push_fill: unroll needs a PUSH count") }
   seen_unroll = 1
   unroll = node_arg_int(i, 0)
  } else if str_eq(key, c"irq") == 1 {
   if seen_irq != 0 { meta_error(c"push_fill: duplicate irq") }
   if node_arg_count(i) != 1 { meta_error(c"push_fill: irq needs disabled") }
   seen_irq = 1
   if str_eq(node_arg_str(i, 0), c"disabled") == 1 { irq_disabled = 1 }
  } else { meta_error(c"push_fill: unknown field") }
  i = i + 1
 }
 if seen_region == 0 { meta_error(c"push_fill: missing region") }
 if base < 16384 { meta_error(c"push_fill: destination must be RAM") }
 if base > 65535 { meta_error(c"push_fill: base outside address space") }
 if length <= 0 { meta_error(c"push_fill: length must be positive") }
 if length > 65536 - base { meta_error(c"push_fill: region exceeds address space") }
 if length % 2 != 0 { meta_error(c"push_fill: length must be even") }
 if seen_value == 0 { meta_error(c"push_fill: missing value") }
 if value < 0 { meta_error(c"push_fill: value outside byte range") }
 if value > 255 { meta_error(c"push_fill: value outside byte range") }
 if unroll < 1 { meta_error(c"push_fill: invalid unroll") }
 if unroll > 256 { meta_error(c"push_fill: invalid unroll") }
 if (length / 2) % unroll != 0 { meta_error(c"push_fill: unroll must divide word count") }
 let chunks: i32 = length / 2 / unroll
 if chunks > 256 { meta_error(c"push_fill: too many loop chunks") }
 if irq_disabled == 0 { meta_error(c"push_fill: requires irq disabled") }
 // Validate the symbol before constructing any ASM text.
 var cursor: ^u8 = name
 var count: u16 = 0
 while cursor^ != 0 {
  let ch: u8 = cursor^
  var valid: u8 = 0
  if ch >= 65 { if ch <= 90 { valid = 1 } }
  if ch >= 97 { if ch <= 122 { valid = 1 } }
  if ch == 95 { valid = 1 }
  if count > 0 { if ch >= 48 { if ch <= 57 { valid = 1 } } }
  if valid == 0 { meta_error(c"push_fill: invalid name") }
  count = count + 1
  if count > 80 { meta_error(c"push_fill: name too long") }
  cursor = cursor + 1
 }
 if count == 0 { meta_error(c"push_fill: empty name") }
 let prefix: ^u8 = str_concat(name, c"_push_fill_")
 emit(str_concat(c"fun ", str_concat(name, c"() -> void {")))
 emit(c"asm z80 (clob) {")
 if unroll > 126 { emit(c"PUSH AF") }
 emit(c"PUSH BC / PUSH DE")
 emit(str_concat(c"LD (", str_concat(prefix, c"restore+1), SP")))
 emit(str_concat(c"LD SP, ", str_from_int(u16(base + length))))
 emit(str_concat(c"LD DE, ", str_from_int(value * 257)))
 emit(str_concat(c"LD B, ", str_from_int(chunks % 256)))
 emit(str_concat(prefix, c"loop:"))
 var push: i32 = 0
 while push < unroll { emit(c"PUSH DE")
  push = push + 1 }
 // Short DJNZ leaves flags and A untouched. Its displacement is -(unroll+2).
 if unroll <= 126 {
  emit(str_concat(c"DJNZ ", str_concat(prefix, c"loop")))
 } else {
  // Large bodies need an absolute jump and an explicit saved flags contract.
  emit(c"DEC B")
  emit(str_concat(c"JP NZ, ", str_concat(prefix, c"loop")))
 }
 emit(str_concat(prefix, c"restore:"))
 emit(c"LD SP, 0 / POP DE / POP BC")
 if unroll > 126 { emit(c"POP AF") }
 emit(c"}")
 emit(c"}")
}
