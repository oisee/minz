// Compile-time byte-region fill. See README.md for layout and bounds contracts.
// Block arguments are static; emitted pointer loops execute at runtime.
fun @fill() -> void {
    var layout: ^u8 = c""
    var order: ^u8 = c"rows"
    var primitive: ^u8 = c"pointer"
    var base: i32 = 0
    var cols: i32 = 0
    var rows: i32 = 0
    var stride: i32 = 0
    var x: i32 = 0
    var y: i32 = 0
    var width: i32 = 0
    var height: i32 = 0
    var value: i32 = 0
    var seen_layout: u8 = 0
    var seen_region: u8 = 0
    var seen_order: u8 = 0
    var seen_value: u8 = 0
    var seen_via: u8 = 0
    var i: u16 = 0
    while i < block_len() {
        let key: ^u8 = node_keyword(i)
        if str_eq(key, c"layout") == 1 {
            if seen_layout != 0 { meta_error(c"fill: duplicate layout") }
            seen_layout = 1
            layout = node_arg_str(i, 0)
            if str_eq(layout, c"linear") == 1 {
                if node_arg_count(i) != 5 { meta_error(c"fill: linear layout needs base, columns, rows, stride") }
                base = node_arg_int(i, 1)
                cols = node_arg_int(i, 2)
                rows = node_arg_int(i, 3)
                stride = node_arg_int(i, 4)
            } else if str_eq(layout, c"zx_bitmap_bytes") == 1 {
                if node_arg_count(i) != 2 { meta_error(c"fill: ZX layout needs base") }
                base = node_arg_int(i, 1)
                cols = 32
                rows = 192
                stride = 32
            } else { meta_error(c"fill: unknown layout") }
        } else if str_eq(key, c"region") == 1 {
            if seen_region != 0 { meta_error(c"fill: duplicate region") }
            if node_arg_count(i) != 4 { meta_error(c"fill: region needs x, y, width, height") }
            seen_region = 1
            x = node_arg_int(i, 0)
            y = node_arg_int(i, 1)
            width = node_arg_int(i, 2)
            height = node_arg_int(i, 3)
        } else if str_eq(key, c"traversal") == 1 {
            if seen_order != 0 { meta_error(c"fill: duplicate traversal") }
            if node_arg_count(i) != 1 { meta_error(c"fill: traversal needs one name") }
            seen_order = 1
            order = node_arg_str(i, 0)
        } else if str_eq(key, c"value") == 1 {
            if seen_value != 0 { meta_error(c"fill: duplicate value") }
            if node_arg_count(i) != 1 { meta_error(c"fill: value needs one byte") }
            seen_value = 1
            value = node_arg_int(i, 0)
        } else if str_eq(key, c"via") == 1 {
            if seen_via != 0 { meta_error(c"fill: duplicate via") }
            if node_arg_count(i) != 1 { meta_error(c"fill: via needs one name") }
            seen_via = 1
            primitive = node_arg_str(i, 0)
        } else { meta_error(c"fill: unknown field") }
        i = i + 1
    }
    if seen_layout == 0 { meta_error(c"fill: missing layout") }
    if seen_value == 0 { meta_error(c"fill: missing value") }
    if base < 0 { meta_error(c"fill: base outside address space") }
    if base > 65535 { meta_error(c"fill: base outside address space") }
    if cols <= 0 { meta_error(c"fill: invalid dimensions") }
    if rows <= 0 { meta_error(c"fill: invalid dimensions") }
    if cols > 65535 { meta_error(c"fill: invalid dimensions") }
    if rows > 65535 { meta_error(c"fill: invalid dimensions") }
    if stride < cols { meta_error(c"fill: stride smaller than columns") }
    if stride > 65535 { meta_error(c"fill: invalid stride") }
    let extent: u32 = u32(rows - 1) * u32(stride) + u32(cols - 1)
    if extent > u32(65535 - base) { meta_error(c"fill: layout exceeds address space") }
    if value < 0 { meta_error(c"fill: value outside byte range") }
    if value > 255 { meta_error(c"fill: value outside byte range") }
    if seen_region == 0 { width = cols
        height = rows }
    if x < 0 { meta_error(c"fill: region outside layout") }
    if y < 0 { meta_error(c"fill: region outside layout") }
    if width < 0 { meta_error(c"fill: region outside layout") }
    if height < 0 { meta_error(c"fill: region outside layout") }
    if x > cols { meta_error(c"fill: region outside layout") }
    if y > rows { meta_error(c"fill: region outside layout") }
    if width > cols - x { meta_error(c"fill: region outside layout") }
    if height > rows - y { meta_error(c"fill: region outside layout") }
    if str_eq(order, c"rows") == 0 {
        if str_eq(order, c"storage") == 0 { meta_error(c"fill: unknown traversal") }
        if x != 0 { meta_error(c"fill: storage needs whole layout") }
        if y != 0 { meta_error(c"fill: storage needs whole layout") }
        if width != cols { meta_error(c"fill: storage needs whole layout") }
        if height != rows { meta_error(c"fill: storage needs whole layout") }
    }
    if str_eq(primitive, c"pointer") == 0 {
        if str_eq(primitive, c"ldir") == 0 { meta_error(c"fill: unknown primitive") }
    }
    if width == 0 { return }
    if height == 0 { return }
    // A constant whole-screen fill may use storage order: all bytes equal.
    var contiguous: u8 = 0
    if str_eq(layout, c"linear") == 1 {
        if width == stride { contiguous = 1 }
    } else {
        if x == 0 {
            if y == 0 {
                if width == 32 {
                    if height == 192 { contiguous = 1 }
                }
            }
        }
    }
    if u32(width) * u32(height) > 65535 { contiguous = 0 }
    var row: i32 = 0
    while row < height {
        var address: i32 = base + (y + row) * stride + x
        if str_eq(layout, c"zx_bitmap_bytes") == 1 {
            let scan: i32 = y + row
            address = base + ((scan & 192) << 5) + ((scan & 7) << 8) + ((scan & 56) << 2) + x
        }
        var length: i32 = width
        if contiguous == 1 { length = width * height }
        if str_eq(primitive, c"ldir") == 1 {
            // Seed once, then copy the growing filled prefix into the next byte.
            // Zero regions returned above; singleton must never execute BC=0 LDIR.
            emit(c"asm z80 (clob) {")
            if length > 1 {
                emit(c"PUSH AF")
                emit(c"PUSH BC")
                emit(c"PUSH DE")
            }
            emit(c"PUSH HL")
            emit(str_concat(c"LD HL, ", str_from_int(address)))
            emit(str_concat(c"LD (HL), ", str_from_int(value)))
            if length > 1 {
                emit(str_concat(c"LD DE, ", str_from_int(address + 1)))
                emit(str_concat(c"LD BC, ", str_from_int(length - 1)))
                emit(c"LDIR")
            }
            emit(c"POP HL")
            if length > 1 {
                emit(c"POP DE")
                emit(c"POP BC")
                emit(c"POP AF")
            }
            emit(c"}")
        } else {
            // Build the runtime loop as typed HIR, without parsing generated text.
            let region: u16 = hir_block()
            let pointer: u16 = hir_ref(c"fill_ptr", c"ptr")
            var counter_type: ^u8 = c"u16"
            if length < 256 { counter_type = c"u8" }
            let counter: u16 = hir_ref(c"fill_left", counter_type)
            hir_append(region, hir_var(c"fill_ptr", c"ptr", hir_int(u16(address), c"ptr")))
            hir_append(region, hir_var(c"fill_left", counter_type, hir_int(u16(length), counter_type)))
            let body: u16 = hir_block()
            hir_append(body, hir_store(pointer, hir_int(u16(value), c"u8")))
            hir_append(body, hir_assign(pointer, hir_binary(c"+", pointer, hir_int(1, c"u8"))))
            hir_append(body, hir_assign(counter, hir_binary(c"-", counter, hir_int(1, counter_type))))
            hir_append(region, hir_while(hir_binary(c"!=", counter, hir_int(0, counter_type)), body))
            emit_hir(region)
        }
        if contiguous == 1 { return }
        row = row + 1
    }
}
