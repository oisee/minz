// Named mutable compiled sprite. Code and patch operands must live in owned RAM.
// PUSH form requires even byte width, opaque masks, and caller-disabled IRQ.
// Direct form is a normal ABI leaf: baked rows fall through, then ordinary RET.
fun @sprite_chain(name: ^u8) -> void {
    var layout: ^u8 = c""
    var mask_row_count: i32 = 0
    var primitive: ^u8 = c"compiled"
    var irq_disabled: u8 = 0
    var base: i32 = 0
    var cols: i32 = 0
    var rows: i32 = 0
    var stride: i32 = 0
    var x: i32 = 0
    var y: i32 = 0
    var width: i32 = 0
    var height: i32 = 0
    var seen_layout: u8 = 0
    var seen_region: u8 = 0
    var seen_via: u8 = 0
    var i: u16 = 0
    while i < block_len() {
        let key: ^u8 = node_keyword(i)
        if str_eq(key, c"destination") == 1 {
            if seen_layout != 0 { meta_error(c"sprite: duplicate layout") }
            seen_layout = 1
            layout = node_arg_str(i, 0)
            if str_eq(layout, c"linear") == 1 {
                if node_arg_count(i) != 5 { meta_error(c"sprite: linear layout needs base, columns, rows, stride") }
                base = node_arg_int(i, 1)
                cols = node_arg_int(i, 2)
                rows = node_arg_int(i, 3)
                stride = node_arg_int(i, 4)
            } else if str_eq(layout, c"zx_bitmap_bytes") == 1 {
                if node_arg_count(i) != 2 { meta_error(c"sprite: ZX layout needs base") }
                base = node_arg_int(i, 1)
                cols = 32
                rows = 192
                stride = 32
            } else { meta_error(c"sprite: unknown layout") }
        } else if str_eq(key, c"region") == 1 {
            if seen_region != 0 { meta_error(c"sprite: duplicate region") }
            if node_arg_count(i) != 4 { meta_error(c"sprite: region needs x, y, width, height") }
            seen_region = 1
            x = node_arg_int(i, 0)
            y = node_arg_int(i, 1)
            width = node_arg_int(i, 2)
            height = node_arg_int(i, 3)
        } else if str_eq(key, c"row") == 1 {
            if node_arg_count(i) != 2 { meta_error(c"sprite: row needs hex mask and graphics") }
            mask_row_count = mask_row_count + 1
        } else if str_eq(key, c"via") == 1 {
            if seen_via != 0 { meta_error(c"sprite: duplicate via") }
            if node_arg_count(i) != 1 { meta_error(c"sprite: via needs one name") }
            seen_via = 1
            primitive = node_arg_str(i, 0)
        } else if str_eq(key, c"irq") == 1 {
            if irq_disabled != 0 { meta_error(c"sprite_chain: duplicate irq") }
            if node_arg_count(i) != 1 { meta_error(c"sprite_chain: irq needs disabled") }
            if str_eq(node_arg_str(i, 0), c"disabled") == 0 { meta_error(c"sprite_chain: irq needs disabled") }
            irq_disabled = 1
        } else { meta_error(c"sprite: unknown field") }
        i = i + 1
    }
    if seen_layout == 0 { meta_error(c"sprite: missing layout") }
    if base < 0 { meta_error(c"sprite: base outside address space") }
    if base > 65535 { meta_error(c"sprite: base outside address space") }
    if cols <= 0 { meta_error(c"sprite: invalid dimensions") }
    if rows <= 0 { meta_error(c"sprite: invalid dimensions") }
    if cols > 65535 { meta_error(c"sprite: invalid dimensions") }
    if rows > 65535 { meta_error(c"sprite: invalid dimensions") }
    if stride < cols { meta_error(c"sprite: stride smaller than columns") }
    if stride > 65535 { meta_error(c"sprite: invalid stride") }
    let extent: u32 = u32(rows - 1) * u32(stride) + u32(cols - 1)
    if extent > u32(65535 - base) { meta_error(c"sprite: layout exceeds address space") }
    if seen_region == 0 { meta_error(c"sprite: missing region") }
    if x < 0 { meta_error(c"sprite: region outside layout") }
    if y < 0 { meta_error(c"sprite: region outside layout") }
    if width < 0 { meta_error(c"sprite: region outside layout") }
    if height < 0 { meta_error(c"sprite: region outside layout") }
    if x > cols { meta_error(c"sprite: region outside layout") }
    if y > rows { meta_error(c"sprite: region outside layout") }
    if width > cols - x { meta_error(c"sprite: region outside layout") }
    if height > rows - y { meta_error(c"sprite: region outside layout") }
    if mask_row_count != height { meta_error(c"sprite: row count differs from height") }
    if str_eq(primitive, c"compiled") == 0 {
      if str_eq(primitive, c"direct") == 0 {
        if str_eq(primitive, c"push") == 0 { meta_error(c"sprite_chain: unknown primitive") }
        if irq_disabled == 0 { meta_error(c"sprite_chain: push requires irq disabled") }
        if width % 2 != 0 { meta_error(c"sprite_chain: push requires even width") }
      } else {
        if width == 0 | height == 0 { meta_error(c"sprite_chain: direct requires nonempty rows") }
        if str_eq(layout,c"zx_bitmap_bytes") == 1 {
            if base % 2048 != 0 { meta_error(c"sprite_chain: direct requires aligned ZX base for DOWN_HL") }
        }
      }
    }
    // Only safe assembler identifiers may enter generated symbol names.
    var cursor: ^u8 = name
    var namelen: u16 = 0
    if cursor^ == 0 { meta_error(c"sprite_chain: empty name") }
    while cursor^ != 0 {
        let ch: u8 = cursor^
        var valid: u8 = 0
        if ch >= 65 { if ch <= 90 { valid = 1 } }
        if ch >= 97 { if ch <= 122 { valid = 1 } }
        if ch == 95 { valid = 1 }
        if namelen > 0 { if ch >= 48 { if ch <= 57 { valid = 1 } } }
        if valid == 0 { meta_error(c"sprite_chain: invalid name") }
        namelen = namelen + 1
        if namelen > 80 { meta_error(c"sprite_chain: name too long") }
        cursor = cursor + 1
    }
    // Emit the JP opcode explicitly: peepholes must not elide mutable links.
    let prefix: ^u8 = str_concat(name, c"_chain_")
    emit(str_concat(c"fun ", str_concat(name, c"() -> void {")))
    if str_eq(primitive, c"direct") == 1 { emit(c"asm z80 {") }
    else { emit(c"asm z80 (clob) {")
      emit(c"PUSH AF / PUSH BC / PUSH DE / PUSH HL")
    }
    if str_eq(primitive, c"push") == 1 {
        emit(str_concat(c"LD (", str_concat(prefix, c"restore+1), SP")))
    }
    emit(str_concat(prefix, c"entry:"))
    if str_eq(primitive, c"direct") == 0 {
    if height == 0 { emit(c"DB 195")
        emit(str_concat(c"DW ", str_concat(prefix, c"done"))) }
    else { emit(c"DB 195")
    emit(str_concat(c"DW ", str_concat(prefix, c"row_0"))) }
    }
    // Decode bytes on the compile-time VM, then emit only the resulting work.
    var row: i32 = 0
    i = 0
    while i < block_len() {
        if str_eq(node_keyword(i), c"row") == 1 {
            let masks: ^u8 = node_arg_str(i, 0)
            let graphics: ^u8 = node_arg_str(i, 1)
            var mlen: i32 = 0
            var glen: i32 = 0
            while masks[mlen] != 0 { mlen = mlen + 1 }
            while graphics[glen] != 0 { glen = glen + 1 }
            if mlen != width * 2 { meta_error(c"sprite: mask width mismatch") }
            if glen != width * 2 { meta_error(c"sprite: graphics width mismatch") }
            var address: i32 = base + (y + row) * stride + x
            if str_eq(layout, c"zx_bitmap_bytes") == 1 {
                let scan: i32 = y + row
                address = base + ((scan & 192) << 5) + ((scan & 7) << 8) + ((scan & 56) << 2) + x
            }
            let rowname: ^u8 = str_concat(prefix, str_concat(c"row_", str_from_int(row)))
            emit(str_concat(rowname, c":"))
            if str_eq(primitive, c"push") == 1 {
                emit(str_concat(c"LD SP, ", str_from_int(u16(address + width))))
            } else { emit(str_concat(c"LD HL, ", str_from_int(address))) }
            var pair_high: u8 = 0
            var row_writes: u8 = 0
            var col: i32 = 0
            while col < width {
                var actual_col: i32 = col
                if str_eq(primitive, c"push") == 1 { actual_col = width - 1 - col }
                var mask: u8 = 0
                var graphic: u8 = 0
                var digit: i32 = 0
                while digit < 4 {
                    var ch: u8 = 0
                    if digit < 2 { ch = masks[actual_col * 2 + digit] }
                    else { ch = graphics[actual_col * 2 + digit - 2] }
                    var nibble: u8 = 255
                    if ch >= 48 { if ch <= 57 { nibble = ch - 48 } }
                    if ch >= 65 { if ch <= 70 { nibble = ch - 55 } }
                    if ch >= 97 { if ch <= 102 { nibble = ch - 87 } }
                    if nibble == 255 { meta_error(c"sprite: invalid hex digit") }
                    if digit < 2 { mask = mask * 16 + nibble }
                    else { graphic = graphic * 16 + nibble }
                    digit = digit + 1
                }
                if str_eq(primitive, c"push") == 1 {
                    if mask != 0 { meta_error(c"sprite_chain: push requires opaque masks") }
                    if col % 2 == 0 { pair_high = graphic }
                    else {
                        let pair: u16 = u16(pair_high) * 256 + u16(graphic)
                        emit(str_concat(c"LD DE, ", str_from_int(pair)))
                        emit(c"PUSH DE")
                    }
                } else {
                    if mask == 0 { emit(str_concat(c"LD (HL), ", str_from_int(graphic)))
                        row_writes = 1
                    }
                    else {
                        if mask != 255 | graphic != 0 {
                            emit(c"LD A, (HL)")
                            emit(str_concat(c"AND ", str_from_int(mask)))
                            emit(str_concat(c"OR ", str_from_int(graphic)))
                            emit(c"LD (HL), A")
                            row_writes = 1
                        }
                    }
                    if col + 1 < width { emit(c"INC HL") }
                }
                col = col + 1
            }
            if str_eq(primitive, c"direct") == 1 {
                // A memory access anchors each mutable LD HL immediate through
                // text peepholes. Purely transparent rows need patch metadata.
                if row_writes == 0 { meta_error(c"sprite_chain: direct requires a write in each row") }
            } else {
            emit(str_concat(rowname, c"_next:"))
            if row + 1 == height { emit(c"DB 195")
        emit(str_concat(c"DW ", str_concat(prefix, c"done"))) }
            else { emit(c"DB 195")
    emit(str_concat(c"DW ", str_concat(prefix, str_concat(c"row_", str_from_int(row + 1))))) }
            }
            row = row + 1
        }
        i = i + 1
    }
    emit(str_concat(prefix, c"done:"))
    if str_eq(primitive, c"push") == 1 {
        emit(str_concat(prefix, c"restore:"))
        emit(c"LD SP, 0")
    }
    if str_eq(primitive, c"direct") == 0 { emit(c"POP HL / POP DE / POP BC / POP AF") }
    emit(c"}")
    emit(c"}")
    if str_eq(primitive, c"direct") == 1 {
        emit(str_concat(c"fun ", str_concat(name, c"_address() -> u16 {")))
        emit(str_concat(c"asm z80 (ret HL) { LD HL, ", str_concat(name, c" }")))
        emit(c"}")
        if str_eq(layout, c"zx_bitmap_bytes") == 1 {
            // Position the complete baked sprite from ONE screen address.
            // Antique Toy ch02 DOWN_HL: ordinary rows, character and third
            // boundaries. Compact CALL and inline recipes remain measured
            // alternatives. Ordinary CPU word stores patch known operands.
            var recipe: u8 = 0
            while recipe < 2 {
                var walk_name: ^u8 = str_concat(name, c"_position")
                if recipe == 1 { walk_name = str_concat(walk_name, c"_inline") }
                emit(str_concat(c"fun ", str_concat(walk_name, c"(address:u16) -> void {")))
                emit(c"asm z80 (in address) {")
                var walk_row: i32 = 0
                while walk_row < height {
                    let patch: ^u8 = str_concat(prefix, str_concat(c"row_", str_from_int(walk_row)))
                    emit(str_concat(c"LD (", str_concat(patch, c"+1), HL")))
                    if walk_row + 1 < height {
                        if recipe == 0 { emit(str_concat(c"CALL ", str_concat(prefix, c"down_hl"))) }
                        else {
                            let next_patch: ^u8 = str_concat(prefix, str_concat(c"walk_next_", str_from_int(walk_row)))
                            emit(c"INC H / LD A,H / AND 7")
                            emit(str_concat(c"JR NZ, ", next_patch))
                            emit(c"LD A,L / ADD A,32 / LD L,A")
                            emit(str_concat(c"JR C, ", next_patch))
                            emit(c"LD A,H / SUB 8 / LD H,A")
                            emit(str_concat(next_patch,c":"))
                        }
                    }
                    walk_row = walk_row + 1
                }
                if recipe == 0 {
                    emit(c"RET")
                    emit(str_concat(prefix,c"down_hl:"))
                    emit(c"INC H / LD A,H / AND 7 / RET NZ")
                    emit(c"LD A,L / ADD A,32 / LD L,A / RET C")
                    emit(c"LD A,H / SUB 8 / LD H,A / RET")
                }
                emit(c"}")
                emit(c"}")
                recipe = recipe + 1
            }
        }
    }
    // Named helpers keep immediate locations symbolic through assembly.
    var helper: i32 = 0
    while helper < height + 2 {
        var suffix: ^u8 = c"entry"
        var target: ^u8 = str_concat(prefix, c"entry")
        if helper < height {
            suffix = str_concat(c"row_", str_from_int(helper))
            target = str_concat(prefix, suffix)
        } else if helper == height + 1 {
            suffix = c"done"
            target = str_concat(prefix, c"done")
        }
        emit(str_concat(c"fun ", str_concat(name, str_concat(c"_", str_concat(suffix, c"_address() -> u16 {")))))
        var address_head: ^u8 = c"asm z80 (ret HL) (clob) { LD HL, "
        if str_eq(primitive, c"direct") == 1 { address_head = c"asm z80 (ret HL) { LD HL, " }
        emit(str_concat(address_head, str_concat(target, c" }")))
        emit(c"}")
        if helper < height + 1 {
          if str_eq(primitive, c"direct") == 0 | helper < height {
            emit(str_concat(c"fun ", str_concat(name, str_concat(c"_set_", str_concat(suffix, c"(address: u16) -> void {")))))
            var patch_head: ^u8 = c"asm z80 (in address) (clob) { LD ("
            if str_eq(primitive, c"direct") == 1 { patch_head = c"asm z80 (in address) { LD (" }
            emit(str_concat(patch_head, str_concat(target, c"+1), HL }")))
            emit(c"}")
          }
        }
        if helper < height & str_eq(primitive, c"direct") == 0 {
            emit(str_concat(c"fun ", str_concat(name, str_concat(c"_set_next_", str_concat(str_from_int(helper), c"(address: u16) -> void {")))))
            emit(str_concat(c"asm z80 (in address) (clob) { LD (", str_concat(target, c"_next+1), HL }")))
            emit(c"}")
        }
        helper = helper + 1
    }
}
