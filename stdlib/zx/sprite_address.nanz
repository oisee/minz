// Pixel coordinates; x must be byte aligned and the caller checks bounds.
fun sprite_address(x:u8,y:u8)->u16 {
    let scan:u16=u16(y)
    return 0x4000 | ((scan & 192) << 5) | ((scan & 7) << 8) | ((scan & 56) << 2) | u16(x >> 3)
}

// Antique Toy ch02 DOWN_HL, expressed as ordinary Nanz byte-address arithmetic.
// Caller ensures another scanline remains within the 192-line bitmap.
fun sprite_next_line(address:u16)->u16 {
    var next:u16=address+256
    if (next & 0x0700)==0 {
        let low:u16=(next & 255)+32
        next=(next & 0xff00) | (low & 255)
        if low < 256 { next=next-2048 }
    }
    return next
}
