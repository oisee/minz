// Pixel coordinates; x must be byte aligned and the caller checks bounds.
fun sprite_address(x:u8,y:u8)->u16 {
    let high:u8=0x40+(y>>6)*8+(y&7)
    let low:u8=((y>>3)&7)*32+(x>>3)
    return u16(high)*256+u16(low)
}

// Antique Toy ch02 DOWN_HL: increment H, then L without carrying into H.
// u8 addition deliberately wraps; lower < 32 means the L update carried.
// Caller ensures another scanline remains within the 192-line bitmap.
fun sprite_next_line(address:u16)->u16 {
    var high:u8=u8(address>>8)+1
    var low:u8=u8(address)
    if (high & 7)==0 {
        low=low+32
        if low>=32 {high=high-8}
    }
    return u16(high)*256+u16(low)
}
