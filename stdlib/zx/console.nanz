// ============================================================================
// stdlib/zx/console.nanz — ZX Spectrum standalone console (no ROM dependency)
// ============================================================================
//
// Text output using ROM font bitmap data at $3D00 (read-only).
// Direct screen memory writes — no RST, no CALL into ROM, no IM1.
// Keyboard input via port $FE matrix scanning.
//
// Usage:
//   import zx.console { * }
//
//   fun main() -> void {
//       con_init(7, 0)           // white ink on black paper
//       con_clear()
//       con_print("Hello ZX!")
//       let ch: u8 = con_getchar()
//   }
// ============================================================================

// ── ZX Spectrum hardware constants ──────────────────────────────────────────

const FONT_ADDR: u16 = 0x3D00    // ROM font: 96 chars (ASCII 32-127), 8 bytes each
const SCREEN_BASE: u16 = 0x4000
const ATTR_BASE: u16 = 0x5800
const SCREEN_COLS: u8 = 32
const SCREEN_ROWS: u8 = 24

// ── Console state ───────────────────────────────────────────────────────────

global con_col: u8 = 0           // cursor column (0-31)
global con_row: u8 = 0           // cursor row (0-23)
global con_attr: u8 = 0x07       // attribute byte (default: white ink, black paper)

// ── Low-level hardware access ───────────────────────────────────────────────

fun zx_poke(@z80_hl addr: u16, @z80_a val: u8) -> void {
    asm z80 (in addr, val) { LD (HL), A }
}

fun zx_peek(@z80_hl addr: u16) -> u8 {
    asm z80 (in addr) { LD A, (HL) }
}

fun zx_in_fe(@z80_a high_byte: u8) -> u8 {
    asm z80 (in high_byte) { IN A, (0xFE) }
}

fun zx_border(@z80_a color: u8) -> void {
    asm z80 (in color) { OUT (0xFE), A }
}

// ── Screen address calculation ──────────────────────────────────────────────
//
// ZX Spectrum screen layout (non-linear):
//   H = 010 TT SSS   (TT = row/8 = third, SSS = line within char)
//   L = RRR CCCCC    (RRR = row%8 shifted to bits 7-5, CCCCC = col)
//
// Optimal bit-shift version: ~27 T-states, no multiplication.
// Based on antique-toy/ch16-sprites pixel_addr_byte.
//
// Input: col (0-31), row (0-23 char row), line (0-7 pixel line within char)
// Output: HL = screen address
//
// Char row y maps to pixel row y*8+line. The full pixel y = row*8 + line.
//   pixel_y bits: TT LLL SSS  where TT=third (0-2), LLL=line (0-7), SSS=row%8

fun screen_addr(@z80_a col: u8, @z80_b row: u8, @z80_c line: u8) -> u16 {
    // H = 010 TT SSS  (TT=row>>3, SSS=line)
    // L = RRR CCCCC   (RRR=row%8<<5, CCCCC=col)
    asm z80 (in col, row, line) (ret HL) {
        LD D, A         ; D = col
        LD A, B         ; A = row
        AND 0x18        ; TT bits
        OR C            ; combine with line
        OR 0x40         ; screen base
        LD H, A
        LD A, B         ; A = row
        AND 0x07        ; sub-row
        RRCA
        RRCA
        RRCA            ; shift left 5
        OR D            ; combine with col
        LD L, A
    }
}

fun attr_addr(@z80_a col: u8, @z80_b row: u8) -> u16 {
    // Attr = $5800 + row*32 + col
    asm z80 (in col, row) (ret HL) {
        LD D, A         ; D = col
        LD A, B         ; A = row
        RRCA
        RRCA
        RRCA            ; row * 32
        LD L, A
        AND 0xE0
        OR D
        LD L, A
        LD A, B         ; A = row again
        RRCA
        RRCA
        RRCA
        AND 0x03
        OR 0x58         ; attr base
        LD H, A
    }
}

// ── Initialization ──────────────────────────────────────────────────────────

fun con_init(ink: u8, paper: u8) -> void {
    con_attr = (paper << 3) | ink
    con_col = 0
    con_row = 0
}

fun con_clear() -> void {
    asm z80 {
        ; Clear pixel RAM: $4000-$57FF (6144 bytes) → 0
        LD HL, 0x4000
        LD DE, 0x4001
        LD BC, 6143
        LD (HL), 0
        LDIR
        ; Set attributes: $5800-$5AFF (768 bytes) → con_attr
        LD HL, 0x5800
        LD DE, 0x5801
        LD BC, 767
        LD A, (zx__console__con_attr)
        LD (HL), A
        LDIR
        ; Reset cursor
        XOR A
        LD (zx__console__con_col), A
        LD (zx__console__con_row), A
    }
}

// ── Character output ────────────────────────────────────────────────────────

fun con_putchar(@z80_a ch: u8) -> void {
 asm z80 (in ch) (clob A,F,BC,DE,HL,IX,IY) {
  CP 13
  JR Z, .newline
  CP 10
  JR Z, .newline
  CP 8
  JR Z, .backspace
  LD C, A
  LD A, (zx__console__con_col)
  LD B, A
  LD A, (zx__console__con_row)
  LD D, A
  CALL zx__console__con_draw_char
  LD A, (zx__console__con_col)
  INC A
  CP 32
  JR NC, .newline
  LD (zx__console__con_col), A
  RET
 .newline:
  XOR A
  LD (zx__console__con_col), A
  LD A, (zx__console__con_row)
  INC A
  CP 24
  JR NC, .scroll
  LD (zx__console__con_row), A
  RET
 .scroll:
  LD A, 23
  LD (zx__console__con_row), A
  JP zx__console__con_scroll
 .backspace:
  LD A, (zx__console__con_row)
  LD D, A
  LD A, (zx__console__con_col)
  OR A
  JR NZ, .previous_col
  LD A, D
  OR A
  RET Z
  DEC A
  LD (zx__console__con_row), A
  LD D, A
  LD A, 32
 .previous_col:
  DEC A
  LD (zx__console__con_col), A
  LD B, A
  LD C, 32
  JP zx__console__con_draw_char
 }
}

fun con_draw_char(@z80_b col: u8, @z80_d row: u8, @z80_c ch: u8) -> void {
    // Explicit register ABI: the ASM body reads col=B, row=D, ch=C.
    asm z80 (in col, row, ch) {
        ; Entry: B=col, D=row, C=ch
        LD IYL, B           ; IYL = col
        LD IYH, D           ; IYH = row

        ; Compute font_ptr = $3D00 + (ch - 32) * 8
        LD A, C             ; A = ch
        SUB 32
        LD L, A
        LD H, 0
        ADD HL, HL
        ADD HL, HL
        ADD HL, HL
        LD DE, 0x3D00
        ADD HL, DE
        EX DE, HL           ; DE = font_ptr

        ; Draw 8 pixel lines
        LD B, 8
        LD C, 0
    .line_loop:
        PUSH DE
        PUSH BC
        LD A, IYH
        AND 0x18
        OR C
        OR 0x40
        LD H, A
        LD A, IYH
        AND 0x07
        RRCA
        RRCA
        RRCA
        OR IYL
        LD L, A
        POP BC
        POP DE
        LD A, (DE)
        LD (HL), A
        INC DE
        INC C
        DJNZ .line_loop

        ; Set attribute
        LD A, IYH
        RRCA
        RRCA
        RRCA
        LD L, A
        AND 0xE0
        OR IYL
        LD L, A
        LD A, IYH
        RRCA
        RRCA
        RRCA
        AND 0x03
        OR 0x58
        LD H, A
        LD A, (zx__console__con_attr)
        LD (HL), A
    }
}

fun con_print(str: ^u8) -> void {
    var i: u16 = 0
    while str[i] != 0 {
        con_putchar(str[i])
        i = i + 1
    }
}

fun con_goto(col: u8, row: u8) -> void {
    con_col = col
    con_row = row
}

fun con_set_attr(ink: u8, paper: u8) -> void {
    con_attr = (paper << 3) | ink
}

fun con_set_bright(on: u8) -> void {
    if on != 0 {
        con_attr = con_attr | 0x40
    } else {
        con_attr = con_attr & 0xBF
    }
}

// ── Scrolling ───────────────────────────────────────────────────────────────

fun scroll_line(row: u8, line: u8) -> void {
    let dst: u16 = screen_addr(0, row, line)
    let src: u16 = screen_addr(0, row + 1, line)
    for col in 0..32 {
        zx_poke(dst + u16(col), zx_peek(src + u16(col)))
    }
}

fun scroll_row(row: u8) -> void {
    for line in 0..8 {
        scroll_line(row, line)
    }
}

fun scroll_attrs(row: u8) -> void {
    let dst: u16 = attr_addr(0, row)
    let src: u16 = attr_addr(0, row + 1)
    for col in 0..32 {
        zx_poke(dst + u16(col), zx_peek(src + u16(col)))
    }
}

// Copy upward in each interleaved pixel plane; boundary rows come from
// the next 2K third. Forward LDIR is safe because destination precedes source.
fun con_scroll() -> void {
 asm z80 (clob A, F, BC, DE, HL, IX, IY) {
  LD IX, 0x4000
  LD IYL, 3
 .third:
  LD IYH, 0
 .plane:
  PUSH IX
  POP HL
  LD A, H
  ADD A, IYH
  LD H, A
  LD D, H
  LD E, L
  LD BC, 32
  ADD HL, BC
  LD BC, 224
  LDIR
  LD A, IYL
  CP 1
  JR Z, .clear
  LD BC, 0x700
  ADD HL, BC
  LD BC, 32
  LDIR
  JR .next
 .clear:
  XOR A
  LD B, 32
 .clear_loop:
  LD (DE), A
  INC DE
  DJNZ .clear_loop
 .next:
  INC IYH
  LD A, IYH
  CP 8
  JR NZ, .plane
  LD BC, 0x800
  ADD IX, BC
  DEC IYL
  JR NZ, .third
  LD HL, 0x5820
  LD DE, 0x5800
  LD BC, 736
  LDIR
  LD A, (zx__console__con_attr)
  LD B, 32
 .attrs:
  LD (DE), A
  INC DE
  DJNZ .attrs
 }
}

// Scroll character rows top..23, preserving all rows above top.
// Useful for a fixed status/upper window; top >=24 leaves the screen intact.
fun con_scroll_region(@z80_a top: u8) -> void {
 asm z80 (in top) (clob A,F,BC,DE,HL,IX,IY) {
  CP 24
  RET NC
  LD IYL, A
 .row:
  LD IYH, 0
 .plane:
  LD A, IYL
  AND 0x18
  OR IYH
  OR 0x40
  LD D, A
  LD A, IYL
  AND 7
  RRCA
  RRCA
  RRCA
  LD E, A
  LD A, IYL
  CP 23
  JR Z, .clear
  INC A
  PUSH AF
  AND 0x18
  OR IYH
  OR 0x40
  LD H, A
  POP AF
  AND 7
  RRCA
  RRCA
  RRCA
  LD L, A
  LD BC, 32
  LDIR
  JR .next_plane
 .clear:
  XOR A
  LD B, 32
 .clear_pixels:
  LD (DE), A
  INC DE
  DJNZ .clear_pixels
 .next_plane:
  INC IYH
  LD A, IYH
  CP 8
  JR NZ, .plane
  ; Attribute address = $5800 + row*32.
  LD A, IYL
  LD L, A
  LD H, 0
  ADD HL, HL
  ADD HL, HL
  ADD HL, HL
  ADD HL, HL
  ADD HL, HL
  LD DE, 0x5800
  ADD HL, DE
  EX DE, HL
  LD A, IYL
  CP 23
  JR Z, .clear_attrs
  LD H, D
  LD L, E
  LD BC, 32
  ADD HL, BC
  LDIR
  JR .next_row
 .clear_attrs:
  LD A, (zx__console__con_attr)
  LD B, 32
 .attr_loop:
  LD (DE), A
  INC DE
  DJNZ .attr_loop
 .next_row:
  INC IYL
  LD A, IYL
  CP 24
  JR NZ, .row
 }
}

// ── Print helpers ───────────────────────────────────────────────────────────

fun con_newline() -> void {
    con_putchar(10)
}

fun con_print_u8(val: u8) -> void {
    var n: u8 = val
    var d2: u8 = 0
    while n >= 100 {
        d2 = d2 + 1
        n = n - 100
    }
    var d1: u8 = 0
    while n >= 10 {
        d1 = d1 + 1
        n = n - 10
    }
    if d2 > 0 { con_putchar(48 + d2) }
    if d2 > 0 | d1 > 0 { con_putchar(48 + d1) }
    con_putchar(48 + n)
}

fun con_print_u16(val: u16) -> void {
    var n: u16 = val
    var d4: u8 = 0
    while n >= 10000 {
        d4 = d4 + 1
        n = n - 10000
    }
    var d3: u8 = 0
    while n >= 1000 {
        d3 = d3 + 1
        n = n - 1000
    }
    var d2: u8 = 0
    while n >= 100 {
        d2 = d2 + 1
        n = n - 100
    }
    var d1: u8 = 0
    while n >= 10 {
        d1 = d1 + 1
        n = n - 10
    }
    let d0: u8 = u8(n)
    var started: u8 = 0
    if d4 > 0 {
        con_putchar(48 + d4)
        started = 1
    }
    if started == 1 | d3 > 0 {
        con_putchar(48 + d3)
        started = 1
    }
    if started == 1 | d2 > 0 {
        con_putchar(48 + d2)
        started = 1
    }
    if started == 1 | d1 > 0 {
        con_putchar(48 + d1)
    }
    con_putchar(48 + d0)
}

// ── Keyboard input ──────────────────────────────────────────────────────────
//
// ZX Spectrum keyboard matrix (active low, bit 0-4):
//   $FE: CS  Z  X  C  V         $EF: 0  9  8  7  6
//   $FD: A   S  D  F  G         $DF: P  O  I  U  Y
//   $FB: Q   W  E  R  T         $BF: EN L  K  J  H
//   $F7: 1   2  3  4  5         $7F: SP SS M  N  B
//
// We scan all half-rows. If exactly one key is pressed, return its ASCII code.
// CAPS SHIFT ($FE bit0) modifies the key.

// Key lookup tables: half-row address, then 5 keys per row (bit0..bit4)
global KBD_ROWS: [u8; 8] = [ 0xFE, 0xFD, 0xFB, 0xF7, 0xEF, 0xDF, 0xBF, 0x7F ]
global KBD_KEYS: [u8; 40] = [
    0,    122, 120, 99,  118,     // CS, z, x, c, v
    97,   115, 100, 102, 103,     // a, s, d, f, g
    113,  119, 101, 114, 116,     // q, w, e, r, t
    49,   50,  51,  52,  53,      // 1, 2, 3, 4, 5
    48,   57,  56,  55,  54,      // 0, 9, 8, 7, 6
    112,  111, 105, 117, 121,     // p, o, i, u, y
    13,   108, 107, 106, 104,     // ENTER, l, k, j, h
    32,   0,   109, 110, 98       // SPACE, SS, m, n, b
]

fun scan_row_key(row_addr: u8, base_idx: u8) -> u8 {
    var row_val: u8 = zx_in_fe(row_addr)
    if row_addr == 0xfe { row_val = row_val | 1 }
    if row_addr == 0x7f { row_val = row_val | 2 }
    if (row_val & 1) == 0 { return KBD_KEYS[base_idx] }
    if (row_val & 2) == 0 { return KBD_KEYS[base_idx + 1] }
    if (row_val & 4) == 0 { return KBD_KEYS[base_idx + 2] }
    if (row_val & 8) == 0 { return KBD_KEYS[base_idx + 3] }
    if (row_val & 16) == 0 { return KBD_KEYS[base_idx + 4] }
    return 0
}

fun any_key_pressed() -> u8 {
    for r in 0..8 {
        let row_val: u8 = zx_in_fe(KBD_ROWS[r])
        if (row_val & 0x1F) != 0x1F {
            return 1
        }
    }
    return 0
}

fun con_getchar() -> u8 {
    // Wait until no key pressed (clean state)
    while any_key_pressed() != 0 { }

    // Wait for a key press
    var result: u8 = 0
    while result == 0 {
        for r in 0..8 {
            let key: u8 = scan_row_key(KBD_ROWS[r], r * 5)
            if key != 0 {
                result = key
            }
        }
    }

    // CAPS SHIFT controls follow the Spectrum legends; codes 8..11 are
    // delete/left/down/up and 12 is right. Uppercase letters remain available.
    let cs_row: u8 = zx_in_fe(0xFE)
    if (cs_row & 1) == 0 {
        if result == 48 { return 8 }
        if result == 53 { return 9 }
        if result == 54 { return 10 }
        if result == 55 { return 11 }
        if result == 56 { return 12 }
        if result >= 97 {
            if result <= 122 {
                result = result - 32
            }
        }
    }

    return result
}

// Four previous commands (up/down), with a draft restored below newest.
// Line capacity is 79 bytes plus NUL. History is console state, not game SAVE.
global con_history: [u8;320]
global con_history_length: [u8;4]
global con_history_count: u8
global con_draft: [u8;80]
global con_draft_length: u8

global con_edit_buf:u16
global con_edit_anchor:u16
global con_edit_length:u8
global con_edit_cursor:u8
global con_edit_limit:u8
global con_edit_history:u8
global con_edit_old:u8

// Compact resident editor. All scratch is console state; non-reentrant.
fun con_input(@z80_hl buf:^u8, @z80_a maxlen:u8)->u8 {
 asm z80 (in buf, maxlen) (ret A) (clob A, F, BC, DE, HL, IX, IY) {
  LD (zx__console__con_edit_buf), HL
  CP 80
  JR C, .limit
  LD A, 79
 .limit:
  LD (zx__console__con_edit_limit), A
  LD A, (zx__console__con_row)
  LD L, A
  LD H, 0
  ADD HL, HL
  ADD HL, HL
  ADD HL, HL
  ADD HL, HL
  ADD HL, HL
  LD A, (zx__console__con_col)
  LD E, A
  LD D, 0
  ADD HL, DE
  LD (zx__console__con_edit_anchor), HL
  XOR A
  LD (zx__console__con_edit_length), A
  LD (zx__console__con_edit_cursor), A
  LD (zx__console__con_edit_old), A
  LD A, (zx__console__con_history_count)
  LD (zx__console__con_edit_history), A
 .redraw:
  CALL .render
 .key:
  CALL zx__console__con_getchar
  CP 13
  JP Z, .enter
  LD B, A
  LD A, (zx__console__con_edit_length)
  LD (zx__console__con_edit_old), A
  LD A, B
  CP 9
  JR Z, .left
  CP 12
  JR Z, .right
  CP 8
  JR Z, .delete
  CP 11
  JP Z, .history
  CP 10
  JP Z, .history
  CP 32
  JR C, .key
  LD B, A
  LD A, (zx__console__con_edit_limit)
  LD C, A
  LD A, (zx__console__con_edit_length)
  CP C
  JR NC, .key
  LD C, A
  LD A, (zx__console__con_edit_cursor)
  LD E, A
  LD A, C
  SUB E
  PUSH BC
  LD C, A
  LD B, 0
  LD HL, (zx__console__con_edit_buf)
  LD E, 1
  LD D, 0
  ADD HL, DE
  LD A, (zx__console__con_edit_length)
  LD E, A
  ADD HL, DE
  DEC HL
  LD D, H
  LD E, L
  DEC HL
  LD A, C
  OR A
  JR Z, .insert_done
  LDDR
 .insert_done:
  POP BC
  LD HL, (zx__console__con_edit_buf)
  LD A, (zx__console__con_edit_cursor)
  LD E, A
  LD D, 0
  ADD HL, DE
  LD (HL), B
  LD HL, zx__console__con_edit_length
  INC (HL)
  LD HL, zx__console__con_edit_cursor
  INC (HL)
  JP .redraw
 .left:
  LD HL, zx__console__con_edit_cursor
  LD A, (HL)
  OR A
  JR Z, .key
  DEC (HL)
  JP .redraw
 .right:
  LD A, (zx__console__con_edit_length)
  LD HL, zx__console__con_edit_cursor
  CP (HL)
  JR Z, .key
  INC (HL)
  JP .redraw
 .delete:
  LD A, (zx__console__con_edit_cursor)
  OR A
  JR Z, .key
  DEC A
  LD (zx__console__con_edit_cursor), A
  LD E, A
  LD D, 0
  LD HL, (zx__console__con_edit_buf)
  ADD HL, DE
  LD D, H
  LD E, L
  INC HL
  LD A, (zx__console__con_edit_length)
  LD B, A
  LD A, (zx__console__con_edit_cursor)
  LD C, A
  LD A, B
  SUB C
  DEC A
  LD C, A
  LD B, 0
  OR A
  JR Z, .delete_done
  LDIR
 .delete_done:
  LD HL, zx__console__con_edit_length
  DEC (HL)
  JP .redraw
 .history:
  PUSH AF
  LD A, (zx__console__con_edit_history)
  LD B, A
  LD A, (zx__console__con_history_count)
  CP B
  JR NZ, .have_draft
  LD A, (zx__console__con_edit_length)
  LD (zx__console__con_draft_length), A
  LD C, A
  LD B, 0
  LD HL, (zx__console__con_edit_buf)
  LD DE, zx__console__con_draft
  CALL .copy
 .have_draft:
  POP AF
  CP 11
  LD HL, zx__console__con_edit_history
  JR NZ, .down
  LD A, (HL)
  OR A
  JR Z, .select_history
  DEC (HL)
  JR .select_history
 .down:
  LD A, (zx__console__con_history_count)
  CP (HL)
  JR Z, .select_history
  INC (HL)
 .select_history:
  LD A, (zx__console__con_edit_history)
  LD B, A
  LD A, (zx__console__con_history_count)
  CP B
  JR NZ, .old_command
  LD HL, zx__console__con_draft
  LD A, (zx__console__con_draft_length)
  JR .load_command
 .old_command:
  LD A, B
  CALL .history_address
  PUSH HL
  LD A, (zx__console__con_edit_history)
  LD E, A
  LD D, 0
  LD HL, zx__console__con_history_length
  ADD HL, DE
  LD A, (HL)
  POP HL
 .load_command:
  LD B, A
  LD A, (zx__console__con_edit_limit)
  CP B
  JR C, .clamped
  LD A, B
 .clamped:
  LD (zx__console__con_edit_length), A
  LD (zx__console__con_edit_cursor), A
  LD C, A
  LD B, 0
  LD DE, (zx__console__con_edit_buf)
  CALL .copy
  JP .redraw
 .enter:
  LD A, (zx__console__con_edit_cursor)
  LD E, A
  LD D, 0
  LD HL, (zx__console__con_edit_buf)
  ADD HL, DE
  LD A, (zx__console__con_edit_length)
  CP E
  LD C, 32
  JR Z, .finish_glyph
  LD C, (HL)
 .finish_glyph:
  LD HL, (zx__console__con_edit_anchor)
  ADD HL, DE
  CALL .draw
  LD A, (zx__console__con_edit_length)
  LD E, A
  LD D, 0
  LD HL, (zx__console__con_edit_buf)
  ADD HL, DE
  LD (HL), 0
  LD HL, (zx__console__con_edit_anchor)
  ADD HL, DE
  CALL .position
  LD A, (zx__console__con_edit_length)
  OR A
  RET Z
  LD A, (zx__console__con_history_count)
  CP 4
  JR C, .store_history
  LD HL, zx__console__con_history+80
  LD DE, zx__console__con_history
  LD BC, 240
  LDIR
  LD HL, zx__console__con_history_length+1
  LD DE, zx__console__con_history_length
  LD BC, 3
  LDIR
  LD A, 3
 .store_history:
  PUSH AF
  CALL .history_address
  EX DE, HL
  LD HL, (zx__console__con_edit_buf)
  LD A, (zx__console__con_edit_length)
  LD C, A
  LD B, 0
  CALL .copy
  POP AF
  LD E, A
  LD D, 0
  INC A
  LD (zx__console__con_history_count), A
  LD HL, zx__console__con_history_length
  ADD HL, DE
  LD A, (zx__console__con_edit_length)
  LD (HL), A
  RET
 .history_address:
  LD L, A
  LD H, 0
  ADD HL, HL
  ADD HL, HL
  ADD HL, HL
  ADD HL, HL
  LD D, H
  LD E, L
  ADD HL, HL
  ADD HL, HL
  ADD HL, DE
  LD DE, zx__console__con_history
  ADD HL, DE
  RET
 .copy:
  LD A, B
  OR C
  RET Z
  LDIR
  RET
 .render:
  LD HL, (zx__console__con_edit_anchor)
  LD A, (zx__console__con_edit_length)
  LD E, A
  LD D, 0
  ADD HL, DE
  LD DE, 768
  OR A
  SBC HL, DE
  JR C, .render_begin
  CALL zx__console__con_scroll
  LD HL, (zx__console__con_edit_anchor)
  LD DE, 32
  OR A
  SBC HL, DE
  LD (zx__console__con_edit_anchor), HL
 .render_begin:
  LD A, (zx__console__con_edit_old)
  LD B, A
  LD A, (zx__console__con_edit_length)
  CP B
  JR NC, .extent
  LD A, B
 .extent:
  INC A
  LD B, A
  LD HL, (zx__console__con_edit_anchor)
  LD DE, (zx__console__con_edit_buf)
  LD IX, 0
 .render_loop:
  LD A, (zx__console__con_edit_length)
  CP IXL
  LD C, 32
  JR Z, .glyph
  JR C, .glyph
  LD A, (DE)
  LD C, A
 .glyph:
  LD A, (zx__console__con_edit_cursor)
  CP IXL
  JR NZ, .draw_glyph
  LD C, 95
 .draw_glyph:
  PUSH BC
  PUSH DE
  PUSH HL
  PUSH IX
  CALL .draw
  POP IX
  POP HL
  POP DE
  POP BC
  INC HL
  INC DE
  INC IX
  DJNZ .render_loop
  LD HL, (zx__console__con_edit_anchor)
  LD A, (zx__console__con_edit_cursor)
  LD E, A
  LD D, 0
  ADD HL, DE
 .position:
  LD A, L
  AND 31
  LD (zx__console__con_col), A
  ADD HL, HL
  ADD HL, HL
  ADD HL, HL
  LD A, H
  LD (zx__console__con_row), A
  RET
 .draw:
  LD A, L
  AND 31
  LD B, A
  ADD HL, HL
  ADD HL, HL
  ADD HL, HL
  LD D, H
  JP zx__console__con_draw_char
 }
}

// ── Cursor display ──────────────────────────────────────────────────────────

fun con_show_cursor() -> void {
    con_draw_char(con_col, con_row, 95)
}

fun con_hide_cursor() -> void {
    con_draw_char(con_col, con_row, 32)
}

// ── Compile-time verification ───────────────────────────────────────────────
//
// ZX Spectrum screen address truth table:
//   (col=0,  row=0,  line=0) → $4000  (top-left, first pixel line)
//   (col=31, row=0,  line=0) → $401F  (top-right)
//   (col=0,  row=0,  line=7) → $4700  (bottom of first char row)
//   (col=0,  row=1,  line=0) → $4020  (second char row, first pixel line)
//   (col=0,  row=8,  line=0) → $4800  (second third, first row)
//   (col=0,  row=16, line=0) → $5000  (third third, first row)
//   (col=15, row=12, line=3) → $4C8F  (middle of screen)
//
// Attribute address truth table:
//   (col=0,  row=0)  → $5800
//   (col=31, row=0)  → $581F
//   (col=0,  row=1)  → $5820
//   (col=0,  row=23) → $5AE0
//   (col=31, row=23) → $5AFF  (last attribute cell)

assert screen_addr(0, 0, 0) == 0x4000 via z80
assert screen_addr(31, 0, 0) == 0x401F via z80
assert screen_addr(0, 0, 7) == 0x4700 via z80
assert screen_addr(0, 1, 0) == 0x4020 via z80
assert screen_addr(0, 8, 0) == 0x4800 via z80
assert screen_addr(0, 16, 0) == 0x5000 via z80
assert screen_addr(15, 12, 3) == 0x4B8F via z80

assert attr_addr(0, 0) == 0x5800 via z80
assert attr_addr(31, 0) == 0x581F via z80
assert attr_addr(0, 1) == 0x5820 via z80
assert attr_addr(0, 23) == 0x5AE0 via z80
assert attr_addr(31, 23) == 0x5AFF via z80

// Z-machine V3 screen windows, Standard 1.1 sections 8.6.1-8.6.3.
// Row0 is status; upper window occupies rows1..height. Initialise after clear.

global z3_upper_height:u8
global z3_selected_window:u8
global z3_lower_row:u8=23
global z3_lower_col:u8

fun z3_windows_reset() {
 z3_upper_height=0 z3_selected_window=0
 z3_lower_row=23 z3_lower_col=0
 con_row=23 con_col=0
}
fun z3_window_select(window:u8) {
 if window>1 { return }
 if z3_selected_window==0 { z3_lower_row=con_row z3_lower_col=con_col }
 z3_selected_window=window
 if window==1 { con_row=1 con_col=0 }
 else { con_row=z3_lower_row con_col=z3_lower_col }
}
fun z3_window_split(lines:u16) {
 var height:u8=23
 if lines<23 { height=u8(lines) }
 z3_upper_height=height
 var row:u8=1
 while row<=height {
  var col:u8=0
  while col<32 { con_draw_char(col,row,32) col=col+1 }
  row=row+1
 }
 if z3_lower_row<=height { z3_lower_row=23 z3_lower_col=0 }
 if z3_selected_window==0 && con_row<=height { con_row=23 con_col=0 }
 if z3_selected_window==1 { con_row=1 con_col=0 }
}
fun z3_window_put(@z80_a ch:u8) {
 asm z80 (in ch) (clob A,F,BC,DE,HL,IX,IY) {
  LD C,A
  LD A, (zx__console__z3_selected_window)
  OR A
  LD A, (zx__console__z3_upper_height)
  JR Z,.lower_check
  OR A
  RET Z
  JR .character
 .lower_check:
  CP 23
  RET Z
 .character:
  LD A,C
  CP 10
  JR Z,.newline
  CP 13
  JR Z,.newline
  LD A, (zx__console__con_col)
  LD B,A
  LD A, (zx__console__con_row)
  LD D,A
  CALL zx__console__con_draw_char
  LD A, (zx__console__con_col)
  CP 31
  JR NC,.newline
  INC A
  LD (zx__console__con_col),A
  RET
 .newline:
  LD A, (zx__console__z3_selected_window)
  OR A
  JR Z,.lower_newline
  LD A, (zx__console__z3_upper_height)
  LD B,A
  LD A, (zx__console__con_row)
  CP B
  RET NC
  JR .advance
 .lower_newline:
  LD A, (zx__console__con_row)
  CP 23
  JR C,.advance
  XOR A
  LD (zx__console__con_col),A
  LD A, (zx__console__z3_upper_height)
  INC A
  JP zx__console__con_scroll_region
 .advance:
  INC A
  LD (zx__console__con_row),A
  XOR A
  LD (zx__console__con_col),A
 }
}
