// ZX128K raw bank window access. Caller disables IRQ; no NMI/reentry.
// Code, globals and native stack must be below C000. Offset is 0..16383.
// bank_bits carries requested RAM bank and caller-owned screen/ROM bits, bit5 clear.
// restore_bits is the actual prior unlocked7FFD value. These functions restore
// paging before returning; they do not change IFF or issue ROM services.
fun bank_read(@z80_a bank_bits: u8, @z80_hl offset: u16, @z80_e restore_bits: u8) -> u8 {
 asm z80 (in bank_bits, offset, restore_bits) (ret A) (clob A, F, BC, D, HL) {
  LD BC, 0x7ffd
  OUT (C), A
  SET 6, H
  SET 7, H
  LD D, (HL)
  LD A, E
  OUT (C), A
  LD A, D
 }
}
fun bank_write(@z80_a bank_bits: u8, @z80_hl offset: u16, @z80_d value: u8, @z80_e restore_bits: u8) -> void {
 asm z80 (in bank_bits, offset, value, restore_bits) (clob A, F, BC, HL) {
  LD BC, 0x7ffd
  OUT (C), A
  SET 6, H
  SET 7, H
  LD (HL), D
  LD A, E
  OUT (C), A
 }
}

// Sum count bytes within one bank, modulo 65536. Caller guarantees
// offset+count<=16384. count=0 performs no reads. Same IRQ/paging contract.
fun bank_sum(@z80_a bank_bits: u8, @z80_hl offset: u16, @z80_de count: u16, @z80_b restore_bits: u8) -> u16 {
 asm z80 (in bank_bits, offset, count, restore_bits) (ret HL) (clob A, F, BC, DE, HL) {
  PUSH BC
  LD BC, 0x7ffd
  OUT (C), A
  SET 6, H
  SET 7, H
  LD BC, 0
 .sum_loop:
  LD A, D
  OR E
  JR Z, .sum_done
  LD A, (HL)
  ADD A, C
  LD C, A
  JR NC, .sum_no_carry
  INC B
 .sum_no_carry:
  INC HL
  DEC DE
  JR .sum_loop
 .sum_done:
  LD H, B
  LD L, C
  POP BC
  LD A, B
  LD BC, 0x7ffd
  OUT (C), A
 }
}

// Restore bank0's dynamic prefix from a non-overlapping archived bank window.
// Caller guarantees offset+count<=16384, count<=16384, source bank!=0,
// restore_bits selects bank0. Same resident-code/disabled-IRQ contract.
fun bank_restore_prefix(@z80_a bank_bits: u8, @z80_hl offset: u16, @z80_de count: u16, @z80_b restore_bits: u8) -> void {
 asm z80 (in bank_bits, offset, count, restore_bits) (clob A, F, BC, DE, HL, IX, IY) {
  LD IYH, A
  LD IYL, B
  SET 6, H
  SET 7, H
  LD IX, 0xc000
  LD BC, 0x7ffd
 .restore_loop:
  LD A, D
  OR E
  JR Z, .restore_done
  LD A, IYH
  OUT (C), A
  LD A, (HL)
  PUSH AF
  LD A, IYL
  OUT (C), A
  POP AF
  LD (IX+0), A
  INC IX
  INC HL
  DEC DE
  JR .restore_loop
 .restore_done:
  LD A, IYL
  OUT (C), A
 }
}

// Decode a trusted, host-validated restart RLE stream into bank0 prefix.
// offset+encoded_size<=16384, source bank!=0, restore_bits selects bank0.
// count is exact decoded size; each encoded run must fit remaining output.
// This primitive is NOT a decoder for untrusted/malformed external saves.
fun bank_restore_rle(@z80_a bank_bits: u8, @z80_hl offset: u16, @z80_de count: u16, @z80_b restore_bits: u8) -> void {
 asm z80 (in bank_bits, offset, count, restore_bits) (clob A, F, BC, DE, HL, IX, IY) {
  LD IYH, A
  LD IYL, B
  SET 6, H
  SET 7, H
  PUSH DE
  POP IX
  LD DE, 0xc000
 .rle_loop:
  PUSH IX
  POP BC
  LD A, B
  OR C
  JR Z, .rle_done
  CALL .rle_read
  BIT 7, A
  JR NZ, .rle_repeat
  INC A
  LD B, A
 .rle_literal:
  CALL .rle_read
  LD (DE), A
  INC DE
  DEC IX
  DJNZ .rle_literal
  JR .rle_loop
 .rle_repeat:
  AND 127
  ADD A, 3
  LD B, A
  CALL .rle_read
  LD C, A
 .rle_fill:
  LD A, C
  LD (DE), A
  INC DE
  DEC IX
  DJNZ .rle_fill
  JR .rle_loop
 .rle_read:
  PUSH BC
  LD BC, 0x7ffd
  LD A, IYH
  OUT (C), A
  LD A, (HL)
  INC HL
  PUSH AF
  LD A, IYL
  OUT (C), A
  POP AF
  POP BC
  RET
 .rle_done:
 }
}

// Preflight trusted bank selection but UNTRUSTED RLE payload: no output writes.
// Restores paging to 0x10. Bank must be 0/1/3/4/6/7, code/SP below C000,
// IRQ disabled. Accepts only exact encoded and decoded lengths in one window.
fun bank_validate_rle(@z80_a bank_bits: u8, @z80_hl offset: u16, @z80_de encoded_size: u16, @z80_ix decoded_size: u16) -> u8 {
 asm z80 (in bank_bits, offset, encoded_size, decoded_size) (ret A) (clob A, F, BC, DE, HL, IX, IY) {
  LD IYH, A
  PUSH HL
  ADD HL, DE
  JR C, .validate_bad_bounds
  LD BC, 0x4001
  OR A
  SBC HL, BC
  JR NC, .validate_bad_bounds
  POP HL
  LD A, H
  CP 0x40
  JR C, .validate_bounds_ok
  JR NZ, .validate_fail
  LD A, L
  OR D
  OR E
  JR NZ, .validate_fail
 .validate_bounds_ok:
  SET 6, H
  SET 7, H
  LD BC, 0x7ffd
  LD A, IYH
  OUT (C), A
 .validate_loop:
  PUSH IX
  POP BC
  LD A, B
  OR C
  JR Z, .validate_end
  LD A, D
  OR E
  JR Z, .validate_fail
  LD A, (HL)
  INC HL
  DEC DE
  BIT 7, A
  JR NZ, .validate_repeat
  INC A
  LD IYL, A
 .validate_literal:
  LD A, D
  OR E
  JR Z, .validate_fail
  INC HL
  DEC DE
  CALL .validate_output
  JR Z, .validate_fail
  DEC IYL
  JR NZ, .validate_literal
  JR .validate_loop
 .validate_repeat:
  AND 127
  ADD A, 3
  LD IYL, A
  LD A, D
  OR E
  JR Z, .validate_fail
  INC HL
  DEC DE
 .validate_repeat_output:
  CALL .validate_output
  JR Z, .validate_fail
  DEC IYL
  JR NZ, .validate_repeat_output
  JR .validate_loop
 .validate_output:
  PUSH IX
  POP BC
  LD A, B
  OR C
  RET Z
  DEC IX
  RET
 .validate_end:
  LD A, D
  OR E
  JR NZ, .validate_fail
  LD D, 1
  JR .validate_return
 .validate_bad_bounds:
  POP HL
 .validate_fail:
  LD D, 0
 .validate_return:
  LD BC, 0x7ffd
  LD A, 0x10
  OUT (C), A
  LD A, D
 }
}
