// Raw Z3 logical-memory foundation, before compressed-block storage.
// Six 16K logical pages map to RAM banks 0,1,3,4,6,7; screen/code use 5/2.
// This is NOT the final state layout. Caller validates address <98304
// (word address <98303), disables IRQ, provides unlocked 7FFD state,
// and keeps code/globals/native stack below C000.
import zx.banked
global story_pages: [u8; 6] = [0, 1, 3, 4, 6, 7]
fun story_byte(address: u32, restore_bits: u8) -> u8 {
 let page: u8 = (address >> 14) as u8
 let offset: u16 = (address as u16) & 0x3fff
 let bank_bits: u8 = story_pages[page] + (restore_bits & 0x18)
 return bank_read(bank_bits, offset, restore_bits)
}
// Z-machine words are big endian; second address must not wrap at 64K.
fun story_word(address: u32, restore_bits: u8) -> u16 {
 let high: u16 = story_byte(address, restore_bits) as u16
 let low: u16 = story_byte(address + 1, restore_bits) as u16
 return high * 256 + low
}

// Split logical address ABI for native hot paths: low word plus high 64K page.
// high64 is 0 or 1; the same full logical bounds as story_byte apply.
fun story_byte_split(low_address: u16, high64: u8, restore_bits: u8) -> u8 {
 let page: u8 = u8(low_address >> 14) + high64 * 4
 let offset: u16 = low_address & 0x3fff
 let bank_bits: u8 = story_pages[page] + (restore_bits & 0x18)
 return bank_read(bank_bits, offset, restore_bits)
}
fun story_word_split(low_address: u16, high64: u8, restore_bits: u8) -> u16 {
 let high: u16 = u16(story_byte_split(low_address, high64, restore_bits))
 var next_high: u8 = high64
 let next_low: u16 = low_address + 1
 if next_low == 0 { next_high = next_high + 1 }
 let low: u16 = u16(story_byte_split(next_low, next_high, restore_bits))
 return high * 256 + low
}
