// stdlib/tui/render — TUI rendering primitives (multi-backend)
//
// Each function has a Z80 body (CP/M BDOS + VT100 escape sequences).
// On MZV, host functions intercept the calls before the Z80 body runs.
// On CP/M, the asm bodies execute directly — VT100 is standard.
// On ZX Spectrum, these would be replaced with attribute-based rendering.
//
// The asm bodies also serve as anti-inlining barriers (OpAsm prevents
// InlineTrivial from eliminating host-overridable calls).

// =============================================================================
// Internal: BDOS helpers
// =============================================================================

// BDOS putchar (function 2, char in E)
fun _tui_bdos_putchar(ch: u8) -> void {
    asm z80 (in ch) {
        LD E, A
        LD C, 2
        CALL 5
    }
}

// Print ESC (0x1B)
fun _tui_esc() -> void {
    asm z80 {
        LD E, 0x1B
        LD C, 2
        CALL 5
    }
}

// Print u8 as decimal (for ANSI escape sequences: row/col numbers)
fun _tui_print_dec(val: u8) -> void {
    asm z80 (in val) {
        ; A = val (0-255)
        LD B, A
        ; Hundreds digit
        LD C, 0
        .hloop: CP 100 / JR C, .hdone / SUB 100 / INC C / JR .hloop
        .hdone:
        LD B, A
        LD A, C / OR A / JR Z, .skip_h
        ADD A, 48 / LD E, A / PUSH BC / LD C, 2 / CALL 5 / POP BC
        .skip_h:
        ; Tens digit
        LD A, B / LD C, 0
        .tloop: CP 10 / JR C, .tdone / SUB 10 / INC C / JR .tloop
        .tdone:
        LD B, A
        LD A, C / ADD A, 48 / LD E, A / PUSH BC / LD C, 2 / CALL 5 / POP BC
        ; Units digit
        LD A, B / ADD A, 48 / LD E, A / LD C, 2 / CALL 5
    }
}

// =============================================================================
// TUI primitives — Z80 body (CP/M) + MZV host override
// =============================================================================

// Position cursor at (x, y) — 0-based.
// Emits: ESC [ (y+1) ; (x+1) H
// Full inline asm: saves x,y on stack across BDOS calls.
// x arrives in A, y in C (PFCCO calling convention: A, C, B, D, E).
fun tui_goto(x: u8, y: u8) -> void {
    asm z80 (in x, y) {
        ; x in A, y in C (PFCCO: first=A, second=C)
        LD H, A         ; H = x
        LD L, C         ; L = y
        PUSH HL         ; save [x, y] on stack

        ; ESC
        LD E, 0x1B
        LD C, 2
        CALL 5
        ; [
        LD E, 91
        LD C, 2
        CALL 5

        ; y+1 as decimal
        POP HL
        PUSH HL         ; peek [x, y]
        LD A, L         ; A = y
        INC A
        LD B, A         ; save in B for _tui_print_dec
        ; inline print_dec (A = value)
        ; Hundreds
        LD C, 0
        .gh: CP 100 / JR C, .ghd / SUB 100 / INC C / JR .gh
        .ghd: LD B, A / LD A, C / OR A / JR Z, .gsh
        ADD A, 48 / LD E, A / PUSH BC / LD C, 2 / CALL 5 / POP BC
        .gsh:
        ; Tens
        LD A, B / LD C, 0
        .gt: CP 10 / JR C, .gtd / SUB 10 / INC C / JR .gt
        .gtd: LD B, A / LD A, C / ADD A, 48 / LD E, A / PUSH BC / LD C, 2 / CALL 5 / POP BC
        ; Units
        LD A, B / ADD A, 48 / LD E, A / LD C, 2 / CALL 5

        ; semicolon
        LD E, 59
        LD C, 2
        CALL 5

        ; x+1 as decimal
        POP HL          ; restore [x, y]
        LD A, H         ; A = x
        INC A
        ; inline print_dec
        LD C, 0
        .xh: CP 100 / JR C, .xhd / SUB 100 / INC C / JR .xh
        .xhd: LD B, A / LD A, C / OR A / JR Z, .xsh
        ADD A, 48 / LD E, A / PUSH BC / LD C, 2 / CALL 5 / POP BC
        .xsh:
        LD A, B / LD C, 0
        .xt: CP 10 / JR C, .xtd / SUB 10 / INC C / JR .xt
        .xtd: LD B, A / LD A, C / ADD A, 48 / LD E, A / PUSH BC / LD C, 2 / CALL 5 / POP BC
        LD A, B / ADD A, 48 / LD E, A / LD C, 2 / CALL 5

        ; H
        LD E, 72
        LD C, 2
        CALL 5
    }
}

// Set text color: fg (0-7), bg (0-7), bright (0 or 1).
// Emits: ESC [ (30+fg) ; (40+bg) m   (bright adds 60)
// Full inline asm: computes fg_code/bg_code, saves on stack across BDOS.
// PFCCO: fg=A, bg=C, bright=B.
fun tui_color(fg: u8, bg: u8, bright: u8) -> void {
    asm z80 (in fg, bg, bright) {
        ; fg in A, bg in C, bright in B
        ; Compute fg_code = 30 + fg, bg_code = 40 + bg
        ADD A, 30       ; A = 30 + fg
        LD D, A         ; D = fg_code
        LD A, C
        ADD A, 40       ; A = 40 + bg
        LD E, A         ; E = bg_code
        ; If bright != 0, add 60 to both
        LD A, B
        OR A
        JR Z, .no_bright
        LD A, D / ADD A, 60 / LD D, A
        LD A, E / ADD A, 60 / LD E, A
        .no_bright:
        ; Save [fg_code, bg_code] on stack
        PUSH DE

        ; ESC
        LD E, 0x1B / LD C, 2 / CALL 5
        ; [
        LD E, 91 / LD C, 2 / CALL 5

        ; fg_code as decimal
        POP DE
        PUSH DE         ; peek
        LD A, D         ; A = fg_code
        ; inline print_dec
        LD C, 0
        .fh: CP 100 / JR C, .fhd / SUB 100 / INC C / JR .fh
        .fhd: LD B, A / LD A, C / OR A / JR Z, .fsh
        ADD A, 48 / LD E, A / PUSH BC / LD C, 2 / CALL 5 / POP BC
        .fsh:
        LD A, B / LD C, 0
        .ft: CP 10 / JR C, .ftd / SUB 10 / INC C / JR .ft
        .ftd: LD B, A / LD A, C / ADD A, 48 / LD E, A / PUSH BC / LD C, 2 / CALL 5 / POP BC
        LD A, B / ADD A, 48 / LD E, A / LD C, 2 / CALL 5

        ; semicolon
        LD E, 59 / LD C, 2 / CALL 5

        ; bg_code as decimal
        POP DE          ; restore
        LD A, E         ; A = bg_code
        ; inline print_dec
        LD C, 0
        .bh: CP 100 / JR C, .bhd / SUB 100 / INC C / JR .bh
        .bhd: LD B, A / LD A, C / OR A / JR Z, .bsh
        ADD A, 48 / LD E, A / PUSH BC / LD C, 2 / CALL 5 / POP BC
        .bsh:
        LD A, B / LD C, 0
        .bt: CP 10 / JR C, .btd / SUB 10 / INC C / JR .bt
        .btd: LD B, A / LD A, C / ADD A, 48 / LD E, A / PUSH BC / LD C, 2 / CALL 5 / POP BC
        LD A, B / ADD A, 48 / LD E, A / LD C, 2 / CALL 5

        ; m
        LD E, 109 / LD C, 2 / CALL 5
    }
}

// Reset colors to default. Emits: ESC [ 0 m
fun tui_reset() -> void {
    asm z80 {
        LD E, 0x1B / LD C, 2 / CALL 5
        LD E, 91   / LD C, 2 / CALL 5
        LD E, 48   / LD C, 2 / CALL 5
        LD E, 109  / LD C, 2 / CALL 5
    }
}

// Clear the entire screen. Emits: ESC [ 2 J  ESC [ H
fun tui_clear() -> void {
    asm z80 {
        ; ESC [ 2 J
        LD E, 0x1B / LD C, 2 / CALL 5
        LD E, 91   / LD C, 2 / CALL 5
        LD E, 50   / LD C, 2 / CALL 5
        LD E, 74   / LD C, 2 / CALL 5
        ; ESC [ H
        LD E, 0x1B / LD C, 2 / CALL 5
        LD E, 91   / LD C, 2 / CALL 5
        LD E, 72   / LD C, 2 / CALL 5
    }
}

// Print a single character. Codes 1-6 → box-drawing (ASCII fallback on CP/M).
fun tui_putch(ch: u8) -> void {
    if ch == 1 {
        _tui_bdos_putchar(43)
        return
    }
    if ch == 2 {
        _tui_bdos_putchar(43)
        return
    }
    if ch == 3 {
        _tui_bdos_putchar(43)
        return
    }
    if ch == 4 {
        _tui_bdos_putchar(43)
        return
    }
    if ch == 5 {
        _tui_bdos_putchar(45)
        return
    }
    if ch == 6 {
        _tui_bdos_putchar(124)
        return
    }
    _tui_bdos_putchar(ch)
}

// Print a null-terminated string.
fun tui_puts(str: ^u8) -> void {
    asm z80 (in str) {
        .loop: LD A, (HL) / OR A / RET Z
        LD E, A / PUSH HL / LD C, 2 / CALL 5 / POP HL / INC HL
        JR .loop
    }
}

// Read one key (blocking). BDOS function 1.
fun tui_read_key() -> u8 {
    asm z80 (ret A) {
        LD C, 1
        CALL 5
    }
}

// Read a line into buffer. BDOS function 0x0A. Returns actual length.
fun tui_read_line(buf: ^u8, maxlen: u8) -> u8 {
    asm z80 (in buf, maxlen) (ret A) {
        ; buf in HL, maxlen routed via calling convention
        ; BDOS 0x0A: DE→[maxlen, actual, chars...]
        ; We put maxlen at (HL), then call BDOS with DE=HL
        PUSH HL
        LD (HL), A    ; maxlen at buf[0] (A = maxlen from 2nd param)
        EX DE, HL
        LD C, 10
        CALL 5
        POP HL
        INC HL
        LD A, (HL)    ; actual length at buf[1]
    }
}

// Terminal dimensions (CP/M standard: 80x24).
fun tui_width() -> u8 {
    asm z80 (ret A) { LD A, 80 }
}

fun tui_height() -> u8 {
    asm z80 (ret A) { LD A, 24 }
}

// =============================================================================
// Box drawing helpers
// =============================================================================

// Draw a box outline at (x, y) with size (w, h)
fun draw_box(x: u8, y: u8, w: u8, h: u8) -> void {
    tui_goto(x, y)
    tui_putch(1)
    var i: u8 = 0
    while i < w - 2 {
        tui_putch(5)
        i = i + 1
    }
    tui_putch(2)

    var row: u8 = 1
    while row < h - 1 {
        tui_goto(x, y + row)
        tui_putch(6)
        tui_goto(x + w - 1, y + row)
        tui_putch(6)
        row = row + 1
    }

    tui_goto(x, y + h - 1)
    tui_putch(3)
    i = 0
    while i < w - 2 {
        tui_putch(5)
        i = i + 1
    }
    tui_putch(4)
}

// Fill rectangle with spaces
fun clear_rect(x: u8, y: u8, w: u8, h: u8) -> void {
    var row: u8 = 0
    while row < h {
        tui_goto(x, y + row)
        var col: u8 = 0
        while col < w {
            tui_putch(32)
            col = col + 1
        }
        row = row + 1
    }
}

// Print string padded to width (inline asm — safe across BDOS CALL 5)
// PFCCO: str=HL (pointer), width=A (second param via C register? no — ^u8 arrives in HL, u8 in A)
// Actually: first param ^u8 → HL, second param u8 → A (PFCCO for ptr+u8)
fun puts_padded(str: ^u8, width: u8) -> void {
    asm z80 (in str, width) {
        ; HL = str, width = C (PFCCO: ptr→HL, u8→C)
        LD B, C         ; B = remaining width (loop counter)
        LD A, C
        OR A
        RET Z           ; width == 0 → nothing to do
        .loop:
        LD A, (HL)      ; load current char
        OR A
        JR Z, .pad      ; hit null → switch to padding
        ; Print character from string
        LD E, A
        PUSH HL         ; save string pointer
        PUSH BC         ; save width counter
        LD C, 2
        CALL 5
        POP BC
        POP HL
        INC HL          ; advance string pointer
        DJNZ .loop
        RET
        .pad:
        ; Fill remaining width with spaces
        LD E, 32
        PUSH HL         ; save pointer (not advancing, but keep stack balanced)
        PUSH BC         ; save counter
        LD C, 2
        CALL 5
        POP BC
        POP HL
        DJNZ .pad
    }
}
