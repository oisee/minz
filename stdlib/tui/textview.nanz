// stdlib/tui/textview — Scrollable text viewer widget
//
// Displays a text buffer with line-by-line scrolling.
// UP/DOWN = line scroll, PgUp/PgDn = page scroll.
// Used by file viewers, help screens, log displays.
//
// Usage:
//   var tv: TextView
//   tv.init(data_ptr, data_len, 0, 0, 80, 22)
//   tv.show(c"View: README.TXT")  // blocks until ESC/F3

import stdlib.tui.render
import stdlib.tui.widget

// =============================================================================
// TextView struct
// =============================================================================

struct TextView {
    data:    ^u8      // pointer to text data
    len:     u16      // total byte length
    scroll:  u16      // current scroll offset (byte position of first visible line)
    x:       u8       // screen position
    y:       u8       //
    w:       u8       // viewport width
    h:       u8       // viewport height (lines)
}

// =============================================================================
// Methods
// =============================================================================

// Initialize text viewer with data and viewport.
fun TextView.init(self: ^TextView, data: ^u8, len: u16, x: u8, y: u8, w: u8, h: u8) -> void {
    self.data = data
    self.len = len
    self.scroll = 0
    self.x = x
    self.y = y
    self.w = w
    self.h = h
}

// Render the visible portion of text.
fun TextView.render(self: ^TextView) -> void {
    var pos: u16 = self.scroll
    var row: u8 = 0

    while row < self.h {
        tui_goto(self.x, self.y + row)
        var col: u8 = 0

        while col < self.w {
            if pos < self.len {
                var ch: u8 = self.data[pos]
                if ch == 13 {
                    // skip CR
                } else {
                    if ch == 10 {
                        // newline: fill rest of row with spaces
                        while col < self.w {
                            tui_putch(32)
                            col = col + 1
                        }
                    } else {
                        if ch >= 32 {
                            tui_putch(ch)
                        } else {
                            tui_putch(46)  // non-printable → dot
                        }
                    }
                }
                pos = pos + 1
            } else {
                // past end of data
                tui_putch(32)
            }
            col = col + 1
        }
        row = row + 1
    }
}

// Scroll down by one line (find next newline from current scroll position).
fun TextView.scroll_down(self: ^TextView) -> void {
    var pos: u16 = self.scroll
    // Find next newline
    while pos < self.len {
        if self.data[pos] == 10 {
            self.scroll = pos + 1
            return
        }
        pos = pos + 1
    }
}

// Scroll up by one line (find previous newline before current scroll position).
fun TextView.scroll_up(self: ^TextView) -> void {
    if self.scroll == 0 { return }
    var pos: u16 = self.scroll - 1
    // Skip the newline at current position
    if pos > 0 { pos = pos - 1 }
    // Find previous newline
    while pos > 0 {
        if self.data[pos] == 10 {
            self.scroll = pos + 1
            return
        }
        pos = pos - 1
    }
    self.scroll = 0
}

// Scroll down by one page.
fun TextView.page_down(self: ^TextView) -> void {
    var i: u8 = 0
    while i < self.h {
        TextView.scroll_down(self)
        i = i + 1
    }
}

// Scroll up by one page.
fun TextView.page_up(self: ^TextView) -> void {
    var i: u8 = 0
    while i < self.h {
        TextView.scroll_up(self)
        i = i + 1
    }
}

// Interactive viewer: renders + handles keys until ESC/F3.
fun TextView.show(self: ^TextView, title: ^u8) -> void {
    var running: u8 = 1
    var w: u8 = tui_width()
    var h: u8 = tui_height()

    while running == 1 {
        tui_clear()

        // Title bar
        tui_color(0, 6, 1)
        tui_goto(0, 0)
        tui_puts(c"  ")
        tui_puts(title)
        var pad: u8 = 4
        while pad < w {
            tui_putch(32)
            pad = pad + 1
        }

        // Text content
        tui_color(7, 0, 0)
        self.y = 2
        self.w = w
        self.h = h - 4
        TextView.render(self)

        // Status bar
        tui_color(0, 6, 1)
        tui_goto(0, h - 1)
        tui_puts(c" UP/DOWN=Scroll  PgUp/PgDn=Page  ESC/F3=Close ")
        pad = 47
        while pad < w {
            tui_putch(32)
            pad = pad + 1
        }
        tui_reset()

        // Handle keys
        var key: u8 = tui_read_key()
        if key == KEY_UP { TextView.scroll_up(self) }
        if key == KEY_DOWN { TextView.scroll_down(self) }
        // PgUp = KEY_UP + shift or just multiple lines
        // For now: use '<' and '>' as page up/down alternatives
        if key == 60 { TextView.page_up(self) }    // <
        if key == 62 { TextView.page_down(self) }   // >
        if key == KEY_ESC { running = 0 }
        if key == KEY_F3 { running = 0 }
    }
}
