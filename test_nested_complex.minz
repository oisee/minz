// Test complex nested functions with closures
fun calculate(x: u8) -> u8 {
    let factor: u8 = 2;
    
    fun multiply() -> u8 {
        // Can we access outer variables?
        return x * factor;  // Should multiply x by 2
    }
    
    fun add_ten() -> u8 {
        return multiply() + 10;
    }
    
    return add_ten();
}

fun main() -> void {
    let result = calculate(5);  // Should be 5*2+10 = 20
    print_u8(result);
}