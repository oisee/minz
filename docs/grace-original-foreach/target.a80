    DJNZ .sum_chain_fe_body1
    JP .sum_chain_fe_exit2
.sum_chain_fe_exit2:
    RET
.sum_chain_trmp0:
    LD B, C
    JRS .sum_chain_fe_body1

; fun max_chain(buf: ptr = HL, n: u8 = C) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
