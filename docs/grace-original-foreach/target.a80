; fun sum_chain(buf: ptr = HL, n: u8 = C) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
sum_chain:
    LD A, 0
    LD E, A    ; preserve live accumulator before CMP
    LD A, C
    AND A
    LD A, E
    ; restore live-out r3 from scratch
    JRS NZ, .sum_chain_trmp0
