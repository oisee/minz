; fun tokenize_all(src: ptr = HL, arena: ptr = DE, tokens: ptr = BC) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1,dead-block-arg=1]
tokenize_all:
    LD A, 0
    LD IX, pos
    LD (IX+0), A     ; lo
    LD (IX+1), 0     ; hi (zero-extend)
    LD A, 0
    LD IX, tok_count
    LD (IX+0), A     ; lo
    LD (IX+1), 0     ; hi (zero-extend)
    PUSH HL
    POP IX
    LD IYH, D
    LD IYL, E
    LD (_spill_tokenize_all_r960), BC
    ; genCall: scan dst=961
    PUSH BC
    PUSH DE
    PUSH HL
    PUSH IX
    POP HL
    LD B, IYH
    LD C, IYL
    LD DE, (_spill_tokenize_all_r960)
    CALL scan
    POP HL
    POP DE
    POP BC
    LD IXH, D
    LD IXL, E
    PUSH HL
    POP IY
    LD (_spill_tokenize_all_r965), BC
.tokenize_all_loop_head1:
    LD HL, TOK_EOF
    LD D, (HL)
    CP D
    JRS Z, .tokenize_all_loop_exit3
.tokenize_all_loop_body2:
    PUSH IY
    POP HL
    LD D, IXH
    LD E, IXL
    LD BC, (_spill_tokenize_all_r965)
    ; genCall: scan dst=972
    PUSH IX
    PUSH IY
    PUSH DE
    LD D, B
    LD E, C
    POP BC
    CALL scan
    POP IY
    POP IX
    JRS .tokenize_all_loop_head1
.tokenize_all_loop_exit3:
    LD HL, (tok_count)    ; u16 direct load (20T, no A clobber)
    RET
; — spill slots for tokenize_all (1 spills)
_spill_tokenize_all_r965: DW 0
; — extra spill slots for tokenize_all (1 rescued)
_spill_tokenize_all_r960: DB 0, 0

; fun copy_forward(dst: ptr = HL, src: ptr = DE, n: u8 = B) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1,dead-block-arg=1,split-join-ret=1,condret-sink=1,cond-rets=1]
copy_forward:
    LD A, 0
    LD IXH, B
    LD B, D
    LD C, E
.copy_forward_loop_head1:
    LD E, A    ; materialize r978 (pendingAcc)
    LD A, E
    CP IXH
    LD A, E
    ; restore block param from scratch
    RET NC
.copy_forward_loop_body2:
    LD E, A
    LD D, 0
    PUSH HL
    PUSH BC
    POP HL
    ADD HL, DE
    LD D, H
    LD E, L
    POP HL
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (DE)
    LD IXL, A
    EX AF, AF'      ; restore byte-load scratch
    PUSH HL
    LD E, A
    LD D, 0
    ADD HL, DE
    LD D, H
    LD E, L
    POP HL
    PUSH AF    ; preserve live A across byte store
    LD A, IXL
    LD (DE), A
    POP AF
    INC A
    JRS .copy_forward_loop_head1

; fun checksum_records(tokens: ptr = HL, bytes: u16 = DE) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1,dead-block-arg=1,split-join-ret=1,condret-sink=1,cond-rets=1]
checksum_records:
    LD C, 0
    LD A, 0
    PUSH HL
    POP IY
    LD HL, 0
    LD BC, 0
.checksum_records_loop_head1:
    PUSH HL
    OR A
    SBC HL, DE
    POP HL
    JRS C, .checksum_records_loop_body2
    LD H, B
    LD L, C
    RET
.checksum_records_loop_body2:
    PUSH HL
    PUSH DE
    LD D, H
    LD E, L
    PUSH IY
    POP HL
    ADD HL, DE
    PUSH HL
    POP IX
    POP DE
    POP HL
    LD A, (IX+0)
    LD IXL, A
    LD IXH, 0
    PUSH HL
    PUSH DE
    PUSH BC
    POP HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    POP DE
    PUSH HL
    POP BC
    POP DE
    POP HL
    INC HL
    JRS .checksum_records_loop_head1

; fun tokenizer_checked(src: ptr = BC, arena: ptr = HL, tokens: ptr = DE, length: u16 = IX) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
tokenizer_checked:
    LD IY, src_len
    LD A, IXL
    LD (IY+0), A     ; lo
    LD A, IXH
    LD (IY+1), A     ; hi
    LD A, (keywords_ready)
    AND A
    JRS NZ, .tokenizer_checked_if_join2
.tokenizer_checked_if_then1:
    PUSH HL
    POP IX
    ; genCall: init_keywords dst=0
    PUSH BC
    PUSH DE
    PUSH HL
    PUSH IX
    POP HL
    CALL init_keywords
    POP HL
    POP DE
    POP BC
    LD HL, keywords_ready
    LD (HL), 1
.tokenizer_checked_if_join2:
    LD IXH, D
    LD IXL, E
    ; genCall: tokenize_all dst=1019
    PUSH DE
    LD D, H
    LD E, L
    LD H, B
    LD L, C
    LD B, IXH
    LD C, IXL
    CALL tokenize_all
    POP DE
    PUSH HL
    ADD HL, HL
    ADD HL, HL
    LD B, H
    LD C, L
    POP HL
    ; genCall: checksum_records dst=1024
    PUSH HL
    LD H, D
    LD L, E
    LD D, B
    LD E, C
    CALL checksum_records
    LD D, H
    LD E, L
    POP HL
    LD BC, token_checksum
    LD A, E
    LD (BC), A     ; lo
    INC BC
    LD A, D
    LD (BC), A     ; hi
    DEC BC
    RET

; fun scan$split_19(arena: ptr = HL, c: u8 = A, src: ptr = DE, tokens: ptr = BC) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
