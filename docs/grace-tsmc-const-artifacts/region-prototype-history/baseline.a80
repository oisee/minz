    ADD HL, DE
    PUSH HL
    POP BC
    POP DE
    POP HL
    LD A, (_spill_intern_r274)
    LD (BC), A
    LD BC, str_bump
    PUSH AF          ; preserve word-load scratch
    LD A, (BC)     ; lo
    PUSH AF          ; stage low byte before replacing address
    INC BC
    LD A, (BC)     ; hi
    LD B, A
