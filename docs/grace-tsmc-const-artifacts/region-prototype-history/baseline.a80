; fun scan(src: ptr = HL, arena: ptr = BC, tokens: ptr = DE) -> u8 = A [recursive] ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
