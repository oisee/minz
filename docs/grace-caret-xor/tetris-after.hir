fun @render()
  var y: u8 = 0:u8
  while ((y:u8) < 20:u8):bool
    var x: u8 = 0:u8
    while ((x:u8) < 10:u8):bool
      var cell: u8 = call @board_get((x:u8), (y:u8)):u8
      var attr: u8 = call @color_attr((cell:u8)):u8
      *(cast(call @zx_attr_addr((11:u8 + (x:u8)):u8, (2:u8 + (y:u8)):u8):u16):ptr) = (attr:u8)
      (x:u8) = ((x:u8) + 1:u8):u8
    (y:u8) = ((y:u8) + 1:u8):u8
  var gy: u8 = call @ghost_y():u8
  if ((gy:u8) != (cur_y:u8)):bool
    var gc: u8 = ((call @piece_color((cur_type:u8)):u8 >> 3:u8):u8 & 7:u8):u8
    var c: u8 = 0:u8
    while ((c:u8) < 4:u8):bool
      var cx: u8 = ((cur_x:u8) + call @piece_dx((cur_type:u8), (cur_rot:u8), (c:u8)):u8):u8
      var cy: u8 = ((gy:u8) + call @piece_dy((cur_type:u8), (cur_rot:u8), (c:u8)):u8):u8
      if (((cx:u8) < 10:u8):bool & ((cy:u8) < 20:u8):bool):bool
        if (call @board_get((cx:u8), (cy:u8)):u8 == 0:u8):bool
          *(cast(call @zx_attr_addr((11:u8 + (cx:u8)):u8, (2:u8 + (cy:u8)):u8):u16):ptr) = (gc:u8)
      (c:u8) = ((c:u8) + 1:u8):u8
  var pc: u8 = call @piece_color((cur_type:u8)):u8
  var c: u8 = 0:u8
  while ((c:u8) < 4:u8):bool
    var cx: u8 = ((cur_x:u8) + call @piece_dx((cur_type:u8), (cur_rot:u8), (c:u8)):u8):u8
    var cy: u8 = ((cur_y:u8) + call @piece_dy((cur_type:u8), (cur_rot:u8), (c:u8)):u8):u8
    if (((cx:u8) < 10:u8):bool & ((cy:u8) < 20:u8):bool):bool
      *(cast(call @zx_attr_addr((11:u8 + (cx:u8)):u8, (2:u8 + (cy:u8)):u8):u16):ptr) = (pc:u8)
    (c:u8) = ((c:u8) + 1:u8):u8
  call @render_preview((next_type:u8), 23:u8, 3:u8):void
  call @render_preview((hold_type:u8), 5:u8, 3:u8):void

