  (last_was_tspin:u8) = call @check_tspin():u8
  call @lock_piece():void
  var cl: u8 = call @clear_lines():u8
  call @score_lines((cl:u8)):void
  call @spawn_piece():void

fun @main()
  var i: u16 = 0:u8
  while ((i:u16) < 200:u8):bool
    ((board:[200]u8))[(i:u16)]:u8 = 0:u8
    (i:u16) = ((i:u16) + 1:u8):u16
  (next_type:u8) = call @random_piece():u8
  call @init_screen():void
  var py: u8 = 3:u8
  while ((py:u8) < 7:u8):bool
    var px: u8 = 5:u8
    while ((px:u8) < 9:u8):bool
      call @fill_cell((px:u8), (py:u8)):void
      (px:u8) = ((px:u8) + 1:u8):u8
    (px:u8) = 23:u8
    while ((px:u8) < 27:u8):bool
      call @fill_cell((px:u8), (py:u8)):void
      (px:u8) = ((px:u8) + 1:u8):u8
    (py:u8) = ((py:u8) + 1:u8):u8
  call @spawn_piece():void
  while ((game_over:u8) == 0:u8):bool
    call @zx_halt():void
    (frame_count:u16) = ((frame_count:u16) + 1:u8):u16
    var keys: u8 = call @read_input():u8
    var changed: u8 = ((keys:u8) ^ (prev_keys:u8)):u8
    var new_keys: u8 = ((keys:u8) & (changed:u8)):u8
    (prev_keys:u8) = (keys:u8)
    if (((new_keys:u8) & 1:u8):u8 != 0:u8):bool
      if ((cur_x:u8) > 0:u8):bool
        if call @can_place((cur_type:u8), (cur_rot:u8), ((cur_x:u8) - 1:u8):u8, (cur_y:u8)):bool
          (cur_x:u8) = ((cur_x:u8) - 1:u8):u8
          (last_was_tspin:u8) = 0:u8
    if (((new_keys:u8) & 2:u8):u8 != 0:u8):bool
      if call @can_place((cur_type:u8), (cur_rot:u8), ((cur_x:u8) + 1:u8):u8, (cur_y:u8)):bool
        (cur_x:u8) = ((cur_x:u8) + 1:u8):u8
        (last_was_tspin:u8) = 0:u8
    if (((new_keys:u8) & 4:u8):u8 != 0:u8):bool
      call @try_rotate():u8
    if (((keys:u8) & 8:u8):u8 != 0:u8):bool
      (drop_timer:u8) = (drop_speed:u8)
    if (((new_keys:u8) & 16:u8):u8 != 0:u8):bool
      while call @can_place((cur_type:u8), (cur_rot:u8), (cur_x:u8), ((cur_y:u8) + 1:u8):u8):bool
        (cur_y:u8) = ((cur_y:u8) + 1:u8):u8
        (score:u16) = ((score:u16) + 2:u8):u16
      call @do_lock_and_clear():void
      (drop_timer:u8) = 0:u8
    if (((new_keys:u8) & 32:u8):u8 != 0:u8):bool
      call @hold_piece():void
    (drop_timer:u8) = ((drop_timer:u8) + 1:u8):u8
    if ((drop_timer:u8) >= (drop_speed:u8)):bool
      (drop_timer:u8) = 0:u8
      if call @can_place((cur_type:u8), (cur_rot:u8), (cur_x:u8), ((cur_y:u8) + 1:u8):u8):bool
        (cur_y:u8) = ((cur_y:u8) + 1:u8):u8
      else
        call @do_lock_and_clear():void
    call @render():void
  var flash: u8 = 0:u8
  while ((flash:u8) < 20:u8):bool
