    call @zx_halt():void
    call @zx_halt():void
    call @zx_halt():void
    call @zx_border(0:u8):void
    call @zx_halt():void
    call @zx_halt():void
    call @zx_halt():void
    (flash:u8) = ((flash:u8) + 1:u8):u8


