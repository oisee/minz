fun @can_place(t: u8, r: u8, px: u8, py: u8) -> bool
  var c: u8 = 0:u8
  while ((c:u8) < 4:u8):bool
    var cx: u8 = ((px:u8) + call @piece_dx((t:u8), (r:u8), (c:u8)):u8):u8
    var cy: u8 = ((py:u8) + call @piece_dy((t:u8), (r:u8), (c:u8)):u8):u8
    if ((cx:u8) >= 10:u8):bool
      return false:bool
    if ((cy:u8) >= 20:u8):bool
      return false:bool
    if (call @board_get((cx:u8), (cy:u8)):u8 != 0:u8):bool
      return false:bool
    (c:u8) = ((c:u8) + 1:u8):u8
  return true:bool

fun @lock_piece()
