  if (((row_df:u8) & 1:u8):u8 == 0:u8):bool
    (keys:u8) = ((keys:u8) | 2:u8):u8
  var row_fb: u8 = call @zx_key_row(251:u8):u8
  if (((row_fb:u8) & 1:u8):u8 == 0:u8):bool
    (keys:u8) = ((keys:u8) | 4:u8):u8
  var row_fd: u8 = call @zx_key_row(253:u8):u8
  if (((row_fd:u8) & 1:u8):u8 == 0:u8):bool
    (keys:u8) = ((keys:u8) | 8:u8):u8
  var row_7f: u8 = call @zx_key_row(127:u8):u8
