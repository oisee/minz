  return (keys:u8)

fun @score_lines(cl: u8)
  if ((cl:u8) == 0:u8):bool
    if ((last_was_tspin:u8) == 1:u8):bool
      (score:u16) = ((score:u16) + 400:u16):u16
    return
  if ((last_was_tspin:u8) == 1:u8):bool
    if ((cl:u8) == 1:u8):bool
      (score:u16) = ((score:u16) + 800:u16):u16
    if ((cl:u8) == 2:u8):bool
      (score:u16) = ((score:u16) + 1200:u16):u16
    if ((cl:u8) == 3:u8):bool
      (score:u16) = ((score:u16) + 1600:u16):u16
  else
    if ((cl:u8) == 1:u8):bool
      (score:u16) = ((score:u16) + 100:u8):u16
    if ((cl:u8) == 2:u8):bool
      (score:u16) = ((score:u16) + 300:u16):u16
    if ((cl:u8) == 3:u8):bool
      (score:u16) = ((score:u16) + 500:u16):u16
    if ((cl:u8) == 4:u8):bool
      (score:u16) = ((score:u16) + 800:u16):u16
  (lines_cleared:u16) = ((lines_cleared:u16) + cast((cl:u8)):u16):u16
  if ((drop_speed:u8) > 5:u8):bool
    if ((cast((lines_cleared:u16)):u8 & 7:u8):u8 == 0:u8):bool
      (drop_speed:u8) = ((drop_speed:u8) - 2:u8):u8

