      call @board_set((cx:u8), (cy:u8), (color_idx:u8)):void
    (c:u8) = ((c:u8) + 1:u8):u8

fun @clear_lines() -> u8
  var cleared: u8 = 0:u8
  var y: u8 = 19:u8
  while ((y:u8) < 20:u8):bool
    var full: u8 = 1:u8
    var x: u8 = 0:u8
    while ((x:u8) < 10:u8):bool
      if (call @board_get((x:u8), (y:u8)):u8 == 0:u8):bool
        (full:u8) = 0:u8
      (x:u8) = ((x:u8) + 1:u8):u8
    if ((full:u8) == 1:u8):bool
      var sy: u8 = (y:u8)
      while ((sy:u8) > 0:u8):bool
        var sx: u8 = 0:u8
        while ((sx:u8) < 10:u8):bool
          call @board_set((sx:u8), (sy:u8), call @board_get((sx:u8), ((sy:u8) - 1:u8):u8):u8):void
          (sx:u8) = ((sx:u8) + 1:u8):u8
        (sy:u8) = ((sy:u8) - 1:u8):u8
      var sx2: u8 = 0:u8
      while ((sx2:u8) < 10:u8):bool
        call @board_set((sx2:u8), 0:u8, 0:u8):void
        (sx2:u8) = ((sx2:u8) + 1:u8):u8
      (cleared:u8) = ((cleared:u8) + 1:u8):u8
    else
      (y:u8) = ((y:u8) - 1:u8):u8
  return (cleared:u8)

