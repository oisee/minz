; generated by MIR2 Z80 codegen

; fun four_ptrs(p0: ptr = HL, p1: ptr = DE, p2: ptr = BC, p3: ptr = IX) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
four_ptrs:
    LD A, (HL)
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (DE)
    LD D, A
    EX AF, AF'      ; restore byte-load scratch
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (BC)
    LD C, A
    EX AF, AF'      ; restore byte-load scratch
    LD E, (IX+0)
    ADD A, D
    LD H, A
    ; materialize r13 (pendingAcc)
    LD A, C
    ADD A, E
    LD B, A
    LD A, H
    ADD A, B
    RET

; fun peek(addr: u16 = HL) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
peek:
    LD A,(HL)
    RET

; fun oracle_four(a: u16 = HL, b: u16 = DE, c: u16 = BC, d: u16 = IX) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
oracle_four    EQU four_ptrs

; fun oracle_observe(addr: u16 = HL) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
oracle_observe    EQU peek

