; MIR2 module: multi.nanz
fun @short_sum(%r1: ptr [pointer], %r2: u8 [general]) -> u8 [acc]
  block @entry:
    %r3 = const 0 : u8 [general]
    %r4 = const 0 : u8 [general]
    jmp @loop_head1(%r4, %r2, %r1, %r3)
  block @loop_head1(%r5: u8 [general], %r6: u8 [general], %r7: ptr [general], %r8: u8 [general]):
    %r9 = cmp.ult %r5, %r6 : bool [flag]
    br_if %r9, @loop_body2(), @loop_exit3(%r5, %r6, %r7, %r8)
  block @loop_body2:
    %r10 = ext %r5 : u8 -> u16 [index]
    %r11 = ptr_add %r7, %r10 : ptr [pointer]
    %r12 = load %r11 : u8 [general]
    %r13 = add %r8, %r12 : u8 [general]
    %r14 = const 1 : u8 [general]
    %r15 = add %r5, %r14 : u8 [general]
    jmp @loop_head1(%r15, %r6, %r7, %r13)
  block @loop_exit3(%r16: u8 [general], %r17: u8 [general], %r18: ptr [general], %r19: u8 [general]):
    ret %r19

fun @long_sum(%r20: ptr [pointer], %r21: u8 [general]) -> u8 [acc]
  block @entry:
    %r22 = const 0 : u8 [general]
    %r23 = const 0 : u8 [general]
    %r24 = const 65535 : u16 [pointer]
