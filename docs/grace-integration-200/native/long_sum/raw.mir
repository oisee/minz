  block @fe_body4(%r32: u8 [counter], %r33: ptr [pointer], %r34: u8 [general]):
    %r35 = load %r33 : u8 [general]
    %r36 = add %r34, %r35 : u8 [general]
    %r37 = ptr_bump %r33, +1 : ptr [pointer]
    djnz %r32, @fe_body4(%r37, %r36), @fe_exit5(%r36)
  block @fe_exit5(%r38: u8 [general]):
    jmp @if_join2(%r21, %r38)
  block @if_else3:
