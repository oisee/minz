    br_if %r43, @loop_body7(), @loop_exit8(%r39, %r40, %r41, %r42)
  block @loop_body7:
    %r44 = ext %r39 : u8 -> u16 [index]
    %r45 = ptr_add %r41, %r44 : ptr [pointer]
    %r46 = load %r45 : u8 [general]
    %r47 = add %r42, %r46 : u8 [general]
    %r48 = const 1 : u8 [general]
    %r49 = add %r39, %r48 : u8 [general]
    jmp @loop_head6(%r49, %r40, %r41, %r47)
  block @loop_exit8(%r50: u8 [general], %r51: u8 [general], %r52: ptr [general], %r53: u8 [general]):
