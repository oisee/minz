    POP IY
    POP HL
    POP DE
    LD BC, 1
    PUSH HL
    LD H, D
    LD L, E
    ADD HL, BC
    PUSH HL
    POP BC
    POP HL
    EX AF, AF'
    LD A, IYH
    LD IXL, A
    EX AF, AF'
    LD IXH, 0
    PUSH HL
    PUSH DE
    PUSH BC
    POP HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    POP DE
    PUSH HL
    POP BC
    POP DE
    POP HL
