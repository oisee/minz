; fun str_eq(a: u16 = HL, b: u16 = DE) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
str_eq:
    PUSH HL
    OR A
    SBC HL, DE
    POP HL
    JRS NZ, .str_eq_if_join2
.str_eq_if_then1:
    LD A, 1
    RET
.str_eq_if_join2:
    ; genCall: peek dst=110
    PUSH DE
    PUSH HL
    CALL peek
    POP HL
    POP DE
    ; genCall: peek dst=111
    PUSH AF
    PUSH DE
    PUSH HL
    LD H, D
    LD L, E
    CALL peek
    LD B, A
    POP HL
    POP DE
    POP AF
    CP B
    JRS Z, .str_eq_if_join4
.str_eq_if_then3:
    LD A, 0
    RET
.str_eq_if_join4:
    LD IYH, 0
    LD IYL, A
.str_eq_loop_head5:
    LD A, IYH
    CP IYL
    LD A, 1
    RET NC
.str_eq_loop_body6:
    LD BC, 1
    PUSH HL
    ADD HL, BC
    PUSH HL
    POP BC
    POP HL
    EX AF, AF'
    LD A, IYH
    LD IXL, A
    EX AF, AF'
    LD IXH, 0
    PUSH HL
    PUSH DE
    PUSH BC
    POP HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    POP DE
    PUSH HL
    POP BC
    POP DE
    POP HL
