; MIR2 module: examples/nanz/hello_cpm.nanz
fun @putch(%r1: u8 [acc])
  block @entry:
    asm "LD E, A\n        LD C, 2\n        CALL 5"
    ret void

fun @main()
  block @entry:
    %r2 = const 72 : u8 [general]
    %r3 = move %r2 : u8 [acc]
    call @putch(%r3)
    %r4 = const 101 : u8 [general]
    %r5 = move %r4 : u8 [acc]
    call @putch(%r5)
    %r6 = const 108 : u8 [general]
    %r7 = move %r6 : u8 [acc]
    call @putch(%r7)
    %r8 = const 108 : u8 [general]
    %r9 = move %r8 : u8 [acc]
    call @putch(%r9)
    %r10 = const 111 : u8 [general]
    %r11 = move %r10 : u8 [acc]
    call @putch(%r11)
    %r12 = const 33 : u8 [general]
    %r13 = move %r12 : u8 [acc]
    call @putch(%r13)
    %r14 = const 13 : u8 [general]
    %r15 = move %r14 : u8 [acc]
    call @putch(%r15)
    %r16 = const 10 : u8 [general]
    %r17 = move %r16 : u8 [acc]
    call @putch(%r17)
    ret void

