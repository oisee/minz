
assert abs_diff(0, 1) == 1
assert abs_diff(1, 0) == 1
assert abs_diff(10, 0) == 10
assert abs_diff(20, -10) == 30

fun abs_diff(a: i8, b: i8) -> u8 {
    c = a - b
    if (a>=b) {
        return c
    }
    return -c
}

