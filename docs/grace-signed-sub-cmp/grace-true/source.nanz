// assert keke(0) == 1
 fun less_sub(a:i8,b:i8)->u8 { if a<b {return a-b}
 return 0 }
 fun equal_sub(a:i8,b:i8)->u8 { var c:i8=a-b
 if a==b {return 100}
 return u8(c) }
 fun greater_sub(a:i8,b:i8)->u8 { var c:i8=a-b
 if a>b {return u8(c)}
 return 0 }
 fun unsigned_sub(a:u8,b:u8)->u8 { var c:u8=a-b
 if a>=b {return c}
 return -c }
 