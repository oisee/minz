; MIR2 module: signed_sub_cmp
fun @abs_diff(%r1: i8 [acc], %r2: i8 [general]) -> u8 [acc]
  block @entry:
    %r3 = sub %r1, %r2 : i8 [acc]
    %r4 = cmp.ge %r1, %r2 : bool [flag]
    br_if %r4, @if_then1(), @if_join2()
  block @if_then1:
    ret %r3
  block @if_join2:
    %r5 = neg %r3 : u8 [acc]
    ret %r5

