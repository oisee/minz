    %r9 = sub %r6, %r7 : i8 [acc]
    ret %r9
  block @if_join2:
    %r10 = const 0 : u8 [general]
    ret %r10

fun @equal_sub(%r11: i8 [acc], %r12: i8 [general]) -> u8 [acc]
  block @entry:
    %r13 = sub %r11, %r12 : i8 [acc]
