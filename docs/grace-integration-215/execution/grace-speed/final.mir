    %r10 = const 0 : bool [general]
    %r11 = cmp.eq %r9, %r10 : bool [flag]
    %r12 = const 0 : bool [general]
    %r13 = cmp.ne %r11, %r12 : bool [flag]
    br_if %r13, @loop_exit3(%r8, %r3), @if_join5()
  block @loop_exit3(%r14: u8 [general], %r15: u8 [general]):
    %r16 = addr_of @state : ptr [pointer]
    store %r16, %r14 : u8
    ret %r15
  block @if_join5:
    %r17 = add %r3, %r8 : u8 [general]
    jmp @loop_head1(%r4, %r8, %r17)

