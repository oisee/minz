@@ -0,0 +1,66 @@
+package hir_test
+
+import (
+	. "github.com/minz/minzc/pkg/hir"
+	"github.com/minz/minzc/pkg/mir2"
+	"github.com/minz/minzc/pkg/nanz"
+	"os"
+	"testing"
+)
+
+func TestArenaPeelIndependentProof(t *testing.T) {
+	for _, mutant := range []string{"valid", "swap", "len1beforepair", "tailzero", "otherfunc", "global", "origin", "orphan", "sticky", "nil"} {
+		t.Run(mutant, func(t *testing.T) {
+			parse := func() *Module {
+				src, e := os.ReadFile("../../../examples/nanz/self_lanz_parser.nanz")
+				if e != nil {
+					t.Fatal(e)
+				}
+				m, e := nanz.Parse(string(src), "self_lanz_parser.nanz")
+				if e != nil {
+					t.Fatal(e)
+				}
+				return m
+			}
+			source, actual := parse(), parse()
+			f := actual.FuncByName("region_match")
+			i, n := Var("i", mir2.TyU8), Var("len", mir2.TyU8)
+			_ = i
+			peek := func(e Expr) Expr { return &CallExpr{Fn: "peek", Args: []Expr{e}, Ty: mir2.TyU8} }
+			d := f.Body.Body[0].(*VarDeclStmt)
+			d.Init = U8(1)
+			old := f.Body.Body
+			f.Body = Blk(If(Eq(n, U8(0)), Blk(&ReturnStmt{Val: U8(1)}), nil), If(Ne(peek(Add(Var("arena_p", mir2.TyU16), U8(1), mir2.TyU16)), peek(Add(Var("src_buf", mir2.TyU16), Var("src_start", mir2.TyU16), mir2.TyU16))), Blk(&ReturnStmt{Val: U8(0)}), nil), If(Eq(n, U8(1)), Blk(&ReturnStmt{Val: U8(1)}), nil), d, old[1], old[2])
+			w := MemoryHostWorkload{Schema: "minz.memory-host-workload/v1", TargetModel: "cpm-z80-v1", MaxSteps: 100000, MaxMemory: 65536, Layout: MemoryHostLayout{CodeOrigin: 0x400, StackLow: 0xe000, StackHigh: 0xeff0, ReturnPC: 0x100}, Hosts: map[string]string{"peek": MemoryHostReadU8, "poke": MemoryHostWriteU8}, Regions: map[string]MemoryHostRegion{"r": {Address: 0x8000, Bytes: make([]byte, 4096), Writable: true}}, Calls: []MemoryHostInvocation{{Function: "region_match", Arguments: []int64{0x8000, 0, 0}}}}
+			switch mutant {
+			case "swap":
+				b := f.Body.Body[1].(*IfStmt).Cond.(*BinExpr)
+				b.L, b.R = b.R, b.L
+			case "len1beforepair":
+				f.Body.Body[1], f.Body.Body[2] = f.Body.Body[2], f.Body.Body[1]
+			case "tailzero":
+				d.Init = U8(0)
+			case "otherfunc":
+				actual.FuncByName("node_tag").Body.Body[0] = &ReturnStmt{Val: U8(0)}
+			case "global":
+				actual.Globals[0].Init = []byte{0, 0x80}
+			case "origin":
+				for s, l := range actual.SourceLocations {
+					l.ByteOffset++
+					actual.SourceLocations[s] = l
+					break
+				}
+			case "orphan":
+				actual.SourceLocations[&ReturnStmt{Val: U8(1)}] = SourceLocation{Unit: "self_lanz_parser.nanz", Line: 1, Column: 1, SourceSHA256: actual.SourceUnits["self_lanz_parser.nanz"]}
+			case "sticky":
+				actual.PointerWalkPolicy = map[string]bool{}
+			case "nil":
+				actual = nil
+			}
+			e := ValidateMemoryHostArenaPeel(source, actual, w)
+			if (e == nil) != (mutant == "valid") {
+				t.Fatal(mutant, e)
+			}
+		})
+	}
+}
diff --git a/minzc/pkg/hir/memory_host_loop_profile_load.go b/minzc/pkg/hir/memory_host_loop_profile_load.go
new file mode 100644
index 00000000..5596eb8c
--- /dev/null
+++ b/minzc/pkg/hir/memory_host_loop_profile_load.go
@@ -0,0 +1,100 @@
+package hir
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"reflect"
+)
+
+const MaxMemoryHostLoopProfileBytes = 8 << 20
+
+// LoadMemoryHostLoopProfile accepts only this closed family, with all typed
+// fields present, exact current source/workload context and complete calls.
+// Measurements must additionally compare it with a newly observed run; JSON
+// identity alone is not provenance for caller-supplied counts.
+func LoadMemoryHostLoopProfile(r io.Reader, source *Module, w MemoryHostWorkload) (*MemoryHostLoopProfileRun, error) {
+	data, e := io.ReadAll(io.LimitReader(r, MaxMemoryHostLoopProfileBytes+1))
+	if e != nil {
+		return nil, e
+	}
+	if len(data) > MaxMemoryHostLoopProfileBytes {
+		return nil, fmt.Errorf("memory loop profile: size limit")
+	}
+	d := json.NewDecoder(bytes.NewReader(data))
+	if e = checkJSONValue(d); e != nil {
+		return nil, e
+	}
+	if _, e = d.Token(); e != io.EOF {
+		return nil, fmt.Errorf("memory loop profile: trailing JSON")
+	}
+	var p MemoryHostLoopProfileRun
+	d = json.NewDecoder(bytes.NewReader(data))
+	d.DisallowUnknownFields()
+	if e = d.Decode(&p); e != nil {
+		return nil, e
+	}
+	// Canonical typed shape equality also refuses omitted zero-valued fields and
+	// null count arrays instead of silently synthesizing a complete profile.
+	var got, want any
+	shapeDecoder := json.NewDecoder(bytes.NewReader(data))
+	shapeDecoder.UseNumber()
+	if e = shapeDecoder.Decode(&got); e != nil {
+		return nil, e
+	}
+	canonical, e := json.Marshal(p)
+	if e != nil {
+		return nil, e
+	}
+	shapeDecoder = json.NewDecoder(bytes.NewReader(canonical))
+	shapeDecoder.UseNumber()
+	if e = shapeDecoder.Decode(&want); e != nil {
+		return nil, e
+	}
+	if !reflect.DeepEqual(got, want) {
+		return nil, fmt.Errorf("memory loop profile: incomplete typed fields")
+	}
+	owned, ctx, e := PrepareMemoryHostWorkload(source, w)
+	if e != nil {
+		return nil, e
+	}
+	if _, e = BuildFunctionSiteMap(source); e != nil {
+		return nil, e
+	}
+	ctx.SemanticsID += ":" + MemoryHostLoopProfileSemantics
+	key, e := BuildProfileCompatibility(source, ctx)
+	if e != nil {
+		return nil, e
+	}
+	sites, e := BuildLoopSiteMap(source)
+	if e != nil {
+		return nil, e
+	}
+	if sites.UnmappedLoops != 0 || p.Schema != "minz.memory-host-loop-observations/v1" || p.Stage != "input-hir-instrumented-mir2-vm" || !reflect.DeepEqual(p.Workload, owned) || !reflect.DeepEqual(p.Context, ctx) || !reflect.DeepEqual(p.Compatibility, key) || !reflect.DeepEqual(p.Sites, sites) {
+		return nil, fmt.Errorf("memory loop profile: incompatible family/source/workload")
+	}
+	if p.FailedCalls != 0 || p.CompletedCalls == 0 || p.CompletedCalls != uint64(len(owned.Calls)) || len(p.Invocations) != len(owned.Calls) || len(p.Counts) != len(sites.Sites) {
+		return nil, fmt.Errorf("memory loop profile: incomplete or failed sample")
+	}
+	sums := make([]LoopCounts, len(sites.Sites))
+	for i, s := range sites.Sites {
+		sums[i].SiteID = s.ID
+	}
+	for _, inv := range p.Invocations {
+		if !inv.Completed || inv.Observation.Error != "" || inv.Observation.Failure != nil || len(inv.Counts) != len(sums) {
+			return nil, fmt.Errorf("memory loop profile: failed invocation")
+		}
+		for i, c := range inv.Counts {
+			if c.SiteID != sums[i].SiteID || c.Entries == 0 && c.BodyEntries != 0 || c.Entries > ^uint64(0)-sums[i].Entries || c.BodyEntries > ^uint64(0)-sums[i].BodyEntries {
+				return nil, fmt.Errorf("memory loop profile: invalid count delta")
+			}
+			sums[i].Entries += c.Entries
+			sums[i].BodyEntries += c.BodyEntries
+		}
+	}
+	if !reflect.DeepEqual(sums, p.Counts) {
+		return nil, fmt.Errorf("memory loop profile: cumulative count mismatch")
+	}
+	return &p, nil
+}
diff --git a/minzc/pkg/pipeline/memory_host_arena_peel_construct.go b/minzc/pkg/pipeline/memory_host_arena_peel_construct.go
