; fun parse_sexpr() -> u16 = HL [recursive] ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1,dead-block-arg=1]
parse_sexpr:
    ; genCall: skip_ws dst=0
    CALL skip_ws
    ; genCall: cur dst=250
    CALL cur
    AND A
    JRS NZ, .parse_sexpr_if_join2
.parse_sexpr_if_then1:
    LD A, 0
