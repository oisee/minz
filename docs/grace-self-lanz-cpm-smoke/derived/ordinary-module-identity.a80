    LD (HL), D     ; hi
    DEC HL
    ; genCall: skip_ws dst=0
    CALL skip_ws
    ; genCall: cur dst=261
    CALL cur
    CP 41
    JRS NZ, .parse_sexpr_if_join6
.parse_sexpr_if_then5:
