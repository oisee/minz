    LD C, 0
    ; genCall: make_node dst=283
    PUSH DE
    LD D, H
    LD E, L
    LD IXL, C
    LD C, B
    LD B, 0
    LD IXH, 0
    CALL make_node
    POP DE
    ; genCall: skip_ws dst=0
    PUSH DE
    PUSH HL
    CALL skip_ws
    POP HL
    POP DE
.parse_sexpr_loop_head7:
    ; genCall: cur dst=286
    PUSH DE
    PUSH HL
    CALL cur
    POP HL
    POP DE
    CP 41
    JRS Z, .parse_sexpr_trmp0
.parse_sexpr_loop_body8:
    ; genCall: cur dst=289
    PUSH DE
    PUSH HL
    CALL cur
