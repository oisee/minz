; fun node_tag(n: u16 = HL) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
node_tag    EQU peek

; fun node_d0(n: u16 = DE) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
