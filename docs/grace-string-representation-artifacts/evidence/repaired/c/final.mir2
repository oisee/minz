    %r5 = addr_of @@mir2.str.1 : ptr [pointer]
    %r6 = move %r5 : ptr [pointer]
    call @@mir.io.print.str(%r6)
    %r7 = const 1 : u16 [pointer]
    %r8 = add %r2, %r7 : u16 [pointer]
    %r9 = addr_of @answer : ptr [pointer]
    store %r9, %r8 : u16
    ret void

