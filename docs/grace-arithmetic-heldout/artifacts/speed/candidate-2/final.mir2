    jmp @fib_tail_tail_loop(%r1, %r2, %r3)
  block @fib_tail_tail_loop(%r4: u8 [acc], %r5: u8 [general], %r6: u8 [counter]):
    %r7 = const 0 : u8 [general]
    %r8 = cmp.eq %r4, %r7 : bool [flag]
    br_if %r8, @if_then1(), @if_join2()
  block @if_then1:
    ret %r5
  block @if_join2:
    %r9 = const 1 : u8 [general]
    %r10 = sub %r4, %r9 : u8 [acc]
    %r11 = move %r10 : u8 [acc]
    %r12 = add %r5, %r6 : u8 [acc]
    %r13 = move %r12 : u8 [counter]
    jmp @fib_tail_tail_loop(%r11, %r6, %r13)

