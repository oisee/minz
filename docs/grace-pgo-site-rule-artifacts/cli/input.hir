; HIR module: /tmp/minz-grace-pgo-resume/examples/nanz/grace_weighted_checksum.nanz
global @checksum_calls : u8
global @checksum_last : u16

fun @weighted_checksum(ptr: ptr, n: u8, a: u16, b: u16, seed: u16) -> u16
  var sum: u16 = (seed:u16)
  var i: u8 = 0:u8
  var __grace_base_0: u16 = ((a:u16) + (b:u16)):u16
  while ((i:u8) < (n:u8)):bool
    (sum:u16) = ((sum:u16) + (__grace_base_0:u16)):u16
    (sum:u16) = ((sum:u16) + cast(((ptr:ptr))[(i:u8)]:u8):u16):u16
    (i:u8) = ((i:u8) + 1:u8):u8
  return (sum:u16)

fun @record_checksum(value: u16) -> u16
  (checksum_calls:u8) = ((checksum_calls:u8) + 1:u8):u8
  (checksum_last:u16) = (value:u16)
  return (value:u16)

fun @checksum_packet(ptr: ptr, n: u8, a: u16, b: u16, seed: u16) -> u16
  var value: u16 = call @weighted_checksum((ptr:ptr), (n:u8), (a:u16), (b:u16), (seed:u16)):u16
  return call @record_checksum((value:u16)):u16

