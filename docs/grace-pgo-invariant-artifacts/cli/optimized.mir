    %r19 = add %r14, %r18 : u16 [pointer]
    %r20 = const 1 : u8 [general]
    %r21 = add %r9, %r20 : u8 [general]
    jmp @loop_head1(%r8, %r21, %r10, %r11, %r19)

fun @record_checksum(%r27: u16 [pointer]) -> u16 [pointer]
