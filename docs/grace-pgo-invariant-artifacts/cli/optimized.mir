    %r32 = addr_of @checksum_calls : ptr [pointer]
    store %r32, %r31 : u8
    %r33 = addr_of @checksum_last : ptr [pointer]
    store %r33, %r27 : u16
    ret %r27

fun @checksum_packet(%r34: ptr [pointer], %r35: u8 [general], %r36: u16 [index], %r37: u16 [index], %r38: u16 [index]) -> u16 [pointer]
