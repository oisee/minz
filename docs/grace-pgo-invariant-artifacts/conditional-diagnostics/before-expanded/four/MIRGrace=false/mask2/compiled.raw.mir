; MIR2 module: conditional-invariant.nanz
fun @scalar(%r1: u16 [pointer], %r2: u16 [index], %r3: u8 [counter], %r4: u8 [general]) -> u16 [pointer]
  block @entry:
    %r5 = const 0 : u8 [general]
    %r6 = const 0 : u8 [general]
    jmp @loop_head1(%r1, %r2, %r6, %r3, %r5)
  block @loop_head1(%r7: u16 [pointer], %r8: u16 [pointer], %r9: u8 [general], %r10: u8 [general], %r11: u16 [pointer]):
    %r12 = cmp.ult %r9, %r10 : bool [flag]
    br_if %r12, @loop_body2(), @loop_exit3(%r7, %r8, %r9, %r10, %r11)
  block @loop_body2:
    %r13 = add %r7, %r8 : u16 [pointer]
    %r14 = add %r11, %r13 : u16 [pointer]
    %r15 = const 1 : u8 [general]
    %r16 = add %r9, %r15 : u8 [general]
    jmp @loop_head1(%r7, %r8, %r16, %r10, %r14)
  block @loop_exit3(%r17: u16 [pointer], %r18: u16 [pointer], %r19: u8 [general], %r20: u8 [general], %r21: u16 [pointer]):
    %r22 = const 0 : u8 [general]
    %r23 = cmp.eq %r4, %r22 : bool [flag]
    br_if %r23, @if_then4(), @if_join5()
  block @if_then4:
    ret %r21
  block @if_join5:
    %r24 = const 0 : u8 [general]
    %r25 = add %r17, %r18 : u16 [pointer]
    jmp @loop_head6(%r25, %r24, %r20, %r21)
  block @loop_head6(%r26: u16 [pointer], %r27: u8 [general], %r28: u8 [general], %r29: u16 [pointer]):
    %r30 = cmp.ult %r27, %r28 : bool [flag]
    br_if %r30, @loop_body7(), @loop_exit8(%r26, %r27, %r28, %r29)
  block @loop_body7:
    %r31 = add %r29, %r26 : u16 [pointer]
    %r32 = const 1 : u8 [general]
    %r33 = add %r27, %r32 : u8 [general]
    jmp @loop_head6(%r26, %r33, %r28, %r31)
  block @loop_exit8(%r34: u16 [pointer], %r35: u8 [general], %r36: u8 [general], %r37: u16 [pointer]):
    ret %r37

fun @idle() -> u16 [pointer]
  block @entry:
    %r38 = const 7 : u8 [general]
    ret %r38

