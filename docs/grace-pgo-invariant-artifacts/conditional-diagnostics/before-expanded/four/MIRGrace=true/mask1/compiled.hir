; HIR module: conditional-invariant.nanz
fun @scalar(a: u16, b: u16, n: u8, second: u8) -> u16
  var s: u16 = 0:u8
  var i: u8 = 0:u8
  var __grace_base_0: u16 = ((a:u16) + (b:u16)):u16
  while ((i:u8) < (n:u8)):bool
    (s:u16) = ((s:u16) + (__grace_base_0:u16)):u16
    (i:u8) = ((i:u8) + 1:u8):u8
  if ((second:u8) == 0:u8):bool
    return (s:u16)
  var j: u8 = 0:u8
  while ((j:u8) < (n:u8)):bool
    (s:u16) = ((s:u16) + ((a:u16) + (b:u16)):u16):u16
    (j:u8) = ((j:u8) + 1:u8):u8
  return (s:u16)

fun @idle() -> u16
  return 7:u8

