        ; fun gcd(a: u8 = A, b: u8 = C) -> u8 = A [recursive] ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
        gcd:
            LD E, A    ; materialize r1 (pendingAcc)
            LD A, C
            AND A
            LD A, E
            ; restore live-out r1 from scratch
            RET Z
        .gcd_recursive:
            LD B, A
            XOR A
            LD D, 8
        .div8_0:
            SLA B
            RLA
            CP C
            JR C, .div8_skip_0
            SUB C
            INC B
        .div8_skip_0:
            DEC D
            JR NZ, .div8_0
            ; genCall: gcd dst=6
            PUSH AF
            EX AF, AF'
            POP AF
            EX AF, AF'
            EX AF, AF'
            LD A, C
            PUSH AF
            EX AF, AF'
            PUSH AF
            EX AF, AF'
            POP AF
            LD C, A
            EX AF, AF'
            POP AF
            JP gcd
        
        
