// EligibleScalarInvariantSites reports original attributed loops where the
// existing proof permits a scalar u16 addition. It neither rewrites nor seeds
// the input. Pointer-result plans are excluded from this scalar-site contract.
func EligibleScalarInvariantSites(m *Module) ([]string, error) {
	if m == nil {
		return nil, fmt.Errorf("invariant sites: nil module")
	}
	if err := Verify(m); err != nil {
		return nil, err
	}
	sites, err := BuildLoopSiteMap(m)
	if err != nil {
		return nil, err
	}
	paths := map[string]map[string]string{}
	for _, s := range sites.Sites {
		if paths[s.Function] == nil {
			paths[s.Function] = map[string]string{}
		}
		paths[s.Function][s.HIRPath] = s.ID
	}
	reserved := map[string]bool{}
	for _, f := range m.Funcs {
		reserved[f.Name] = true
	}
	for _, g := range m.Globals {
		reserved[g.Name] = true
	}
	eligible := []string{}
	for _, f := range m.Funcs {
		walkGraceBlocks(f.Body, "body", func(path string, b *Block) {
			for i, s := range b.Body {
				loop, ok := s.(*WhileStmt)
				if !ok {
					continue
				}
				plan := findGraceHoistSelected(f, b, reserved, func(candidate *WhileStmt) bool { return candidate == loop })
				if plan != nil && plan.expr.Ty == mir2.TyU16 {
					if id := paths[f.Name][fmt.Sprintf("%s/s%d", path, i)]; id != "" {
						eligible = append(eligible, id)
					}
				}
			}
		})
	}
	sort.Strings(eligible)
	return eligible, nil
}

// EligibleInvariantBaseSites is the scalar source-proof discovery API.
func EligibleInvariantBaseSites(m *Module) ([]string, error) { return EligibleScalarInvariantSites(m) }

// RemainingInvariantBaseSites reports legal scalar additions still present in
// attributed current loops. It uses lineage identities after rewriting, avoiding
// original HIR paths that may shift when preheader declarations are inserted.
func RemainingInvariantBaseSites(m *Module) ([]string, error) {
	if m == nil {
		return nil, fmt.Errorf("invariant remaining: nil module")
	}
	if err := Verify(m); err != nil {
		return nil, err
	}
	reserved := map[string]bool{}
	for _, f := range m.Funcs {
		reserved[f.Name] = true
	}
	for _, g := range m.Globals {
		reserved[g.Name] = true
	}
	seen := map[string]bool{}
	for _, f := range m.Funcs {
		walkGraceBlocks(f.Body, "", func(_ string, b *Block) {
			for _, s := range b.Body {
				loop, ok := s.(*WhileStmt)
				if !ok {
					continue
				}
				origin, mapped := m.LoopLineage[loop]
				if !mapped {
					continue
				}
				plan := findGraceHoistSelected(f, b, reserved, func(candidate *WhileStmt) bool { return candidate == loop })
				if plan != nil && plan.expr.Ty == mir2.TyU16 {
					seen[origin.SiteID] = true
				}
			}
		})
	}
	out := []string{}
	for id := range seen {
		out = append(out, id)
	}
	sort.Strings(out)
	return out, nil
}
	g := &hirGraceGraph{module: m, byLabel: make(map[string]*hirGraceBlock), globals: map[string]bool{}, facts: AnalyzeFacts(m)}
	for _, f := range m.Funcs {
		g.globals[f.Name] = true
	}
	for _, v := range m.Globals {
		g.globals[v.Name] = true
	}
	for i, f := range m.Funcs {
		if f.IsExtern || f.Body == nil {
			continue
		}
		unsafe := false
		walkGraceBlocks(f.Body, "", func(_ string, b *Block) {
			for _, s := range b.Body {
				switch s.(type) {
				case *LabelStmt, *GotoStmt:
					unsafe = true // labels can make a discarded branch reachable
				}
			}
		})
		walkGraceBlocks(f.Body, fmt.Sprintf("f%d", i), func(label string, b *Block) {
			g.labels = append(g.labels, label)
			g.byLabel[label] = &hirGraceBlock{label: label, block: b, unsafeControl: unsafe, owner: f}
		})
	}
	return g
}

func walkGraceBlocks(b *Block, path string, visit func(string, *Block)) {
	if b == nil {
		return
	}
	visit(path, b)
	for i, s := range b.Body {
		p := fmt.Sprintf("%s/s%d", path, i)
		switch st := s.(type) {
		case *Block:
			walkGraceBlocks(st, p, visit)
		case *IfStmt:
			walkGraceBlocks(st.Then, p+"/then", visit)
			walkGraceBlocks(st.Else, p+"/else", visit)
		case *WhileStmt:
			walkGraceBlocks(st.Body, p+"/while", visit)
		case *ForRangeStmt:
			walkGraceBlocks(st.Body, p+"/range", visit)
		case *ForEachStmt:
			walkGraceBlocks(st.Body, p+"/each", visit)
		case *SwitchStmt:
			for j, c := range st.Cases {
				walkGraceBlocks(c.Body, fmt.Sprintf("%s/case%d", p, j), visit)
			}
			walkGraceBlocks(st.Default, p+"/default", visit)
		}
	}
}

// A branch-local binding must not leak into the surrounding lowerer env.
// Until HIR has explicit scope nodes, leave such branches alone.
func graceHasBindings(b *Block) bool {
	found := false
	walkGraceBlocks(b, "", func(_ string, block *Block) {
		for _, s := range block.Body {
			visitStmtExprs(s, func(e Expr) {
				switch x := e.(type) {
