// The same unedited source supplies zero, one or two observed legal sites.
// Early return lets a workload observe the first without entering the second.
const invariantSitesSource = "'`fun scalar(a:u16,b:u16,c:u16,d:u16,n:u8,second:bool)->u16 {
 var s:u16=0
 var i:u8=0
 while i<n { s=s+(a+b)
 i=i+1 }
 if !second { return s }
 var j:u8=0
 while j<n { s=s+(c+d)
 j=j+1 }
 return s
}
fun idle()->u16 { return 7 }
`

func invariantSitesFixture(t *testing.T, observed int, zeroOnly bool) (func() (*hir.Module,error), hir.ProfileWorkload, []byte) {
 t.Helper()
 factory := func() (*hir.Module,error) { return nanz.Parse(invariantSitesSource,"invariant-sites.nanz") }
 literal := func(n int64) hir.ProfileArgument { return hir.ProfileArgument{Value:&n} }
 w := hir.ProfileWorkload{Schema:"minz.profile-workload/v1",TargetModel:"cpm-z80-v1",MaxSteps:200000,MaxMemory:65536}
 if observed == 0 {
  w.Calls = []hir.ProfileInvocation{{Function:"idle"}}
 } else {
  lengths := []int64{0,1,5,255}
  if zeroOnly { lengths = lengths[:1] }
  flag := int64(0)
  if observed == 2 { flag = 1 }
  for _, n := range lengths {
   w.Calls = append(w.Calls,hir.ProfileInvocation{Function:"scalar",Arguments:[]hir.ProfileArgument{literal(65535),literal(2),literal(60000),literal(10000),literal(n),literal(flag)}})
  }
 }
 m,err := factory(); if err != nil { t.Fatal(err) }
 legal,err := hir.EligibleInvariantBaseSites(m)
 if err != nil || len(legal)!=2 { t.Fatalf("source proof: %v %v",legal,err) }
 raw,err := hir.RunLoopProfile(m,w); if err != nil { t.Fatal(err) }
 p,err := json.Marshal(raw.Profile); if err != nil { t.Fatal(err) }
 return factory,w,p
}

func TestInvariantSiteVariantSets(t *testing.T) {
 for _, observed := range []int{0,1,2} {
  for _, zeroOnly := range []bool{false,true} {
   t.Run(fmt.Sprintf("sites%d/zero%v",observed,zeroOnly),func(t *testing.T){
    factory,w,p := invariantSitesFixture(t,observed,zeroOnly)
    for _, size := range []bool{false,true} {
     r,err := MeasureInvariantSiteVariantSets(factory,p,w,Options{AssertMode:"none",UseHIRGrace:true,OptSize:size},4)
     if err != nil { t.Fatal(err) }
     e := r.Evidence
     if e.Schema!="minz.invariant-site-variant-sets/v1" || len(e.EligibleSites)!=observed || len(e.Candidates)!=1<<observed { t.Fatal("incomplete bounded enumeration") }
     best := 0
     for mask,c := range e.Candidates {
      if len(c.RequestedSitePolicy)!=observed || len(c.RulePolicy)!=2 || c.RulePolicy["hir-constant-if"] || !c.RulePolicy["hir-invariant-base"] { t.Fatal("missing explicit policy",mask) }
      for j,id := range e.EligibleSites {
       if c.RequestedSitePolicy[id] != (mask&(1<<(observed-1-j))!=0) { t.Fatal("wrong site request",mask,id) }
      }
      if err := invariantSitesRealized(c.Lineage,c.RequestedSitePolicy); err!=nil { t.Fatal(err) }
      if err := invariantSitesRealized(c.FinalLineage,c.RequestedSitePolicy); err!=nil { t.Fatal(err) }
      if c.FinalHIR=="" || !jointSameState(c.RawRun,e.Oracle) || !jointSameState(c.FinalRawRun,e.Oracle) { t.Fatal("missing semantic evidence") }
      for _,d := range c.Decisions { if d.Variant!="original" { t.Fatal("pointer choice enabled") } }
      if len(c.Binary)==0 || c.ModuleBytes!=len(c.Binary) || c.BinarySHA256!=fmt.Sprintf("%x",sha256.Sum256(c.Binary)) || c.Run.BinarySHA256!=c.BinarySHA256 { t.Fatal("exact binary mismatch") }
      var total int64
      for j,inv := range c.Run.Invocations {
       total += inv.TStates
       want := int64(7)
       if observed>0 {
        args := w.Calls[j].Arguments
        // Independent modulo-65536 host arithmetic, including long trips.
        sum := uint64(*args[0].Value)+uint64(*args[1].Value)
        if observed==2 { sum += uint64(*args[2].Value)+uint64(*args[3].Value) }
        want = int64(uint16(sum*uint64(*args[4].Value)))
       }
       if len(inv.Results)!=1 || inv.Results[0].I!=want { t.Fatalf("independent Z80 oracle: candidate %d call %d got %v want %d",mask,j,inv.Results,want) }
      }
      if total!=c.TotalTStates { t.Fatal("invocation cost mismatch") }
      better := c.TotalTStates<e.Candidates[best].TotalTStates
      if size { better = c.ModuleBytes<e.Candidates[best].ModuleBytes }
      if better { best=mask }
     }
     if e.Selected!=best || !bytes.Equal(r.Binary,e.Candidates[best].Binary) || r.Steps.Assembly=="" { t.Fatal("retained winner mismatch") }
     copied := *e; copied.SHA256=""
     data,err := json.Marshal(copied)
     if err!=nil || e.SHA256!=fmt.Sprintf("%x",sha256.Sum256(data)) { t.Fatal("evidence digest mismatch") }
    }
   })
  }
 }
}

