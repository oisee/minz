fun @fib_tail(%r1: u8 [acc], %r2: u8 [general], %r3: u8 [counter]) -> u8 [acc]
  block @entry:
    %r4 = const 0 : u8 [general]
    %r5 = cmp.eq %r1, %r4 : bool [flag]
    br_if %r5, @if_then1(), @if_join2()
  block @if_then1:
    ret %r2
  block @if_join2:
    %r6 = const 1 : u8 [general]
    %r7 = sub %r1, %r6 : u8 [acc]
    %r8 = move %r7 : u8 [acc]
    %r9 = add %r2, %r3 : u8 [acc]
    %r10 = move %r9 : u8 [counter]
    %r11 = call @fib_tail(%r8, %r3, %r10) : u8 [acc]
    ret %r11

