.peek_char_if_join2:
    LD DE, (src_buf)    ; u16 direct load, no scratch clobber
    LD HL, (pos)    ; u16 direct load (20T, no A clobber)
    ADD HL, DE
    ; genCall: peek dst=269
    JP peek

; fun skip_ws() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
