; fun print_all_tokens() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1,dead-block-arg=1,condret-sink=1,cond-rets=1]
print_all_tokens:
    LD DE, 0
.print_all_tokens_loop_head1:
    LD HL, (tok_count)    ; u16 direct load (20T, no A clobber)
    PUSH DE
    EX DE, HL
    OR A
    SBC HL, DE
    EX DE, HL
    POP DE
    RET NC
.print_all_tokens_loop_body2:
    LD HL, (tok_arena)    ; u16 direct load (20T, no A clobber)
    PUSH HL
    LD H, D
    LD L, E
    ADD HL, HL
    ADD HL, HL
    LD B, H
    LD C, L
    POP HL
    ADD HL, BC
    ; genCall: peek dst=1338
    PUSH DE
    PUSH HL
    CALL peek
    POP HL
    POP DE
    LD BC, 1
    PUSH HL
    ADD HL, BC
    PUSH HL
    POP BC
    POP HL
    ; genCall: peek dst=1341
    PUSH AF
    PUSH DE
    PUSH HL
    LD H, B
    LD L, C
    CALL peek
    LD B, A
    POP HL
    POP DE
    POP AF
    LD C, B
    LD B, 0
    LD IX, 2
    PUSH DE
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    POP DE
    POP DE
    ; genCall: peek dst=1345
    PUSH AF
    PUSH BC
    PUSH DE
    CALL peek
    LD H, A
    POP DE
    POP BC
    POP AF
    LD L, H
    LD H, 0
    LD H, L
    LD L, 0
    ADD HL, BC
    ; genCall: tok_name dst=0
    PUSH DE
    LD B, H
    LD C, L
    CALL tok_name
    POP DE
    LD HL, _mir2_str_25
    LD A, (HL)
    LD BC, 1
    ADD HL, BC
    PUSH HL
    POP BC
.print_all_tokens_loop_head6:
    AND A
    JRS Z, .print_all_tokens_loop_exit8
.print_all_tokens_loop_body7:
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (BC)
    LD H, A
    EX AF, AF'      ; restore byte-load scratch
    ; genCall: @mir.io.print.char dst=0
    PUSH AF
    LD A, H
    CALL __cpm_putchar
    POP AF
    LD HL, 1
    ADD HL, BC
    DEC A
    LD B, H
    LD C, L
    JRS .print_all_tokens_loop_head6
.print_all_tokens_loop_exit8:
    LD HL, 1
    ADD HL, DE
    LD D, H
    LD E, L
    JRS .print_all_tokens_loop_head1

