; fun emit(typ: u8 = A, str_ptr: u16 = DE) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
emit:
    LD HL, (tok_arena)    ; u16 direct load (20T, no A clobber)
    LD BC, (tok_count)    ; u16 direct load, no scratch clobber
    PUSH HL
    LD H, B
    LD L, C
    ADD HL, HL
    ADD HL, HL
    LD B, H
    LD C, L
    POP HL
    ADD HL, BC
    ; genCall: poke dst=0
    PUSH DE
    PUSH HL
    LD C, A
    CALL poke
    POP HL
    POP DE
    LD BC, 1
    PUSH HL
    ADD HL, BC
    PUSH HL
    POP BC
    POP HL
    PUSH HL
    PUSH DE
    POP HL
    LD A, L
    AND 255
    LD L, A
    LD H, 0
    PUSH HL
    POP IX
    POP HL
    ; genCall: poke dst=0
    PUSH DE
    PUSH HL
    LD H, B
