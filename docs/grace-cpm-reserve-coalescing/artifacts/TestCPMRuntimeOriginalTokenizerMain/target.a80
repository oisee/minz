; fun tokenize_all() -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1,dead-block-arg=1]
tokenize_all:
    LD C, 0
    LD HL, pos
    LD (HL), C     ; lo
    INC HL
    LD (HL), 0     ; hi (zero-extend u8→u16)
    DEC HL
    LD C, 0
    LD HL, tok_count
    LD (HL), C     ; lo
    INC HL
    LD (HL), 0     ; hi (zero-extend u8→u16)
    DEC HL
    ; genCall: scan dst=875
    CALL scan
