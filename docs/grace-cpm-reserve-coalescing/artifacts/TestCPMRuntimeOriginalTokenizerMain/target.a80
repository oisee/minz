    LD H, B
    LD L, C
    LD C, E
    CALL poke
    POP HL
    LD DE, 3
    ADD HL, DE
    LD C, 0
    ; genCall: poke dst=0
    CALL poke
    LD DE, (tok_count)    ; u16 direct load, no scratch clobber
    INC DE
    LD HL, tok_count
    LD (HL), E     ; lo
    INC HL
    LD (HL), D     ; hi
    DEC HL
    RET

; fun classify(str_ptr: u16 = DE) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
classify:
