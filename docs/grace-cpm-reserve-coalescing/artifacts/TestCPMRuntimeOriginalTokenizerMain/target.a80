; fun intern(start: u16 = DE, len: u8 = C) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1,dead-block-arg=1]
intern:
    LD HL, (str_arena)    ; u16 direct load (20T, no A clobber)
    LD IXL, C
.intern_loop_head1:
    LD BC, (str_bump)    ; u16 direct load, no scratch clobber
    PUSH HL
    OR A
    SBC HL, BC
    POP HL
    JRS NC, .intern_trmp0
.intern_loop_body2:
    ; genCall: peek dst=170
    PUSH DE
    PUSH HL
    PUSH IX
    CALL peek
    POP IX
    POP HL
    POP DE
    CP IXL
    JRS NZ, .intern_if_join5
.intern_if_then4:
    PUSH HL
    POP BC
    LD IXH, IXL
    ; genCall: region_eq dst=174
    PUSH AF
    PUSH DE
    PUSH HL
    PUSH IX
    LD H, D
    LD L, E
    LD D, B
    LD E, C
    LD B, IXH
    CALL region_eq
    LD B, A
    POP IX
    POP HL
    POP DE
    POP AF
    LD IYH, A    ; preserve live accumulator before CMP
    LD A, B
    CP 1
    LD A, IYH
    ; restore live-out r170 from scratch
    JRS NZ, .intern_if_join7
.intern_if_then6:
    RET
.intern_if_join7:
.intern_if_join5:
    INC HL
    LD C, A
    LD B, 0
    ADD HL, BC
    JRS .intern_loop_head1
.intern_loop_exit3:
    LD DE, (str_bump)    ; u16 direct load, no scratch clobber
    LD BC, (str_bump)    ; u16 direct load, no scratch clobber
    ; genCall: poke dst=0
    PUSH HL
    PUSH AF
    LD A, (_spill_intern_r181)
    LD L, A
    POP AF
    EX (SP), HL
    PUSH DE
    PUSH HL
    LD H, B
    LD L, C
    EX AF, AF'
    LD A, (_spill_intern_r181)
    LD C, A
    EX AF, AF'
    CALL poke
    POP HL
    POP DE
    EX (SP), HL
    PUSH AF
    LD A, L
    LD (_spill_intern_r181), A
    POP AF
    POP HL
    PUSH AF
    LD A, 0
    LD (_spill_intern_r187), A
    POP AF
.intern_loop_head8:
    LD A, (_spill_intern_r187)
    PUSH HL
    LD HL, _spill_intern_r181
    LD H, (HL)
    CP H
    POP HL
    JRS NC, .intern_trmp1
.intern_loop_body9:
    LD BC, (str_bump)    ; u16 direct load, no scratch clobber
    INC BC
    EX AF, AF'
    LD A, (_spill_intern_r187)
    LD IXL, A
    EX AF, AF'
    LD IXH, 0
    PUSH HL
    PUSH DE
    PUSH BC
    POP HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    POP DE
    PUSH HL
    POP BC
    POP DE
    POP HL
    LD IX, src_buf
    PUSH AF          ; preserve word-load scratch
    LD A, (IX+0)     ; lo
    PUSH AF          ; stage low byte before replacing address
    LD A, (IX+1)     ; hi
    LD IXH, A
    POP AF
    LD IXL, A
    POP AF           ; restore word-load scratch
    PUSH HL
    PUSH DE
    PUSH DE
    LD D, IXH
    LD E, IXL
    ADD HL, DE
    POP DE
    PUSH HL
    POP IX
    POP DE
    POP HL
    EX AF, AF'
    LD A, (_spill_intern_r187)
    LD IYL, A
    EX AF, AF'
    LD IYH, 0
    PUSH HL
    PUSH DE
    PUSH IX
    POP HL
    PUSH DE
    LD D, IYH
    LD E, IYL
    ADD HL, DE
    POP DE
    PUSH HL
    POP IX
    POP DE
    POP HL
    ; genCall: peek dst=203
    PUSH HL
    PUSH AF
    LD A, (_spill_intern_r181)
    LD L, A
    POP AF
    EX (SP), HL
    PUSH HL
    PUSH AF
    LD A, (_spill_intern_r187)
    LD L, A
    POP AF
    EX (SP), HL
    PUSH BC
    PUSH DE
    PUSH HL
    PUSH IX
    POP HL
    CALL peek
    POP HL
    POP DE
    POP BC
    EX (SP), HL
    PUSH AF
    LD A, L
    LD (_spill_intern_r187), A
    POP AF
    POP HL
    EX (SP), HL
    PUSH AF
    LD A, L
    LD (_spill_intern_r181), A
    POP AF
    POP HL
    ; genCall: poke dst=0
    PUSH HL
    PUSH AF
    LD A, (_spill_intern_r181)
    LD L, A
    POP AF
    EX (SP), HL
    PUSH HL
    PUSH AF
    LD A, (_spill_intern_r187)
    LD L, A
    POP AF
    EX (SP), HL
    PUSH DE
    PUSH HL
    LD H, B
    LD L, C
    LD C, A
    CALL poke
    POP HL
    POP DE
    EX (SP), HL
    PUSH AF
    LD A, L
    LD (_spill_intern_r187), A
    POP AF
    POP HL
    EX (SP), HL
    PUSH AF
    LD A, L
    LD (_spill_intern_r181), A
    POP AF
    POP HL
    LD C, 1
    LD A, (_spill_intern_r187)
    ADD A, 1
    LD (_spill_intern_r187), A
    JRS .intern_loop_head8
.intern_loop_exit10:
    LD HL, (str_bump)    ; u16 direct load (20T, no A clobber)
    INC HL
    EX AF, AF'
    LD A, (_spill_intern_r206)
    LD C, A
    EX AF, AF'
    LD B, 0
    ADD HL, BC
    LD BC, str_bump
    LD (str_bump), HL    ; u16 direct store (16T, no A clobber)
    LD H, D
    LD L, E
    RET
.intern_trmp0:
    EX AF, AF'
    LD A, IXL
    LD (_spill_intern_r181), A
    EX AF, AF'
    LD H, D
    LD L, E
    JRS .intern_loop_exit3
.intern_trmp1:
    EX AF, AF'
    LD A, (_spill_intern_r181)
    LD (_spill_intern_r206), A
    EX AF, AF'
    JRS .intern_loop_exit10
; — spill slots for intern (2 spills)
_spill_intern_r181: DB 0
_spill_intern_r187: DB 0
; — extra spill slots for intern (1 rescued)
_spill_intern_r206: DB 0

; fun is_digit(c: u8 = A) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
is_digit:
    CP 48
    JRS C, .is_digit_if_join2
.is_digit_if_then1:
    CP 57
    JRS C, .is_digit_if_then3
    JRS Z, .is_digit_if_then3
    JRS .is_digit_if_join4
.is_digit_if_then3:
    LD A, 1
    RET
.is_digit_if_join4:
.is_digit_if_join2:
    LD A, 0
    RET

