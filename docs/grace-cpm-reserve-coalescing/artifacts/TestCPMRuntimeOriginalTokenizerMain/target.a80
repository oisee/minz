; fun region_eq(src_start: u16 = HL, arena_ptr: u16 = DE, len: u8 = B) -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
