    LD HL, TOK_EOF
    LD D, (HL)
    CP D
    JRS Z, .tokenize_all_loop_exit3
.tokenize_all_loop_body2:
    ; genCall: scan dst=880
    CALL scan
    JRS .tokenize_all_loop_head1
.tokenize_all_loop_exit3:
    LD HL, (tok_count)    ; u16 direct load (20T, no A clobber)
    RET

