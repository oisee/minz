; fun peek_char() -> u8 = A ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[dse=1]
peek_char:
    LD DE, (pos)    ; u16 direct load, no scratch clobber
    LD HL, (src_len)    ; u16 direct load (20T, no A clobber)
    EX DE, HL
    OR A
    SBC HL, DE
    EX DE, HL
    JRS C, .peek_char_if_join2
