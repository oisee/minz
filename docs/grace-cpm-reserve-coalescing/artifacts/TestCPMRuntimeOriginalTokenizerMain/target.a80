; BDOS2 console: preserve primary registers and flags across the operating system.
__cpm_putchar:
    PUSH AF
    PUSH BC
    PUSH DE
    PUSH HL
    PUSH IX
    PUSH IY
    LD E, A
    LD C, 2
    CALL 5
    POP IY
    POP IX
    POP HL
    POP DE
    POP BC
    POP AF
    RET
__cpm_saved_sp:
    DW 0
__cpm_stack_guard:
    DB 0xA5
__cpm_stack:
    DS 256
__cpm_stack_top:
__cpm_image_end:
