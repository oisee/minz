global data:[u8;5]=[1,2,3,4,5]
global output:u8
fun small_sum(ptr:^u8,n:u8)->u8 {
 var s:u8=0
 var i:u8=0
 while i<n {s=s+ptr[i]
 i=i+1}
 return s
}
fun big_sum(ptr:^u8,n:u8)->u8 {
 var s:u8=0
 var i:u8=0
 while i<n {s=s+ptr[i]
 i=i+1}
 return s
}
fun run()->u8 {
 var first:u8=small_sum(&data,1)
 var second:u8=big_sum(&data,5)
 output=first+second
 return output
}