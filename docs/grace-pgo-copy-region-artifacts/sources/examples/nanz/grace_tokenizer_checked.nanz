// Typed executable port of self_tokenizer.nanz scanner and Pascal interning.
// Arena pointers are caller resources; stored string pointers are u16 offsets.
// Source requires a zero sentinel for unchecked operator lookahead. No extern I/O.
global str_bump:u16=0
global tok_count:u16=0
global src_len:u16=0
global pos:u16=0
global tok_start:u16=0
global keywords_ready:u8=0
global token_checksum:u16=0
// ── Keyword pointers (set during init) ──────────────────
global KW_FUN: u16 = 0
global KW_FN: u16 = 0
global KW_RETURN: u16 = 0
global KW_IF: u16 = 0
global KW_ELSE: u16 = 0
global KW_WHILE: u16 = 0
global KW_LET: u16 = 0
global KW_VAR: u16 = 0
global KW_GLOBAL: u16 = 0
global KW_STRUCT: u16 = 0
global KW_ENUM: u16 = 0
global KW_IMPORT: u16 = 0
global KW_TRUE: u16 = 0
global KW_FALSE: u16 = 0
global KW_ASSERT: u16 = 0
global KW_RETURN_S: u16 = 0

// ── Token types ─────────────────────────────────────────
global TOK_EOF: u8 = 0
global TOK_IDENT: u8 = 1
global TOK_INT: u8 = 2
global TOK_LPAREN: u8 = 3
global TOK_RPAREN: u8 = 4
global TOK_LBRACE: u8 = 5
global TOK_RBRACE: u8 = 6
global TOK_COLON: u8 = 7
global TOK_COMMA: u8 = 8
global TOK_ARROW: u8 = 9
global TOK_EQ: u8 = 10
global TOK_EQEQ: u8 = 11
global TOK_PLUS: u8 = 12
global TOK_MINUS: u8 = 13
global TOK_STAR: u8 = 14
global TOK_SLASH: u8 = 15
global TOK_LT: u8 = 16
global TOK_GT: u8 = 17
global TOK_LTEQ: u8 = 18
global TOK_GTEQ: u8 = 19
global TOK_BANGEQ: u8 = 20
global TOK_STRING: u8 = 21
global TOK_KW: u8 = 30

// ═══════════════════════════════════════════════════════
// String Arena — interned Pascal-style strings
// Layout: [len: u8] [char0] [char1] ... [charN-1]
// ═══════════════════════════════════════════════════════

// Allocate string from literal bytes (for keyword init)
fun str_alloc_2(arena:^u8,a: u8, b: u8) -> u16 {
    let p: u16 = str_bump
    arena[p] = u8(2)
    arena[p + 1] = u8(a)
    arena[p + 2] = u8(b)
    str_bump = str_bump + 3
    return p
}

fun str_alloc_3(arena:^u8,a: u8, b: u8, c: u8) -> u16 {
    let p: u16 = str_bump
    arena[p] = u8(3)
    arena[p + 1] = u8(a)
    arena[p + 2] = u8(b)
    arena[p + 3] = u8(c)
    str_bump = str_bump + 4
    return p
}

fun str_alloc_4(arena:^u8,a: u8, b: u8, c: u8, d: u8) -> u16 {
    let p: u16 = str_bump
    arena[p] = u8(4)
    arena[p + 1] = u8(a)
    arena[p + 2] = u8(b)
    arena[p + 3] = u8(c)
    arena[p + 4] = u8(d)
    str_bump = str_bump + 5
    return p
}

fun str_alloc_5(arena:^u8,a: u8, b: u8, c: u8, d: u8, e: u8) -> u16 {
    let p: u16 = str_bump
    arena[p] = u8(5)
    arena[p + 1] = u8(a)
    arena[p + 2] = u8(b)
    arena[p + 3] = u8(c)
    arena[p + 4] = u8(d)
    arena[p + 5] = u8(e)
    str_bump = str_bump + 6
    return p
}

fun str_alloc_6(arena:^u8,a: u8, b: u8, c: u8, d: u8, e: u8, f: u8) -> u16 {
    let p: u16 = str_bump
    arena[p] = u8(6)
    arena[p + 1] = u8(a)
    arena[p + 2] = u8(b)
    arena[p + 3] = u8(c)
    arena[p + 4] = u8(d)
    arena[p + 5] = u8(e)
    arena[p + 6] = u8(f)
    str_bump = str_bump + 7
    return p
}

// String length
fun str_len(arena:^u8,s: u16) -> u8 {
    return arena[s]
}

// String equality — compare length + bytes
fun str_eq(arena:^u8,a: u16, b: u16) -> u8 {
    if a == b { return 1 }  // pointer equality!
    let la: u8 = arena[a]
    if la != arena[b] { return 0 }
    var i: u8 = 0
    while i < la {
        if arena[a + 1 + i] != arena[b + 1 + i] { return 0 }
        i = i + 1
    }
    return 1
}

// Compare source region with arena string
fun region_eq(src:^u8,arena:^u8,src_start: u16, arena_ptr: u16, len: u8) -> u8 {
    var i: u8 = 0
    while i < len {
        if src[src_start + i] != arena[arena_ptr + 1 + i] {
            return 0
        }
        i = i + 1
    }
    return 1
}

// Intern: find existing or allocate new from source buffer
fun intern(src:^u8,arena:^u8,start: u16, len: u8) -> u16 {
    // Search all existing strings
    var p: u16 = 0
    while p < str_bump {
        let slen: u8 = arena[p]
        if slen == len {
            if region_eq(src,arena,start, p, len) == 1 {
                return p
            }
        }
        p = p + 1 + slen
    }
    // Not found — allocate new
    let new_p: u16 = str_bump
    arena[str_bump] = u8(len)
    let copied:u8 = copy_forward(arena + str_bump + 1,src + start,len)
    str_bump = str_bump + 1 + len
    return new_p
}

// ═══════════════════════════════════════════════════════
// Character classification
// ═══════════════════════════════════════════════════════

fun is_digit(c: u8) -> u8 {
    if c >= 48 {
        if c <= 57 { return 1 }
    }
    return 0
}

fun is_alpha(c: u8) -> u8 {
    if c >= 65 { if c <= 90 { return 1 } }
    if c >= 97 { if c <= 122 { return 1 } }
    if c == 95 { return 1 }
    return 0
}

fun is_alnum(c: u8) -> u8 {
    if is_digit(c) == 1 { return 1 }
    return is_alpha(c)
}

fun is_space(c: u8) -> u8 {
    if c == 32 { return 1 }
    if c == 9 { return 1 }
    if c == 10 { return 1 }
    if c == 13 { return 1 }
    return 0
}

// ═══════════════════════════════════════════════════════
// Tokenizer
// ═══════════════════════════════════════════════════════

fun peek_char(src:^u8) -> u8 {
    if pos >= src_len { return 0 }
    return src[pos]
}

fun skip_ws(src:^u8) -> void {
    while is_space(peek_char(src)) == 1 { pos = pos + 1 }
}

fun skip_comment(src:^u8) -> void {
    while peek_char(src) != 10 {
        if peek_char(src) == 0 { return }
        pos = pos + 1
    }
    pos = pos + 1
}

// Emit token to arena
fun emit(tokens:^u8,typ: u8, str_ptr: u16) -> void {
    let addr: u16 = tok_count * 4
    tokens[addr] = u8(typ)
    tokens[addr + 1] = u8(str_ptr % 256)
    tokens[addr + 2] = u8(str_ptr / 256)
    tokens[addr + 3] = u8(0)
    tok_count = tok_count + 1
}

// Classify keyword by pointer equality
fun classify(str_ptr: u16) -> u8 {
    if str_ptr == KW_FUN { return TOK_KW }
    if str_ptr == KW_FN { return TOK_KW }
    if str_ptr == KW_RETURN { return TOK_KW }
    if str_ptr == KW_IF { return TOK_KW }
    if str_ptr == KW_ELSE { return TOK_KW }
    if str_ptr == KW_WHILE { return TOK_KW }
    if str_ptr == KW_LET { return TOK_KW }
    if str_ptr == KW_VAR { return TOK_KW }
    if str_ptr == KW_TRUE { return TOK_KW }
    if str_ptr == KW_FALSE { return TOK_KW }
    return TOK_IDENT
}

// Scan one token
fun scan(src:^u8,arena:^u8,tokens:^u8) -> u8 {
    skip_ws(src)
    tok_start = pos
    let c: u8 = peek_char(src)

    if c == 0 { return TOK_EOF }

    // Comment
    if c == 47 {
        if src[pos + 1] == 47 {
            skip_comment(src)
            return scan(src,arena,tokens)
        }
        pos = pos + 1
        emit(tokens,TOK_SLASH, 0)
        return TOK_SLASH
    }

    // Two-char ops
    if c == 45 {
        if src[pos + 1] == 62 {
            pos = pos + 2
            emit(tokens,TOK_ARROW, 0)
            return TOK_ARROW
        }
        pos = pos + 1
        emit(tokens,TOK_MINUS, 0)
        return TOK_MINUS
    }
    if c == 61 {
        if src[pos + 1] == 61 {
            pos = pos + 2
            emit(tokens,TOK_EQEQ, 0)
            return TOK_EQEQ
        }
        pos = pos + 1
        emit(tokens,TOK_EQ, 0)
        return TOK_EQ
    }
    if c == 60 {
        if src[pos + 1] == 61 {
            pos = pos + 2
            emit(tokens,TOK_LTEQ, 0)
            return TOK_LTEQ
        }
        pos = pos + 1
        emit(tokens,TOK_LT, 0)
        return TOK_LT
    }
    if c == 62 {
        if src[pos + 1] == 61 {
            pos = pos + 2
            emit(tokens,TOK_GTEQ, 0)
            return TOK_GTEQ
        }
        pos = pos + 1
        emit(tokens,TOK_GT, 0)
        return TOK_GT
    }
    if c == 33 {
        if src[pos + 1] == 61 {
            pos = pos + 2
            emit(tokens,TOK_BANGEQ, 0)
            return TOK_BANGEQ
        }
        pos = pos + 1
        return scan(src,arena,tokens)
    }

    // Single-char
    if c == 40 { pos = pos + 1
        emit(tokens,TOK_LPAREN, 0)
        return TOK_LPAREN }
    if c == 41 { pos = pos + 1
        emit(tokens,TOK_RPAREN, 0)
        return TOK_RPAREN }
    if c == 123 { pos = pos + 1
        emit(tokens,TOK_LBRACE, 0)
        return TOK_LBRACE }
    if c == 125 { pos = pos + 1
        emit(tokens,TOK_RBRACE, 0)
        return TOK_RBRACE }
    if c == 58 { pos = pos + 1
        emit(tokens,TOK_COLON, 0)
        return TOK_COLON }
    if c == 44 { pos = pos + 1
        emit(tokens,TOK_COMMA, 0)
        return TOK_COMMA }
    if c == 43 { pos = pos + 1
        emit(tokens,TOK_PLUS, 0)
        return TOK_PLUS }
    if c == 42 { pos = pos + 1
        emit(tokens,TOK_STAR, 0)
        return TOK_STAR }

    // Number
    if is_digit(c) == 1 {
        while is_digit(peek_char(src)) == 1 { pos = pos + 1 }
        let len: u8 = u8(pos - tok_start)
        let s: u16 = intern(src,arena,tok_start, len)
        emit(tokens,TOK_INT, s)
        return TOK_INT
    }

    // Identifier / keyword
    if is_alpha(c) == 1 {
        while is_alnum(peek_char(src)) == 1 { pos = pos + 1 }
        let len: u8 = u8(pos - tok_start)
        let s: u16 = intern(src,arena,tok_start, len)
        let kw: u8 = classify(s)
        emit(tokens,kw, s)
        return kw
    }

    // String
    if c == 34 {
        pos = pos + 1
        let str_start: u16 = pos
        while peek_char(src) != 34 {
            if peek_char(src) == 0 { return TOK_EOF }
            pos = pos + 1
        }
        let slen: u8 = u8(pos - str_start)
        let s: u16 = intern(src,arena,str_start, slen)
        pos = pos + 1
        emit(tokens,TOK_STRING, s)
        return TOK_STRING
    }

    // Unknown
    pos = pos + 1
    return scan(src,arena,tokens)
}

// ═══════════════════════════════════════════════════════
// Init keywords + run
// ═══════════════════════════════════════════════════════

fun init_keywords(arena:^u8) -> void {
    // Pre-intern all keywords — these get the first arena slots
    KW_FN     = str_alloc_2(arena,102, 110)                         // fn
    KW_IF     = str_alloc_2(arena,105, 102)                         // if
    KW_FUN    = str_alloc_3(arena,102, 117, 110)                    // fun
    KW_LET    = str_alloc_3(arena,108, 101, 116)                    // let
    KW_VAR    = str_alloc_3(arena,118, 97, 114)                     // var
    KW_ELSE   = str_alloc_4(arena,101, 108, 115, 101)               // else
    KW_ENUM   = str_alloc_4(arena,101, 110, 117, 109)               // enum
    KW_TRUE   = str_alloc_4(arena,116, 114, 117, 101)               // true
    KW_WHILE  = str_alloc_5(arena,119, 104, 105, 108, 101)          // while
    KW_FALSE  = str_alloc_5(arena,102, 97, 108, 115, 101)           // false
    KW_RETURN = str_alloc_6(arena,114, 101, 116, 117, 114, 110)     // return
    KW_GLOBAL = str_alloc_6(arena,103, 108, 111, 98, 97, 108)       // global
    KW_STRUCT = str_alloc_6(arena,115, 116, 114, 117, 99, 116)      // struct
    KW_IMPORT = str_alloc_6(arena,105, 109, 112, 111, 114, 116)     // import
    KW_ASSERT = str_alloc_6(arena,97, 115, 115, 101, 114, 116)      // assert
}

fun tokenize_all(src:^u8,arena:^u8,tokens:^u8) -> u16 {
    pos = 0
    tok_count = 0
    var tok: u8 = scan(src,arena,tokens)
    while tok != TOK_EOF {
        tok = scan(src,arena,tokens)
    }
    return tok_count
}


fun copy_forward(dst:^u8,src:^u8,n:u8)->u8 {
 var i:u8=0
 while i<n {dst[i]=src[i]
 i=i+1}
 return i
}
// Checksum of the actual four-byte token records, including intern offsets.
fun checksum_records(tokens:^u8,bytes:u16)->u16 {
 var total:u16=0
 var i:u16=0
 while i<bytes {total=total+u16(tokens[i])
 i=i+1}
 return total
}
fun tokenizer_checked(src:^u8,arena:^u8,tokens:^u8,length:u16)->u16 {
 src_len=length
 if keywords_ready==0 {init_keywords(arena)
 keywords_ready=1}
 let count:u16=tokenize_all(src,arena,tokens)
 token_checksum=checksum_records(tokens,count*4)
 return count
}
