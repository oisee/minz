{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MinZ",
  "scopeName": "source.minz",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#asm-block"
    },
    {
      "include": "#lambda"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#metafunctions"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#iterator-methods"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.minz",
          "match": "//.*$"
        },
        {
          "name": "comment.block.minz",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.minz",
          "match": "\\b(if|else|while|for|in|loop|at|break|continue|return|case|defer|do|times|match)\\b"
        },
        {
          "name": "keyword.declaration.minz",
          "match": "\\b(fun|fn|let|const|type|struct|enum|import|export|pub|global|gen|yield)\\b"
        },
        {
          "name": "storage.modifier.mutability.minz",
          "match": "\\b(mut)\\b"
        },
        {
          "name": "keyword.operator.cast.minz",
          "match": "\\b(as)\\b"
        },
        {
          "name": "keyword.other.minz",
          "match": "\\b(asm|sizeof|alignof)\\b"
        },
        {
          "name": "storage.modifier.visibility.minz",
          "match": "\\b(pub|priv)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.minz",
          "match": "\\b(u8|u16|u24|i8|i16|i24|bool|void|Error|f8\\.8|f\\.8|f\\.16|f16\\.8|f8\\.16)\\b"
        },
        {
          "name": "entity.name.type.minz",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.bracket.minz",
          "begin": "@\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.begin.minz"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.end.minz"
            }
          },
          "patterns": [
            {
              "name": "entity.name.function.attribute.minz",
              "match": "\\b(smc|extern|inline|abi|mode|target|tailrec|cold|hot)\\b"
            },
            {
              "include": "#literals"
            }
          ]
        },
        {
          "name": "meta.attribute.lua.minz",
          "begin": "@lua\\[\\[\\[",
          "end": "\\]\\]\\]",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.metafunction.minz"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.control.metafunction.minz"
            }
          },
          "contentName": "source.lua.embedded.minz"
        },
        {
          "name": "meta.attribute.minz-meta.minz",
          "begin": "@minz\\[\\[\\[",
          "end": "\\]\\]\\]",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.metafunction.minz"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.control.metafunction.minz"
            }
          },
          "contentName": "source.minz.embedded"
        }
      ]
    },
    "metafunctions": {
      "patterns": [
        {
          "name": "keyword.control.metafunction.minz",
          "match": "@(define|print|if|elif|else|error|emit|include|target|abi|extern|mode)\\b"
        },
        {
          "name": "meta.metafunction.call.minz",
          "match": "@([a-zA-Z_][a-zA-Z0-9_]*)(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.metafunction.minz"
            }
          }
        }
      ]
    },
    "asm-block": {
      "patterns": [
        {
          "name": "meta.asm-block.minz",
          "begin": "\\basm\\s*\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.asm.minz"
            }
          },
          "endCaptures": {
            "0": {
              "name": "keyword.other.asm.minz"
            }
          },
          "contentName": "source.z80asm.embedded.minz",
          "patterns": [
            {
              "name": "comment.line.semicolon.asm.minz",
              "match": ";.*$"
            },
            {
              "name": "keyword.mnemonic.z80.minz",
              "match": "\\b(LD|ADD|ADC|SUB|SBC|AND|OR|XOR|CP|INC|DEC|PUSH|POP|JP|JR|CALL|RET|RST|DJNZ|NOP|HALT|DI|EI|EX|EXX|IM|RLC|RRC|RL|RR|SLA|SRA|SRL|BIT|SET|RES|IN|OUT|LDIR|LDDR|CPIR|CPDR|OTIR|OTDR|NEG|RETI|RETN|RLD|RRD|CCF|SCF|DAA|CPL|ld|add|adc|sub|sbc|and|or|xor|cp|inc|dec|push|pop|jp|jr|call|ret|rst|djnz|nop|halt|di|ei|ex|exx|im|rlc|rrc|rl|rr|sla|sra|srl|bit|set|res|in|out|ldir|lddr|cpir|cpdr|otir|otdr|neg|reti|retn|rld|rrd|ccf|scf|daa|cpl)\\b"
            },
            {
              "name": "variable.language.register.z80.minz",
              "match": "\\b(A|B|C|D|E|H|L|AF|BC|DE|HL|SP|IX|IY|I|R|AF'|a|b|c|d|e|h|l|af|bc|de|hl|sp|ix|iy|i|r)\\b"
            },
            {
              "name": "keyword.control.flag.z80.minz",
              "match": "\\b(NZ|Z|NC|C|PO|PE|P|M|nz|z|nc|c|po|pe|p|m)\\b"
            },
            {
              "name": "constant.numeric.hexadecimal.asm.minz",
              "match": "\\$[0-9a-fA-F]+"
            },
            {
              "name": "constant.numeric.decimal.asm.minz",
              "match": "\\b[0-9]+\\b"
            },
            {
              "name": "string.quoted.single.asm.minz",
              "match": "'[^']*'"
            },
            {
              "name": "string.quoted.double.asm.minz",
              "match": "\"[^\"]*\""
            }
          ]
        }
      ]
    },
    "lambda": {
      "patterns": [
        {
          "name": "meta.lambda.minz",
          "begin": "(\\|)(?=[^|]*\\|\\s*(?:=>|\\{))",
          "end": "(\\|)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.begin.lambda.minz"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.parameters.end.lambda.minz"
            }
          },
          "patterns": [
            {
              "name": "variable.parameter.lambda.minz",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            },
            {
              "include": "#types"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.minz",
          "begin": "\\b(fun|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.function.minz"
            },
            "2": {
              "name": "entity.name.function.minz"
            }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#function-parameters"
            }
          ]
        },
        {
          "name": "meta.function.declaration.asm.minz",
          "match": "\\b(asm)\\s+(fun|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.asm.minz"
            },
            "2": {
              "name": "keyword.declaration.function.minz"
            },
            "3": {
              "name": "entity.name.function.minz"
            }
          }
        },
        {
          "name": "support.function.builtin.minz",
          "match": "\\b(print|len|memcpy|memset)\\s*(?=\\()"
        },
        {
          "name": "meta.function.call.minz",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.call.minz"
            }
          }
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        {
          "name": "variable.parameter.minz",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "include": "#types"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "iterator-methods": {
      "patterns": [
        {
          "name": "support.function.iterator.minz",
          "match": "\\.(iter|map|filter|forEach|take|skip|reduce|enumerate|collect|peek|inspect|flatMap|zip|chain)\\s*(?=\\()"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.hexadecimal.minz",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.minz",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.decimal.minz",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "string.quoted.double.minz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.interpolation.minz",
              "begin": "#\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.minz"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.minz"
                }
              },
              "contentName": "source.minz.embedded",
              "patterns": [
                {
                  "include": "source.minz"
                }
              ]
            },
            {
              "name": "constant.character.escape.minz",
              "match": "\\\\(n|r|t|0|\\\\|\"|'|x[0-9a-fA-F]{2})"
            }
          ]
        },
        {
          "name": "string.quoted.single.minz",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.minz",
              "match": "\\\\(n|r|t|0|\\\\|\"|'|x[0-9a-fA-F]{2})"
            }
          ]
        },
        {
          "name": "constant.language.boolean.minz",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.minz",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.scope.minz",
          "match": "::"
        },
        {
          "name": "keyword.operator.assignment.minz",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.minz",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.minz",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.bitwise.minz",
          "match": "(<<|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.logical.minz",
          "match": "\\b(and|or|not)\\b|!"
        },
        {
          "name": "keyword.operator.arrow.minz",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.address-of.minz",
          "match": "&(?=[a-zA-Z_])"
        },
        {
          "name": "keyword.operator.other.minz",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.minz",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.minz",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.minz",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.comma.minz",
          "match": ","
        },
        {
          "name": "punctuation.terminator.semicolon.minz",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.minz",
          "match": ":"
        },
        {
          "name": "punctuation.separator.dot.minz",
          "match": "\\."
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.minz",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
