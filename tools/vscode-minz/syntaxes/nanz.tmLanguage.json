{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nanz",
  "scopeName": "source.nanz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#attributes" },
    { "include": "#functions" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nanz",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nanz",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nanz",
          "match": "\\b(if|else|while|for|in|switch|case|default|break|continue|return)\\b"
        },
        {
          "name": "keyword.declaration.nanz",
          "match": "\\b(fun|fn|var|let|struct|global|interface|enum|const|import|pipe|trans|asm)\\b"
        },
        {
          "name": "keyword.other.assert.nanz",
          "match": "\\bassert\\b"
        },
        {
          "name": "keyword.other.nanz",
          "match": "\\b(at)\\b"
        },
        {
          "name": "constant.language.nanz",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.nanz",
          "match": "\\b(u8|u16|u24|u32|i8|i16|i24|i32|bool|void|bcd8|bcd16|bcd24|bcd32|ptr)\\b"
        },
        {
          "comment": "Ranged type annotation: u8<lo..hi>",
          "name": "storage.type.ranged.nanz",
          "match": "\\b(u8|u16|i8|i16)\\s*<\\s*-?\\d+\\s*\\.\\.\\s*-?\\d+\\s*>"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "keyword.control.error.nanz",
          "match": "@(error|check|propagate)\\b"
        },
        {
          "name": "support.function.builtin.nanz",
          "match": "@(print|print_u8|print_u16|print_str|emit|define|if|elif|else|target|embed)\\b"
        },
        {
          "name": "entity.other.attribute-name.nanz",
          "match": "@\\w+"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "comment": "Method declaration: fun Type.method( — must come before plain function",
          "match": "\\b(fun|fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.declaration.nanz" },
            "2": { "name": "entity.name.type.nanz" },
            "3": { "name": "entity.name.function.nanz" }
          }
        },
        {
          "comment": "Operator overload declaration: fun +(  fun -( etc.",
          "match": "\\b(fun|fn)\\s+([+\\-*/<>=!&|^]+)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.declaration.nanz" },
            "2": { "name": "entity.name.function.operator.nanz keyword.operator.nanz" }
          }
        },
        {
          "comment": "Fallible function declaration: fun name?(",
          "match": "\\b(fun|fn)\\s+([A-Za-z_][A-Za-z0-9_]*\\?)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.declaration.nanz" },
            "2": { "name": "entity.name.function.fallible.nanz" }
          }
        },
        {
          "comment": "Function declaration: fun name(",
          "match": "\\b(fun|fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.declaration.nanz" },
            "2": { "name": "entity.name.function.nanz" }
          }
        },
        {
          "comment": "Function call: name(",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.nanz" }
          }
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "string.quoted.double.nanz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.nanz", "match": "\\\\." }
          ]
        },
        {
          "name": "constant.numeric.hex.nanz",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.nanz",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.integer.nanz",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.nanz",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.bitwise.nanz",
          "match": "&|\\||\\^|~|<<|>>"
        },
        {
          "name": "keyword.operator.comparison.nanz",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.nanz",
          "match": "="
        },
        {
          "name": "keyword.operator.pointer.nanz",
          "match": "\\^"
        },
        {
          "name": "keyword.operator.arrow.nanz",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.nanz",
          "match": "\\.\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.nanz", "match": "," },
        { "name": "punctuation.terminator.nanz", "match": ";" },
        { "name": "punctuation.accessor.nanz", "match": "\\." },
        { "name": "punctuation.definition.block.nanz", "match": "[{}]" },
        { "name": "punctuation.definition.bracket.nanz", "match": "[\\[\\]]" },
        { "name": "punctuation.definition.paren.nanz", "match": "[()]" },
        { "name": "punctuation.separator.colon.nanz", "match": ":" }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.nanz",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
