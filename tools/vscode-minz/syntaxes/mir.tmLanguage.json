{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MIR",
  "scopeName": "source.mir",
  "patterns": [
    { "include": "#comments" },
    { "include": "#function-declaration" },
    { "include": "#section-headers" },
    { "include": "#labels" },
    { "include": "#instructions" },
    { "include": "#registers" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.mir",
          "match": ";.*$"
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "match": "^\\s*(Function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.declaration.function.mir" },
            "2": { "name": "entity.name.function.mir" },
            "3": { "name": "punctuation.paren.open.mir" }
          }
        },
        {
          "match": "->\\s*(void|u8|u16|i8|i16|bool)",
          "captures": {
            "1": { "name": "storage.type.mir" }
          }
        }
      ]
    },
    "section-headers": {
      "patterns": [
        {
          "name": "keyword.control.section.mir",
          "match": "^\\s*(Instructions|Locals|Parameters):"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^\\s*\\d+:\\s+([a-zA-Z_][a-zA-Z0-9_]*):",
          "captures": {
            "1": { "name": "entity.name.label.mir" }
          }
        },
        {
          "match": "\\b(jump|jump_if|jump_if_not)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.flow.mir" },
            "2": { "name": "entity.name.label.mir" }
          }
        },
        {
          "match": "\\b(jump_if_not)\\s+(r\\d+)\\s*,\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.flow.mir" },
            "2": { "name": "variable.other.register.mir" },
            "3": { "name": "entity.name.label.mir" }
          }
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "keyword.control.flow.mir",
          "match": "\\b(jump|jump_if|jump_if_not|return|call)\\b"
        },
        {
          "name": "keyword.operator.builtin.mir",
          "match": "\\b(PRINT|HALT|NOP|DJNZ)\\b"
        },
        {
          "name": "keyword.other.instruction.mir",
          "match": "\\b(store|load)\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.other.register.mir",
          "match": "\\br\\d+\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.mir",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.mir",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.hex.mir",
          "match": "\\$[0-9a-fA-F]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.mir",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.mir",
          "match": "(?<=\\s)(\\+|\\-|\\*|/|%|&|\\||\\^)(?=\\s)"
        },
        {
          "name": "keyword.operator.assignment.mir",
          "match": "(?<![=!<>])=(?![=])"
        }
      ]
    }
  }
}
