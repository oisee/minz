{
  "name": "minz-language-support",
  "displayName": "MinZ Multi-Frontend Language Support",
  "description": "Language support for MinZ, Nanz, Frill, C23 — targeting Z80, CUDA, OpenCL, Vulkan, Metal",
  "version": "0.9.0",
  "publisher": "minz-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/oisee/minz.git",
    "directory": "tools/vscode-minz"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "minz",
    "nanz",
    "lanz",
    "lizp",
    "z80",
    "assembly",
    "systems programming",
    "zx spectrum",
    "retro",
    "plm80",
    "pascal",
    "c89",
    "objc",
    "dezog"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "minz",
        "aliases": [
          "MinZ",
          "minz"
        ],
        "extensions": [
          ".minz",
          ".mz"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/minz-light.svg",
          "dark": "./icons/minz-dark.svg"
        }
      },
      {
        "id": "nanz",
        "aliases": [
          "Nanz",
          "nanz"
        ],
        "extensions": [
          ".nanz"
        ],
        "configuration": "./nanz-language-configuration.json"
      },
      {
        "id": "mir",
        "aliases": [
          "MIR",
          "MinZ IR"
        ],
        "extensions": [
          ".mir"
        ],
        "configuration": "./mir-language-configuration.json"
      },
      {
        "id": "lanz",
        "aliases": [
          "Lanz",
          "lanz"
        ],
        "extensions": [
          ".lanz"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "lizp",
        "aliases": [
          "Lizp",
          "lizp"
        ],
        "extensions": [
          ".lizp"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "plm",
        "aliases": [
          "PL/M-80",
          "plm"
        ],
        "extensions": [
          ".plm"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "minz-pascal",
        "aliases": [
          "MinZ Pascal",
          "pascal"
        ],
        "extensions": [
          ".pas"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "minz-c",
        "aliases": [
          "MinZ C89",
          "c89"
        ],
        "extensions": [
          ".c"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "minz-objc",
        "aliases": [
          "MinZ ObjC",
          "objc"
        ],
        "extensions": [
          ".m"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "minz-abap",
        "aliases": [
          "MinZ ABAP",
          "abap"
        ],
        "extensions": [
          ".abap"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "frill",
        "aliases": [
          "Frill",
          "frill"
        ],
        "extensions": [
          ".frl"
        ],
        "configuration": "./frill-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "minz",
        "scopeName": "source.minz",
        "path": "./syntaxes/minz.tmLanguage.json"
      },
      {
        "language": "nanz",
        "scopeName": "source.nanz",
        "path": "./syntaxes/nanz.tmLanguage.json"
      },
      {
        "language": "mir",
        "scopeName": "source.mir",
        "path": "./syntaxes/mir.tmLanguage.json"
      },
      {
        "language": "frill",
        "scopeName": "source.frill",
        "path": "./syntaxes/frill.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "minz",
        "path": "./snippets/minz-snippets.json"
      },
      {
        "language": "nanz",
        "path": "./snippets/nanz-snippets.json"
      },
      {
        "language": "frill",
        "path": "./snippets/frill-snippets.json"
      }
    ],
    "commands": [
      {
        "command": "minz.compile",
        "title": "MinZ: Compile to Z80 Assembly",
        "icon": "$(play)"
      },
      {
        "command": "minz.compileAndRun",
        "title": "MinZ: Compile & Run",
        "icon": "$(terminal)"
      },
      {
        "command": "minz.compileToIR",
        "title": "MinZ: Compile to IR",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "minz.compileToMIR",
        "title": "MinZ: Compile to MIR",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "minz.compileToASM",
        "title": "MinZ: Compile to Z80 ASM (side-by-side)",
        "icon": "$(file-code)"
      },
      {
        "command": "minz.compileAll",
        "title": "MinZ: Compile All (MIR + ASM)",
        "icon": "$(layers)"
      },
      {
        "command": "minz.compileOptimized",
        "title": "MinZ: Compile Optimized",
        "icon": "$(rocket)"
      },
      {
        "command": "minz.showAST",
        "title": "MinZ: Show AST",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "minz.debugBuild",
        "title": "MinZ: Debug Build (with SLD)",
        "icon": "$(debug-alt)"
      },
      {
        "command": "minz.startDebugging",
        "title": "MinZ: Start Debugging (DeZog)",
        "icon": "$(debug-start)"
      },
      {
        "command": "minz.compileNative",
        "title": "MinZ: Compile to Native (C99 + QBE)",
        "icon": "$(zap)"
      },
      {
        "command": "minz.compileNativeC",
        "title": "MinZ: Compile to Native (C99 only)",
        "icon": "$(file-binary)"
      },
      {
        "command": "minz.compileNativeQBE",
        "title": "MinZ: Compile to Native (QBE only)",
        "icon": "$(file-binary)"
      },
      {
        "command": "minz.emitC",
        "title": "MinZ: Emit C99 Code",
        "icon": "$(code)"
      },
      {
        "command": "minz.emitQBE",
        "title": "MinZ: Emit QBE IL",
        "icon": "$(code)"
      },
      {
        "command": "minz.compileAndRunMZV",
        "title": "MinZ: Compile & Run MZV",
        "icon": "$(vm)"
      },
      {
        "command": "minz.compileCUDA",
        "title": "MinZ: Compile to CUDA",
        "icon": "$(rocket)"
      },
      {
        "command": "minz.compileOpenCL",
        "title": "MinZ: Compile to OpenCL",
        "icon": "$(rocket)"
      },
      {
        "command": "minz.compileVulkan",
        "title": "MinZ: Compile to Vulkan (GLSL)",
        "icon": "$(rocket)"
      },
      {
        "command": "minz.compileMetal",
        "title": "MinZ: Compile to Metal",
        "icon": "$(rocket)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.compile",
          "group": "minz@1"
        },
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.compileAndRun",
          "group": "minz@2"
        },
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.compileToMIR",
          "group": "minz@3"
        },
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.compileToASM",
          "group": "minz@3"
        },
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.compileAll",
          "group": "minz@4"
        },
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.compileOptimized",
          "group": "minz@5"
        },
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.compileAndRunMZV",
          "group": "minz@5b"
        },
        {
          "when": "editorLangId == minz",
          "command": "minz.debugBuild",
          "group": "minz@6"
        },
        {
          "when": "editorLangId == minz",
          "command": "minz.startDebugging",
          "group": "minz@7"
        },
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.compileNative",
          "group": "minz@8"
        },
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.emitC",
          "group": "minz@9"
        },
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.emitQBE",
          "group": "minz@9"
        }
      ],
      "editor/title": [
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.compile",
          "group": "navigation@1"
        },
        {
          "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap",
          "command": "minz.compileOptimized",
          "group": "navigation@2"
        },
        {
          "when": "editorLangId == minz",
          "command": "minz.startDebugging",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "minz.compile",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap"
      },
      {
        "command": "minz.compileAndRun",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap"
      },
      {
        "command": "minz.compileOptimized",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap"
      },
      {
        "command": "minz.compileToMIR",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap"
      },
      {
        "command": "minz.compileToASM",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap"
      },
      {
        "command": "minz.compileAll",
        "key": "ctrl+alt+shift+b",
        "mac": "cmd+alt+shift+b",
        "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap"
      },
      {
        "command": "minz.compileAndRunMZV",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorLangId == minz || editorLangId == nanz || editorLangId == frill || editorLangId == lanz || editorLangId == lizp || editorLangId == plm || editorLangId == minz-pascal || editorLangId == minz-c || editorLangId == minz-objc || editorLangId == minz-abap"
      },
      {
        "command": "minz.showAST",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorLangId == minz"
      },
      {
        "command": "minz.debugBuild",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorLangId == minz"
      },
      {
        "command": "minz.startDebugging",
        "key": "f5",
        "when": "editorLangId == minz && !inDebugMode"
      }
    ],
    "problemMatchers": [
      {
        "name": "minz",
        "owner": "minz",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning|note):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "minz",
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "description": "The MinZ task to run"
          },
          "file": {
            "type": "string",
            "description": "The MinZ source file"
          }
        }
      }
    ],
    "configuration": {
      "title": "MinZ",
      "properties": {
        "minz.compilerPath": {
          "type": "string",
          "default": "mz",
          "description": "Path to the MinZ compiler (mz)"
        },
        "minz.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the MinZ LSP server (mzlsp). Empty = auto-detect."
        },
        "minz.outputDirectory": {
          "type": "string",
          "default": "./build",
          "description": "Directory for compiled output files"
        },
        "minz.enableOptimizations": {
          "type": "boolean",
          "default": true,
          "description": "Enable optimizations by default"
        },
        "minz.target": {
          "type": "string",
          "default": "cpm",
          "enum": ["cpm", "zxspectrum", "msx", "cpc", "amstrad"],
          "description": "Target platform for Compile & Run"
        },
        "minz.enableSMC": {
          "type": "boolean",
          "default": false,
          "description": "Enable self-modifying code optimizations"
        },
        "minz.enableTrueSMC": {
          "type": "boolean",
          "default": false,
          "description": "Enable TRUE SMC (immediate anchors)"
        },
        "minz.showCompilerOutput": {
          "type": "boolean",
          "default": true,
          "description": "Show compiler output in terminal"
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:minz",
    "onLanguage:nanz",
    "onLanguage:lanz",
    "onLanguage:lizp",
    "onLanguage:plm",
    "onLanguage:minz-pascal",
    "onLanguage:minz-c",
    "onLanguage:minz-objc",
    "workspaceContains:**/*.minz",
    "workspaceContains:**/*.mz",
    "workspaceContains:**/*.nanz",
    "workspaceContains:**/*.lanz",
    "workspaceContains:**/*.lizp",
    "workspaceContains:**/*.plm",
    "workspaceContains:**/*.pas",
    "workspaceContains:**/*.m",
    "onLanguage:minz-abap",
    "workspaceContains:**/*.abap",
    "onLanguage:frill",
    "workspaceContains:**/*.frl"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package",
    "build": "node scripts/build.js",
    "test": "echo \"Tests not implemented yet\""
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.x",
    "typescript": "^4.9.4",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "author": "",
  "license": "ISC"
}
