(assert add_byte 250 10 == 4)
(assert sum_to 0 == 0)
(assert sum_to 10 == 55)
(assert sum_to 30 == 209)
(assert abs_diff 12 40 == 28)
(assert abs_diff 40 12 == 28)
(assert abs_diff 12 12 == 0)
(assert add_word 1000 2345 == 3345)
(assert add_word 65535 2 == 1)
(assert negative -1 == 1)
(assert negative 1 == 0)
(assert forward_word 1000 == 1300)
