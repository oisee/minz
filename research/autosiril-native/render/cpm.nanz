// Independently linked CP/M adapter for actual kind5 files.
@extern(0x0005) fun bdos8(@z80_c command:u8,@z80_de address:u16)->u8

global input_fcbs:[u8;108]
global input_buffers:[u8;384]
global input_positions:[u8;3]
global input_live:[u8;3]
global text_fcb:[u8;36]
global state_fcb:[u8;36]
global meta_fcb:[u8;36]
global info_fcb:[u8;36]
global text_buffer:[u8;128]
global state_buffer:[u8;128]
global meta_buffer:[u8;128]
global info_buffer:[u8;128]
global text_position:u8
global state_position:u8
global meta_position:u8
global info_position:u8
global text_live:u8
global state_live:u8
global meta_live:u8
global info_live:u8
global file_dma:[u8;128]
global mixed_name:[u8;11] = [77,73,88,69,68,32,32,32,66,73,78]
global text_name:[u8;11] = [79,85,84,80,85,84,32,32,84,88,84]
global state_name:[u8;11] = [83,84,65,84,69,32,32,32,66,73,78]
global meta_name:[u8;11] = [77,69,84,65,32,32,32,32,66,73,78]
global info_name:[u8;11] = [82,69,78,68,32,32,32,32,73,78,70]
global wire_magic:[u8;4] = [65,83,73,82]
global wire_header:[u8;8] = [1,5,16,0,3,0,0,0]
global meta_magic:[u8;4] = [65,82,77,68]
global meta_header:[u8;10]
global wire_end_magic:[u8;4] = [69,78,68,33]
global record_buffer:[u8;16]
// Definitions are kept as their semantic payload (<=64 ids, <=4096 bytes total);
// canonical 8-byte fragments are rebuilt for META.BIN, so the raw fragment
// count (up to 568) never needs storage of its own.
global definition_payloads:[u8;4096]
global definition_lengths:[u16;64]
global definition_count:u16
global definition_fragments:u16
global metadata_payloads:[u8;64]
global metadata_seen:u8
global validated_cells:u16
global skipped_byte:u8
global validation_skipped:u16
global validated_extents:[u32;3]
global cursor_records:[u32;3]
global cursor_finished:[u8;3]
global cursor_meta:[u8;3]
global cursor_have_cell:[u8;3]
global cursor_last_channel:[u8;3]
global cursor_last_row:[u16;3]
global cursor_defs:[u16;3]
global cursor_fragments:[u16;3]
global cursor_used:[u16;3]
global cursor_def_length:[u16;3]
global cursor_def_offset:[u16;3]
global cursor_def_repeat:[u16;3]
global cursor_def_previous:[u8;3]
global text_logical_bytes:u32
global state_logical_bytes:u32

fun fcb_input_name(handle:u8) {
    var index:u16 = 0
    while index < 36 { input_fcbs[u16(handle)*36+index] = 0
        index = index + 1 }
    index = 0
    while index < 11 { input_fcbs[u16(handle)*36+index+1] = mixed_name[index]
        index = index + 1 }
}
fun cursor_get(handle:u8)->u8 {
    if fault != 0 { return 0 }
    if input_positions[handle] == 128 {
        let status:u8 = bdos8(20,u16(&input_fcbs[u16(handle)*36]))
        if status != 0 { if status == 1 { fault = 951 } else { fault = 904 } return 0 }
        var index:u16 = 0
        let base:u16 = u16(handle)*128
        while index < 128 {
            input_buffers[base+index] = file_dma[index]
            index = index + 1
        }
        input_positions[handle] = 0
    }
    let at:u16 = u16(handle)*128+u16(input_positions[handle])
    input_positions[handle] = input_positions[handle] + 1
    return input_buffers[at]
}
fun cursor_word(handle:u8)->u16 {
    let low:u8 = cursor_get(handle)
    if fault != 0 { return 0 }
    let high:u8 = cursor_get(handle)
    if fault != 0 { return 0 }
    return u16(low) | (u16(high) << 8)
}
fun cursor_u32(handle:u8)->u32 {
    let low:u16 = cursor_word(handle)
    if fault != 0 { return 0 }
    let high:u16 = cursor_word(handle)
    if fault != 0 { return 0 }
    return u32(low) | (u32(high) << 16)
}
fun cursor_payload(handle:u8) {
    var index:u16 = 0
    while index < 16 { record_buffer[index] = cursor_get(handle)
        index = index + 1 }
}
fun cursor_header(handle:u8) {
    var index:u16 = 0
    while index < 4 {
        let byte:u8 = cursor_get(handle)
        if fault != 0 { return }
        if byte != wire_magic[index] { fault = 950 return }
        index = index + 1 }
    index = 0
    while index < 8 {
        let byte:u8 = cursor_get(handle)
        if fault != 0 { return }
        if index == 0 && byte != wire_header[0] { fault = 952 return }
        if index > 0 && byte != wire_header[index] { fault = 953 return }
        index = index + 1
    }
}
fun cursor_finish(handle:u8) {
    while input_positions[handle] < 128 {
        if cursor_get(handle) != 0 { fault = 957 return }
    }
    let status:u8 = bdos8(20,u16(&input_fcbs[u16(handle)*36]))
    if status == 0 { fault = 957 } else { if status != 1 { fault = 904 } }
}
fun cursor_end(handle:u8,count:u32) {
    let low:u16 = cursor_word(handle)
    let high:u16 = cursor_word(handle)
    if low != u16(count) || high != u16(count >> 16) { fault = 956 return }
    var index:u16 = 0
    let magic0:u8 = cursor_get(handle)
    if magic0 != 69 { fault = 960 return }
    if cursor_get(handle) != 78 { fault = 961 return }
    if cursor_get(handle) != 68 { fault = 962 return }
    if cursor_get(handle) != 33 { fault = 963 return }
    cursor_finish(handle)
}
fun cursor_open(handle:u8) {
    if input_live[handle] != 0 { fault = 900 return }
    input_positions[handle] = 128
    if bdos8(15,u16(&input_fcbs[u16(handle)*36])) == 255 { fault = 900 return }
    input_live[handle] = 1
    cursor_header(handle)
    cursor_records[handle] = 0
    cursor_finished[handle] = 0
    cursor_meta[handle] = 0
    cursor_have_cell[handle] = 0
    cursor_last_channel[handle] = 0
    cursor_last_row[handle] = 0
    cursor_defs[handle] = 0
    cursor_fragments[handle] = 0
    cursor_used[handle] = 0
    cursor_def_length[handle] = 0
    cursor_def_offset[handle] = 0
    cursor_def_repeat[handle] = 0
    cursor_def_previous[handle] = 0
}
fun cursor_close(handle:u8) {
    if input_live[handle] == 0 { return }
    input_live[handle] = 0
    if bdos8(16,u16(&input_fcbs[u16(handle)*36])) == 255 && fault == 0 { fault = 906 }
}
fun cursor_validate_payload(handle:u8,selected:u8,phase:u8)->u8 {
    if record_buffer[0] == 0 {
        if phase == 2 && record_buffer[1] == selected && record_buffer[15] == 0 { return 1 }
        return 0
    }
    return 0
}
fun cursor_validate_definition(handle:u8) {
    let id:u16 = u16(record_buffer[1]) | (u16(record_buffer[2]) << 8)
    let length:u16 = u16(record_buffer[3]) | (u16(record_buffer[4]) << 8)
    let offset:u16 = u16(record_buffer[5]) | (u16(record_buffer[6]) << 8)
    let count:u8 = record_buffer[7]
    if id != cursor_defs[handle] || id >= 64 || length == 0 || length > 4096 { fault = 985 return }
    if offset != cursor_def_offset[handle] { fault = 985 return }
    if offset == 0 && cursor_def_length[handle] != 0 { fault = 985 return }
    if offset != 0 && length != cursor_def_length[handle] { fault = 985 return }
    if cursor_used[handle] > 4096-length { fault = 985 return }
    var want:u16 = length-offset
    if want > 8 { want = 8 }
    if count == 0 || u16(count) != want { fault = 985 return }
    if offset == 0 { cursor_def_length[handle] = length }
    var index:u8 = 0
    while index < 8 {
        let byte:u8 = record_buffer[8+u16(index)]
        if index < count {
            if byte > 127 || (id == 0 && byte != 0) { fault = 985 return }
            definition_payloads[cursor_used[handle]+offset+u16(index)] = byte
        } else if byte != 0 { fault = 985 return }
        index = index + 1
    }
    cursor_def_offset[handle] = offset+u16(count)
    if cursor_def_offset[handle] == length {
        definition_lengths[id] = length
        cursor_defs[handle] = id+1
        cursor_used[handle] = cursor_used[handle]+length
        cursor_def_offset[handle] = 0
        cursor_def_length[handle] = 0
    }
}
fun cursor_next(handle:u8,selected:u8)->u8 {
    if fault != 0 { return 2 }
    while fault == 0 {
        if cursor_finished[handle] != 0 { return 0 }
        let tag:u8 = cursor_get(handle)
        if fault != 0 { return 2 }
        if tag == 255 {
            if cursor_meta[handle] != 4 ||
                cursor_fragments[handle] != definition_fragments { fault = 985 return 2 }
            cursor_end(handle,cursor_records[handle])
            if fault == 0 { cursor_finished[handle] = 1 }
            return 0
        }
        if tag != 1 { fault = 955 return 2 }
        cursor_payload(handle)
        if fault != 0 { return 2 }
        cursor_records[handle] = cursor_records[handle] + 1
        if record_buffer[0] == 1 {
            if cursor_fragments[handle] >= definition_fragments { fault = 985 return 2 }
            cursor_fragments[handle] = cursor_fragments[handle]+1
        } else if record_buffer[0] == 0 {
            let channel:u8 = record_buffer[1]
            if cursor_meta[handle] != 0 || channel > 2 ||
                cursor_fragments[handle] != definition_fragments { fault = 958 return 2 }
            let row:u16 = u16(record_buffer[2]) | (u16(record_buffer[3]) << 8)
            let kind:u8 = record_buffer[12]
            if kind == 112 {
                let definition:u16 = u16(record_buffer[7]) | (u16(record_buffer[8]) << 8)
                if definition >= definition_count { fault = 985 return 2 }
            }
            if cursor_have_cell[handle] != 0 && channel < cursor_last_channel[handle] { fault = 970 return 2 }
            if cursor_have_cell[handle] != 0 && channel == cursor_last_channel[handle] && row <= cursor_last_row[handle] { fault = 970 return 2 }
            cursor_have_cell[handle] = 1
            cursor_last_channel[handle] = channel
            cursor_last_row[handle] = row
            if cursor_validate_payload(handle,selected,2) == 1 { return 1 }
        } else if record_buffer[0] >= 2 && record_buffer[0] <= 3 {
            let index:u8 = cursor_meta[handle]
            if index >= 4 { fault = 992 return 2 }
            if index < 3 && (record_buffer[0] != 2 || record_buffer[1] != index) { fault = 993 return 2 }
            if index == 3 && (record_buffer[0] != 3 || record_buffer[1] != 0) { fault = 993 return 2 }
            cursor_meta[handle] = index + 1
        } else { fault = 958 return 2 }
        if fault != 0 { return 2 }
    }
    return 2
}
fun validate_definitions() {
    cursor_open(0)
    while fault == 0 {
        let tag:u8 = cursor_get(0)
        if fault != 0 { return }
        if tag == 255 { fault = 985 return }
        if tag != 1 { fault = 955 return }
        cursor_payload(0)
        if fault != 0 { return }
        if record_buffer[0] != 1 {
            if cursor_def_length[0] != 0 { fault = 985 return }
            definition_count = cursor_defs[0]
            cursor_close(0)
            return
        }
        cursor_validate_definition(0)
        if fault != 0 { return }
        definition_fragments = definition_fragments+1
    }
    if fault != 0 { return }
    cursor_close(0)
}
// Cached fields must equal what the original LNote constructor derives
// (note2enote with cool_envelope): the source is rejected, never normalized.
fun validate_cache() {
    if record_buffer[15] != 0 { fault = 987 return }
    let note:u8 = record_buffer[4]
    let cached:u16 = u16(record_buffer[13]) | (u16(record_buffer[14]) << 8)
    if record_buffer[12] == 101 {
        if note >= 144 { fault = 987 return }
        let volume:u16 = u16(record_buffer[9]) | (u16(record_buffer[10]) << 8)
        var envelope:u8 = 15
        if volume >= 1500 { envelope = env_forms[note] }
        if record_buffer[5] != 2 || record_buffer[6] != envelope { fault = 986 return }
        if cached != u16(i16(note) + env_offsets[note]) { fault = 986 return }
    } else if cached != 65535 { fault = 986 return }
}
fun validate_cells() {
    cursor_open(0)
    validation_skipped = 0
    while validation_skipped < definition_fragments && fault == 0 {
        skipped_byte = cursor_get(0)
        if fault != 0 { return }
        if skipped_byte != 1 { fault = 955 return }
        cursor_payload(0)
        if fault != 0 { return }
        if record_buffer[0] != 1 { fault = 985 return }
        validation_skipped = validation_skipped+1
    }
    var last_channel:u8 = 0
    var have_cell:u8 = 0
    while fault == 0 {
        let tag:u8 = cursor_get(0)
        if fault != 0 { return }
        if tag == 255 { fault = 992 return }
        if tag != 1 { fault = 955 return }
        cursor_payload(0)
        if fault != 0 { return }
        if record_buffer[0] == 2 || record_buffer[0] == 3 { cursor_close(0) return }
        if record_buffer[0] != 0 { fault = 958 return }
        let channel:u8 = record_buffer[1]
        let row:u16 = u16(record_buffer[2]) | (u16(record_buffer[3]) << 8)
        if channel > 2 { fault = 958 return }
        let kind:u8 = record_buffer[12]
        if kind == 112 {
            let definition:u16 = u16(record_buffer[7]) | (u16(record_buffer[8]) << 8)
            if definition >= definition_count { fault = 985 return }
        }
        validate_cache()
        if fault != 0 { return }
        if have_cell != 0 && channel < last_channel { fault = 991 return }
        if have_cell != 0 && channel == last_channel && row <= validated_extents[channel]-1 { fault = 958 return }
        have_cell = 1
        last_channel = channel
        validated_extents[channel] = u32(row)+1
        if validated_cells >= 9216 { fault = 983 return }
        validated_cells = validated_cells+1
    }
}
fun validate_metadata() {
    cursor_open(0)
    validation_skipped = 0
    while validation_skipped < definition_fragments+validated_cells && fault == 0 {
        skipped_byte = cursor_get(0)
        if fault != 0 { return }
        if skipped_byte != 1 { fault = 955 return }
        cursor_payload(0)
        if fault != 0 { return }
        validation_skipped = validation_skipped+1
    }
    var records:u32 = u32(definition_fragments)+u32(validated_cells)
    while fault == 0 {
        let tag:u8 = cursor_get(0)
        if fault != 0 { return }
        if tag == 255 {
            if metadata_seen != 4 { fault = 992 return }
            cursor_end(0,records)
            break
        }
        if tag != 1 { fault = 955 return }
        cursor_payload(0)
        if fault != 0 { return }
        records = records+1
        if record_buffer[0] != 2 && record_buffer[0] != 3 { fault = 958 return }
        let metadata_at:u8 = record_buffer[1]
        if record_buffer[0] == 3 { metadata_at = 3 }
        if metadata_seen >= 4 || metadata_at > 3 || metadata_at != metadata_seen { fault = 993 return }
        if record_buffer[0] == 2 && metadata_at > 2 { fault = 993 return }
        if record_buffer[0] == 3 && record_buffer[1] != 0 { fault = 993 return }
        var reserved:u8 = 6
        while reserved < 16 {
            if record_buffer[reserved] != 0 { fault = 993 return }
            reserved = reserved+1
        }
        var index:u16 = 0
        while index < 16 { metadata_payloads[u16(metadata_at)*16+index] = record_buffer[index]
            index = index+1 }
        metadata_seen = metadata_seen+1
    }
    if fault != 0 { return }
    var channel:u8 = 0
    while channel < 3 {
        let extent:u32 = u32(metadata_payloads[u16(channel)*16+2]) |
            (u32(metadata_payloads[u16(channel)*16+3]) << 8) |
            (u32(metadata_payloads[u16(channel)*16+4]) << 16) |
            (u32(metadata_payloads[u16(channel)*16+5]) << 24)
        if extent != validated_extents[channel] { fault = 994+u16(channel) return }
        channel = channel+1
    }
    render_rows[0] = metadata_payloads[50]
    render_rows[1] = metadata_payloads[51]
    render_rows[2] = metadata_payloads[52]
    render_rows[3] = metadata_payloads[53]
    cursor_close(0)
}
fun read_record(lane:u8,destination:u16)->u8 {
    if destination != u16(&source_record[u16(lane)*16]) { fault = 988 return 2 }
    let status:u8 = cursor_next(lane,lane)
    if status != 1 { return status }
    var index:u16 = 0
    while index < 16 { source_record[u16(lane)*16+index] = record_buffer[index]
        index = index + 1 }
    return 1
}
fun text_flush()->u8 {
    if text_position == 0 { return 0 }
    var index:u16 = 0
    while index < 128 {
        file_dma[index] = text_buffer[index]
        index = index + 1
    }
    return bdos8(21,u16(&text_fcb[0]))
}
fun state_flush()->u8 {
    if state_position == 0 { return 0 }
    var index:u16 = 0
    while index < 128 {
        file_dma[index] = state_buffer[index]
        index = index + 1
    }
    return bdos8(21,u16(&state_fcb[0]))
}
fun text_put(byte:u8) {
    if fault != 0 { return }
    text_buffer[u16(text_position)] = byte
    text_position = text_position+1
    text_logical_bytes = text_logical_bytes+1
    if text_position == 128 {
        if text_flush() != 0 { fault = 902 return }
        text_position = 0
    }
}
fun state_put(byte:u8) {
    if fault != 0 { return }
    state_buffer[u16(state_position)] = byte
    state_position = state_position+1
    state_logical_bytes = state_logical_bytes+1
    if state_position == 128 {
        if state_flush() != 0 { fault = 902 return }
        state_position = 0
    }
}
fun write_packet(sink:u8,source:u16)->u8 {
    if sink == 0 && source != u16(&line_packet[0]) { fault = 988 return 1 }
    if sink == 1 && source != u16(&state_packet[0]) { fault = 988 return 1 }
    var count:u8 = 0
    if sink == 0 { count = line_packet[0] } else { count = state_packet[0] }
    var index:u16 = 0
    while index < u16(count) {
        if sink == 0 { text_put(line_packet[index+1]) }
        index = index + 1
    }
    if sink == 1 {
        state_put(state_packet[0])
        index = 1
        while index <= u16(count) {
            state_put(state_packet[index])
            index = index + 1
        }
    }
    if fault != 0 { return 1 }
    return 0
}
fun meta_put(byte:u8) {
    if fault != 0 { return }
    meta_buffer[u16(meta_position)] = byte
    meta_position = meta_position+1
    if meta_position == 128 {
        var index:u16 = 0
        while index < 128 { file_dma[index] = meta_buffer[index]
            index = index + 1 }
        if bdos8(21,u16(&meta_fcb[0])) != 0 { fault = 902 return }
        meta_position = 0
    }
}
fun info_put(byte:u8) {
    if fault != 0 { return }
    info_buffer[u16(info_position)] = byte
    info_position = info_position+1
    if info_position == 128 {
        var index:u16 = 0
        while index < 128 { file_dma[index] = info_buffer[index]
            index = index + 1 }
        if bdos8(21,u16(&info_fcb[0])) != 0 { fault = 902 return }
        info_position = 0
    }
}
fun info_u32(value:u32) {
    info_put(u8(value))
    info_put(u8(value >> 8))
    info_put(u8(value >> 16))
    info_put(u8(value >> 24))
}
fun prepare_output(which:u8) {
    var index:u16 = 0
    var fcb:u16 = u16(&text_fcb[0])
    if which == 1 { fcb = u16(&state_fcb[0]) }
    if which == 2 { fcb = u16(&meta_fcb[0]) }
    if which == 3 { fcb = u16(&info_fcb[0]) }
    while index < 36 {
        if which == 0 { text_fcb[index] = 0 }
        if which == 1 { state_fcb[index] = 0 }
        if which == 2 { meta_fcb[index] = 0 }
        if which == 3 { info_fcb[index] = 0 }
        index = index + 1
    }
    index = 0
    while index < 11 {
        if which == 0 { text_fcb[index+1] = text_name[index] }
        if which == 1 { state_fcb[index+1] = state_name[index] }
        if which == 2 { meta_fcb[index+1] = meta_name[index] }
        if which == 3 { info_fcb[index+1] = info_name[index] }
        index = index + 1
    }
}
fun output_open(which:u8)->u8 {
    prepare_output(which)
    let fcb:u16 = u16(&text_fcb[0])
    if which == 1 { fcb = u16(&state_fcb[0]) }
    if which == 2 { fcb = u16(&meta_fcb[0]) }
    if which == 3 { fcb = u16(&info_fcb[0]) }
    if bdos8(22,fcb) == 255 { return 1 }
    return 0
}
fun output_close(fcb:u16,live:u8,buffer:u8,position:u8) {
    if live == 0 { return }
    if fcb == u16(&text_fcb[0]) { text_live = 0 }
    if fcb == u16(&state_fcb[0]) { state_live = 0 }
    if fcb == u16(&meta_fcb[0]) { meta_live = 0 }
    if fcb == u16(&info_fcb[0]) { info_live = 0 }
    if position != 0 {
        var index:u16 = 0
        while index < 128 {
            var byte:u8 = 0
            if index < u16(position) {
                if fcb == u16(&text_fcb[0]) { byte = text_buffer[index] }
                if fcb == u16(&state_fcb[0]) { byte = state_buffer[index] }
                if fcb == u16(&meta_fcb[0]) { byte = meta_buffer[index] }
                if fcb == u16(&info_fcb[0]) { byte = info_buffer[index] }
            }
            file_dma[index] = byte
            index = index + 1 }
        if bdos8(21,fcb) != 0 && fault == 0 { fault = 903 }
    }
    if bdos8(16,fcb) == 255 && fault == 0 { fault = 903 }
}
fun cleanup() {
    var handle:u8 = 0
    while handle < 3 { cursor_close(handle)
        handle = handle+1 }
    output_close(u16(&text_fcb[0]),text_live,u16(&text_buffer[0]),text_position)
    output_close(u16(&state_fcb[0]),state_live,u16(&state_buffer[0]),state_position)
    output_close(u16(&meta_fcb[0]),meta_live,u16(&meta_buffer[0]),meta_position)
    output_close(u16(&info_fcb[0]),info_live,u16(&info_buffer[0]),info_position)
}
fun write_companions() {
    if output_open(2) != 0 { fault = 901 return }
    meta_live = 1
    var index:u16 = 0
    while index < 4 { meta_put(meta_magic[index])
        index = index+1 }
    index = 0
    meta_header[0] = 1
    meta_header[1] = 5
    // ARMD header count is the raw fragment count, as in the source file.
    meta_header[2] = u8(definition_fragments)
    meta_header[3] = u8(definition_fragments >> 8)
    meta_header[4] = 4
    while index < 10 { meta_put(meta_header[index])
        index = index+1 }
    var base:u16 = 0
    index = 0
    while index < definition_count {
        let length:u16 = definition_lengths[index]
        var offset:u16 = 0
        while offset < length {
            var count:u16 = length-offset
            if count > 8 { count = 8 }
            meta_put(1)
            meta_put(1)
            meta_put(u8(index))
            meta_put(u8(index >> 8))
            meta_put(u8(length))
            meta_put(u8(length >> 8))
            meta_put(u8(offset))
            meta_put(u8(offset >> 8))
            meta_put(u8(count))
            var byte:u16 = 0
            while byte < 8 {
                if byte < count { meta_put(definition_payloads[base+offset+byte]) } else { meta_put(0) }
                byte = byte+1
            }
            offset = offset+count
        }
        base = base+length
        index = index+1
    }
    index = 0
    while index < 4 {
        meta_put(1)
        var offset:u16 = 0
        while offset < 16 {
            meta_put(metadata_payloads[index*16+offset])
            offset = offset+1
        }
        index = index+1
    }
    meta_put(255)
    let records:u32 = u32(definition_fragments)+4
    meta_put(u8(records))
    meta_put(u8(records >> 8))
    meta_put(u8(records >> 16))
    meta_put(u8(records >> 24))
    index = 0
    while index < 4 { meta_put(wire_end_magic[index])
        index = index+1 }
    if output_open(3) != 0 { fault = 901 return }
    info_live = 1
    info_put(82)
    info_put(73)
    info_put(78)
    info_put(70)
    info_put(1)
    info_u32(text_logical_bytes)
    info_u32(state_logical_bytes)
    info_u32(u32(render_rows[0]) | (u32(render_rows[1]) << 8) | (u32(render_rows[2]) << 16) | (u32(render_rows[3]) << 24))
}
fun disk_main()->u16 {
    fault = 0
    definition_fragments = 0
    definition_count = 0
    metadata_seen = 0
    validated_cells = 0
    text_logical_bytes = 0
    state_logical_bytes = 0
    text_position = 0
    state_position = 0
    meta_position = 0
    info_position = 0
    text_live = 0
    state_live = 0
    meta_live = 0
    info_live = 0
    var index:u16 = 0
    while index < 4096 { definition_payloads[index] = 0
        index = index+1 }
    index = 0
    while index < 64 { metadata_payloads[index] = 0
        definition_lengths[index] = 0
        index = index+1 }
    index = 0
    while index < 3 { input_live[index] = 0
        index = index+1 }
    bdos8(26,u16(&file_dma[0]))
    var handle:u8 = 0
    while handle < 3 { fcb_input_name(handle)
        handle = handle+1 }
    if fault == 0 { validate_definitions() }
    if fault == 0 { validate_cells() }
    if fault == 0 { validate_metadata() }
    cursor_close(0)
    if fault == 0 {
        if output_open(0) != 0 { fault = 901 } else { text_live = 1 }
    }
    if fault == 0 {
        if output_open(1) != 0 { fault = 901 } else { state_live = 1 }
    }
    handle = 0
    while handle < 3 && fault == 0 { cursor_open(handle)
        handle = handle+1 }
    if fault == 0 { render_run() }
    if fault == 0 { write_companions() }
    cleanup()
    return fault
}
