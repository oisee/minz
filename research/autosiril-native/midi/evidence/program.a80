; fun close_paired(id: u16 = DE, tick: u32 = mem) ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP
close_paired:
    ; genCall: paired_row dst=768
    PUSH DE
    PUSH HL
    LD HL, (_spill_close_paired_r767)
    EX (SP), HL
    EXX
    PUSH HL
    LD HL, (_spill_close_paired_r767+2)
    EX (SP), HL
    EXX
    EXX
    EX (SP), HL
    LD (_spill_paired_row_r731+2), HL
    POP HL
    EXX
    EX (SP), HL
    LD (_spill_paired_row_r731), HL
    POP HL
    CALL paired_row
    POP DE
    LD BC, (fault)    ; u16 direct load, no scratch clobber
    LD A, 0
    LD A, B
    OR C
    JRS Z, .close_paired_if_join2
.close_paired_if_then1:
    RET
.close_paired_if_join2:
    ; genCall: record_slot dst=773
    PUSH HL
    CALL record_slot
    PUSH HL
    POP IX
    POP HL
    LD A, L
    LD DE, note_bytes
    LD B, IXH
    LD C, IXL
    INC BC
    INC BC
    PUSH HL
    LD H, D
    LD L, E
    ADD HL, BC
    LD D, H
    LD E, L
    POP HL
    LD (DE), A
    LD L, H
    LD H, 0
    LD C, L
    LD HL, note_bytes
    LD DE, 3
    PUSH HL
    PUSH IX
    POP HL
    ADD HL, DE
    LD D, H
    LD E, L
    POP HL
    ADD HL, DE
    LD (HL), C
