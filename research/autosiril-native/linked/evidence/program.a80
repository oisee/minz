    RL C
    RL B
    PUSH HL
    LD H, B
    LD L, C
    OR A
    SBC HL, DE
    JR C, .div16_skip_0
    LD B, H
    LD C, L
    POP HL
    SET 0, L
    DEC A
    JR NZ, .div16_0
    JR .div16_done_0
.div16_skip_0:
    POP HL
    DEC A
    JR NZ, .div16_0
.div16_done_0:
    POP DE
    LD H, L
    LD L, 0
    ADD HL, HL
    ADD HL, HL
    ADD HL, HL
    ADD HL, HL
    LD B, H
    LD C, L
    LD HL, 682
    PUSH BC
    PUSH DE
    PUSH HL
    POP DE
    POP HL
    LD BC, 0
    LD A, 16
.div16_1:
    ADD HL, HL
    RL C
    RL B
    PUSH HL
    LD H, B
    LD L, C
    OR A
    SBC HL, DE
    JR C, .div16_skip_1
    LD B, H
    LD C, L
    POP HL
    SET 0, L
    DEC A
    JR NZ, .div16_1
    JR .div16_done_1
.div16_skip_1:
    POP HL
    DEC A
    JR NZ, .div16_1
.div16_done_1:
