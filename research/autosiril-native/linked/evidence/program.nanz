// Streaming SMF bytes -> compact paired note arena. No allocation or host music.
// MIDI parsing is the shared decoder; quantization is the actual Crystal export.
import mem.bytes
import midi.smf
@extern fun crystal_quantize(tick:u32,ppqn:u32,per_beat:u32)->u32

global midi_payload:[u8;512]
global midi_buffer:ByteBuffer
global midi_decoder:SmfDecoder
global midi_event:MidiEvent
global input_chunk:[u8;256]
global input_length:u16
global input_consumed:u16
global native_control:u8
global per_beat:u32
global tick_limit:u32
global note_bytes:[u8;12288]
global note_count:u16
global source_count:u16
global track_seen:[u8;64]
global track_source:[u8;64]
global active:[u16;512]
global active_channel:[u8;512]
global active_count:u16
global peak_active:u16
global fault:u16
global accepted_bytes:u32
global event_count:u32

fun record_slot(id:u16)->u16 {
    let index:u16 = id - 1
    return (index / 682) * 4096 + (index % 682) * 6
}
fun paired_row(tick:u32)->u16 {
    let ppqn:u32 = u32(midi_decoder.division)
    if ppqn == 0 { fault = 201
        return 0 }
    if tick_limit == 0 {
        // Guard before the Crystal UInt32 arithmetic can wrap.
        tick_limit = (u32(65536) * ppqn - 1 - ppqn / 2) / per_beat
    }
    if tick > tick_limit { fault = 202
        return 0 }
    return u16(crystal_quantize(tick,ppqn,per_beat))
}
fun close_paired(id:u16,tick:u32) {
    let row:u16 = paired_row(tick)
    if fault != 0 { return }
    let at:u16 = record_slot(id)
    note_bytes[at+2] = u8(row)
    note_bytes[at+3] = u8(row >> 8)
}
fun release_paired(channel:u8,pitch:u8,tick:u32) {
    var index:u16 = 0
    while index < active_count {
        let id:u16 = active[index]
        let at:u16 = record_slot(id)
        if active_channel[index] == channel && note_bytes[at+4] == pitch {
            close_paired(id,tick)
            if fault != 0 { return }
            // Stable compaction retains FIFO order for duplicate pitches.
            var next:u16 = index + 1
            while next < active_count {
                active[next-1] = active[next]
                active_channel[next-1] = active_channel[next]
                next = next + 1
            }
            active_count = active_count - 1
            return
        }
        index = index + 1
    }
}
fun consume_paired_event() {
    let track:u16 = midi_event.track
    if track >= 64 { fault = 203
        return }
    let kind:u8 = midi_event.status & 240
    let channel:u8 = midi_event.status & 15
    let pitch:u8 = midi_event.data1
    if kind == 144 && midi_event.data2 != 0 {
        if note_count >= 2046 { fault = 204
            return }
        if active_count >= 512 { fault = 205
            return }
        let row:u16 = paired_row(midi_event.tick)
        if fault != 0 { return }
        if track_seen[track] == 0 {
            if source_count >= 256 { fault = 206
                return }
            track_source[track] = u8(source_count)
            track_seen[track] = 1
            source_count = source_count + 1
        }
        note_count = note_count + 1
        let id:u16 = note_count
        let at:u16 = record_slot(id)
        note_bytes[at] = u8(row)
        note_bytes[at+1] = u8(row >> 8)
        note_bytes[at+2] = 0
        note_bytes[at+3] = 0
        note_bytes[at+4] = pitch
        note_bytes[at+5] = track_source[track]
        active[active_count] = id
        active_channel[active_count] = channel
        active_count = active_count + 1
        if active_count > peak_active { peak_active = active_count }
        return
    }
    if kind == 128 || kind == 144 {
        release_paired(channel,pitch,midi_event.tick)
        return
    }
    if midi_event.status == 255 && midi_event.meta == 47 {
        // midilib synthesizes unmatched offs in onset order, each with the
        // final event's delta. This historical behavior is intentional.
        var tick:u32 = midi_event.tick
        var index:u16 = 0
        while index < active_count {
            if tick > u32(4294967295) - midi_event.delta { fault = 207
                return }
            tick = tick + midi_event.delta
            close_paired(active[index],tick)
            if fault != 0 { return }
            index = index + 1
        }
        active_count = 0
    }
}
fun paired_boot() {
    midi_buffer.init(&midi_payload,512)
    midi_decoder.init(&midi_buffer)
    fault = 0
    note_count = 0
    source_count = 0
    active_count = 0
    peak_active = 0
    input_consumed = 0
    accepted_bytes = 0
    event_count = 0
    tick_limit = 0
    var index:u16 = 0
    while index < 64 {
        track_seen[index] = 0
        track_source[index] = 0
        index = index + 1
    }
    if per_beat == 0 || per_beat > 256 { fault = 208 }
}

global native_source:u8
global native_mode:u8
global native_limit:u32
global output_count:u16
global output_rows:[u16;1024]
global output_values:[u16;1024]
// ADR 0051/0052: paired notes -> scalar generator of flattened entries.
// Read-only note arena: 12 banks, 682 six-byte records per 4096-byte bank.
// Record: start:u16, off:u16, pitch:u8, source:u8. IDs are 1-based handles.
// The backing array emulates physical banks; no mapped near pointer escapes.
@extern fun crystal_cell_action(mask:u8)->u8
@extern fun crystal_prefer(current:u8,candidate:u8,mode:u8)->u8
fun emit_flat(row:u16,value:u16){
 if output_count>=1024{fault=200
 return}
 output_rows[output_count]=row
 output_values[output_count]=value
 output_count=output_count+1
}
global last_start:[u16;256]
global source_seen:[u8;256]
global banked:u8
global churn:u8
global mapped_bank:u16
global mapping_epoch:u32
global bank_switches:u32
global payload_reads:u32
global rows_visited:u32
global yielded:u32
global stream_busy:u8
global yield_row:u16

fun map_bank(bank:u16) {
    if bank >= 3 { fault = 100
        return }
    if mapped_bank != bank {
        if mapping_epoch == u32(4294967295) { fault = 101
            return }
        mapped_bank = bank
        mapping_epoch = mapping_epoch + 1
        bank_switches = bank_switches + 1
    }
}
fun read_window(slot:u16,epoch:u32)->u8 {
    if epoch != mapping_epoch || mapped_bank >= 3 || slot >= 4096 {
        fault = 102
        return 0
    }
    return note_bytes[mapped_bank * 4096 + slot]
}
fun read_byte(id:u16,field:u16)->u8 {
    if id == 0 || id > note_count || id > 2046 || field >= 6 { fault = 103
        return 0 }
    let index:u16 = id - 1
    let bank:u16 = index / 682
    let slot:u16 = (index % 682) * 6 + field
    payload_reads = payload_reads + 1
    if banked == 0 { return note_bytes[bank * 4096 + slot] }
    if churn != 0 { map_bank((bank + 1) % 3) }
    map_bank(bank)
    return read_window(slot,mapping_epoch)
}
fun start_of(id:u16)->u16 {
    let low:u16 = u16(read_byte(id,0))
    return low | (u16(read_byte(id,1)) << 8)
}
fun off_of(id:u16)->u16 {
    let low:u16 = u16(read_byte(id,2))
    return low | (u16(read_byte(id,3)) << 8)
}
fun validate_input() {
    var source_index:u16 = 0
    while source_index < 256 { source_seen[source_index] = 0
        source_index = source_index + 1 }
    if note_count > 2046 { fault = 104
        return }
    var id:u16 = 1
    while id <= note_count {
        let source:u8 = read_byte(id,5)
        let start:u16 = start_of(id)
        if off_of(id) < start { fault = 105
            return }
        if source_seen[source] != 0 && start < last_start[source] {
            fault = 106
            return
        }
        source_seen[source] = 1
        last_start[source] = start
        id = id + 1
    }
}
fun next_source(id:u16,source:u8)->u16 {
    var next:u16 = id
    while next <= note_count {
        if read_byte(next,5) == source { return next }
        next = next + 1
    }
    return 0
}
// Only one stream may own active[] at once. Frames retain scalar handles.
gen flattened(source:u8,mode:u8)->u16 {
    if stream_busy != 0 { fault = 107
        return }
    stream_busy = 1
    active_count = 0
    var next:u16 = next_source(1,source)
    while next != 0 || active_count != 0 {
        var row:u16 = 0
        var have_row:bool = false
        if next != 0 { row = start_of(next)
            have_row = true }
        var i:u16 = 0
        while i < active_count {
            let min_off:u16 = off_of(active[i])
            if !have_row || min_off < row { row = min_off
                have_row = true }
            i = i + 1
        }
        // Add starts in original note-ID order, including zero-length notes.
        while next != 0 && start_of(next) == row {
            if active_count >= 512 { fault = 108
                return }
            active[active_count] = next
            active_count = active_count + 1
            if active_count > peak_active { peak_active = active_count }
            next = next_source(next + 1,source)
        }
        rows_visited = rows_visited + 1
        var mask:u8 = 0
        i = 0
        while i < active_count {
            let mask_id:u16 = active[i]
            let start:u16 = start_of(mask_id)
            let off:u16 = off_of(mask_id)
            if start == row { mask = mask | 1 }
            if off == row { mask = mask | 4 }
            if start < row && row < off { mask = mask | 2 }
            i = i + 1
        }
        let action:u8 = crystal_cell_action(mask)
        if action != 0 {
            if action == 1 && mode == 112 {
                i = 0
                while i < active_count {
                    let poly_id:u16 = active[i]
                    if start_of(poly_id) == row || off_of(poly_id) > row {
                        let poly_pitch:u8 = read_byte(poly_id,4)
                        yielded = yielded + 1
                        yield_row = row
                        yield u16(poly_pitch) | u16(256)
                    }
                    i = i + 1
                }
            } else {
                var have:u8 = 0
                var pitch:u8 = 0
                var prefer_mode:u8 = mode
                if action == 4 { prefer_mode = 100 }
                i = 0
                while i < active_count {
                    let pick_id:u16 = active[i]
                    if action == 4 || start_of(pick_id) == row || off_of(pick_id) > row {
                        let candidate:u8 = read_byte(pick_id,4)
                        if have == 0 { pitch = candidate
                            have = 1 }
                        else { pitch = crystal_prefer(pitch,candidate,prefer_mode) }
                    }
                    i = i + 1
                }
                if have != 0 {
                    yielded = yielded + 1
                    yield_row = row
                    yield u16(pitch) | (u16(action) << 8)
                }
            }
        }
        // Compact survivors without changing their original ID order.
        var kept:u16 = 0
        i = 0
        while i < active_count {
            let keep_id:u16 = active[i]
            if off_of(keep_id) > row {
                active[kept] = keep_id
                kept = kept + 1
            }
            i = i + 1
        }
        active_count = kept
        if fault != 0 { return }
    }
    stream_busy = 0
}
fun consume(source:u8,mode:u8,limit:u32) {
    // A rejected consumer must never release another cursor's scratch lease.
    if stream_busy != 0 { fault = 107
        return }
    var it = flattened(source,mode)
    var value:u16 = 0
    var count:u32 = 0
    while count < limit && pull_next(&it,&value) {
        emit_flat(yield_row,value)
        count = count + 1
    }
    // The local frame is abandoned here; release its shared scratch region.
    stream_busy = 0
}
fun factory_probe() {
    var it = flattened(0,112)
}
fun stale_probe()->u8 {
    map_bank(0)
    let epoch:u32 = mapping_epoch
    map_bank(1)
    return read_window(0,epoch)
}
fun exhaustion_probe(source:u8,mode:u8)->u16 {
    var it = flattened(source,mode)
    var value:u16 = 0
    while pull_next(&it,&value) { value = value }
    value = 4242
    let before:u32 = rows_visited
    if pull_next(&it,&value) { return 1 }
    if pull_next(&it,&value) { return 2 }
    if value != 4242 || rows_visited != before { return 3 }
    return 0
}
fun exclusive_probe()->u16 {
    var first = flattened(0,112)
    var second = flattened(0,112)
    var value:u16 = 0
    if pull_next(&first,&value) {
        if pull_next(&second,&value) { return 1 }
    }
    stream_busy = 0
    return fault
}
fun native_flatten()->u16{
 if fault!=0{return fault}
 if midi_decoder.finish()!=SmfStatus.DONE{fault=310
 return fault}
 output_count=0
 rows_visited=0
 yielded=0
 peak_active=0
 payload_reads=0
 bank_switches=0
 mapping_epoch=0
 mapped_bank=65535
 yield_row=0
 validate_input()
 if fault!=0{return fault}
 consume(native_source,native_mode,native_limit)
 return fault
}
fun native_main()->u16 {
    if native_control == 3 { return native_flatten() }
    if native_control == 0 { paired_boot()
        return fault }
    if fault != 0 { return fault }
    if native_control == 2 {
        let status:u8 = midi_decoder.finish()
        if status != SmfStatus.DONE { fault = 300 + u16(midi_decoder.error) }
        return fault
    }
    if native_control != 1 { fault = 209
        return fault }
    if input_length > 256 { fault = 210
        return fault }
    input_consumed = 0
    while input_consumed < input_length {
        let result:u16 = midi_decoder.feed_byte(input_chunk[input_consumed],&midi_event)
        let consumed:u16 = result >> 8
        input_consumed = input_consumed + consumed
        accepted_bytes = accepted_bytes + u32(consumed)
        let status:u8 = u8(result & 255)
        if status == SmfStatus.ERROR {
            fault = 300 + u16(midi_decoder.error)
            return fault
        }
        if status == SmfStatus.EVENT {
            event_count = event_count + 1
            consume_paired_event()
            midi_decoder.ack()
            if fault != 0 { return fault }
        }
        if consumed == 0 { fault = 211
            return fault }
    }
    return fault
}
