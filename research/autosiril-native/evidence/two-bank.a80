; fun start_of(id: u16 = HL) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1]
start_of:
    LD DE, 0
    ; genCall: read_byte dst=148
    PUSH HL
    CALL read_byte
    POP HL
    LD DE, 1
    ; genCall: read_byte dst=150
    PUSH AF
    CALL read_byte
    LD B, A
    POP AF
    ; pack disjoint byte lanes
    LD L, A
    LD H, B
    RET

; fun off_of(id: u16 = HL) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1]
off_of:
    LD DE, 2
    ; genCall: read_byte dst=154
    PUSH HL
    CALL read_byte
    POP HL
    LD DE, 3
    ; genCall: read_byte dst=156
    PUSH AF
    CALL read_byte
    LD B, A
    POP AF
    ; pack disjoint byte lanes
    LD L, A
    LD H, B
    RET

; fun validate_input() ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=6,dead-block-arg=2,condret-sink=1,ptr-threading=1,cond-rets=1]
validate_input:
.validate_input_loop_head1:
    LD HL, source_seen
    LD C, 0
    LD DE, 256
    ; genCall: @mir.mem.fill_bytes16 dst=0
    LD B, D
    PUSH AF
    LD A, E
    LD E, C
    LD C, A
    POP AF
    LD A, C
    OR B
    JRS Z, .byte_fill_done_0
    LD A, E
    LD (HL), A
    DEC BC
    LD A, B
    OR C
    JRS Z, .byte_fill_done_0
    LD D, H
    LD E, L
    INC DE
    LDIR
.byte_fill_done_0:
.validate_input_loop_exit3:
    LD DE, (note_count)    ; u16 direct load, no scratch clobber
    LD HL, 1364
    OR A
    SBC HL, DE
    JRS NC, .validate_input_if_join5
.validate_input_if_then4:
    LD DE, 104
    LD (fault), DE    ; u16 direct store, no scratch clobber
    RET
.validate_input_if_join5:
    LD HL, 1
.validate_input_loop_head6:
    LD DE, (note_count)    ; u16 direct load, no scratch clobber
    PUSH HL
    OR A
    SBC HL, DE
    POP HL
    JRS C, .validate_input_loop_body7
    JRS Z, .validate_input_loop_body7
    RET
.validate_input_loop_body7:
    LD DE, 5
    ; genCall: read_byte dst=174
    PUSH HL
    CALL read_byte
    POP HL
    ; genCall: start_of dst=175
    PUSH AF
    PUSH HL
    CALL start_of
    LD D, H
    LD E, L
    POP HL
    POP AF
    ; genCall: off_of dst=176
    PUSH AF
    PUSH DE
    PUSH HL
    CALL off_of
    LD B, H
    LD C, L
    POP HL
    POP DE
    POP AF
    LD IYH, A    ; preserve live accumulator before CMP
    PUSH HL
    LD H, B
    LD L, C
    OR A
    SBC HL, DE
    POP HL
    ; restore live-out r174 from scratch
    LD A, IYH
    JRS NC, .validate_input_if_join10
.validate_input_if_then9:
    LD DE, 105
    LD (fault), DE    ; u16 direct store, no scratch clobber
    RET
.validate_input_if_join10:
    LD BC, source_seen
    LD IXL, A
    LD IXH, 0
    PUSH HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    LD L, C
    LD H, B
    ADD HL, DE
    LD C, L
    LD B, H
    POP DE
    POP HL
    EX AF, AF'      ; preserve byte-load scratch
    LD A, (BC)
    LD C, A
    EX AF, AF'      ; restore byte-load scratch
    LD IYH, A    ; preserve live accumulator before CMP
    LD A, C
    AND A
    ; restore live-out r174 from scratch
    LD A, IYH
    JRS Z, .validate_input_logic_false15
.validate_input_logic_rhs13:
    LD BC, last_start
    LD IXL, A
    LD IXH, 0
    PUSH HL    ; preserve live HL across indexed word shift
    PUSH IX
    POP HL
    ADD HL, HL
    PUSH HL
    POP IX
    POP HL     ; restore indexed word shift scratch
    PUSH HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    LD L, C
    LD H, B
    ADD HL, DE
    LD C, L
    LD B, H
    POP DE
    POP HL
    PUSH AF          ; preserve word-load scratch
    LD A, (BC)     ; lo
    PUSH AF          ; stage low byte before replacing address
    INC BC
    LD A, (BC)     ; hi
    LD B, A
    POP AF
    LD C, A
    POP AF           ; restore word-load scratch
    LD IYH, A    ; preserve live accumulator before CMP
    PUSH HL
    LD H, D
    LD L, E
    OR A
    SBC HL, BC
    POP HL
    ; restore live-out r174 from scratch
    LD A, IYH
    JRS NC, .validate_input_logic_false15
.validate_input_logic_true14:
    LD C, 1
.validate_input_logic_join16:
    BIT 0, C
    JRS Z, .validate_input_if_join12
.validate_input_if_then11:
    LD DE, 106
    LD (fault), DE    ; u16 direct store, no scratch clobber
    RET
.validate_input_if_join12:
    LD BC, source_seen
    PUSH HL
    PUSH DE
    LD E, A
    LD D, 0
    LD L, C
    LD H, B
    ADD HL, DE
    LD C, L
    LD B, H
    POP DE
    POP HL
    PUSH AF    ; preserve live A across byte store
    LD A, 1
    LD (BC), A
    POP AF
    LD BC, last_start
    PUSH HL
    LD L, A
    LD H, 0
    ADD HL, HL
    PUSH HL
    POP IX
    POP HL
    PUSH HL
    PUSH DE
    LD D, IXH
    LD E, IXL
    LD L, C
    LD H, B
    ADD HL, DE
    LD C, L
    LD B, H
    POP DE
    POP HL
    LD A, E
    LD (BC), A     ; lo
    INC BC
    LD A, D
    LD (BC), A     ; hi
    DEC BC
    INC HL
    JRS .validate_input_loop_head6
.validate_input_logic_false15:
    LD C, 0
    JRS .validate_input_logic_join16

; fun next_source(id: u16 = HL, source: u8 = C) -> u16 = HL ; clobbers: A, B, BC, C, D, DE, E, F, H, HL, IX, IXH, IXL, IY, IYH, IYL, L
; [trace] backend=PBQP passes=[const-fold=1,dse=1,dead-block-arg=1,condret-sink=1,cond-rets=1]
next_source:
