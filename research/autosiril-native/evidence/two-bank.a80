    PUSH BC
    PUSH HL
    CALL read_byte
    POP HL
    POP BC
    CP C
    JRS NZ, .next_source_if_join5
.next_source_if_then4:
    RET
.next_source_if_join5:
    INC HL
    JRS .next_source_loop_head1

