// Common file producer. Transport fills input_chunk and uses explicit status:
// low16=count, high16=0 progress / 1 EOF / 2 error. Empty progress is not EOF.
// open_input/create_output/finish return zero on success; finish direction0/1.
global chunk_capacity:u16
global input_padding:u8
global file_cursor:u16
global file_header:[u8;12] = [65,83,73,82,1,1,6,0,0,0,0,0]

fun file_write_record() {
    if fault != 0 { return }
    let result:u32 = write_chunk(file_cursor)
    if (result >> 16) != 0 || u16(result) != file_cursor { fault = 902 }
    file_cursor = 0
}
fun file_put(byte:u8) {
    if fault != 0 { return }
    if chunk_capacity == 0 || chunk_capacity > 256 { fault = 910
        return }
    input_chunk[file_cursor] = byte
    file_cursor = file_cursor + 1
    if file_cursor == chunk_capacity { file_write_record() }
}
fun file_put_word(word:u16) {
    file_put(u8(word))
    file_put(u8(word >> 8))
}
fun file_save_notes() {
    if create_output() != 0 { fault = 901
        return }
    file_cursor = 0
    file_header[8] = u8(source_count)
    file_header[9] = u8(source_count >> 8)
    var index:u16 = 0
    while index < 12 {
        file_put(file_header[index])
        index = index + 1
    }
    var id:u16 = 1
    while id <= note_count && fault == 0 {
        file_put(1)
        let at:u16 = record_slot(id)
        index = 0
        while index < 6 {
            file_put(note_bytes[at+index])
            index = index + 1
        }
        id = id + 1
    }
    file_put(255)
    file_put_word(note_count)
    file_put_word(0)
    file_put(69)
    file_put(78)
    file_put(68)
    file_put(33)
    if file_cursor != 0 && fault == 0 { file_write_record() }
    if finish(1) != 0 && fault == 0 { fault = 903 }
}
fun disk_main()->u16 {
    native_control = 0
    native_main()
    if fault != 0 { return fault }
    if open_input() != 0 { fault = 900
        return fault }
    if chunk_capacity == 0 || chunk_capacity > 256 { fault = 910
        finish(0)
        return fault }
    var eof:u8 = 0
    var ended:u8 = 0
    var stalled:u16 = 0
    while eof == 0 && fault == 0 {
        let result:u32 = read_chunk()
        let status:u16 = u16(result >> 16)
        let count:u16 = u16(result)
        if status == 1 {
            if count != 0 { fault = 911 } else { eof = 1 }
        } else {
            if status != 0 { fault = 904 } else {
                if count > 256 { fault = 210 } else {
                    if count == 0 {
                        stalled = stalled + 1
                        if stalled >= 1024 { fault = 912 }
                    } else {
                        stalled = 0
                        if ended != 0 { fault = 905 } else {
                            var index:u16 = 0
                            while index < count && fault == 0 {
                                if midi_decoder.phase == SmfPhase.END {
                                    if input_padding == 0 || input_chunk[index] != 26 { fault = 905 }
                                } else {
                                    input_chunk[0] = input_chunk[index]
                                    input_length = 1
                                    native_control = 1
                                    native_main()
                                }
                                index = index + 1
                            }
                            if midi_decoder.phase == SmfPhase.END { ended = 1 }
                        }
                    }
                }
            }
        }
    }
    if finish(0) != 0 && fault == 0 { fault = 906 }
    if fault == 0 {
        native_control = 2
        native_main()
    }
    if fault == 0 { file_save_notes() }
    return fault
}
