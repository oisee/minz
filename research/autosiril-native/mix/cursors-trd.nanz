// Three owned logical-file cursors over the append-only TRD sector binding.
// Physical scratch is overwritten by every catalog/read/write operation.
global fault:u16
global input_live:[u8;3]
global input_done:[u8;3]
global input_at:[u16;3]
global input_length:[u16;3]
global input_counts:[u32;3]
global cursor_positions:[u16;3]
global cursor_remaining:[u16;3]
global input_buffers:[u8;768]
global input_chunk:[u8;256]
global output_buffer:[u8;256]
global output_at:u16
global output_live:u8
global written_records:u32
global source_name:[u8;11]
global sink_name:[u8;11]
global input_name:[u8;9]
global output_name:[u8;9] = [77,73,88,69,68,32,32,32,77]
global disk_error:u16
global input_position:u16
global input_remaining:u16
global free_position:u16
global free_count:u16
global directory_count:u16
global output_position:u16
global output_written:u16
global output_sectors:u16
global input_open:u8
global output_tail:u8
global writer_free_position:u16
global writer_free_count:u16
global writer_directory_count:u16

fun cursor_open(handle:u8)->u8 {
    if handle >= 3 { return 1 }
    if input_live[handle] != 0 { return 1 }
    var index:u16 = 0
    while index < 8 {
        input_name[index] = source_name[index]
        index = index+1
    }
    input_name[8] = source_name[0]
    // open_input refreshes catalog validation and selected source only. It
    // must never reset a live output's append position, tail or counters.
    let status:u8 = open_input()
    if output_live != 0 {
        let changed:bool = free_position != writer_free_position || free_count != writer_free_count || directory_count != writer_directory_count
        free_position = writer_free_position
        free_count = writer_free_count
        directory_count = writer_directory_count
        if changed && status == 0 { disk_error = 12
            return 1 }
    }
    if status != 0 { return 1 }
    cursor_positions[handle] = input_position
    cursor_remaining[handle] = input_remaining
    input_at[handle] = 0
    input_length[handle] = 0
    input_done[handle] = 0
    input_counts[handle] = 0
    input_live[handle] = 1
    return 0
}
fun cursor_close(handle:u8)->u8 {
    if handle >= 3 { return 1 }
    if input_live[handle] == 0 { return 1 }
    input_live[handle] = 0
    return 0
}
fun cursor_refill(handle:u8)->u32 {
    if handle >= 3 { return u32(131072) }
    if input_live[handle] == 0 { return u32(131072) }
    input_open = 1
    input_position = cursor_positions[handle]
    input_remaining = cursor_remaining[handle]
    let result:u32 = read_chunk()
    let status:u16 = u16(result >> 16)
    if status != 0 {
        if status == 1 && u16(result) == 0 { return u32(65536) }
        // EOF-with-bytes and unknown status codes are not a valid EOF.
        return u32(131072)
    }
    let count:u16 = u16(result)
    if count == 0 || count > 256 { return u32(131072) }
    cursor_positions[handle] = input_position
    cursor_remaining[handle] = input_remaining
    var index:u16 = 0
    let base:u16 = u16(handle)*256
    while index < count {
        input_buffers[base+index] = input_chunk[index]
        index = index+1
    }
    input_at[handle] = 0
    input_length[handle] = count
    return result
}
fun cursor_get(handle:u8)->u32 {
    if handle >= 3 { return u32(131072) }
    if input_live[handle] == 0 { return u32(131072) }
    if input_at[handle] == input_length[handle] {
        let result:u32 = cursor_refill(handle)
        if (result >> 16) != 0 { return result }
    }
    let byte:u8 = input_buffers[u16(handle)*256+input_at[handle]]
    input_at[handle] = input_at[handle]+1
    input_counts[handle] = input_counts[handle]+1
    return u32(byte)
}
fun sink_open()->u8 {
    if output_live != 0 { return 1 }
    if create_output() != 0 { return 1 }
    writer_free_position = free_position
    writer_free_count = free_count
    writer_directory_count = directory_count
    output_at = 0
    written_records = 0
    return 0
}
fun sink_flush() {
    if fault != 0 || output_at == 0 { return }
    let count:u16 = output_at
    var index:u16 = 0
    while index < count {
        input_chunk[index] = output_buffer[index]
        index = index+1
    }
    output_at = 0
    let result:u32 = write_chunk(count)
    if (result >> 16) != 0 || u16(result) != count { fault = 902
        return }
    written_records = written_records+1
}
fun sink_put(byte:u8) {
    if fault != 0 { return }
    output_buffer[output_at] = byte
    output_at = output_at+1
    if output_at == 256 { sink_flush() }
}
fun cursors_cleanup() {
    var handle:u8 = 0
    while handle < 3 {
        if input_live[handle] != 0 {
            if cursor_close(handle) != 0 && fault == 0 { fault = 906 }
        }
        handle = handle+1
    }
    input_open = 0
    if output_live != 0 {
        if finish(1) != 0 && fault == 0 { fault = 903 }
    }
}
