// Lossless kind4 readers with per-handle framing/definition/order state.
// Definitions are copied on the initial validation pass; later scans own heads.
global scan_payload:[u8;48]
global scan_records:[u32;3]
global scan_finished:[u8;3]
global scan_meta:[u8;3]
global scan_started:[u8;3]
global scan_last_channel:[u8;3]
global scan_have_cell:[u8;3]
global scan_counts:[u16;9]
global scan_last_rows:[u16;9]
global scan_defs:[u16;3]
global scan_used:[u16;3]
global scan_def_length:[u16;3]
global scan_def_offset:[u16;3]
global scan_def_repeat:[u16;3]
global scan_def_previous:[u8;3]
global scan_def_lengths:[u16;192]
global scan_copy_defs:u8
global wire_records:u32
global render_rows:u32
global delay_one:u16 = 6
global delay_two:u16 = 12
global note_seen:[u8;64]
global note_previous:[u16;64]
global note_name:[u8;11] = [78,79,84,69,83,32,32,32,66,73,78]
global delayed_name:[u8;11] = [68,69,76,65,89,69,68,32,66,73,78]
global mixed_name:[u8;11] = [77,73,88,69,68,32,32,32,66,73,78]
global wire_magic:[u8;4] = [65,83,73,82]
global wire_end:[u8;4] = [69,78,68,33]
global mixed_header:[u8;12] = [65,83,73,82,1,5,16,0,3,0,0,0]

fun scan_byte(handle:u8)->u8 {
    if fault != 0 { return 0 }
    let result:u32 = cursor_get(handle)
    if (result >> 16) != 0 {
        if (result >> 16) == 1 { fault = 951 } else { fault = 904 }
        return 0
    }
    return u8(result)
}
fun scan_word(handle:u8)->u16 {
    let low:u8 = scan_byte(handle)
    let high:u8 = scan_byte(handle)
    return u16(low) | (u16(high) << 8)
}
fun scan_u32(handle:u8)->u32 {
    let low:u16 = scan_word(handle)
    let high:u16 = scan_word(handle)
    return u32(low) | (u32(high) << 16)
}
fun scan_pword(handle:u8,offset:u16)->u16 {
    let at:u16 = u16(handle)*16+offset
    return u16(scan_payload[at]) | (u16(scan_payload[at+1]) << 8)
}
fun scan_header(handle:u8,kind:u8,width:u8)->u16 {
    var index:u8 = 0
    while index < 4 {
        if scan_byte(handle) != wire_magic[index] && fault == 0 { fault = 950 }
        index = index + 1
    }
    if fault != 0 { return 0 }
    let version:u8 = scan_byte(handle)
    let actual_kind:u8 = scan_byte(handle)
    let actual_width:u8 = scan_byte(handle)
    let flags:u8 = scan_byte(handle)
    let metadata:u16 = scan_word(handle)
    let reserved:u16 = scan_word(handle)
    if fault != 0 { return 0 }
    if version != 1 { fault = 952 }
    if actual_kind != kind || actual_width != width || flags != 0 || reserved != 0 { fault = 953 }
    return metadata
}
fun scan_end(handle:u8,expected:u32) {
    let count:u32 = scan_u32(handle)
    if fault != 0 { return }
    if count != expected { fault = 956
        return }
    var index:u8 = 0
    while index < 4 {
        if scan_byte(handle) != wire_end[index] && fault == 0 { fault = 956 }
        index = index + 1
    }
    if fault != 0 { return }
    // Physical CP/M padding only; the next complete record must be EOF.
    let padding:u16 = (128 - u16(input_counts[handle]) % 128) % 128
    var left:u16 = 0
    while left < padding && fault == 0 {
        if scan_byte(handle) != 0 && fault == 0 { fault = 957 }
        left = left + 1
    }
    if fault != 0 { return }
    let result:u32 = cursor_get(handle)
    if (result >> 16) == 2 { fault = 904
        return }
    if (result >> 16) != 1 { fault = 957 }
}
fun wire_record(handle:u8) {
    if fault != 0 { return }
    sink_put(1)
    var index:u16 = 0
    let base:u16 = u16(handle)*16
    while index < 16 {
        sink_put(scan_payload[base+index])
        index = index + 1
    }
    if fault == 0 { wire_records = wire_records + 1 }
}
fun scan_definition(handle:u8) {
    let base:u16 = u16(handle)*16
    let id:u16 = scan_pword(handle,1)
    let length:u16 = scan_pword(handle,3)
    let offset:u16 = scan_pword(handle,5)
    let count:u16 = u16(scan_payload[base+7])
    if scan_meta[handle] != 0 || id != scan_defs[handle] || id >= 64 ||
        length == 0 || length > 4096 || offset != scan_def_offset[handle] { fault = 985
        return }
    if offset == 0 {
        if scan_def_length[handle] != 0 || scan_used[handle] > 4096-length { fault = 985
            return }
        if id == 0 {
            if length > 32 { fault = 985
                return }
            scan_def_repeat[handle] = length
        }
        if scan_def_repeat[handle] == 0 || length % scan_def_repeat[handle] != 0 { fault = 985
            return }
        scan_def_length[handle] = length
        scan_def_previous[handle] = 0
    } else {
        if length != scan_def_length[handle] { fault = 985
            return }
    }
    var want:u16 = length-offset
    if want > 8 { want = 8 }
    if count != want || count == 0 { fault = 985
        return }
    var index:u16 = 0
    while index < 8 {
        let byte:u8 = scan_payload[base+8+index]
        if index < count {
            let position:u16 = offset+index
            if byte > 127 || (id == 0 && byte != 0) || (position == 0 && byte != 0) { fault = 985
                return }
            if position % scan_def_repeat[handle] != 0 {
                if byte != scan_def_previous[handle] { fault = 985
                    return }
            } else {
                if position != 0 && byte <= scan_def_previous[handle] { fault = 985
                    return }
            }
            scan_def_previous[handle] = byte
        } else {
            if byte != 0 { fault = 985
                return }
        }
        index = index + 1
    }
    scan_def_offset[handle] = offset+count
    if scan_def_offset[handle] == length {
        scan_def_lengths[u16(handle)*64+id] = length
        scan_defs[handle] = id+1
        scan_used[handle] = scan_used[handle]+length
        scan_def_offset[handle] = 0
        scan_def_length[handle] = 0
    }
    if scan_copy_defs != 0 { wire_record(handle) }
}
fun scan_open(handle:u8) {
    if cursor_open(handle) != 0 { fault = 900
        return }
    scan_records[handle] = 0
    scan_finished[handle] = 0
    scan_meta[handle] = 0
    scan_started[handle] = 0
    scan_have_cell[handle] = 0
    scan_last_channel[handle] = 0
    scan_defs[handle] = 0
    scan_used[handle] = 0
    scan_def_length[handle] = 0
    scan_def_offset[handle] = 0
    scan_def_repeat[handle] = 0
    var channel:u16 = 0
    while channel < 3 {
        scan_counts[u16(handle)*3+channel] = 0
        scan_last_rows[u16(handle)*3+channel] = 0
        channel = channel + 1
    }
    let metadata:u16 = scan_header(handle,4,16)
    if fault == 0 && metadata != 3 { fault = 953 }
}
fun scan_next(handle:u8,selected:u8)->u8 {
    if scan_finished[handle] != 0 || fault != 0 { return 0 }
    let base:u16 = u16(handle)*16
    while fault == 0 {
        let tag:u8 = scan_byte(handle)
        if fault != 0 { return 0 }
        if tag == 255 {
            if scan_meta[handle] != 3 || scan_defs[handle] == 0 || scan_def_length[handle] != 0 { fault = 985
                return 0 }
            scan_end(handle,scan_records[handle])
            scan_finished[handle] = 1
            return 0
        }
        if tag != 1 { fault = 955
            return 0 }
        var index:u16 = 0
        while index < 16 {
            scan_payload[base+index] = scan_byte(handle)
            index = index + 1
        }
        if fault != 0 { return 0 }
        scan_records[handle] = scan_records[handle]+1
        let role:u8 = scan_payload[base]
        if role == 1 { scan_definition(handle) } else {
            if scan_defs[handle] == 0 || scan_def_length[handle] != 0 { fault = 985
                return 0 }
            let channel:u8 = scan_payload[base+1]
            if role == 2 {
                if channel != scan_meta[handle] || channel >= 3 { fault = 987
                    return 0 }
                let extent:u32 = u32(scan_pword(handle,2)) | (u32(scan_pword(handle,4)) << 16)
                let slot:u16 = u16(handle)*3+u16(channel)
                if scan_counts[slot] != 0 && extent <= u32(scan_last_rows[slot]) { fault = 987
                    return 0 }
                index = 6
                while index < 16 {
                    if scan_payload[base+index] != 0 { fault = 987
                        return 0 }
                    index = index + 1
                }
                scan_meta[handle] = scan_meta[handle]+1
            } else {
                if role != 0 || scan_meta[handle] != 0 || channel >= 3 { fault = 958
                    return 0 }
                let row:u16 = scan_pword(handle,2)
                let slot:u16 = u16(handle)*3+u16(channel)
                let kind:u8 = scan_payload[base+12]
                if scan_payload[base+4] > 127 || scan_payload[base+15] != 0 ||
                    (scan_payload[base+11] != 115 && scan_payload[base+11] != 114) ||
                    (kind != 109 && kind != 112 && kind != 100 && kind != 101) { fault = 958
                    return 0 }
                if kind == 112 && scan_pword(handle,7) >= scan_defs[handle] { fault = 985
                    return 0 }
                if scan_have_cell[handle] != 0 && channel < scan_last_channel[handle] { fault = 970
                    return 0 }
                if scan_counts[slot] != 0 && row <= scan_last_rows[slot] { fault = 970
                    return 0 }
                if scan_counts[slot] >= 3072 { fault = 959
                    return 0 }
                scan_counts[slot] = scan_counts[slot]+1
                scan_last_rows[slot] = row
                scan_last_channel[handle] = channel
                scan_have_cell[handle] = 1
                scan_started[handle] = 1
                if channel == selected { return 1 }
            }
        }
    }
    return 0
}
fun read_cell(lane:u8,destination:u16)->u8 {
    let base:u16 = u16(lane)*16
    if destination != u16(&mix_pool[base]) { fault = 988
        return 2 }
    let status:u8 = scan_next(lane,lane)
    if fault != 0 { return 2 }
    if status == 0 { return 0 }
    var index:u16 = 0
    while index < 16 {
        mix_pool[base+index] = scan_payload[base+index]
        index = index + 1
    }
    return 1
}
fun write_cell(lane:u8,source:u16)->u8 {
    // The kernel supplies an owned cell address; pointer never crosses a call
    // that changes paging or input ownership.
    let at:u16 = source-u16(&mix_pool)
    if at > 224 { fault = 988
        return 1 }
    if mix_pool[at+1] != lane { fault = 988
        return 1 }
    sink_put(1)
    var index:u16 = 0
    while index < 16 { sink_put(mix_pool[at+index])
        index = index + 1 }
    if fault != 0 { return 1 }
    wire_records = wire_records+1
    return 0
}
fun sink_word(value:u16) {
    sink_put(u8(value))
    sink_put(u8(value >> 8))
}
fun sink_u32(value:u32) {
    sink_word(u16(value))
    sink_word(u16(value >> 16))
}
fun wire_metadata(role:u8,channel:u8,value:u32) {
    sink_put(1)
    sink_put(role)
    sink_put(channel)
    sink_u32(value)
    var index:u8 = 6
    while index < 16 { sink_put(0)
        index = index + 1 }
    if fault == 0 { wire_records = wire_records+1 }
}
fun read_notes() {
    if cursor_open(0) != 0 { fault = 900
        return }
    let sources:u16 = scan_header(0,1,6)
    if fault == 0 && sources > 64 { fault = 954 }
    var count:u16 = 0
    var max_off:u16 = 0
    var done:u8 = 0
    var index:u16 = 0
    while index < 64 { note_seen[index] = 0
        index = index+1 }
    while done == 0 && fault == 0 {
        let tag:u8 = scan_byte(0)
        if tag == 255 {
            scan_end(0,u32(count))
            done = 1
        } else {
            if tag != 1 { fault = 955
                return }
            if count >= 2046 { fault = 959
                return }
            let start:u16 = scan_word(0)
            let off:u16 = scan_word(0)
            let pitch:u8 = scan_byte(0)
            let source:u8 = scan_byte(0)
            if fault != 0 { return }
            if pitch > 127 || u16(source) >= sources { fault = 958
                return }
            if off < start { fault = 105
                return }
            if note_seen[source] != 0 && start < note_previous[source] { fault = 106
                return }
            note_seen[source] = 1
            note_previous[source] = start
            if off > max_off { max_off = off }
            count = count+1
        }
    }
    render_rows = 0
    if count != 0 {
        var delay:u16 = delay_one
        if delay_two > delay { delay = delay_two }
        render_rows = u32(max_off)+u32(delay)
    }
}
fun disk_main()->u16 {
    fault = 0
    wire_records = 0
    render_rows = 0
    var index:u16 = 0
    if delay_one > 32 || delay_two > 32 { fault = 976
        return fault }
    var total:u16 = 0
    var group:u8 = 0
    while group < 3 {
        if mix_counts_config[group] > 3 || (mix_policies[group] != 43 && mix_policies[group] != 45) { fault = 976
            return fault }
        total = total+u16(mix_counts_config[group])
        group = group+1
    }
    if total != 3 { fault = 976
        return fault }
    while index < 11 { source_name[index] = note_name[index]
        sink_name[index] = mixed_name[index]
        index = index+1 }
    read_notes()
    if input_live[0] != 0 {
        if cursor_close(0) != 0 && fault == 0 { fault = 906 }
    }
    index = 0
    while index < 11 { source_name[index] = delayed_name[index]
        index = index+1 }
    if fault == 0 { scan_open(0) }
    if fault == 0 {
        if sink_open() != 0 { fault = 901 }
    }
    if fault == 0 {
        index = 0
        while index < 12 { sink_put(mixed_header[index])
            index = index+1 }
        scan_copy_defs = 1
        scan_next(0,3)
        scan_copy_defs = 0
    }
    if input_live[0] != 0 {
        if cursor_close(0) != 0 && fault == 0 { fault = 906 }
    }
    var handle:u8 = 0
    while handle < 3 && fault == 0 {
        scan_open(handle)
        handle = handle+1
    }
    if fault == 0 { mix_run() }
    if fault == 0 {
        handle = 0
        while handle < 3 {
            wire_metadata(2,handle,mix_extents[handle])
            handle = handle+1
        }
        wire_metadata(3,0,render_rows)
        sink_put(255)
        sink_u32(wire_records)
        index = 0
        while index < 4 { sink_put(wire_end[index])
            index = index+1 }
        sink_flush()
    }
    cursors_cleanup()
    return fault
}
