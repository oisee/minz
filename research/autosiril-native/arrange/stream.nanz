// Duplex staging: input_chunk belongs to the transport; unread bytes and
// pending output survive arbitrary reads, writes and catalog operations.
global input_chunk:[u8;256]
global reader_chunk:[u8;256]
global output_chunk:[u8;256]
global chunk_capacity:u16
global input_padding:u8
global input_padding_quantum:u16
global wire_read_position:u16
global file_length:u16
global file_cursor:u16
global output_cursor:u16
global file_header:[u8;12] = [65,83,73,82,1,3,16,0,3,0,0,0]
global wire_magic:[u8;4] = [65,83,73,82]
global wire_end_magic:[u8;4] = [69,78,68,33]

fun file_write_record() {
    if fault != 0 { return }
    var index:u16 = 0
    while index < output_cursor {
        input_chunk[index] = output_chunk[index]
        index = index + 1
    }
    let result:u32 = write_chunk(output_cursor)
    if (result >> 16) != 0 || u16(result) != output_cursor { fault = 902 }
    output_cursor = 0
}
fun file_put(byte:u8) {
    if fault != 0 { return }
    output_chunk[output_cursor] = byte
    output_cursor = output_cursor + 1
    if output_cursor == chunk_capacity { file_write_record() }
}
fun file_put_word(word:u16) {
    file_put(u8(word))
    file_put(u8(word >> 8))
}
fun read_header() {
    var index:u16 = 0
    while index < 4 {
        let byte:u8 = file_get()
        if fault != 0 { return }
        if byte != wire_magic[index] { fault = 950
            return }
        index = index + 1
    }
    let version:u8 = file_get()
    if fault != 0 { return }
    if version != 1 { fault = 952
        return }
    let kind:u8 = file_get()
    let width:u8 = file_get()
    let flags:u8 = file_get()
    let channels:u16 = file_get_word()
    let reserved:u16 = file_get_word()
    if fault != 0 { return }
    if kind != 2 || width != 5 || flags != 0 || reserved != 0 || channels != 3 { fault = 953 }
}
fun read_events() {
    var done:u8 = 0
    while done == 0 && fault == 0 {
        let tag:u8 = file_get()
        if fault != 0 { return }
        if tag == 255 {
            let low:u16 = file_get_word()
            let high:u16 = file_get_word()
            if fault != 0 { return }
            let count:u32 = u32(low) | (u32(high) << 16)
            if count != input_events { fault = 956
                return }
            var index:u16 = 0
            while index < 4 {
                let byte:u8 = file_get()
                if fault != 0 { return }
                if byte != wire_end_magic[index] { fault = 956
                    return }
                index = index + 1
            }
            file_input_end()
            if fault == 0 { arrange_group() }
            done = 1
        } else {
            if tag != 1 { fault = 955
                return }
            let channel:u8 = file_get()
            let row:u16 = file_get_word()
            let value:u16 = file_get_word()
            if fault != 0 { return }
            accept_event(channel,row,value)
        }
    }
}
fun file_save_events() {
    read_header()
    if fault != 0 { return }
    if create_output() != 0 { fault = 901
        return }
    var index:u16 = 0
    while index < 12 { file_put(file_header[index])
        index = index + 1 }
    clipped[0] = 0
    ornament_find(orn_repeat)
    read_events()
    if fault == 0 {
        file_put(255)
        file_put_word(u16(output_records))
        file_put_word(u16(output_records >> 16))
        file_put(69)
        file_put(78)
        file_put(68)
        file_put(33)
    }
    if output_cursor != 0 && fault == 0 { file_write_record() }
}
fun disk_main()->u16 {
    fault = 0
    group_open = 0
    orn_count = 0
    orn_used = 0
    input_events = 0
    output_records = 0
    lnote_count = 0
    file_cursor = 0
    file_length = 0
    output_cursor = 0
    wire_read_position = 0
    if orn_repeat == 0 || orn_repeat > 32 { fault = 83
        return fault }
    var index:u16 = 0
    while index < 3 {
        event_counts[index] = 0
        if channel_modes[index] != 109 && channel_modes[index] != 112 && channel_modes[index] != 100 { fault = 976
            return fault }
        if config_envelopes[index] > 1 { fault = 976
            return fault }
        index = index + 1
    }
    if open_input() != 0 { fault = 900
        return fault }
    if chunk_capacity == 0 || chunk_capacity > 256 || input_padding_quantum > 256 ||
        (input_padding != 0 && input_padding_quantum == 0) { fault = 910 }
    if fault == 0 { file_save_events() }
    if finish(0) != 0 && fault == 0 { fault = 906 }
    group_open = 0
    if output_open != 0 {
        if finish(1) != 0 && fault == 0 { fault = 903 }
    }
    return fault
}
