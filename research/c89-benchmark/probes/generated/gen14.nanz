global source: [u8; 256]
global other: [u8; 256]
global n: u16
global result: u16
fun mix(a: u8, b: u8) -> u8 { return a | b }
fun execute() {
    var sum: u16 = 0
    var p: ^u8 = &source
    var q: ^u8 = &other
    var i: u16 = n
    while i != 0 {
        var v: u8 = mix(p^, q^)
        if v < 40 { v = v + 1 }
        sum = sum + u16(v)
        p = p + 1
        q = q + 1
        i = i - 1
    }
    result = sum
}
