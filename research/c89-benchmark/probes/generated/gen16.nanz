global source: [u8; 768]
global other: [u8; 512]
global n: u16
global result: u16
fun mix(a: u8, b: u8) -> u8 { return a + b }
fun execute() {
    var sum: u8 = 0
    var p: ^u8 = &source
    var q: ^u8 = &other
    var i: u16 = n
    while i != 0 {
        var v: u8 = mix(p^, q^)
        if v > 100 { v = v - 1 }
        sum = sum + v
        p = p + 3
        q = q + 2
        i = i - 1
    }
    result = u16(sum)
}
