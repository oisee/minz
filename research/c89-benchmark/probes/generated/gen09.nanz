global source: [u8; 512]
global other: [u8; 768]
global n: u16
global result: u16
fun mix(a: u8, b: u8) -> u8 { return a | b }
fun execute() {
    var sum: u16 = 0
    var p: ^u8 = &source
    var q: ^u8 = &other
    var i: u16 = n
    while i != 0 {
        sum = sum + u16(mix(p^, q^))
        p = p + 2
        q = q + 3
        i = i - 1
    }
    result = sum
}
