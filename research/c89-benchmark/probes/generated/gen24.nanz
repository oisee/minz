global source: [u8; 256]
global n: u16
global result: u16
fun execute() {
    var sum: u16 = 0
    var p: ^u8 = &source
    var i: u16 = n
    while i != 0 {
        var v: u8 = (p^ + 106)
        if v > 200 { v = v - 55 }
        sum = sum + u16(v)
        p = p + 1
        i = i - 1
    }
    result = sum
}
