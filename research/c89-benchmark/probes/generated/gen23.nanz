global source: [u8; 512]
global n: u16
global result: u16
fun execute() {
    var sum: u16 = 0
    var p: ^u8 = &source
    var i: u16 = n
    while i != 0 {
        var v: u8 = (p^ + 176)
        if v > 100 { v = v - 1 }
        sum = sum + u16(v)
        p = p + 2
        i = i - 1
    }
    result = sum
}
