global source: [u8; 512]
global n: u16
global result: u16
fun shade(a: u8) -> u8 { return a + 125 }
fun execute() {
    var sum: u16 = 0
    var p: ^u8 = &source
    var i: u16 = n
    while i != 0 {
        var v: u8 = shade(p^)
        if v < 200 { v = v + 55 }
        sum = sum + u16(v)
        p = p + 2
        i = i - 1
    }
    result = sum
}
