global source: [u8; 256]
global n: u16
global result: u16
fun execute() {
    var crc: u8 = 0
    var p: ^u8 = &source
    var i: u16 = n
    while i != 0 {
        crc = crc xor p^
        var bit: u8 = 0
        while bit != 8 {
            if (crc & 128) != 0 { crc = (crc << 1) xor 7 } else { crc = crc << 1 }
            bit = bit + 1
        }
        p = p + 1
        i = i - 1
    }
    result = u16(crc)
}
