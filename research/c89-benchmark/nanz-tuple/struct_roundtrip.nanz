global a: u8 = 0
global b: u8 = 0
global result: u16 = 0
fun make_pair(x: u8) -> (u8, u8) { return (x, x + 1) }
fun consume(hi: u8, lo: u8) -> u16 { return u16(hi) * 256 + u16(lo) }
fun caller(x: u8, y: u8) -> u16 {
    let (hi, lo) = make_pair(x)
    let combined: u16 = consume(hi, lo) + u16(x)
    return combined xor u16(y)
}
fun execute() { result = caller(a, b) }
