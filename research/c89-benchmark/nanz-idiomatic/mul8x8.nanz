global a: u8 = 0
global b: u8 = 0
global result: u16 = 0
fun mul8x8(x: u8, y: u8) -> u16 {
    var multiplicand: u16 = u16(x)
    var multiplier: u8 = y
    var product: u16 = 0
    while multiplier != 0 {
        if (multiplier & 1) == 1 { product = product + multiplicand }
        multiplicand = multiplicand << 1
        multiplier = multiplier >> 1
    }
    return product
}
fun execute() { result = mul8x8(a, b) }
