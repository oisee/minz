global source: [u8; 64]
global target: [u8; 64]
global n: u8 = 0
global result: u16 = 0
fun copy_bytes(dst: ^u8, src: ^u8, count: u8) {
    var i: u8 = 0
    for value: u8 in src[0..count] {
        dst[i] = value
        i = i + 1
    }
}
fun execute() {
    copy_bytes(&target, &source, n)
    result = u16(n)
}
