global source: [u8; 256]
global n: u16
global result: u16
global other: [u8; 256]
fun execute() {
    var sum: u16 = 0
    var p: ^u8 = &source
    var q: ^u8 = &other
    var i: u16 = n
    while i != 0 {
        sum = sum + u16(p^ xor q^)
        p = p + 1
        q = q + 1
        i = i - 1
    }
    result = sum
}
