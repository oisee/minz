; Hand Z80 reference. Contract: 0 <= n <= 256; disjoint buffers.
ORG 0x8000
execute:
    LD HL,[n]
    LD DE,4
    OR A
    SBC HL,DE
    JR C,empty
    LD DE,[limit]
    OR A
    SBC HL,DE
    JR NC,use_limit
    ADD HL,DE
    JR have_count
use_limit:
    EX DE,HL
have_count:
    LD A,H
    OR L
    LD B,L
    JR Z,empty
    LD HL,source+4
    LD DE,0
loop:
    LD A,[HL]
    INC HL
    ADD A,E
    LD E,A
    JR NC,no_carry
    INC D
no_carry:
    DJNZ loop
done:
    LD [result],DE
    RET
empty:
    LD DE,0
    JR done

source:
    DS 256,0
n:
    DS 2,0
result:
    DS 2,0
limit:
    DS 2,0
