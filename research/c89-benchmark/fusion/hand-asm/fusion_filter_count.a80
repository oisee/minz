; Hand Z80 reference. Contract: 0 <= n <= 256; disjoint buffers.
ORG 0x8000
execute:
    LD HL,[n]
    LD A,H
    OR L
    LD B,L
    LD DE,0
    JR Z,done
    LD A,[k]
    LD C,A
    LD HL,source
loop:
    LD A,[HL]
    INC HL
    CP C
    JR NZ,next
    INC DE
next:
    DJNZ loop
done:
    LD [result],DE
    RET

source:
    DS 256,0
n:
    DS 2,0
result:
    DS 2,0
k:
    DS 1,0
