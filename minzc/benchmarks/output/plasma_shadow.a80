; Function: .home.alice.dev.minz.examples.plasma_shadow.main
plasma_shadow_main:
; IsSMCDefault=true, IsSMCEnabled=true
; Using absolute addressing for locals (SMC style)
    PUSH BC
    PUSH DE
    DI
    ; r1 = call .home.alice.dev.minz.examples.plasma_shadow.init_sine
    ; Call to .home.alice.dev.minz.examples.plasma_shadow.init_sine (args: 0)
    CALL shadow_init_sine
    ; Clear main screen bitmap
    LD HL, 0x4000
    LD DE, 0x4001
    LD BC, 6143
    LD (HL), 0
    LDIR
    ; Clear main screen attributes
    LD HL, 0x5800
    LD DE, 0x5801
    LD BC, 767
    LD (HL), 0x47      ; White INK on white PAPER (invisible)
    LDIR
    ; Switch to bank 7 for shadow screen
    LD A, 0x17         ; Bank 7, screen 0
    LD BC, 0x7FFD
    OUT (C), A
    ; Clear shadow screen bitmap
    LD HL, 0xC000
    LD DE, 0xC001
    LD BC, 6143
    LD (HL), 0
    LDIR
    ; Clear shadow screen attributes
    LD HL, 0xD800
    LD DE, 0xD801
    LD BC, 767
    LD (HL), 0x47
    LDIR
    ; Switch back to bank 0
    LD A, 0x10
    LD BC, 0x7FFD
    OUT (C), A
    EI
    ; loop_17:
_home_alice_dev_minz_examples_plasma_shadow_main_loop_17:
    HALT
    ; r4 = load .home.alice.dev.minz.examples.plasma_shadow.phase1
    LD HL, ($F000)
    ; store phase1, r4
    LD ($F000), HL
    ; r7 = load .home.alice.dev.minz.examples.plasma_shadow.phase2
    LD HL, ($F020)
    ; Register 7 already in HL
    ; store phase2, r7
    ; Register 7 already in HL
    LD ($F000), HL
    ; r10 = call .home.alice.dev.minz.examples.plasma_shadow.render_plasma
    ; Call to .home.alice.dev.minz.examples.plasma_shadow.render_plasma (args: 0)
    CALL shadow_render_plasma
    ; r11 = call .home.alice.dev.minz.examples.plasma_shadow.flip_display
    ; Call to .home.alice.dev.minz.examples.plasma_shadow.flip_display (args: 0)
    CALL shadow_flip_display
    ; jump loop_17
    JP _home_alice_dev_minz_examples_plasma_shadow_main_loop_17
    POP DE
    POP BC
    RET

; Standard library routines
temp_result:
    DW 0           ; Temporary storage for function results


    END main


