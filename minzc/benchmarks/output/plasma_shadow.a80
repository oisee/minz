; Function: .home.alice.dev.minz.examples.plasma_shadow.cls_all
shadow_cls_all:
; IsSMCDefault=true, IsSMCEnabled=true
; Using absolute addressing for locals (SMC style)
    ; Clear main screen bitmap
    LD HL, 0x4000
    LD DE, 0x4001
    LD BC, 6143
    LD (HL), 0
    LDIR
    ; Clear main screen attributes
    LD HL, 0x5800
    LD DE, 0x5801
    LD BC, 767
    LD (HL), 0x47      ; White INK on white PAPER (invisible)
    LDIR
    ; Switch to bank 7 for shadow screen
    LD A, 0x17         ; Bank 7, screen 0
    LD BC, 0x7FFD
    OUT (C), A
    ; Clear shadow screen bitmap
    LD HL, 0xC000
    LD DE, 0xC001
    LD BC, 6143
    LD (HL), 0
    LDIR
    ; Clear shadow screen attributes
    LD HL, 0xD800
    LD DE, 0xD801
    LD BC, 767
    LD (HL), 0x47
    LDIR
    ; Switch back to bank 0
    LD A, 0x10
    LD BC, 0x7FFD
    OUT (C), A
    ; return
    RET
; Using hierarchical register allocation (physical → shadow → memory)

; Function: .home.alice.dev.minz.examples.plasma_shadow.select_shadow_screen
select_shadow_screen:
; IsSMCDefault=true, IsSMCEnabled=true
; Using absolute addressing for locals (SMC style)
    LD A, 0x17         ; Bank 7 + screen 0 displayed
    LD BC, 0x7FFD
    OUT (C), A
    ; return
    RET
; Using hierarchical register allocation (physical → shadow → memory)

; Function: .home.alice.dev.minz.examples.plasma_shadow.select_main_screen
select_main_screen:
; IsSMCDefault=true, IsSMCEnabled=true
; Using absolute addressing for locals (SMC style)
    LD A, 0x10         ; Bank 0 + screen 0 displayed
    LD BC, 0x7FFD
    OUT (C), A
    ; return
    RET
; Using hierarchical register allocation (physical → shadow → memory)

; Function: .home.alice.dev.minz.examples.plasma_shadow.flip_display
shadow_flip_display:
; IsSMCDefault=true, IsSMCEnabled=true
; Using absolute addressing for locals (SMC style)
    ; test r1
    ; Register 1 already in HL
    LD A, H
    OR L           ; Test HL (set flags)
    ; jump_if_not r3, else_11
    LD A, L
    OR A
    JP Z, _home_alice_dev_minz_examples_plasma_shadow_flip_display_else_11   ; Test for zero
    LD A, 0x1F     ; Bank 7 + screen 1 (shadow) displayed
    LD BC, 0x7FFD
    OUT (C), A
    ; r4 = 1
    LD A, 1
    LD H, A         ; Store to physical register H
    ; store current_screen, r4
    LD ($F000), HL
    ; jump end_if_12
    JP _home_alice_dev_minz_examples_plasma_shadow_flip_display_end_if_12
    ; else_11:
_home_alice_dev_minz_examples_plasma_shadow_flip_display_else_11:
    LD A, 0x10     ; Bank 0 + screen 0 (main) displayed
    LD BC, 0x7FFD
    OUT (C), A
    ; r5 = 0
    XOR A        ; MIR hint: zero via XOR
    LD L, A         ; Store to physical register L
    ; end_if_12:
_home_alice_dev_minz_examples_plasma_shadow_flip_display_end_if_12:
    ; store current_screen, r5
    LD ($F000), HL
    ; return
    RET
; Using hierarchical register allocation (physical → shadow → memory)

; Function: .home.alice.dev.minz.examples.plasma_shadow.poke$u16$u8
poke_u16_u8:
; IsSMCDefault=true, IsSMCEnabled=true
; Using absolute addressing for locals (SMC style)
    POP HL          ; return address
    POP DE          ; addr
    POP BC          ; val in C
    PUSH HL         ; restore return
    LD A, C
    LD (DE), A
    ; return
    RET
; Using hierarchical register allocation (physical → shadow → memory)

; Function: .home.alice.dev.minz.examples.plasma_shadow.render_plasma
shadow_render_plasma:
; IsSMCDefault=false, IsSMCEnabled=true
; Using absolute addressing for locals (SMC style)
    ; test r1
    LD A, H
    OR L           ; Test HL (set flags)
    ; jump_if_not r3, else_13
    EXX               ; Switch to shadow registers
    LD A, B         ; From shadow B' (now active)
