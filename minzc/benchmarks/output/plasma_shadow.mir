Function .home.alice.dev.minz.examples.plasma_shadow.render_plasma() -> void
  @smc
  Locals:
    r6 = base: u16
    r8 = y_angle: u8
    r10 = ptr: u16
    r14 = x_angle: u8
    r18 = wave1: u8
    r22 = wave2: u8
    r26 = wave3: u8
    r32 = color: u8
    r40 = attr: u8
  Instructions:
      0: TEST
      1: jump_if_not r3, else_13
      2: ASM ; Inlined from .home.alice.dev.minz.examples.plasma_shadow.select_shadow_screen
      3: jump end_if_14
      4: else_13:
      5: ASM ; Inlined from .home.alice.dev.minz.examples.plasma_shadow.select_main_screen
      6: end_if_14:
      7: r7 = 22528
      8: store base, r7
      9: r9 = load .home.alice.dev.minz.examples.plasma_shadow.phase1
     10: store y_angle, r9
     11: r11 = load base
     12: NOP ; DJNZ OPTIMIZED: for row in 0..24
     13: djnz_loop_15:
     14: store ptr, r11
     15: r15 = load .home.alice.dev.minz.examples.plasma_shadow.phase2
     16: NOP ; DJNZ OPTIMIZED: for col in 0..32
     17: djnz_loop_16:
     18: r19 = addr(.home.alice.dev.minz.examples.plasma_shadow.sin_table)
     19: LOAD_INDEX ; Load array element (u8)
     20: r23 = addr(.home.alice.dev.minz.examples.plasma_shadow.sin_table)
     21: LOAD_INDEX ; Load array element (u8)
     22: r27 = addr(.home.alice.dev.minz.examples.plasma_shadow.sin_table)
     23: LOAD_INDEX ; Load array element (u8)
     24: store x_angle, r15
     25: store wave1, r21
     26: store wave2, r25
     27: store wave3, r31
     28: r33 = load wave1
     29: r34 = load wave2
     30: r36 = load wave3
     31: r35 = r33 + r34
     32: r37 = r35 + r36
     33: r38 = 7
     34: r39 = r37 & r38
     35: r41 = 64
     36: store color, r39
     37: r42 = load color
     38: SHL
     39: SHL
     40: SHL
     41: r45 = r41 | r44
     42: ASM ; Inlined from .home.alice.dev.minz.examples.plasma_shadow.poke$u16$u8
     43: store attr, r45
     44: r51 = load ptr
     45: r52 = 1
     46: r53 = r51 + r52
     47: store ptr, r53
     48: r54 = load x_angle
     49: r55 = 8
     50: r56 = r54 + r55
     51: INC ; Increment col
     52: DJNZ ; DJNZ - decrement B and loop
     53: store x_angle, r56
     54: r57 = load y_angle
     55: r58 = 11
     56: r59 = r57 + r58
     57: INC ; Increment row
     58: DJNZ ; DJNZ - decrement B and loop
     59: store y_angle, r59
     60: return

Function .home.alice.dev.minz.examples.plasma_shadow.main() -> void
  @smc
  Instructions:
      0: ASM
      1: r1 = call .home.alice.dev.minz.examples.plasma_shadow.init_sine
      2: ASM ; Inlined from .home.alice.dev.minz.examples.plasma_shadow.cls_all
      3: ASM
      4: loop_17:
      5: ASM
      6: r4 = load .home.alice.dev.minz.examples.plasma_shadow.phase1
      7: r5 = 3
      8: r6 = r4 + r5
      9: store phase1, r6
     10: r7 = load .home.alice.dev.minz.examples.plasma_shadow.phase2
     11: r8 = 5
     12: r9 = r7 + r8
     13: store phase2, r9
     14: r10 = call .home.alice.dev.minz.examples.plasma_shadow.render_plasma
     15: r11 = call .home.alice.dev.minz.examples.plasma_shadow.flip_display
     16: jump loop_17

