Function .home.alice.dev.minz.examples.plasma_shadow.init_sine() -> void
  @smc
  Locals:
    r5 = quadrant: u8
    r11 = pos: u8
    r15 = val: u8
  Instructions:
      0: r2 = 256
      1: r3 = r1 ; Initialize loop variable i
      2: for_loop_1:
      3: r4 = r3 < r2 ; Check i < end
      4: jump_if_not r4, for_end_2
      5: r6 = load i
      6: SHR
      7: SHR
      8: SHR
      9: SHR
     10: SHR
     11: SHR
     12: r9 = 3
     13: r10 = r8 & r9
     14: store quadrant, r10
     15: r12 = load i
     16: r13 = 63
     17: r14 = r12 & r13
     18: r16 = 0
     19: TEST
     20: store pos, r14
     21: store val, r16
     22: jump_if_not r19, else_3
     23: r20 = load pos
     24: SHR
     25: SHR
     26: SHR
     27: store val, r22
     28: jump end_if_4
     29: else_3:
     30: end_if_4:
     31: r23 = load quadrant
     32: r24 = 1
     33: r25 = r23 == r24
     34: jump_if_not r25, else_5
     35: r26 = 63
     36: r27 = load pos
     37: r28 = r26 - r27
     38: SHR
     39: SHR
     40: SHR
     41: store val, r30
     42: jump end_if_6
     43: else_5:
     44: end_if_6:
     45: r31 = load quadrant
     46: r32 = 2
     47: r33 = r31 == r32
     48: jump_if_not r33, else_7
     49: r34 = load pos
     50: SHR
     51: SHR
     52: SHR
     53: store val, r36
     54: jump end_if_8
     55: else_7:
     56: end_if_8:
     57: r37 = load quadrant
     58: r38 = 3
     59: r39 = r37 == r38
     60: jump_if_not r39, else_9
     61: r40 = 63
     62: r41 = load pos
     63: r42 = r40 - r41
     64: SHR
     65: SHR
     66: SHR
     67: store val, r44
     68: jump end_if_10
     69: else_9:
     70: end_if_10:
     71: r46 = addr(.home.alice.dev.minz.examples.plasma_shadow.sin_table)
     72: STORE_PTR ; Store to array[index] (u8)
     73: INC ; Increment i
     74: jump for_loop_1
     75: for_end_2:
     76: return

