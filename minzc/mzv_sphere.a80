    LD ($F00A), HL
    ; store a32, r4
    ; Register 4 already in HL
    LD ($F006), HL
    ; r8 = load a32
    LD HL, ($F006)
    ; r9 = load b32
    LD HL, ($F00A)
    ; r10 = r8 * r9
    ; 8-bit multiplication
    LD A, H
    LD B, A       ; B = multiplicand
    LD A, L
    LD C, A       ; C = multiplier
    LD HL, 0      ; HL = result
    LD A, C
    OR A          ; Check if multiplier is 0
    JR Z, mzv_sphere_fp_mul_i16_i16_mul_done_15
mzv_sphere_fp_mul_i16_i16_mul_loop_15:
    LD D, 0
    LD E, B
    ADD HL, DE    ; Add multiplicand to result
    DEC C
    JR NZ, mzv_sphere_fp_mul_i16_i16_mul_loop_15
mzv_sphere_fp_mul_i16_i16_mul_done_15:
    LD ($F014), HL    ; Virtual register 10 to memory
    ; store result, r10
    LD HL, ($F014)    ; Virtual register 10 from memory
    LD ($F00E), HL
    ; r13 = load result
    LD HL, ($F00E)
    ; Register 13 already in HL
    ; return r13
    ; Register 13 already in HL
    POP DE
    POP BC
    RET
; Using hierarchical register allocation (physical → shadow → memory)

; Function: mzv_sphere.fp_div$i16$i16
mzv_sphere.fp_div$i16$i16:
; TRUE SMC function with immediate anchors
fp_div_i16_i16_param_b$immOP:
    LD HL, 0       ; b anchor (will be patched)
fp_div_i16_i16_param_b$imm0 EQU fp_div_i16_i16_param_b$immOP+1
    LD ($F006), HL    ; Virtual register 3 to memory
    ; test r3
    LD HL, ($F006)    ; Virtual register 3 from memory
    LD A, H
    OR L           ; Test HL (set flags)
    ; jump_if_not r5, else_1
    EXX               ; Switch to shadow registers
    LD A, B         ; From shadow B' (now active)
    EXX               ; Switch back to main registers
    OR A
    JP Z, mzv_sphere_fp_div_i16_i16_else_1_i3   ; Test for zero
fp_div_i16_i16_param_a$immOP:
    LD HL, 0       ; a anchor (will be patched)
fp_div_i16_i16_param_a$imm0 EQU fp_div_i16_i16_param_a$immOP+1
    ; r7 = 0
    XOR A        ; MIR hint: zero via XOR
    EXX               ; Switch to shadow registers
    LD D, A         ; Store to shadow D' (now active)
    EXX               ; Switch back to main registers
    ; r8 = r6 >= r7
    ; 8-bit greater-or-equal comparison
    EXX               ; Switch to shadow registers
    LD A, C         ; From shadow C' (now active)
    EXX               ; Switch back to main registers
    LD B, A
    EXX               ; Switch to shadow registers
    LD A, D         ; From shadow D' (now active)
    EXX               ; Switch back to main registers
    LD C, A
    LD A, B       ; A = Src1
    CP C          ; Compare Src1 with Src2
    JR NC, mzv_sphere_fp_div_i16_i16_ge_true_16     ; No Carry = Src1 >= Src2
    LD HL, 0       ; False: Src1 < Src2
    JR mzv_sphere_fp_div_i16_i16_ge_done_16
mzv_sphere_fp_div_i16_i16_ge_true_16:
    LD HL, 1       ; True
mzv_sphere_fp_div_i16_i16_ge_done_16:
    ; jump_if_not r8, else_3
    EXX               ; Switch to shadow registers
    LD A, E         ; From shadow E' (now active)
    EXX               ; Switch back to main registers
    OR A
    JP Z, mzv_sphere_fp_div_i16_i16_else_3_i3   ; Test for zero
    ; r9 = 32767
    LD HL, 32767
    ; Register 9 already in HL
    ; return r9
    ; Register 9 already in HL
    POP DE
    POP BC
    RET
    ; else_3:
mzv_sphere_fp_div_i16_i16_else_3_i3:
    ; Folded: 
    LD A, -32768
    LD H, A         ; Store to physical register H
    ; return r11
    POP DE
    POP BC
    RET
    ; else_1:
mzv_sphere_fp_div_i16_i16_else_1_i3:
    LD HL, (a$imm0)   ; Reuse from anchor
    LD ($F01A), HL    ; Virtual register 13 to memory
    LD HL, (b$imm0)   ; Reuse from anchor
    ; Register 15 already in HL
    ; store b32, r15
    ; Register 15 already in HL
    LD ($F01C), HL
    ; store a32, r13
    LD HL, ($F01A)    ; Virtual register 13 from memory
    LD ($F018), HL
    ; r17 = load a32
    LD HL, ($F018)
    ; Register 17 already in HL
    ; r20 = load b32
    LD HL, ($F01C)
    ; r21 = r17 / r20
    ; 8-bit division
    LD A, L
    LD D, A       ; D = dividend
    LD A, H
    LD E, A       ; E = divisor
    OR A          ; Check for divide by zero
    JR Z, mzv_sphere_fp_div_i16_i16_div_by_zero_17
    LD B, 0       ; B = quotient
    LD A, D       ; A = remainder
mzv_sphere_fp_div_i16_i16_div_loop_17:
    CP E          ; Compare remainder with divisor
    JR C, mzv_sphere_fp_div_i16_i16_div_done_17
    SUB E         ; Subtract divisor
    INC B         ; Increment quotient
    JR mzv_sphere_fp_div_i16_i16_div_loop_17
mzv_sphere_fp_div_i16_i16_div_by_zero_17:
    LD B, 0       ; Return 0 for divide by zero
mzv_sphere_fp_div_i16_i16_div_done_17:
    LD L, B       ; Result in L
    LD H, 0
    LD ($F02A), HL    ; Virtual register 21 to memory
    ; store result, r21
    LD HL, ($F02A)    ; Virtual register 21 from memory
    LD ($F020), HL
    ; r22 = load result
    LD HL, ($F020)
    ; Register 22 already in HL
    ; return r22
    ; Register 22 already in HL
    POP DE
    POP BC
    RET
; Using hierarchical register allocation (physical → shadow → memory)

; Function: mzv_sphere.fp_sqrt$i16
mzv_sphere.fp_sqrt$i16:
; TRUE SMC function with immediate anchors
fp_sqrt_i16_param_x$immOP:
    LD HL, 0       ; x anchor (will be patched)
fp_sqrt_i16_param_x$imm0 EQU fp_sqrt_i16_param_x$immOP+1
    ; Register 2 already in HL
    ; r3 = 0
    XOR A        ; MIR hint: zero via XOR
    LD L, A         ; Store to HL (low byte)
    ; r4 = r2 <= r3
    ; Register 2 already in HL
    LD D, H
    LD E, L
    OR A           ; Clear carry
    SBC HL, DE     ; Compare Src1 - Src2
    JP M, mzv_sphere_fp_sqrt_i16_le_true_18
    JP Z, mzv_sphere_fp_sqrt_i16_le_true_18
    LD HL, 0       ; False
    JP mzv_sphere_fp_sqrt_i16_le_done_18
mzv_sphere_fp_sqrt_i16_le_true_18:
    LD HL, 1       ; True
mzv_sphere_fp_sqrt_i16_le_done_18:
    ; jump_if_not r4, else_5
    LD A, H
    OR A
    JP Z, mzv_sphere_fp_sqrt_i16_else_5_i4   ; Test for zero
    ; r5 = 0
    XOR A        ; MIR hint: zero via XOR
    LD L, A         ; Store to physical register L
    ; return r5
    POP DE
    POP BC
    RET
    ; else_5:
mzv_sphere_fp_sqrt_i16_else_5_i4:
    LD HL, (x$imm0)   ; Reuse from anchor
    ; r9 = r7 >> r0
    ; Shift right
    LD A, H
    LD B, A       ; B = value to shift
    LD A, ($F000)     ; Virtual register 0 from memory
    LD C, A       ; C = shift count
    LD A, B       ; A = value
    OR A          ; Clear carry
    JR Z, mzv_sphere_fp_sqrt_i16_shr_done_19
    LD B, C       ; B = counter
mzv_sphere_fp_sqrt_i16_shr_loop_19:
    DEC B
    JP M, mzv_sphere_fp_sqrt_i16_shr_done_19
    SRL A         ; Shift right, 0 into bit 7
    JR mzv_sphere_fp_sqrt_i16_shr_loop_19
mzv_sphere_fp_sqrt_i16_shr_done_19:
    LD L, A
    LD H, 0
    LD ($F012), HL    ; Virtual register 9 to memory
    ; test r10
    ; Register 10 already in HL
    LD A, H
    OR L           ; Test HL (set flags)
    ; store guess, r9
    LD HL, ($F012)    ; Virtual register 9 from memory
    LD ($F00C), HL
    ; jump_if_not r12, else_7
    LD A, L
    OR A
    JP Z, mzv_sphere_fp_sqrt_i16_else_7_i4   ; Test for zero
    ; r13 = 1
    LD A, 1
    LD H, A         ; Store to physical register H
    ; store guess, r13
    LD ($F00C), HL
    ; jump end_if_8
    JP mzv_sphere_fp_sqrt_i16_end_if_8_i4
    ; else_7:
mzv_sphere_fp_sqrt_i16_else_7_i4:
    ; end_if_8:
mzv_sphere_fp_sqrt_i16_end_if_8_i4:
    ; r14 = load guess
    LD HL, ($F00C)
    ; Register 14 already in HL
    ; r15 = 256
    LD HL, 256
    LD ($F01E), HL    ; Virtual register 15 to memory
    ; r16 = r14 > r15
    ; Register 14 already in HL
    LD HL, ($F01E)    ; Virtual register 15 from memory
    EX DE, HL
    OR A           ; Clear carry
    SBC HL, DE     ; Compare Src1 - Src2
    JP P, mzv_sphere_fp_sqrt_i16_gt_check_zero_20
    LD HL, 0       ; False (negative)
    JP mzv_sphere_fp_sqrt_i16_gt_done_20
mzv_sphere_fp_sqrt_i16_gt_check_zero_20:
    LD A, H
    OR L           ; Check if result is zero
    JP Z, mzv_sphere_fp_sqrt_i16_gt_false_20
    LD HL, 1       ; True (positive and non-zero)
    JP mzv_sphere_fp_sqrt_i16_gt_done_20
mzv_sphere_fp_sqrt_i16_gt_false_20:
    LD HL, 0       ; False (zero)
mzv_sphere_fp_sqrt_i16_gt_done_20:
    ; Register 16 already in HL
    ; jump_if_not r16, else_9
    LD A, L
    OR A
    JP Z, mzv_sphere_fp_sqrt_i16_else_9_i4   ; Test for zero
    ; r17 = 256
    LD HL, 256
    LD ($F022), HL    ; Virtual register 17 to memory
    ; store guess, r17
    LD HL, ($F022)    ; Virtual register 17 from memory
    LD ($F00C), HL
    ; jump end_if_10
    JP mzv_sphere_fp_sqrt_i16_end_if_10_i4
    ; else_9:
mzv_sphere_fp_sqrt_i16_else_9_i4:
    ; end_if_10:
mzv_sphere_fp_sqrt_i16_end_if_10_i4:
    ; r19 = 0
    XOR A        ; MIR hint: zero via XOR
    LD H, A         ; Store to physical register H
    ; store i, r19
    LD A, H
    LD ($F024), A
    ; loop_11:
mzv_sphere_fp_sqrt_i16_loop_11_i4:
    ; r20 = load i
    LD A, ($F024)
    LD ($F028), A     ; Virtual register 20 to memory
    ; r21 = 6
    LD A, 6
    LD H, A         ; Store to physical register H
    ; r22 = r20 < r21
    ; 8-bit less-than comparison
    LD A, ($F028)     ; Virtual register 20 from memory
    LD B, A
    LD A, H
    LD C, A
    LD A, B       ; A = Src1
    CP C          ; Compare Src1 with Src2
    JR C, mzv_sphere_fp_sqrt_i16_lt_true_21      ; Carry = Src1 < Src2
    LD HL, 0       ; False
    JR mzv_sphere_fp_sqrt_i16_lt_done_21
mzv_sphere_fp_sqrt_i16_lt_true_21:
    LD HL, 1       ; True
mzv_sphere_fp_sqrt_i16_lt_done_21:
    ; jump_if_not r22, end_loop_12
    LD A, L
    OR A
    JP Z, mzv_sphere_fp_sqrt_i16_end_loop_12_i4   ; Test for zero
    ; r28 = call mzv_sphere.fp_div$i16$i16

    ; *** SMC ANNOTATED CALL to mzv_sphere.fp_div$i16$i16 ***
    ; Pattern: store_u8, Dest: temp_result
    LD A, #00               ; NOP opcode
    LD (fp_div_i16_i16_return_patch.op), A
    LD HL, temp_result
    LD (fp_div_i16_i16_store_addr), HL
    LD HL, ($F034)    ; Virtual register 26 from memory
    LD (fp_div_i16_i16_param_a+1), HL  ; Patch a
    LD HL, ($F036)    ; Virtual register 27 from memory
    LD (fp_div_i16_i16_param_b+1), HL  ; Patch b
    CALL fp_div_i16_i16
    ; Register 28 already in HL
    ; *** END SMC CALL ***

    ; store temp_result, r28
    ; Register 28 already in HL
    LD ($F000), HL
    ; store div_result, r28
    ; Register 28 already in HL
    LD ($F02E), HL
    ; r29 = load guess
    LD HL, ($F00C)
    ; Register 29 already in HL
    ; r30 = load div_result
    LD HL, ($F02E)
    ; r31 = r29 + r30
    ; Register 29 already in HL
    LD D, H
    LD E, L
    ADD HL, DE
    ; r33 = r31 >> r0
    ; Shift right
    LD A, H
    LD B, A       ; B = value to shift
    LD A, ($F000)     ; Virtual register 0 from memory
    LD C, A       ; C = shift count
    LD A, B       ; A = value
    OR A          ; Clear carry
    JR Z, mzv_sphere_fp_sqrt_i16_shr_done_22
    LD B, C       ; B = counter
mzv_sphere_fp_sqrt_i16_shr_loop_22:
    DEC B
    JP M, mzv_sphere_fp_sqrt_i16_shr_done_22
    SRL A         ; Shift right, 0 into bit 7
    JR mzv_sphere_fp_sqrt_i16_shr_loop_22
mzv_sphere_fp_sqrt_i16_shr_done_22:
    LD L, A
    LD H, 0
    ; test r34
    LD HL, ($F044)    ; Virtual register 34 from memory
    LD A, H
    OR L           ; Test HL (set flags)
    ; store guess, r33
    LD ($F00C), HL
    ; jump_if_not r36, else_13
    LD A, L
    OR A
    JP Z, mzv_sphere_fp_sqrt_i16_else_13_i4   ; Test for zero
    ; r37 = 1
    LD A, 1
    LD L, A         ; Store to physical register L
    ; store guess, r37
    LD ($F00C), HL
    ; jump end_if_14
    JP mzv_sphere_fp_sqrt_i16_end_if_14_i4
    ; else_13:
mzv_sphere_fp_sqrt_i16_else_13_i4:
    ; end_if_14:
mzv_sphere_fp_sqrt_i16_end_if_14_i4:
    ; r38 = load i
    LD A, ($F024)
    LD L, A         ; Store to HL (low byte)
    ; store i, r38
    LD A, L
    LD ($F024), A
    ; jump loop_11
    JP mzv_sphere_fp_sqrt_i16_loop_11_i4
    ; end_loop_12:
mzv_sphere_fp_sqrt_i16_end_loop_12_i4:
    ; r41 = load guess
    LD HL, ($F00C)
    ; return r41
    POP DE
    POP BC
    RET

; TRUE SMC PATCH-TABLE
; Format: DW anchor_addr, DB size, DB param_tag
PATCH_TABLE:
    DW fp_mul_i16_i16_param_a$imm0           ; mzv_sphere.fp_mul$i16$i16.a
    DB 2              ; Size in bytes
    DB 0              ; Reserved for param tag
    DW fp_mul_i16_i16_param_b$imm0           ; mzv_sphere.fp_mul$i16$i16.b
    DB 2              ; Size in bytes
    DB 0              ; Reserved for param tag
    DW fp_div_i16_i16_param_a$imm0           ; mzv_sphere.fp_div$i16$i16.a
    DB 2              ; Size in bytes
    DB 0              ; Reserved for param tag
    DW fp_div_i16_i16_param_b$imm0           ; mzv_sphere.fp_div$i16$i16.b
    DB 2              ; Size in bytes
    DB 0              ; Reserved for param tag
    DW fp_sqrt_i16_param_x$imm0           ; mzv_sphere.fp_sqrt$i16.x
    DB 2              ; Size in bytes
    DB 0              ; Reserved for param tag
    DW 0              ; End of table
PATCH_TABLE_END:

; Standard library routines
temp_result:
    DW 0           ; Temporary storage for function results

cls:
    LD HL, $4000       ; Screen start
    LD DE, $4001
    LD BC, $17FF       ; Screen size - 1
    LD (HL), 0
    LDIR               ; Clear screen
    LD HL, $5800       ; Attribute start
    LD DE, $5801
    LD BC, $02FF       ; Attribute size - 1
    LD (HL), $38       ; White ink on black paper
    LDIR               ; Clear attributes
    RET

zx_clear_screen:
    JP cls             ; Use standard cls

zx_set_pixel:
    ; TODO: Implement pixel setting
    ; For now, just return
    RET


    END


; Assembly peephole optimization: 3 patterns applied