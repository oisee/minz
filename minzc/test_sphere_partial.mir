; Module: main

Function test_sphere_partial.fp_mul$i16$i16(a: i16, b: i16) -> i16
  @smc
  Locals:
    r3 = a32: i32
    r5 = b32: i32
    r7 = result: i32
  Instructions:
      0: unknown op 33
      1: unknown op 33
      2: store b32, r6
      3: store a32, r4
      4: r8 = load a32
      5: r9 = load b32
      6: r10 = r8 * r9
      7: r11 = 8
      8: r12 = r10 >> r11
      9: store result, r12
     10: r13 = load result
     11: return r13

Function test_sphere_partial.fp_div$i16$i16(a: i16, b: i16) -> i16
  @smc
  Locals:
    r12 = a32: i32
    r14 = b32: i32
    r16 = result: i32
  Instructions:
      0: unknown op 33
      1: test r3
      2: jump_if_not r5, else_1
      3: unknown op 33
      4: r7 = 0
      5: r8 = r6 >= r7
      6: jump_if_not r8, else_3
      7: r9 = 32767
      8: return r9
      9: else_3:
     10: r11 = -32768
     11: return r11
     12: else_1:
     13: unknown op 33
     14: unknown op 33
     15: store b32, r15
     16: store a32, r13
     17: r17 = load a32
     18: r20 = load b32
     19: r18 = 8
     20: r19 = r17 << r18
     21: r21 = r19 / r20
     22: store result, r21
     23: r22 = load result
     24: return r22

Function test_sphere_partial.main() -> void
  @smc
  Locals:
    r1 = x: i16
    r3 = y: i16
    r5 = z: i16
  Instructions:
      0: r2 = 10
      1: r4 = 20
      2: patch_template store_u8
      3: patch_target temp_result
      4: patch_param a
      5: patch_param b
      6: store x, r2
      7: store y, r4
      8: r10 = call test_sphere_partial.fp_mul$i16$i16
      9: store z, r10
     10: return

