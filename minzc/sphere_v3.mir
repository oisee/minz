     36: r32 = r30 * r31
     37: r35 = r33 * r34
     38: r36 = r32 + r35
     39: store dist_sq, r36
     40: r37 = load dist_sq
     41: r38 = 3600
     42: r39 = r37 < r38
     43: jump_if_not r39, else_5
     44: r40 = load dist_sq
     45: r41 = 1600
     46: r42 = r40 < r41
     47: jump_if_not r42, else_7
     48: r0 = r45
