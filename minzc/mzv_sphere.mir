      0: TRUE_SMC_LOAD ; Load from anchor a$imm0
      1: TRUE_SMC_LOAD ; Load from anchor b$imm0
      2: store b32, r6
      3: store a32, r4
      4: r8 = load a32
      5: r9 = load b32
      6: r10 = r8 * r9
      7: r11 = 8
      8: SHR
      9: store result, r12
     10: r13 = load result
     11: return r13

