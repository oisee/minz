fun signed_return(x: i8) -> i16 {
return x
}
fun signed_identity(x: i16) -> i16 {
return x
}
fun signed_relay(x: i8) -> i16 {
return signed_identity(x)
}
fun fuzz_entry(a: u16, b: u16, c: u16) -> u16 {
var x: i16 = (a as i16)
var y: i16 = (b as i16)
var z: i8 = (c as i8)
var w: i16 = z
w = z
x = (x + signed_return(z))
y = (y + signed_relay(z))
if z >= x {
w = signed_identity(z)
} else {
w = (w + -1)
}
if y < z {
w = signed_identity(z)
} else {
w = (w + -1)
}
if x > -32768 {
x = (x % -32768)
} else {
x = (x + -32768)
}
if z >= -3 {
z = (z / -3)
} else {
z = (z + -3)
}
if y <= -7 {
y = (y - -7)
} else {
y = (z + -7)
}
if y < -255 {
y = (y + -255)
} else {
y = (y + -255)
}
return ((((x as u16) xor (y as u16)) + (z as u16)) xor (w as u16))
}
fun g() -> u16 { return fuzz_entry(24, 50880, 299) }
assert fuzz_entry(24, 50880, 299) == 50569 via z80
