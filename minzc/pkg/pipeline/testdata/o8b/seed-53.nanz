fun signed_return(x: i8) -> i16 {
return x
}
fun signed_identity(x: i16) -> i16 {
return x
}
fun signed_relay(x: i8) -> i16 {
return signed_identity(x)
}
fun fuzz_entry(a: u16, b: u16, c: u16) -> u16 {
var x: i16 = (a as i16)
var y: i16 = (b as i16)
var z: i8 = (c as i8)
var w: i16 = z
w = z
x = (x + signed_return(z))
y = (y + signed_relay(z))
if z == x {
w = signed_identity(z)
} else {
w = (w + -1)
}
if y <= z {
w = signed_identity(z)
} else {
w = (w + -1)
}
if z != -128 {
z = (z / -128)
} else {
z = (z + -128)
}
if z != -3 {
z = (z / -3)
} else {
z = (z + -3)
}
if x > -1 {
x = (x - -1)
} else {
x = (z + -1)
}
if x <= -128 {
x = (x + -128)
} else {
x = (x + -128)
}
if y <= -7 {
y = (y / -7)
} else {
y = (x + -7)
}
if x == -3 {
x = (x * -3)
} else {
x = (z + -3)
}
return ((((x as u16) xor (y as u16)) + (z as u16)) xor (w as u16))
}
fun g() -> u16 { return fuzz_entry(48363, 27352, 237) }
assert fuzz_entry(48363, 27352, 237) == 65390 via z80
