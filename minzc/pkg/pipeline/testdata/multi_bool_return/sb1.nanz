struct B4 { a: bool, b: bool, c: bool, d: bool }
fun mk(x: u8) -> B4 { return B4{a: (x & 1) == 1, b: (x & 2) == 2, c: (x & 4) != 0, d: (x & 8) != 0} }
fun probe(x: u8) -> u8 { let b: B4 = mk(x)
  var n: u8 = 0
  if b.a { n = n + 1 }
  if b.b { n = n + 2 }
  if b.c { n = n + 4 }
  if b.d { n = n + 8 }
  return n }
assert probe(4) == 4 via mir2
assert probe(4) == 4 via z80
assert probe(8) == 8 via z80
assert probe(0) == 0 via z80
