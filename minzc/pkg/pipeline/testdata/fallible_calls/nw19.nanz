// nvar2.py seed 19 (reviewer repro nw19). Bug B, as nw2.nanz.
assert run(0, 0) == 25
assert run(3, 5) == 66
assert run(15, 15) == 196
assert run(200, 7) == 92
assert run(9, 250) == 254
assert run(16, 31) == 248
assert run(77, 129) == 50
global g1: u8 = 0
global g2: u8 = 0
global w: u16 = 0
global buf: [u8; 16]
global buf2: [u8; 16]
global port: u8 = 0

fun put(p: ^u8, i: u8, v: u8) -> u8 {
    if i > 15 { @error(9) }
    p[i & 15] = v
    g1 = v
    return v + i
}

fun pk(p: ^u8, i: u8) -> u16 {
    let lo: u8 = p[i & 15]
    let hi: u8 = p[(i + 1) & 15]
    g2 = lo
    return u16(hi) | (u16(lo) << 8)
}

fun run(a: u8, b: u8) -> u8 {
    var k: u8 = 0
    while k < 16 {
        buf[k] = k * 7 + 3
        buf2[k] = k * 5 + 1
        k = k + 1
    }
    var x: u8 = put(&buf, (a & 11) & 15, b)
    @propagate
    g2 = x
    port = b
    var y: u8 = put(&buf, (b & 11) & 15, x)
    @propagate
    w = 0
    w = w + pk(&buf2, x)
    w = w + pk(&buf, x)
    w = w + pk(&buf2, b)
    return y + g1 + g2 + port + u8(w >> 8) + u8(w) + b
}

