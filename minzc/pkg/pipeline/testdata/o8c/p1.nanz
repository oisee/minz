fun pc(x0: u8) -> u8 {
 var x: u8 = x0
 var n: u8 = 0
 while x != 0 {
  if (x & 1) != 0 { n = n + 1 }
  x = x >> 1
 }
 return n
}
assert pc(0) == 0 via mir2
assert pc(0) == 0 via z80
assert pc(1) == 1 via mir2
assert pc(1) == 1 via z80
