fun nest2(x: u8, k: u8) -> u8 {
 var y: u8 = x
 for i in 0..4 {
  if (y & 0x80) != 0 {
   y = (y << 1) xor k
   if (y & 0x80) != 0 { y = (y << 1) xor 1 } else { y = y << 1 }
  } else { y = y << 1 }
 }
 return y
}
