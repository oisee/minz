fun mul8(a0: u8, b: u8) -> u16 {
 var a: u16 = a0 as u16
 var m: u8 = b
 var acc: u16 = 0
 for i in 0..8 {
  if (m & 1) != 0 { acc = acc + a }
  a = a << 1
  m = m >> 1
 }
 return acc
}
