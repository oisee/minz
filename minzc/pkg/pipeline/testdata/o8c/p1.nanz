fun press(a: u8, b: u8) -> u8 {
 var x: u8 = a
 var p: u8 = 0
 var q: u8 = 1
 var r: u8 = 2
 var s: u8 = 3
 for i in 0..8 {
  if (x & 0x80) != 0 { x = (x << 1) xor b
   p = p + i } else { x = x << 1
   q = q xor i }
  r = r + p
  s = s + q + x
 }
 return x + p + q + r + s
}
