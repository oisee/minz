fun nest(x: u8, k: u8) -> u8 {
 var y: u8 = 0
 if (x & 0x80) != 0 {
  if (x & 0x40) != 0 { y = (x << 1) xor k } else { y = (x << 1) + k }
 } else { y = x << 1 }
 return y
}
