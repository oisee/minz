fun crc8(x0: u8, k: u8) -> u8 {
 var x: u8 = x0
 var i: u8 = 0
 while i < 8 {
  if (x & 0x80) != 0 { x = (x << 1) xor k } else { x = x << 1 }
  i = i + 1
 }
 return x
}
