fun mul8b(a0: u8, b: u8) -> u8 {
 var a: u8 = a0
 var m: u8 = b
 var acc: u8 = 0
 while m != 0 {
  if (m & 1) != 0 { acc = acc + a }
  m = m >> 1
  a = a << 1
 }
 return acc
}
