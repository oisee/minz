global g: u8 = 0
fun glob(x: u8, k: u8) -> u8 {
 g = 0
 var a: u8 = x
 var m: u8 = k
 while m != 0 {
  if (m & 1) != 0 { g = g + a }
  m = m >> 1
  a = a + 1
 }
 return g
}
