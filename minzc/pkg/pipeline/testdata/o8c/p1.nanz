fun crc16(x0: u16, n: u8) -> u16 {
 var x: u16 = x0
 var i: u8 = 0
 while i < n {
  if (x & 0x8000) != 0 { x = (x << 1) xor 0x1021 } else { x = x << 1 }
  i = i + 1
 }
 return x
}
