fun lc(a: u8, b: u8) -> u8 {
 var m: u8 = b
 var acc: u8 = 0
 while m != 0 {
  if (m & 1) != 0 { acc = acc + a + m }
  m = m >> 1
  acc = acc xor m
 }
 return acc
}
