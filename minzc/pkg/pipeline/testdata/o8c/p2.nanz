fun same(x0: u8, a: u8, b: u8) -> u8 {
 var x: u8 = x0
 var p: u8 = 0
 if (x & 0x80) != 0 { x = x << 1
  p = a } else { x = x << 1
  p = b }
 return x + p
}
assert same(0x81, 3, 5) == 5 via mir2
assert same(0x81, 3, 5) == 5 via z80
assert same(0x41, 3, 5) == 135 via mir2
assert same(0x41, 3, 5) == 135 via z80
assert same(0xff, 0x10, 0x20) == 14 via z80
assert same(0x7f, 0x10, 0x20) == 30 via z80

fun same2(x0: u8, a: u8, b: u8, n: u8) -> u8 {
 var x: u8 = x0
 var p: u8 = 0
 var q: u8 = 1
 for i in 0..n {
  if (x & 0x80) == 0 { x = x << 1
   p = q
   q = a } else { x = x << 1
   p = a
   q = p }
 }
 return x + p + q
}
assert same2(0x81, 3, 5, 1) == 8 via mir2
assert same2(0x81, 3, 5, 1) == 8 via z80
assert same2(0x81, 3, 5, 2) == 10 via mir2
assert same2(0x81, 3, 5, 2) == 10 via z80
assert same2(0x5a, 3, 5, 7) == 6 via mir2
assert same2(0x5a, 3, 5, 7) == 6 via z80

fun same16(x0: u16, a: u16, b: u16, n: u8) -> u16 {
 var x: u16 = x0
 var p: u16 = 0
 var q: u16 = 1
 for i in 0..n {
  if (x & 0x8000) == 0 { x = x << 1
   p = q
   q = a } else { x = x << 1
   p = b
   q = p }
 }
 return x + p + q
}
assert same16(0x8001, 3, 5, 1) == 12 via mir2
assert same16(0x8001, 3, 5, 1) == 12 via z80
assert same16(0x5a5a, 3, 5, 9) == 46086 via mir2
assert same16(0x5a5a, 3, 5, 9) == 46086 via z80
