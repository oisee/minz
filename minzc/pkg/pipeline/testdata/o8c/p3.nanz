
global buf: [u8; 4]
global gv: u8 = 0
fun shrbit(x: u8, k: u8) -> u8 {
 let y: u8 = x >> 3
 var r: u8 = 0
 if (y & 1) != 0 { r = (y >> 1) xor k } else { r = y >> 1 }
 return r
}
fun ldg(x: u8, k: u8) -> u8 {
 gv = x
 var r: u8 = 0
 if (gv & 0x80) != 0 { r = (gv << 1) xor k } else { r = gv << 1 }
 return r
}
fun ldp(x: u8, k: u8) -> u8 {
 buf[1] = x
 let p: ^u8 = &buf[1]
 var r: u8 = 0
 let v: u8 = p^
 if (v & 0x80) != 0 { r = (v << 1) xor k } else { r = v << 1 }
 return r
}
fun ldp2(x: u8, k: u8) -> u8 {
 buf[2] = x
 var r: u8 = 0
 var i: u8 = 0
 while i < 8 {
  let v: u8 = buf[2]
  if (v & 0x80) != 0 { buf[2] = (v << 1) xor k } else { buf[2] = v << 1 }
  i = i + 1
 }
 return buf[2]
}
fun bitret(x: u8) -> bool {
 let y: u8 = x << 1
 gv = y
 return (x & 0x80) != 0
}
fun twotest(x: u8, k: u8) -> u8 {
 var r: u8 = 0
 if (x & 0x80) != 0 { r = (x << 1) xor k } else { r = x << 1 }
 if (x & 0x80) != 0 { r = r + 1 }
 return r
}
fun shtwice(x: u8, k: u8) -> u8 {
 var r: u8 = 0
 let a: u8 = x << 1
 let b: u8 = a << 1
 if (x & 0x80) != 0 { r = b xor k } else { r = b + a }
 return r
}
fun shtw2(x: u8, k: u8) -> u8 {
 var r: u8 = 0
 let a: u8 = x << 1
 if (a & 0x80) != 0 { r = (a << 1) xor k } else { r = (a << 1) + x }
 return r
}

