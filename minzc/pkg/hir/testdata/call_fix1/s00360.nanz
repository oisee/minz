fun entry(a: u16, b: u8) -> u16 {
  let v1: u8 = b
  let v2: u16 = a
  let v3: u8 = b
  let v4: u8 = (h1(b) xor h0(v3, b, v3))
  let res: u16 = v2 xor (v4 as u16) xor (b as u16) xor a xor (v1 as u16) xor (v3 as u16)
  return res
}
fun h1(p0: u8) -> u8 {
  let l0: u16 = (p0 as u16)
  if p0 < p0 {
    return p0
  }
  return h0(p0, p0, (l0 as u8))
}
fun h0(p0: u8, p1: u8, p2: u8) -> u8 {
  if 60 < p1 {
    return (p2 * p1)
  }
  return (p1 & 220)
}
assert entry(50279, 106) == 106 via z80
assert entry(36252, 31) == 31 via z80
