fun entry(a: u16, b: u8, c: u16, d: u8) -> u16 {
  let v1: u16 = (a | (c | a))
  let v2: u16 = h0((a as u8), (v1 as u8), b)
  let v3: u16 = (v1 | ((d as u16) & (b as u16)))
  let v4: u8 = (100 + (d | b))
  let res: u16 = v1 xor c xor (b as u16) xor (d as u16) xor (v4 as u16) xor v3
  return res
}
fun h0(p0: u8, p1: u8, p2: u8) -> u16 {
  if (p0 as u16) < 20755 {
    return ((p0 as u16) + (2 & 2))
  }
  return (p2 as u16)
}
fun h1(p0: u16) -> u16 {
  let l0: u8 = 252
  if p0 < (l0 as u16) {
    return (p0 | p0)
  }
  return p0
}
assert entry(13086, 65, 16638, 97) == 16410 via z80
assert entry(15022, 164, 15019, 240) == 15015 via z80
