fun h1(p0: u16, p1: u16) -> u16 {
  if p0 < p1 {
    return p0
  }
  return 1
}
fun h0(p0: u8) -> u8 {
  let l0: u8 = (p0 & (p0 & 5))
  if p0 < l0 {
    return p0
  }
  return 195
}
fun entry(a: u16, b: u8) -> u16 {
  let v1: u16 = a
  let v2: u8 = b
  let v3: u8 = h0(v2)
  let res: u16 = (b as u16) xor a xor (v2 as u16) xor v1 xor (v3 as u16)
  return res
}
assert entry(2488, 224) == 195 via z80
assert entry(54001, 185) == 195 via z80
