fun h0(p0: u8) -> u8 {
  let l0: u8 = (p0 | 5)
  if l0 < l0 {
    return p0
  }
  return l0
}
fun entry(a: u16, b: u8) -> u16 {
  let v3: u8 = ((a as u8) & h1(b, a))
  let v6: u8 = (v3 * v3)
  let res: u16 = a xor (v6 as u16) xor (v3 as u16) xor (b as u16)
  return res
}
fun h1(p0: u8, p1: u16) -> u8 {
  let l1: u8 = (p0 xor p0)
  let l2: u16 = p1
  if p0 < p0 {
    return (p0 + l1)
  }
  return (p1 as u8)
}
assert entry(44237, 183) == 44190 via z80
assert entry(42935, 68) == 42901 via z80
