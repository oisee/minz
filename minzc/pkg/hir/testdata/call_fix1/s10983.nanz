fun h3(p0: u8, p1: u16, p2: u16) -> u16 {
  if p1 < p2 {
    return ((p2 & p2) + p1)
  }
  return p2
}
fun h1(p0: u16, p1: u16, p2: u8) -> u16 {
  let l0: u8 = (p0 as u8)
  if p0 < p1 {
    return p0
  }
  return (3 - p1)
}
fun h2(p0: u16) -> u16 {
  let l1: u8 = (p0 as u8)
  if (l1 as u16) < p0 {
    return p0
  }
  return p0
}
fun entry(a: u16, b: u8, c: u16, d: u8) -> u16 {
  let v2: u8 = h0(h0(b, b, c), (c as u8), c)
  let v3: u8 = (h0(b, v2, (b as u16)) - (a as u8))
  let v4: u8 = d
  let res: u16 = (v4 as u16) xor a xor (v3 as u16) xor (b as u16) xor (v2 as u16) xor (d as u16)
  return res
}
fun h0(p0: u8, p1: u8, p2: u16) -> u8 {
  if p1 < p0 {
    return p0
  }
  return ((p1 + p0) - p0)
}
assert entry(29051, 150, 4946, 50) == 29024 via z80
assert entry(7484, 73, 14871, 235) == 7473 via z80
