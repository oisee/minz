fun entry(a: u16, b: u8) -> u16 {
  let v1: u8 = ((b + (a as u8)) | (113 + b))
  let v2: u16 = a
  let v3: u8 = h1(v2, v2)
  let v4: u8 = h1(a, a)
  let res: u16 = (v1 as u16) xor (v4 as u16) xor (v3 as u16) xor (b as u16) xor a xor v2
  return res
}
fun h0(p0: u16, p1: u16) -> u16 {
  let l0: u8 = (p1 as u8)
  if p1 < p1 {
    return ((57739 & 0) | (p0 / 7))
  }
  return (p0 - 40795)
}
fun h1(p0: u16, p1: u16) -> u8 {
  if (p0 as u8) < 3 {
    return 37
  }
  return 100
}
