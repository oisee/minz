fun h0(p0: u16, p1: u8, p2: u8) -> u16 {
  let l0: u16 = p0
  let l1: u16 = (l0 & l0)
  if l1 < (p2 as u16) {
    return l0
  }
  return l1
}
fun entry(a: u16, b: u8) -> u16 {
  let v4: u16 = ((a + a) | (b as u16))
  let v5: u16 = a
  let v6: u8 = ((b - b) + b)
  let res: u16 = (v6 as u16) xor a xor (b as u16) xor v5 xor v4
  return res
}
fun h2(p0: u16, p1: u8, p2: u16) -> u16 {
  let l3: u8 = (p1 | (p1 - p1))
  if p0 < p0 {
    return (p2 / (p2 | 1))
  }
  return 255
}
fun h1(p0: u8, p1: u16) -> u16 {
  let l2: u16 = (p1 * 5)
  if (p0 as u16) < p1 {
    return p1
  }
  return p1
}
assert entry(57277, 64) == 49018 via z80
assert entry(20982, 61) == 41981 via z80
