fun h0(p0: u8, p1: u16) -> u8 {
  let l0: u16 = p1
  if p0 < p0 {
    return ((p0 & p0) & ((p1 as u8) & p0))
  }
  return (p0 - p0)
}
fun h1(p0: u8) -> u8 {
  let l1: u16 = (p0 as u16)
  if p0 < p0 {
    return p0
  }
  return h0(p0, l1)
}
fun entry(a: u16, b: u8) -> u16 {
  let v2: u8 = ((b xor b) + b)
  let v3: u8 = b
  let v4: u8 = 0
  let v5: u16 = a
  let res: u16 = (v2 as u16) xor (v4 as u16) xor (b as u16) xor (v3 as u16) xor a xor v5
  return res
}
assert entry(49304, 31) == 31 via z80
assert entry(11780, 165) == 165 via z80
