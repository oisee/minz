fun h0(p0: u8) -> u8 {
  let l0: u8 = p0
  if p0 < p0 {
    return l0
  }
  return l0
}
fun h1(p0: u8, p1: u16) -> u16 {
  if (p0 as u16) < p1 {
    return p1
  }
  return (((p0 as u16) | p1) xor p1)
}
fun entry(a: u16, b: u8) -> u16 {
  let v2: u16 = h1(b, a)
  let v3: u8 = b
  let v4: u8 = h0(b)
  let res: u16 = (v4 as u16) xor (b as u16) xor v2 xor a xor (v3 as u16)
  return res
}
fun h2(p0: u16) -> u16 {
  let l1: u16 = (p0 xor p0)
  if l1 < p0 {
    return p0
  }
  return ((l1 + p0) + (p0 | 2))
}
assert entry(43967, 168) == 168 via z80
assert entry(9091, 205) == 205 via z80
