; MinZ Intermediate Representation (MIR)
; Module: main

Function test_16bit_ops() -> void
  @smc
  Locals:
    r1 = a: u16
    r3 = b: u16
    r5 = c: u16
    r7 = d: u16
    r9 = mask: u16
    r11 = result: u16
    r15 = shifted: u16
  Instructions:
      0: r2 = 4660
      1: store , r2
      2: r4 = 22136
      3: store , r4
      4: r6 = 100
      5: store , r6
      6: r8 = 200
      7: store , r8
      8: r10 = 65280
      9: store , r10
     10: r12 = load b
     11: r13 = load mask
     12: r14 = r12 & r13
     13: store , r14
     14: r16 = load a
     15: r17 = 4
     16: 34
     17: store , r18
     18: return

Function main() -> void
  @smc
  Instructions:
      0: return

