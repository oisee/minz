;; SimplifyIdentities — ISLE rules for MIR2 algebraic simplification
;;
;; These rules eliminate identity operations that don't change values.
;; Applied as a pre-pass before more complex optimizations.

;; Additive identity
(rule (add ?x (const 0)) ?x)
(rule (add (const 0) ?x) ?x)

;; Multiplicative identity
(rule (mul ?x (const 1)) ?x)
(rule (mul (const 1) ?x) ?x)

;; Multiplicative zero
(rule (mul ?x (const 0)) (const 0))
(rule (mul (const 0) ?x) (const 0))

;; Subtractive identity
(rule (sub ?x (const 0)) ?x)

;; Double negation
(rule (neg (neg ?x)) ?x)

;; Double complement
(rule (not (not ?x)) ?x)

;; AND identity / zero
(rule (and ?x (const 255)) ?x)     ;; u8: x & 0xFF = x
(rule (and ?x (const 0)) (const 0))

;; OR identity / zero
(rule (or ?x (const 0)) ?x)
(rule (or (const 0) ?x) ?x)

;; XOR self = 0
(rule (xor ?x ?x) (const 0))

;; Shift by zero
(rule (shl ?x (const 0)) ?x)
(rule (shr ?x (const 0)) ?x)
(rule (sar ?x (const 0)) ?x)

;; INC/DEC peephole
(rule 10 (add ?x (const 1)) (inc ?x))
(rule 10 (sub ?x (const 1)) (dec ?x))

;; ── From SimplifyIdentities (constprop.go) ──────────────────────────────

;; Sub(0, x) → Neg(x) — zero minus x is negation
(rule (sub (const 0) ?x) (neg ?x))

;; PtrAdd(x, 0) → x — null offset is identity
(rule (ptr_add ?x (const 0)) ?x)

;; ── Multiply strength reduction (from SDCC + combine.go) ────────────────

;; x*2 → x+x (ADD is 1 byte, MUL would be a call)
(rule 15 (mul ?x (const 2)) (add ?x ?x))
(rule 15 (mul (const 2) ?x) (add ?x ?x))

;; x*4 → shl(x, 2)
(rule 15 (mul ?x (const 4)) (shl ?x (const 2)))
(rule 15 (mul (const 4) ?x) (shl ?x (const 2)))

;; x*8 → shl(x, 3)
(rule 15 (mul ?x (const 8)) (shl ?x (const 3)))
(rule 15 (mul (const 8) ?x) (shl ?x (const 3)))

;; ── Bitwise identities ──────────────────────────────────────────────────

;; AND with self = self
(rule (and ?x ?x) ?x)

;; OR with self = self
(rule (or ?x ?x) ?x)

;; XOR with zero = identity (both operand positions)
(rule (xor ?x (const 0)) ?x)
(rule (xor (const 0) ?x) ?x)

;; ── Comparison simplification ───────────────────────────────────────────

;; cmp(x, x) — comparing equal values
;; (always true for eq/le/ge, always false for ne/lt/gt)
;; Expressed as: cmp(x, x) → const_true for eq
(rule (cmp_eq ?x ?x) (const 1))
(rule (cmp_ne ?x ?x) (const 0))

;; ── Extension/truncation identities ─────────────────────────────────────

;; Truncate(Extend(x)) when widths cancel → identity
;; (expressed via nested call patterns)
(rule (trunc (ext ?x)) ?x)
(rule (trunc (sext ?x)) ?x)
