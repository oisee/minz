// Simplified case test
enum State { A, B }
enum Input { X, Y }

fun test(s: State, i: Input) -> State {
    case s {
        State.A => {
            case i {
                Input.X => State.B,
                _ => State.A,
            }
        },
        State.B => State.A,
    }
}

fun main() -> void {
    let result = test(State.A, Input.X);
}
