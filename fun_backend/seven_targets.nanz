// Seven Targets — one source, seven backends, all correct.
//
// This program compiles to 7 different targets:
//
//   TARGET 1: Z80 Assembly
//     mz seven_targets.nanz -o out.a80
//     mza out.a80 -o out.bin
//     mze out.bin
//
//   TARGET 2: LLVM IR → native x86_64
//     mz seven_targets.nanz --emit llvm -o out.ll
//     clang out.ll -o out && ./out; echo "exit: $?"
//
//   TARGET 3: LLVM IR → JIT
//     lli out.ll   (after adding wrapper)
//
//   TARGET 4: WebAssembly
//     mz seven_targets.nanz --emit wasm
//
//   TARGET 5: QBE → native
//     mzn seven_targets.nanz --qbe
//
//   TARGET 6: C99 → native
//     mzn seven_targets.nanz --c99
//
//   TARGET 7: MIR2 VM (no codegen needed)
//     mzv seven_targets.nanz
//
// Verify correctness on ALL:
//   mz seven_targets.nanz --asserts-force mir2
//   mz seven_targets.nanz --asserts-force z80
//   mz seven_targets.nanz --asserts-force wasm
//   mz seven_targets.nanz --asserts-force llvm

fun add(a: u8, b: u8) -> u8 { return a + b }
fun sub(a: u8, b: u8) -> u8 { return a - b }
fun mul(a: u8, b: u8) -> u8 { return a * b }
fun shl(x: u8, n: u8) -> u8 { return x << n }

fun triple(x: u8) -> u8 { return x + x + x }

fun main() -> u8 {
    return triple(add(3, 4))
}

// assert add(3, 4) == 7
// assert sub(10, 3) == 7
// assert mul(6, 7) == 42
// assert shl(1, 3) == 8
// assert triple(7) == 21
// assert triple(add(3, 4)) == 21
